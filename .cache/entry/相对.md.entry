{"sections":[{"slug":"相对","section":{"metadata":{"slug":{"Plain":"相对"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">相对观点</span>"},"taxon":{"Plain":"<span lang=\"zh\">观念</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"相对观点"},"data-taxon":{"Plain":"观念"}},"content":{"Lazy":[{"Plain":"\n<p><span lang=\"zh\">两个复杂的对象</span>, <span lang=\"zh\">可能其中一个</span><strong><span lang=\"zh\">相对于</span></strong><span lang=\"zh\">另一个就不那么复杂</span>. <span lang=\"zh\">因此采用相对的观点</span>, <span lang=\"zh\">有时可以降低我们每次需要关注的问题的复杂性</span>: <span lang=\"zh\">将复杂的问题拆解成一个基底的问题和这个基底之上的</span><strong><span lang=\"zh\">相对观点</span></strong><span lang=\"zh\">的问题</span>.</p>\n<p><span lang=\"zh\">两个不同的基底上的相对的对象可以通过</span><strong></strong>"},{"Local":{"url":"/基变换","text":"<span lang=\"zh\">基变换</span>"}},{"Plain":"<span lang=\"zh\">相联系</span>; <span lang=\"zh\">基变换常构成</span>"},{"Local":{"url":"/纤维范畴","text":"<span lang=\"zh\">纤维范畴</span>"}},{"Plain":".</p>\n<p><span lang=\"zh\">空间之间的映射</span> (<span lang=\"zh\">如</span>"},{"Local":{"url":"/纤维丛","text":"<span lang=\"zh\">纤维丛</span>"}},{"Plain":")\n$$\r\nX \\to Y\r\n$$\n<span lang=\"zh\">可视为</span><strong><span lang=\"zh\">相对于</span></strong><span lang=\"zh\">空间</span> $Y$ <span lang=\"zh\">的一个空间</span>. <span lang=\"zh\">例如</span>"},{"Local":{"url":"/主丛","text":"<span lang=\"zh\">主丛</span>"}},{"Plain":"<span lang=\"zh\">可视为相对于基底的主齐性空间</span>.</p>\n"}]}}}]}