{"sections":[{"slug":"Weyl特征公式","section":{"metadata":{"slug":{"Plain":"Weyl特征公式"},"ext":{"Plain":"md"},"title":{"Plain":"“Weyl <span lang=\"zh\">特征公式</span>”"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"“Weyl 特征公式”"},"data-taxon":{"Plain":"百科"}},"content":{"Plain":"\n<p>Weyl <span lang=\"zh\">特征公式将不可约表示的特征表示为极大权</span> (heighest weights).</p>\n"}}}]}