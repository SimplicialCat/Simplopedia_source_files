{"metadata":{"slug":[{"Plain":"预层意象"},0],"title":[{"Plain":"预层意象"},2],"author":[{"Lazy":[{"Local":{"url":"SimplicialCat","text":"SimplicialCat"}}]},4],"tag":[{"Plain":"百科"},3],"ext":[{"Plain":"md"},1]},"content":{"Lazy":[{"Plain":"\n<p>预层意象指的是某范畴上 $\\mathsf{Set}$ (或 $\\mathsf{Ani}$) 取值的"},{"Local":{"url":"预层","text":"预层"}},{"Plain":"构成的"},{"Local":{"url":"意象","text":"意象"}},{"Plain":".</p>\n<h2>性质</h2>\n"}]}}