{"sections":[{"slug":"预层意象","section":{"metadata":{"slug":{"Plain":"预层意象"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">预层意象</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"预层意象"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<p><span lang=\"zh\">预层意象指的是某范畴上</span> $\\mathsf{Set}$ (<span lang=\"zh\">或</span> $\\mathsf{Ani}$) <span lang=\"zh\">取值的</span>"},{"Local":{"url":"/预层","text":"<span lang=\"zh\">预层</span>"}},{"Plain":"<span lang=\"zh\">构成的</span>"},{"Local":{"url":"/意象","text":"<span lang=\"zh\">意象</span>"}},{"Plain":".</p>\n<h2><span lang=\"zh\">性质</span></h2>\n"}]}}}]}