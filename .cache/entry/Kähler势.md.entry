{"sections":[{"slug":"Kähler势","section":{"metadata":{"slug":{"Plain":"Kähler势"},"ext":{"Plain":"md"},"title":{"Plain":"“Kähler <span lang=\"zh\">势</span>”"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"“Kähler 势”"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">定义</span></h2>\n<p><span lang=\"zh\">设</span> $\\rho$ <span lang=\"zh\">是</span>"},{"Local":{"url":"/复流形","text":"<span lang=\"zh\">复流形</span>"}},{"Plain":" $M$ <span lang=\"zh\">上的实值光滑函数</span>. <span lang=\"zh\">若实闭</span> $(1,1)$-<span lang=\"zh\">形式</span>\n$$\r\n\\omega = \\frac{\\sqrt{-1}}{2}\\partial \\bar\\partial \\rho\r\n$$\n<span lang=\"zh\">是</span>"},{"Local":{"url":"/正形式","text":"<span lang=\"zh\">正形式</span>"}},{"Plain":", <span lang=\"zh\">也即是</span> "},{"Local":{"url":"/Kähler形式","text":"<span lang=\"zh\">基本形式</span>"}},{"Plain":", <span lang=\"zh\">则称</span> $\\rho$ <span lang=\"zh\">为其</span> Kähler <span lang=\"zh\">势</span>.</p>\n<h2><span lang=\"zh\">性质</span></h2>\n<p>Kähler <span lang=\"zh\">形式整体上不一定可表示为</span> $\\displaystyle \\frac{\\sqrt{-1}}{2}\\partial \\bar\\partial \\rho$ <span lang=\"zh\">的形式</span>, <span lang=\"zh\">但若两个</span> Kähler <span lang=\"zh\">形式在同一个</span> de Rham <span lang=\"zh\">上同调类中</span>, <span lang=\"zh\">它们的差可表示为这种形式</span>. <span lang=\"zh\">另一个</span> Kähler <span lang=\"zh\">形式</span> $\\omega' = \\omega + d\\beta$</p>\n"}]}}}]}