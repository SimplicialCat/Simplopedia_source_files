{"metadata":{"author":[{"Lazy":[{"Local":{"url":"SimplicialCat","text":"SimplicialCat"}}]},4],"slug":[{"Plain":"保守函子"},0],"title":[{"Plain":"保守函子"},2],"tag":[{"Plain":"百科"},3],"ext":[{"Plain":"md"},1]},"content":{"Lazy":[{"Plain":"\n<h2>定义</h2>\n<p><strong>保守函子</strong> (conservative functor) 是"},{"Local":{"url":"反映(范畴论)","text":"反映同构"}},{"Plain":"的函子.</p>\n<h2>例</h2>\n<p>"},{"Local":{"url":"全忠实函子","text":"全忠实函子"}},{"Plain":"为保守函子.</p>\n<p>"},{"Local":{"url":"自由-遗忘伴随","text":"遗忘函子"}},{"Plain":" $\\mathsf{Grp}\\to\\mathsf{Set}$ 为保守函子. 对任何"},{"Local":{"url":"代数理论","text":"代数理论"}},{"Plain":"乃至"},{"Local":{"url":"单子","text":"单子"}},{"Plain":"都是如此.</p>\n"}]}}