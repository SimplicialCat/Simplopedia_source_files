{"sections":[{"slug":"单Lie群","section":{"metadata":{"slug":{"Plain":"单Lie群"},"ext":{"Plain":"md"},"title":{"Plain":"“<span lang=\"zh\">单</span> Lie <span lang=\"zh\">群</span>”"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"“单 Lie 群”"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<p><span lang=\"zh\">单</span> Lie <span lang=\"zh\">群是指非交换连通</span> Lie <span lang=\"zh\">群</span>, <span lang=\"zh\">没有非平凡的连通正规子群</span>. <span lang=\"zh\">这等价于其</span> Lie <span lang=\"zh\">代数为</span>"},{"Local":{"url":"/单Lie代数","text":"<span lang=\"zh\">单</span> Lie <span lang=\"zh\">代数</span>"}},{"Plain":".</p>\n<h2><span lang=\"zh\">相关概念</span></h2>\n<p>"},{"Local":{"url":"/单群","text":"<span lang=\"zh\">单群</span>"}},{"Plain":"</p>\n"}]}}}]}