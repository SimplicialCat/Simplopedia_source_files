{"sections":[{"slug":"deRham上同调","section":{"metadata":{"slug":{"Plain":"deRham上同调"},"ext":{"Plain":"md"},"title":{"Plain":"de Rham <span lang=\"zh\">上同调</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"de Rham 上同调"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<p><span lang=\"zh\">代数簇</span> (<span lang=\"zh\">或代数几何中更一般的几何对象</span>) <span lang=\"zh\">的</span> <strong>De Rham <span lang=\"zh\">上同调</span></strong><span lang=\"zh\">是</span> "},{"Local":{"url":"/deRham复形","text":"de Rham <span lang=\"zh\">复形</span>"}},{"Plain":"<span lang=\"zh\">的</span>"},{"Local":{"url":"/超上同调","text":"<span lang=\"zh\">超上同调</span>"}},{"Plain":".</p>\n<p><span lang=\"zh\">对于好的代数簇</span>, <span lang=\"zh\">例如光滑紧合的代数簇</span>, <span lang=\"zh\">其</span> de Rham <span lang=\"zh\">上同调等同于其解析化后的</span> de Rham <span lang=\"zh\">上同调</span>.</p>\n"}]}}}]}