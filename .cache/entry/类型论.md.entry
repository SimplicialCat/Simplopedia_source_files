{"sections":[{"slug":"类型论","section":{"metadata":{"slug":{"Plain":"类型论"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">类型论</span>"},"taxon":{"Plain":"<span lang=\"zh\">学科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"类型论"},"data-taxon":{"Plain":"学科"}},"content":{"Lazy":[{"Plain":"\n<p><span lang=\"zh\">类型论是一种关于</span> “<span lang=\"zh\">元素</span>” <span lang=\"zh\">与</span> “<span lang=\"zh\">类型</span>” <span lang=\"zh\">的形式语言</span>, <span lang=\"zh\">适于作为</span>"},{"Local":{"url":"/数学基础","text":"<span lang=\"zh\">数学基础</span>"}},{"Plain":", <span lang=\"zh\">以及作为范畴的</span>"},{"Local":{"url":"/内语言","text":"<span lang=\"zh\">内语言</span>"}},{"Plain":".</p>\n<p>"},{"Local":{"url":"/tutorial-type-theory","text":"<span lang=\"zh\">教程</span> : <span lang=\"zh\">类型论</span>"}},{"Plain":"</p>\n<p><span lang=\"zh\">分支</span>:</p>\n<ul>\n<li>"},{"Local":{"url":"/同伦类型论","text":"<span lang=\"zh\">同伦类型论</span>"}},{"Plain":"</li>\n</ul>\n"}]}}}]}