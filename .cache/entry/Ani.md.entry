{"sections":[{"slug":"Ani","section":{"metadata":{"slug":{"Plain":"Ani"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">生象的范畴</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"生象的范畴"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<p><span lang=\"zh\">生象的范畴</span> $\\mathsf{Ani}$ <span lang=\"zh\">是最基本的</span> "},{"Local":{"url":"/∞-意象","text":"$\\infty$-<span lang=\"zh\">意象</span>"}},{"Plain":".</p>\n<h2><span lang=\"zh\">性质</span></h2>\n<p>$\\mathsf{Ani}$ <span lang=\"zh\">是一个点在</span>"},{"Local":{"url":"/余极限","text":"<span lang=\"zh\">余极限</span>"}},{"Plain":"<span lang=\"zh\">下自由生成的范畴</span>.</p>\n<h3><span lang=\"zh\">带基点对象</span></h3>\n<p>$\\mathsf{Ani}$ <span lang=\"zh\">的终对象</span> $*$ <span lang=\"zh\">下的</span>"},{"Local":{"url":"/仰范畴","text":"<span lang=\"zh\">仰范畴</span>"}},{"Plain":"<span lang=\"zh\">称为</span><strong><span lang=\"zh\">带基点生象</span></strong><span lang=\"zh\">的范畴</span> "},{"Local":{"url":"/Ani_pt","text":"$\\mathsf{Ani}_*$"}},{"Plain":".</p>\n"}]}}}]}