{"sections":[{"slug":"局部化(范畴论)","section":{"metadata":{"slug":{"Plain":"局部化(范畴论)"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">局部化</span> (<span lang=\"zh\">范畴论</span>)"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"subject":{"Lazy":[{"Local":{"url":"/范畴论","text":"<span lang=\"zh\">范畴论</span>"}}]},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"局部化 (范畴论)"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">观念</span></h2>\n<p><span lang=\"zh\">在</span>"},{"Local":{"url":"/范畴论","text":"<span lang=\"zh\">范畴论</span>"}},{"Plain":"<span lang=\"zh\">中</span>, <strong><span lang=\"zh\">局部化</span></strong><span lang=\"zh\">是一种万有的使一些态射变得可逆的方法</span>.</p>\n<p><span lang=\"zh\">另见</span>"},{"Local":{"url":"/局部化","text":"<span lang=\"zh\">局部化</span> (<span lang=\"zh\">环</span>)"}},{"Plain":", "},{"Local":{"url":"/Bousfield局部化","text":"Bousfield <span lang=\"zh\">局部化</span> (<span lang=\"zh\">稳定同伦论</span>)"}},{"Plain":".</p>\n<h2><span lang=\"zh\">定义</span></h2>\n<p><span lang=\"zh\">设</span> $\\mathcal{C}$ <span lang=\"zh\">为范畴</span>, $S$ <span lang=\"zh\">为</span> $\\mathcal{C}$ <span lang=\"zh\">中的一族态射</span>. <span lang=\"zh\">定义</span> $\\mathcal C$ <span lang=\"zh\">关于</span> $S$ <span lang=\"zh\">的</span><strong><span lang=\"zh\">局部化</span></strong><span lang=\"zh\">为满足如下条件的范畴</span> $\\mathcal C[S^{-1}]$ <span lang=\"zh\">配备函子</span> $\\mathcal C \\to \\mathcal C[S^{-1}]$:</p>\n<ul>\n<li><span lang=\"zh\">对任意函子</span> $F\\colon \\mathcal C\\to\\mathcal D$, <span lang=\"zh\">若</span> $F$ <span lang=\"zh\">将</span> $S$ <span lang=\"zh\">中的每个态射变为同构</span>, <span lang=\"zh\">则</span> $F$ <span lang=\"zh\">唯一地穿过</span> $\\mathcal C \\to \\mathcal C[S^{-1}]$, <span lang=\"zh\">即存在唯一的</span> $\\mathcal C[S^{-1}] \\to \\mathcal D$ <span lang=\"zh\">以及交换图</span>$$\r\n\\begin{array}{ccc}\r\n\\mathcal C &amp; \\rightarrow &amp; \\mathcal C[S^{-1}] \\\\\r\n &amp; \\searrow &amp; \\downarrow \\\\\r\n &amp;  &amp; \\mathcal D.\r\n\\end{array}\r\n$$</li>\n</ul>\n<p><span lang=\"zh\">等价地</span>, <span lang=\"zh\">可定义</span> $\\mathcal C[S^{-1}]$ <span lang=\"zh\">为</span>"},{"Local":{"url":"/Cat","text":"<span lang=\"zh\">范畴的范畴</span> $\\mathsf{Cat}$"}},{"Plain":" <span lang=\"zh\">中的如下</span>"},{"Local":{"url":"/推出","text":"<span lang=\"zh\">推出</span>"}},{"Plain":",\n$$\r\n\\begin{array}{ccc}\r\n\\bigsqcup_S \\{\\cdot\\to\\cdot\\} &amp; \\rightarrow &amp; \\bigsqcup_S \\{\\cdot\\leftrightarrow\\cdot\\} \\\\\r\n\\downarrow &amp;  &amp; \\downarrow \\\\\r\n\\mathcal C &amp; \\rightarrow &amp; \\mathcal C[S^{-1}]\r\n\\end{array}\r\n$$\n<span lang=\"zh\">其中</span> $\\{\\cdot\\to\\cdot\\}$ <span lang=\"zh\">是</span>"},{"Local":{"url":"/游走","text":"<span lang=\"zh\">游走</span>"}},{"Plain":"<span lang=\"zh\">的箭头</span>.</p>\n"}]}}}]}