{"sections":[{"slug":"p-进整数","section":{"metadata":{"slug":{"Plain":"p-进整数"},"ext":{"Plain":"md"},"title":{"Plain":"p-<span lang=\"zh\">进整数</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"p-进整数"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">定义</span></h2>\n<p><span lang=\"zh\">对于素数</span> $p$, <span lang=\"zh\">定义</span> <strong>$p$-<span lang=\"zh\">进整数环</span></strong> $\\mathbb{Z}_p$ <span lang=\"zh\">为整数环</span> $\\mathbb{Z}$ <span lang=\"zh\">关于</span> $p$ <span lang=\"zh\">生成的理想</span> $(p)$ <span lang=\"zh\">的</span>"},{"Local":{"url":"/完备化(环)","text":"<span lang=\"zh\">完备化</span>"}},{"Plain":", <span lang=\"zh\">即</span>\n$$\r\n\\mathbb{Z}_p = \\operatorname{lim}_n \\mathbb{Z}/(p^n).\r\n$$</p>\n"}]}}}]}