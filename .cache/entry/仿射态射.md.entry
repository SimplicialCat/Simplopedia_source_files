{"sections":[{"slug":"仿射态射","section":{"metadata":{"slug":{"Plain":"仿射态射"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">仿射态射</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"subject":{"Lazy":[{"Local":{"url":"/代数几何","text":"<span lang=\"zh\">代数几何</span>"}}]},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"仿射态射"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">观念</span></h2>\n<p><span lang=\"zh\">仿射态射是</span>"},{"Local":{"url":"/相对","text":"<span lang=\"zh\">相对</span>"}},{"Plain":"<span lang=\"zh\">版本的</span>"},{"Local":{"url":"/仿射概形","text":"<span lang=\"zh\">仿射概形</span>"}},{"Plain":".</p>\n<h2><span lang=\"zh\">定义</span></h2>\n<p><span lang=\"zh\">对于</span>"},{"Local":{"url":"/概形","text":"<span lang=\"zh\">概形</span>"}},{"Plain":"<span lang=\"zh\">的态射</span> $f\\colon X\\to Y$, <span lang=\"zh\">若对任意仿射开集</span> $U\\subset Y$, <span lang=\"zh\">其原像</span> $X\\times_Y U$ <span lang=\"zh\">为</span>"},{"Local":{"url":"/仿射概形","text":"<span lang=\"zh\">仿射概形</span>"}},{"Plain":", <span lang=\"zh\">则称</span> $f$ <span lang=\"zh\">为</span><strong><span lang=\"zh\">仿射态射</span></strong>.</p>\n<h2><span lang=\"zh\">性质</span></h2>\n<p><span lang=\"zh\">仿射态射是</span>"},{"Local":{"url":"/局部性质","text":"<span lang=\"zh\">目标上的局部性质</span>"}},{"Plain":", <span lang=\"zh\">在</span>"},{"Local":{"url":"/基变换","text":"<span lang=\"zh\">基变换</span>"}},{"Plain":"<span lang=\"zh\">下稳定</span>.</p>\n<p><strong><span lang=\"zh\">定理</span></strong>. <span lang=\"zh\">对于仿射态射</span> $p\\colon Y\\to X$, <span lang=\"zh\">有</span> $p_*\\mathcal O_Y$<span lang=\"zh\">为</span>"},{"Local":{"url":"/拟凝聚层","text":"<span lang=\"zh\">拟凝聚</span>"}},{"Plain":" $\\mathcal O_X$-<span lang=\"zh\">代数</span>, <span lang=\"zh\">且</span> $Y$ <span lang=\"zh\">到</span>"},{"Local":{"url":"/相对谱","text":"<span lang=\"zh\">相对谱</span>"}},{"Plain":"<span lang=\"zh\">的典范的映射</span> $Y\\to\\operatorname{Spec}_X(p_*\\mathcal O_Y)$ <span lang=\"zh\">为同构</span>.</p>\n<p><strong><span lang=\"zh\">推论</span></strong>. "},{"Local":{"url":"/闭嵌入","text":"<span lang=\"zh\">闭嵌入</span>"}},{"Plain":"<span lang=\"zh\">都是仿射态射</span>.</p>\n"}]}}}]}