{"metadata":{"tag":[{"Plain":"百科"},3],"title":[{"Plain":"Lean"},2],"author":[{"Lazy":[{"Local":{"url":"SimplicialCat","text":"SimplicialCat"}}]},4],"slug":[{"Plain":"Lean"},0],"ext":[{"Plain":"md"},1]},"content":{"Lazy":[{"Plain":"\n<h2>观念</h2>\n<p><span class=\"link external\"><a href=\"https://lean-lang.org/\" title=\"Lean [https://lean-lang.org/]\">Lean</a></span>, 此处特指 Lean 4 (包含 <span class=\"link external\"><a href=\"https://lean-lang.org/use-cases/mathlib/\" title=\"Mathlib [https://lean-lang.org/use-cases/mathlib/]\">Mathlib</a></span>), 是一种基于"},{"Local":{"url":"类型论","text":"类型论"}},{"Plain":"的, 用于做"},{"Local":{"url":"形式化数学","text":"形式化数学"}},{"Plain":"的编程语言.</p>\n<h2>相关话题</h2>\n<p>"},{"Local":{"url":"AI4FP","text":"AI 与形式化数学"}},{"Plain":"</p>\n"}]}}