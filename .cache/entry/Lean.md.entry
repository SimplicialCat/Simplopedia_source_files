{"sections":[{"slug":"Lean","section":{"metadata":{"slug":{"Plain":"Lean"},"ext":{"Plain":"md"},"title":{"Plain":"Lean"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"Lean"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">观念</span></h2>\n<p><span class=\"link external\"><a href=\"https://lean-lang.org/\" title=\"Lean [https://lean-lang.org/]\">Lean</a></span>, <span lang=\"zh\">此处特指</span> Lean 4 (<span lang=\"zh\">包含</span> <span class=\"link external\"><a href=\"https://lean-lang.org/use-cases/mathlib/\" title=\"Mathlib [https://lean-lang.org/use-cases/mathlib/]\">Mathlib</a></span>), <span lang=\"zh\">是一种基于</span>"},{"Local":{"url":"/类型论","text":"<span lang=\"zh\">类型论</span>"}},{"Plain":"<span lang=\"zh\">的</span>, <span lang=\"zh\">用于做</span>"},{"Local":{"url":"/形式化数学","text":"<span lang=\"zh\">形式化数学</span>"}},{"Plain":"<span lang=\"zh\">的编程语言</span>.</p>\n<h2><span lang=\"zh\">相关话题</span></h2>\n<p>"},{"Local":{"url":"/AI4FP","text":"AI <span lang=\"zh\">与形式化数学</span>"}},{"Plain":"</p>\n"}]}}}]}