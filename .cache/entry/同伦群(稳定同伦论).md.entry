X) = \\pi_0 (X[-n])$.</p>\n<h3><span lang=\"zh\">通过余极限</span></h3>\n<p><span lang=\"zh\">对于来自</span>"},{"Local":{"url":"/稳定化","text":"<span lang=\"zh\">稳定化</span>"}},{"Plain":"<span lang=\"zh\">过程的</span>"},{"Local":{"url":"/稳定无穷范畴","text":"<span lang=\"zh\">稳定</span> $\\infty$-<span lang=\"zh\">范畴</span>"}},{"Plain":", <span lang=\"zh\">例如</span>"},{"Local":{"url":"/谱","text":"<span lang=\"zh\">谱</span>"}},{"Plain":"<span lang=\"zh\">的范畴</span> "},{"Local":{"url":"/Sp","text":"$\\mathsf{Sp}$"}},{"Plain":", <span lang=\"zh\">其中对象的同伦群可定义为逼近它的一列对象的同伦群的</span>"},{"Local":{"url":"/余极限","text":"<span lang=\"zh\">余极限</span>"}},{"Plain":": <span lang=\"zh\">若</span>\n$$\r\nX = \\operatorname{colim}_k \\Sigma^{\\infty-k} X_k,\r\n$$\n<span lang=\"zh\">则</span>\n$$\r\n\\pi_n(X) = \\operatorname{colim}_k \\pi_{n+k} X_k.\r\n$$</p>\n"}]}}}]}