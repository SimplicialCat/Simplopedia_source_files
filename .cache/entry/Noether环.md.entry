{"sections":[{"slug":"Noether环","section":{"metadata":{"slug":{"Plain":"Noether环"},"ext":{"Plain":"md"},"title":{"Plain":"“Noether <span lang=\"zh\">环</span>”"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"“Noether 环”"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<p>Noether <span lang=\"zh\">环是满足升链性质的环</span>. (<span lang=\"zh\">这里的环是指交换环</span>.)</p>\n<h2><span lang=\"zh\">例</span></h2>\n<ul>\n<li><span lang=\"zh\">若</span> $R$ <span lang=\"zh\">是</span> Noether <span lang=\"zh\">环</span>, <span lang=\"zh\">则</span> $R[x]$ <span lang=\"zh\">是</span> Noether <span lang=\"zh\">环</span>.</li>\n<li>Noether <span lang=\"zh\">环的商是</span> Noether <span lang=\"zh\">环</span>.</li>\n<li>Noether <span lang=\"zh\">环的局部化是</span> Noether <span lang=\"zh\">环</span>.</li>\n<li>"},{"Local":{"url":"/Artin环","text":"Artin <span lang=\"zh\">环</span>"}},{"Plain":"<span lang=\"zh\">是</span> Noether <span lang=\"zh\">环</span>.</li>\n</ul>\n"}]}}}]}