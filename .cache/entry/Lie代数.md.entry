{"metadata":{"author":[{"Lazy":[{"Local":{"url":"SimplicialCat","text":"SimplicialCat"}}]},4],"title":[{"Plain":"Lie 代数"},2],"ext":[{"Plain":"md"},1],"tag":[{"Plain":"百科"},3],"slug":[{"Plain":"Lie代数"},0]},"content":{"Lazy":[{"Plain":"\n<h2>定义</h2>\n<h3>作为 Lawvere 理论</h3>\n<p>Lie 代数的理论是一种 "},{"Local":{"url":"Lawvere理论","text":"Lawvere 理论"}},{"Plain":".</p>\n<h3>通过算畴</h3>\n<p>Lie 代数是 "},{"Local":{"url":"Lie算畴","text":"Lie 算畴"}},{"Plain":"上的代数.</p>\n<h2>相关概念</h2>\n<p>"},{"Local":{"url":"Cartan子代数","text":"Cartan 子代数"}},{"Plain":", "},{"Local":{"url":"根","text":"根"}},{"Plain":", "},{"Local":{"url":"微分分次Lie代数","text":"微分分次 Lie 代数"}},{"Plain":"</p>\n"}]}}