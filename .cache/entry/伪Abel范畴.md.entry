{"sections":[{"slug":"伪Abel范畴","section":{"metadata":{"slug":{"Plain":"伪Abel范畴"},"ext":{"Plain":"md"},"title":{"Plain":"“<span lang=\"zh\">伪</span> Abel <span lang=\"zh\">范畴</span>”"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"“伪 Abel 范畴”"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">定义</span></h2>\n<p><span lang=\"zh\">伪</span> Abel <span lang=\"zh\">范畴</span> (pseudo-abelian category) <span lang=\"zh\">是指满足如下性质的</span>"},{"Local":{"url":"/加性范畴","text":"<span lang=\"zh\">加性范畴</span>"}},{"Plain":": <span lang=\"zh\">所有幂等自同态都导致一个分解</span>; <span lang=\"zh\">也即对任意对象</span> $E\\in\\mathsf C$ <span lang=\"zh\">与态射</span> $p\\colon E\\to E$, <span lang=\"zh\">只要</span> $p^2 = p$, <span lang=\"zh\">就有</span> $\\ker p$ <span lang=\"zh\">存在</span>, <span lang=\"zh\">从而</span> $E \\simeq \\ker p \\oplus \\ker (1-p)$.</p>\n<h2><span lang=\"zh\">性质</span></h2>\n<p><span lang=\"zh\">任何</span>"},{"Local":{"url":"/加性范畴","text":"<span lang=\"zh\">加性范畴</span>"}},{"Plain":"<span lang=\"zh\">可万有地嵌入某个伪</span> Abel <span lang=\"zh\">范畴中</span>.</p>\n<p><strong><span lang=\"zh\">命题</span></strong>. <span lang=\"zh\">对任意</span>"},{"Local":{"url":"/加性范畴","text":"<span lang=\"zh\">加性范畴</span>"}},{"Plain":" $\\mathsf C$, <span lang=\"zh\">存在伪</span> Abel <span lang=\"zh\">范畴</span> $\\widetilde {\\mathsf {C}}$, <span lang=\"zh\">称为关联于</span> $\\mathsf C$ <span lang=\"zh\">的伪</span> Abel <span lang=\"zh\">范畴</span>, <span lang=\"zh\">以及加性函子</span> $\\varphi\\colon \\mathsf C \\to \\widetilde {\\mathsf C}$, <span lang=\"zh\">满足泛性质</span>.</p>\n<h2><span lang=\"zh\">例</span></h2>\n<p><strong><span lang=\"zh\">定理</span></strong>. <span lang=\"zh\">设</span> $R$ <span lang=\"zh\">为含幺环</span>, <span lang=\"zh\">记</span> $\\mathsf C$ <span lang=\"zh\">为有限生成自由</span> $R$-<span lang=\"zh\">模的范畴</span>, <span lang=\"zh\">则</span> $\\widetilde {\\mathsf C}$ <span lang=\"zh\">等价于有限生成</span>"},{"Local":{"url":"/投射","text":"<span lang=\"zh\">投射对象</span>"}},{"Plain":"<span lang=\"zh\">左</span> $R$-<span lang=\"zh\">模的范畴</span>.</p>\n"}]}}}]}