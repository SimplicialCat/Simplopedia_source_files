{"sections":[{"slug":"特征簇(群)","section":{"metadata":{"slug":{"Plain":"特征簇(群)"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">特征簇</span> (<span lang=\"zh\">群</span>)"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"特征簇 (群)"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<p><span lang=\"zh\">群</span> $G$ <span lang=\"zh\">与流形</span> $X$ <span lang=\"zh\">对应的</span><strong><span lang=\"zh\">特征簇</span></strong><span lang=\"zh\">指的是</span> $X$ <span lang=\"zh\">上的</span> $G$-"},{"Local":{"url":"/局部系统","text":"<span lang=\"zh\">局部系统</span>"}},{"Plain":"<span lang=\"zh\">的</span>"},{"Local":{"url":"/模空间","text":"<span lang=\"zh\">模空间</span>"}},{"Plain":".</p>\n<p><span lang=\"zh\">特征簇具有</span>"},{"Local":{"url":"/量子化","text":"<span lang=\"zh\">量子化</span>"}},{"Plain":"; <span lang=\"zh\">见</span>"},{"Local":{"url":"/量子特征簇","text":"<span lang=\"zh\">量子特征簇</span>"}},{"Plain":".</p>\n<h2><span lang=\"zh\">性质</span></h2>\n<h3><span lang=\"zh\">层范畴</span></h3>\n<p><span lang=\"zh\">特征簇上的一些层范畴可用</span> $X$ <span lang=\"zh\">上的</span>"},{"Local":{"url":"/分解同调","text":"<span lang=\"zh\">分解同调</span>"}},{"Plain":"<span lang=\"zh\">计算</span>. <span lang=\"zh\">例如</span>"},{"Local":{"url":"/拟凝聚层","text":"<span lang=\"zh\">拟凝聚层</span>"}},{"Plain":"<span lang=\"zh\">范畴</span> $\\mathsf{QCoh}()$ <span lang=\"zh\">是表示范畴</span> $\\mathsf{Rep}(G)$ <span lang=\"zh\">的分解同调</span>.</p>\n"}]}}}]}