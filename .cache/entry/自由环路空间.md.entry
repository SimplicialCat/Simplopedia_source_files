{"sections":[{"slug":"自由环路空间","section":{"metadata":{"slug":{"Plain":"自由环路空间"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">自由环路空间</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"自由环路空间"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">定义</span></h2>\n<h3><span lang=\"zh\">生象</span></h3>\n<p>"},{"Local":{"url":"/生象","text":"<span lang=\"zh\">生象</span>"}},{"Plain":" $X$ <span lang=\"zh\">的</span><strong><span lang=\"zh\">自由环路空间</span></strong> (free loop space) $\\mathcal L X$ <span lang=\"zh\">是</span> $S^1$ <span lang=\"zh\">到</span> $X$ <span lang=\"zh\">的映射生象</span>\n$$\r\n\\mathcal L X = \\mathsf{Hom}_{\\mathsf{Ani}}(S^1,X).\r\n$$</p>\n<p><span lang=\"zh\">由于</span> $S^1$ <span lang=\"zh\">的</span>"},{"Local":{"url":"/数学对象的表现","text":"<span lang=\"zh\">表现</span>"}},{"Plain":" $S^1 = *\\sqcup_{*\\sqcup *} *$, <span lang=\"zh\">有</span>\n$$\r\n\\mathcal LX = X\\times_{X\\times X}X.\r\n$$</p>\n<h2><span lang=\"zh\">例</span></h2>\n<p>"},{"Local":{"url":"/群","text":"<span lang=\"zh\">群</span>"}},{"Plain":" $G$ <span lang=\"zh\">的</span>"},{"Local":{"url":"/逆环路空间","text":"<span lang=\"zh\">逆环路空间</span>"}},{"Plain":" $\\mathbf{B}G$ <span lang=\"zh\">的自由环路空间</span> $\\mathcal L\\mathbf{B}G$ <span lang=\"zh\">是</span> $G$ <span lang=\"zh\">关于自身的</span>"},{"Local":{"url":"/共轭作用","text":"<span lang=\"zh\">共轭作用</span>"}},{"Plain":"<span lang=\"zh\">的商</span>:\n$$\r\n\\mathcal L\\mathbf{B}G = G /_{\\mathrm{ad}} G.\r\n$$</p>\n"}]}}}]}