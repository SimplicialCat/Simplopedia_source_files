{"sections":[{"slug":"Galois覆叠","section":{"metadata":{"slug":{"Plain":"Galois覆叠"},"ext":{"Plain":"md"},"title":{"Plain":"Galois <span lang=\"zh\">覆叠</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"Galois 覆叠"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<p><strong>Galois <span lang=\"zh\">覆叠</span></strong> (<span lang=\"zh\">又叫</span><strong><span lang=\"zh\">正则覆叠</span></strong>) <span lang=\"zh\">是覆叠变换群在纤维上有</span>"},{"Local":{"url":"/传递作用","text":"<span lang=\"zh\">传递作用</span>"}},{"Plain":"<span lang=\"zh\">的</span>"},{"Local":{"url":"/覆叠","text":"<span lang=\"zh\">覆叠</span>"}},{"Plain":", <span lang=\"zh\">等同于变换群</span> (<span lang=\"zh\">作为离散群</span>) <span lang=\"zh\">的</span>"},{"Local":{"url":"/主丛","text":"<span lang=\"zh\">主丛</span>"}},{"Plain":".</p>\n"}]}}}]}