{"metadata":{"tag":[{"Plain":"百科"},3],"slug":[{"Plain":"凝聚意象"},0],"ext":[{"Plain":"md"},1],"author":[{"Lazy":[{"Local":{"url":"SimplicialCat","text":"SimplicialCat"}}]},4],"title":[{"Plain":"凝聚意象"},2]},"content":{"Lazy":[{"Plain":"\n<h2>定义</h2>\n<p>对于"},{"Local":{"url":"意象","text":"意象"}},{"Plain":" $\\mathcal C$, 若其中"},{"Local":{"url":"拟紧拟分离对象","text":"拟紧拟分离对象"}},{"Plain":"关于"},{"Local":{"url":"有限极限","text":"有限极限"}},{"Plain":"封闭且构成"},{"Local":{"url":"生成元(范畴论)","text":"生成元"}},{"Plain":", 则称其为<strong>凝聚意象</strong> (coherent topos).</p>\n<h3>高阶凝聚性</h3>\n<table><thead><tr><th>概念</th><th>等价表述</th></tr></thead><tbody>\n<tr><td>$0$-凝聚对象</td><td>拟紧对象</td></tr>\n<tr><td>局部 $0$-凝聚意象</td><td>由拟紧对象生成</td></tr>\n<tr><td>$1$-凝聚对象</td><td></td></tr>\n</tbody></table>\n<p>归纳地定义 $n$-凝聚意象</p>\n<h2>例</h2>\n"}]}}