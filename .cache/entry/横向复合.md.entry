{"sections":[{"slug":"横向复合","section":{"metadata":{"slug":{"Plain":"横向复合"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">横向复合</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"横向复合"},"data-taxon":{"Plain":"百科"}},"content":{"Plain":"\n<h2><span lang=\"zh\">观念</span></h2>\n<p><span lang=\"zh\">高阶范畴中</span>, $1$-<span lang=\"zh\">态射的复合</span>\n$$\r\n\\operatorname{Hom}(y,z)\\times \\operatorname{Hom}(x,y) \\to\\operatorname{Hom}(x,z)\r\n$$\n<span lang=\"zh\">有函子性</span>; <span lang=\"zh\">左边两个</span> Hom <span lang=\"zh\">范畴中的态射</span> (<span lang=\"zh\">即原范畴中的</span> $2$-<span lang=\"zh\">态射</span>) <span lang=\"zh\">在这一函子下的像称为</span><strong><span lang=\"zh\">横向复合</span></strong> (horizontal composition).</p>\n"}}}]}