{"sections":[{"slug":"松函子","section":{"metadata":{"slug":{"Plain":"松函子"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">松函子</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"松函子"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<p><span lang=\"zh\">松函子是</span> "},{"Local":{"url":"/2-范畴","text":"$2$-<span lang=\"zh\">范畴</span>"}},{"Plain":"<span lang=\"zh\">及更高阶范畴之间的一种态射</span> $F \\colon \\mathcal C \\to\\mathcal D$, <span lang=\"zh\">它不一定是函子</span>, <span lang=\"zh\">因为它不要求保持态射的复合等结构</span>, <span lang=\"zh\">而是要求具有某些单方向的态射</span>, <span lang=\"zh\">例如</span>\n$$\r\nF(fg) \\to F(f) F(g).\r\n$$\n<span lang=\"zh\">这些态射不一定可逆</span>.</p>\n<h2><span lang=\"zh\">例</span></h2>\n<h3><span lang=\"zh\">单子</span></h3>\n<p><span lang=\"zh\">松函子</span> $1\\to\\mathsf{Cat}$ <span lang=\"zh\">等同于一个范畴</span> $\\mathcal C$ <span lang=\"zh\">上的</span>"},{"Local":{"url":"/单子","text":"<span lang=\"zh\">单子</span>"}},{"Plain":". <span lang=\"zh\">当然这里的</span> $\\mathsf{Cat}$ <span lang=\"zh\">也可换成任意</span> $2$-<span lang=\"zh\">范畴</span>.</p>\n<h2><span lang=\"zh\">相关概念</span></h2>\n<p>"},{"Local":{"url":"/松幺半函子","text":"<span lang=\"zh\">松幺半函子</span>"}},{"Plain":"</p>\n"}]}}}]}