{"sections":[{"slug":"完备化(域)","section":{"metadata":{"slug":{"Plain":"完备化(域)"},"ext":{"Plain":"md"},"title":{"Plain":"“<span lang=\"zh\">完备化</span> (<span lang=\"zh\">域</span>)”"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"“完备化 (域)”"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<p><span lang=\"zh\">域</span> $F$ <span lang=\"zh\">关于</span>"},{"Local":{"url":"/绝对值","text":"<span lang=\"zh\">绝对值</span>"}},{"Plain":" $\\|{-}\\|\\colon F\\to\\mathbb{R}_{\\geq 0}$ <span lang=\"zh\">的完备化是一个域</span> $F'$, <span lang=\"zh\">带有绝对值</span> $\\|{-}\\|\\colon F'\\to\\mathbb{R}_{\\geq 0}$ <span lang=\"zh\">以及保持</span> $\\|{-}\\|$ <span lang=\"zh\">的稠密嵌入</span> $F\\to F'$, <span lang=\"zh\">且</span> $F'$ <span lang=\"zh\">关于</span> $\\|{-}\\|$ <span lang=\"zh\">构成完备度量空间</span>.</p>\n<h2><span lang=\"zh\">例</span></h2>\n<p>$\\mathbb{Q}$ <span lang=\"zh\">关于</span> $p$-<span lang=\"zh\">进绝对值的完备化为</span> $p$-<span lang=\"zh\">进数域</span> $\\mathbb{Q}_p$.</p>\n<h2><span lang=\"zh\">相关概念</span></h2>\n<p>"},{"Local":{"url":"/位","text":"<span lang=\"zh\">位</span>"}},{"Plain":", "},{"Local":{"url":"/完备化(环)","text":"<span lang=\"zh\">完备化</span> (<span lang=\"zh\">环</span>)"}},{"Plain":"</p>\n"}]}}}]}