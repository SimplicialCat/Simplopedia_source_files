{"metadata":{"author":[{"Lazy":[{"Local":{"url":"SimplicialCat","text":"SimplicialCat"}}]},4],"title":[{"Plain":"单纯集"},2],"slug":[{"Plain":"单纯集"},0],"ext":[{"Plain":"md"},1],"tag":[{"Plain":"百科"},3]},"content":{"Lazy":[{"Plain":"\n<h2>定义</h2>\n<p>单纯集是"},{"Local":{"url":"单纯形范畴","text":"单纯形范畴"}},{"Plain":" $\\Delta$ 上的"},{"Local":{"url":"预层","text":"预层"}},{"Plain":", 即集合范畴中的"},{"Local":{"url":"单纯对象","text":"单纯对象"}},{"Plain":".</p>\n<h2>相关概念</h2>\n<p>"},{"Local":{"url":"几何实现","text":"几何实现"}},{"Plain":", "},{"Local":{"url":"双单纯集","text":"双单纯集"}},{"Plain":".</p>\n"}]}}