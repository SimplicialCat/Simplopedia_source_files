{"sections":[{"slug":"Duhamel公式","section":{"metadata":{"slug":{"Plain":"Duhamel公式"},"ext":{"Plain":"md"},"title":{"Plain":"“Duhamel <span lang=\"zh\">公式</span>”"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"“Duhamel 公式”"},"data-taxon":{"Plain":"百科"}},"content":{"Plain":"\n<p><span lang=\"zh\">设</span> $A_z$ <span lang=\"zh\">是</span> $\\operatorname{End}(V)$ <span lang=\"zh\">中的单参数曲线</span>, <span lang=\"zh\">则</span>\n$$\r\n\\frac{d}{dz}e^{-tA_z} = - \\int_0^t e^{-(t-s)A_z} \\frac{dA_z}{dz} e^{-sA_z} \\,ds.\r\n$$</p>\n"}}}]}