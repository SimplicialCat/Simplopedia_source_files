{"sections":[{"slug":"Lie算畴","section":{"metadata":{"slug":{"Plain":"Lie算畴"},"ext":{"Plain":"md"},"title":{"Plain":"Lie <span lang=\"zh\">算畴</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"Lie 算畴"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">定义</span></h2>\n<h3><span lang=\"zh\">作为对称序列</span></h3>\n<p><span lang=\"zh\">固定基域</span> $k$, <span lang=\"zh\">记</span> $\\operatorname{Lie}(x_1,\\cdots,x_n)$ <span lang=\"zh\">为</span> $n$ <span lang=\"zh\">个变元生成的</span>"},{"Local":{"url":"/自由-遗忘伴随","text":"<span lang=\"zh\">自由</span>"}},{"Plain":" $k$-Lie <span lang=\"zh\">代数</span>; <span lang=\"zh\">令</span> $L(n)$ <span lang=\"zh\">为</span> $\\operatorname{Lie}(x_1,\\cdots,x_n)$ <span lang=\"zh\">中由所有恰包含每个</span> $x_i$ <span lang=\"zh\">一次的单项式生成的子空间</span>. <span lang=\"zh\">具体地</span>, <span lang=\"zh\">其一组基为</span>\n$$\r\n[x_{\\sigma(1)},[x_{\\sigma(2)},\\cdots[x_{\\sigma(n-1)},x_n]\\cdots]],\r\n$$\n<span lang=\"zh\">其中</span> $\\sigma\\in$ "},{"Local":{"url":"/对称群","text":"$S_{n-1}$"}},{"Plain":".</p>\n<p><span lang=\"zh\">对称群</span> "},{"Local":{"url":"/对称群","text":"$S_n$"}},{"Plain":" <span lang=\"zh\">通过变元的置换作用于</span> $L(n)$ <span lang=\"zh\">上</span>. <span lang=\"zh\">那么</span> $\\{L(n)\\}$ <span lang=\"zh\">构成</span> $k$-<span lang=\"zh\">线性空间范畴上的</span>"},{"Local":{"url":"/对称序列","text":"<span lang=\"zh\">对称序列</span>"}},{"Plain":".</p>\n"}]}}}]}