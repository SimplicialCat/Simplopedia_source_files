{"metadata":{"ext":[{"Plain":"md"},1],"tag":[{"Plain":"meta"},3],"slug":[{"Plain":"notion"},0],"author":[{"Lazy":[{"Local":{"url":"SimplicialCat","text":"SimplicialCat"}}]},4],"title":[{"Plain":"观念"},2]},"content":{"Lazy":[{"Plain":"\n<p>数学不只是公式和推理法则的游戏, 原因在于数学概念之上附加了人的<strong>观念</strong>. 它不属于逻辑, 但深刻地影响着人们做数学的方式.</p>\n<p>"},{"Embed":{"url":"数学对象的表现.md","title":null,"option":{"numbering":false,"details_open":false,"catalog":true}}},{"Plain":"</p>\n<p>"},{"Embed":{"url":"代数-几何对偶.md","title":null,"option":{"numbering":false,"details_open":false,"catalog":true}}},{"Plain":"</p>\n<p>"},{"Embed":{"url":"语法–语义对偶.md","title":null,"option":{"numbering":false,"details_open":false,"catalog":true}}},{"Plain":"</p>\n<p>"},{"Embed":{"url":"探测.md","title":null,"option":{"numbering":false,"details_open":false,"catalog":true}}},{"Plain":"</p>\n<p>"},{"Embed":{"url":"形变.md","title":null,"option":{"numbering":false,"details_open":false,"catalog":true}}},{"Plain":"</p>\n"}]}}