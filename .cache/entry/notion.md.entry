{"sections":[{"slug":"notion","section":{"metadata":{"slug":{"Plain":"notion"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">观念</span>"},"taxon":{"Plain":"Meta. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"观念"},"data-taxon":{"Plain":"Meta"}},"content":{"Lazy":[{"Plain":"\n<p><span lang=\"zh\">数学不只是公式和推理法则的游戏</span>, <span lang=\"zh\">原因在于数学概念之上附加了人的</span><strong><span lang=\"zh\">观念</span></strong>. <span lang=\"zh\">它不属于逻辑</span>, <span lang=\"zh\">但深刻地影响着人们做数学的方式</span>.</p>\n"},{"Embed":{"url":"/数学对象的表现.md","title":null,"option":{"numbering":false,"details_open":false,"catalog":true}}},{"Embed":{"url":"/语法–语义对偶.md","title":null,"option":{"numbering":false,"details_open":false,"catalog":true}}}]}}}]}