{"sections":[{"slug":"直化","section":{"metadata":{"slug":{"Plain":"直化"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">直化</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"直化"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">观念</span></h2>\n<p><span lang=\"zh\">将范畴</span> $\\mathcal C$ <span lang=\"zh\">上的</span>"},{"Local":{"url":"/纤维范畴","text":"<span lang=\"zh\">纤维范畴</span>"}},{"Plain":"<span lang=\"zh\">对应到函子</span> $\\mathcal C \\to \\mathsf{Cat}$, <span lang=\"zh\">称为</span><strong><span lang=\"zh\">直化</span></strong> (straightening); <span lang=\"zh\">反之称为</span><strong><span lang=\"zh\">反直化</span></strong> (unstraightening).</p>\n"}]}}}]}