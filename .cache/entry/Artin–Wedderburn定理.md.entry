{"sections":[{"slug":"Artin–Wedderburn定理","section":{"metadata":{"slug":{"Plain":"Artin–Wedderburn定理"},"ext":{"Plain":"md"},"title":{"Plain":"Artin–Wedderburn <span lang=\"zh\">定理</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"Artin–Wedderburn 定理"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">陈述</span></h2>\n<p>"},{"Local":{"url":"/半单环","text":"<span lang=\"zh\">半单环</span>"}},{"Plain":" $R$ <span lang=\"zh\">是有限个除环上的矩阵代数的积</span>:\n$$\r\nR \\simeq \\prod_{i=1}^n M_{n_i}(D_i).\r\n$$</p>\n<h2><span lang=\"zh\">证明</span></h2>\n<p><span lang=\"zh\">将</span> $R$ <span lang=\"zh\">视为自身上的</span>"},{"Local":{"url":"/结合代数上的模","text":"<span lang=\"zh\">模</span>"}},{"Plain":", <span lang=\"zh\">分解为单模</span>:\n$$\r\nR \\simeq \\bigoplus X_i^{n_i}.\r\n$$</p>\n<p><span lang=\"zh\">由</span> "},{"Local":{"url":"/Schur引理","text":"Schur <span lang=\"zh\">引理</span>"}},{"Plain":",\n$$\r\n\\operatorname{End}(R)\\simeq \\prod_{i=1}^n M_{n_i}(\\operatorname{End}(X_i)),\r\n$$\n<span lang=\"zh\">其中</span> $\\operatorname{End}(X_i)$ <span lang=\"zh\">为除环</span>.</p>\n<p><span lang=\"zh\">最后</span>, $R$ <span lang=\"zh\">作为模的自同态环同构于环</span> $R$:\n$$\r\nR\\simeq \\operatorname{End}(R).\r\n$$\n<span lang=\"zh\">结论得证</span>.</p>\n"}]}}}]}