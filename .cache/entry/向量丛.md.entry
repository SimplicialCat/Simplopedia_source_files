{"metadata":{"title":[{"Plain":"向量丛"},2],"author":[{"Lazy":[{"Local":{"url":"SimplicialCat","text":"SimplicialCat"}}]},4],"ext":[{"Plain":"md"},1],"taxon":[{"Plain":"百科. "},3],"slug":[{"Plain":"向量丛"},0]},"content":{"Lazy":[{"Plain":"\n<h2>观念</h2>\n<p><strong>向量丛</strong>是以线性空间为纤维的"},{"Local":{"url":"纤维丛","text":"纤维丛"}},{"Plain":".</p>\n<h2>定义</h2>\n<h3>概形</h3>\n"}]}}