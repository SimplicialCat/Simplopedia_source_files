{"sections":[{"slug":"Dold–Thom定理","section":{"metadata":{"slug":{"Plain":"Dold–Thom定理"},"ext":{"Plain":"md"},"title":{"Plain":"Dold–Thom <span lang=\"zh\">定理</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"Dold–Thom 定理"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">陈述</span></h2>\n<p><span lang=\"zh\">拓扑空间的约化</span>"},{"Local":{"url":"/同调","text":"<span lang=\"zh\">同调</span>"}},{"Plain":"<span lang=\"zh\">同构于其生成的自由交换幺半群的</span>"},{"Local":{"url":"/同伦群","text":"<span lang=\"zh\">同伦群</span>"}},{"Plain":".</p>\n<p><span lang=\"zh\">空间</span> $X$ <span lang=\"zh\">生成的自由交换幺半群可构造为</span><strong><span lang=\"zh\">无穷对称积</span></strong> (infinite symmetric product), <span lang=\"zh\">即对称积</span> $X^n / S_n$ <span lang=\"zh\">的余极限</span>.</p>\n"}]}}}]}