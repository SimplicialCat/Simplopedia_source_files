{"sections":[{"slug":"内部观点","section":{"metadata":{"slug":{"Plain":"内部观点"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">内部观点</span>"},"taxon":{"Plain":"<span lang=\"zh\">观念</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"内部观点"},"data-taxon":{"Plain":"观念"}},"content":{"Lazy":[{"Plain":"\n<p><span lang=\"zh\">通常一个</span> “<span lang=\"zh\">数学结构</span>” (<span lang=\"zh\">尤其是</span>"},{"Local":{"url":"/代数理论","text":"<span lang=\"zh\">代数结构</span>"}},{"Plain":") <span lang=\"zh\">是如下资料</span>:</p>\n<ul>\n<li><span lang=\"zh\">一些集合</span>,</li>\n<li><span lang=\"zh\">带有一些映射</span>,</li>\n<li><span lang=\"zh\">满足一些条件</span>.</li>\n</ul>\n<p><span lang=\"zh\">将其中的集合与映射替换为特定范畴中的对象与态射</span>, <span lang=\"zh\">再将条件解读为该范畴的</span>"},{"Local":{"url":"/内语言","text":"<span lang=\"zh\">内语言</span>"}},{"Plain":", <span lang=\"zh\">得到的结构称为这个范畴</span><strong><span lang=\"zh\">内部</span></strong><span lang=\"zh\">的结构</span>.</p>\n<p><span lang=\"zh\">内部观点与</span>"},{"Local":{"url":"/相对","text":"<span lang=\"zh\">相对观点</span>"}},{"Plain":"<span lang=\"zh\">常常同时出现</span>.</p>\n"}]}}}]}