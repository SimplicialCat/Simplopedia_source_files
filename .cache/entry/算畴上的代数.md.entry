{"sections":[{"slug":"算畴上的代数","section":{"metadata":{"slug":{"Plain":"算畴上的代数"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">算畴上的代数</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"算畴上的代数"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">定义</span></h2>\n<h3><span lang=\"zh\">通过多重范畴定义</span></h3>\n<p><span lang=\"zh\">设</span> $\\mathcal O$ <span lang=\"zh\">为</span> (<span lang=\"zh\">对称</span>) "},{"Local":{"url":"/算畴","text":"<span lang=\"zh\">算畴</span>"}},{"Plain":", <span lang=\"zh\">视为多重范畴</span>; <span lang=\"zh\">设</span> $\\mathcal C$ <span lang=\"zh\">为</span>"},{"Local":{"url":"/对称幺半范畴","text":"<span lang=\"zh\">对称幺半范畴</span>"}},{"Plain":", <span lang=\"zh\">那么</span> $\\mathcal C$ <span lang=\"zh\">本身也可视为对称算畴及多重范畴</span>; <span lang=\"zh\">定义</span> $\\mathcal O$ <span lang=\"zh\">在</span> $\\mathcal C$ <span lang=\"zh\">中的</span><strong><span lang=\"zh\">代数</span></strong><span lang=\"zh\">为多重范畴之间的函子</span>\n$$\r\n\\mathcal O \\to \\mathcal C.\r\n$$</p>\n<h3><span lang=\"zh\">通过对称序列定义</span></h3>\n<p><span lang=\"zh\">给定</span>"},{"Local":{"url":"/对称幺半范畴","text":"<span lang=\"zh\">对称幺半范畴</span>"}},{"Plain":" $\\mathcal V$ <span lang=\"zh\">上的对称算畴</span> $F$, <span lang=\"zh\">视为</span> $\\mathcal V$-"},{"Local":{"url":"/对称序列","text":"<span lang=\"zh\">对称序列</span>"}},{"Plain":"<span lang=\"zh\">范畴中的</span>"},{"Local":{"url":"/结合代数","text":"<span lang=\"zh\">结合代数</span>"}},{"Plain":" $F\\colon \\mathsf{Fin}^{\\simeq}\\to\\mathcal V$; <span lang=\"zh\">一个</span> $F$-<span lang=\"zh\">代数是指一个</span> (<span lang=\"zh\">带</span> $\\mathcal{V}$-<span lang=\"zh\">模结构的范畴中的</span>) <span lang=\"zh\">对象</span> $A$, <span lang=\"zh\">以及</span> "},{"Local":{"url":"/对称群","text":"$S_n$"}},{"Plain":"-<span lang=\"zh\">等变的态射</span> $F(n)\\otimes A^{\\otimes n}\\to A$, <span lang=\"zh\">满足适当的结合律</span>, <span lang=\"zh\">幺元律</span>.</p>\n<h2><span lang=\"zh\">例</span></h2>\n<ul>\n<li>"},{"Local":{"url":"/E∞-算畴","text":"<span lang=\"zh\">交换算畴</span>"}},{"Plain":"<span lang=\"zh\">上的代数称为</span>"},{"Local":{"url":"/交换代数","text":"<span lang=\"zh\">交换代数</span>"}},{"Plain":".</li>\n<li>"},{"Local":{"url":"/A∞-算畴","text":"<span lang=\"zh\">结合算畴</span>"}},{"Plain":"<span lang=\"zh\">上的代数称为</span>"},{"Local":{"url":"/结合代数","text":"<span lang=\"zh\">结合代数</span>"}},{"Plain":".</li>\n</ul>\n<h2><span lang=\"zh\">性质</span></h2>\n<h3><span lang=\"zh\">模</span></h3>\n<p><span lang=\"zh\">对于算畴上的代数可以谈论</span>"},{"Local":{"url":"/OpAlgMod","text":"<span lang=\"zh\">模</span>"}},{"Plain":".</p>\n"}]}}}]}