{"sections":[{"slug":"可缩(同伦类型论)","section":{"metadata":{"slug":{"Plain":"可缩(同伦类型论)"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">可缩类型</span> (<span lang=\"zh\">同伦类型论</span>)"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"可缩类型 (同伦类型论)"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">定义</span></h2>\n<p><span lang=\"zh\">在</span>"},{"Local":{"url":"/同伦类型论","text":"<span lang=\"zh\">同伦类型论</span>"}},{"Plain":"<span lang=\"zh\">中</span>, <span lang=\"zh\">称类型</span> $A$ <span lang=\"zh\">可缩</span>, <span lang=\"zh\">是指</span> $A$ <span lang=\"zh\">有元素</span> $a: A$ <span lang=\"zh\">使得</span> $A$ <span lang=\"zh\">的任意元素都等于</span> $a$, <span lang=\"zh\">即</span>\n$$\r\n\\mathsf{isContr}(A) := \\sum_{a : A}\\prod_{x : A} x =_A a.\r\n$$</p>\n"}]}}}]}