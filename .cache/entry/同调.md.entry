{"sections":[{"slug":"同调","section":{"metadata":{"slug":{"Plain":"同调"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">同调</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"同调"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">观念</span></h2>\n<p><strong><span lang=\"zh\">同调</span></strong><span lang=\"zh\">在数学上有许多含义</span>. <span lang=\"zh\">其共性是一种表现得像</span>"},{"Local":{"url":"/张量积","text":"<span lang=\"zh\">张量积</span>"}},{"Plain":", "},{"Local":{"url":"/余极限","text":"<span lang=\"zh\">余极限</span>"}},{"Plain":"<span lang=\"zh\">那样的协变函子</span>. <span lang=\"zh\">而与之相对的</span>"},{"Local":{"url":"/上同调","text":"<span lang=\"zh\">上同调</span>"}},{"Plain":"<span lang=\"zh\">则是一种表现得像</span> Hom, "},{"Local":{"url":"/极限","text":"<span lang=\"zh\">极限</span>"}},{"Plain":"<span lang=\"zh\">那样的反变函子</span>.</p>\n<h2><span lang=\"zh\">定义</span></h2>\n<p>"},{"Local":{"url":"/生象","text":"<span lang=\"zh\">生象</span>"}},{"Plain":" $X$ <span lang=\"zh\">的</span><strong><span lang=\"zh\">同调群</span></strong> $H_n(X)$ <span lang=\"zh\">是其</span>"},{"Local":{"url":"/自由-遗忘伴随","text":"<span lang=\"zh\">自由</span>"}},{"Plain":"<span lang=\"zh\">生成的交换群</span> (<span lang=\"zh\">见</span> "},{"Local":{"url":"/Dold–Thom定理","text":"Dold–Thom <span lang=\"zh\">定理</span>"}},{"Plain":") <span lang=\"zh\">对应的</span>"},{"Local":{"url":"/连合谱","text":"<span lang=\"zh\">连合谱</span>"}},{"Plain":" $\\Sigma^\\infty X \\wedge H\\mathbb{Z}$ <span lang=\"zh\">的</span>"},{"Local":{"url":"/同伦群(稳定同伦论)","text":"<span lang=\"zh\">同伦群</span>"}},{"Plain":":\n$$\r\nH_n(X) = \\pi_n(\\Sigma^\\infty X \\wedge H\\mathbb{Z}).\r\n$$</p>\n<h3><span lang=\"zh\">广义同调</span></h3>\n<p>$$\r\nE_n(X) := \\pi_n (\\Sigma^\\infty X \\wedge E).\r\n$$</p>\n<p><span lang=\"zh\">见</span>"},{"Local":{"url":"/广义同调","text":"<span lang=\"zh\">广义同调</span>"}},{"Plain":".</p>\n<h2><span lang=\"zh\">性质<