{"sections":[{"slug":"双边杠构造","section":{"metadata":{"slug":{"Plain":"双边杠构造"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">双边杠构造</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"双边杠构造"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">观念</span></h2>\n<p><span lang=\"zh\">如果说</span>"},{"Local":{"url":"/单子","text":"<span lang=\"zh\">单子</span>"}},{"Plain":"<span lang=\"zh\">是</span>"},{"Local":{"url":"/结合代数","text":"<span lang=\"zh\">结合代数</span>"}},{"Plain":"<span lang=\"zh\">的</span>"},{"Local":{"url":"/范畴化","text":"<span lang=\"zh\">范畴化</span>"}},{"Plain":", <span lang=\"zh\">那么双边杠构造就是</span>"},{"Local":{"url":"/结合代数上的模","text":"<span lang=\"zh\">结合代数上的模</span>"}},{"Plain":"<span lang=\"zh\">的相对张量积的范畴化</span>.</p>\n<p><span lang=\"zh\">双边杠构造是</span>"},{"Local":{"url":"/杠构造","text":"<span lang=\"zh\">杠构造</span>"}},{"Plain":" (bar construction) <span lang=\"zh\">的推广</span>.</p>\n<h2><span lang=\"zh\">定义</span></h2>\n<p><span lang=\"zh\">设</span> $T$ <span lang=\"zh\">为范畴</span> $\\mathcal C$ <span lang=\"zh\">上的</span>"},{"Local":{"url":"/单子","text":"<span lang=\"zh\">单子</span>"}},{"Plain":". <span lang=\"zh\">对于</span> $T$ <span lang=\"zh\">上的</span>"},{"Local":{"url":"/单子上的代数","text":"<span lang=\"zh\">左模</span>"}},{"Plain":" $X\\colon I\\to\\mathcal C$ <span lang=\"zh\">与</span>"},{"Local":{"url":"/单子上的代数","text":"<span lang=\"zh\">右模</span>"}},{"Plain":" $Y\\colon \\mathcal C\\to J$, <strong><span lang=\"zh\">双边杠构造</span></strong><span lang=\"zh\">是</span> $\\mathsf{Fun}(I,J)$ <span lang=\"zh\">中的</span>"},{"Local":{"url":"/单纯对象","text":"<span lang=\"zh\">单纯对象</span>"}},{"Plain":"\n$$\r\nB(Y,T,X) = (\\cdots YTTX \\to^3 YTX \\rightrightarrows YX).\r\n$$</p>\n<h2><span lang=\"zh\">例</span></h2>\n<h3><span lang=\"zh\">伴随的典范双边杠构造</span></h3>\n<p><span lang=\"zh\">对于函子</span> $F\\colon \\mathcal C\\to\\mathcal D$, $G\\colon \\mathcal D\\to\\mathcal C$ <span lang=\"zh\">之间的一对</span>"},{"Local":{"url":"/伴随","text":"<span lang=\"zh\">伴随</span>"}},{"Plain":" $F\\dashv G$ <span lang=\"zh\">给出的</span>"},{"Local":{"url":"/伴随给出单子","text":"<span lang=\"zh\">单子</span>"}},{"Plain":" $T = GF$,</p>\n<ul>\n<li>$F$ <span lang=\"zh\">有典范的</span> $T$-<strong><span lang=\"zh\">右模</span></strong><span lang=\"zh\">结构</span> $FT=FGF \\to F$,</li>\n<li>$G$ <span lang=\"zh\">有典范的</span> $T$-<strong><span lang=\"zh\">左模</span></strong><span lang=\"zh\">结构</span> $TG=GFG \\to G$.</li>\n</ul>\n<p><span lang=\"zh\">因此伴随</span> $F\\dashv G$ <span lang=\"zh\">给出典范的</span><strong><span lang=\"zh\">双边杠构造</span></strong>\n$$\r\nB(F,T,G) = (\\cdots FGFGFG \\to^3 FGFG \\rightrightarrows FG).\r\n$$</p>\n<h3><span lang=\"zh\">分解同调</span></h3>\n<p><span lang=\"zh\">记</span> $D_n$ <span lang=\"zh\">为</span> "},{"Local":{"url":"/En-算畴","text":"$\\mathbb E_n$-<span lang=\"zh\">算畴</span>"}},{"Plain":"<span lang=\"zh\">对应的单子</span>. <span lang=\"zh\">对于</span> $n$ <span lang=\"zh\">维标架流形</span> $M$, <span lang=\"zh\">记</span> $D_M$ <span lang=\"zh\">为</span>"},{"Local":{"url":"/对称序列","text":"<span lang=\"zh\">对称序列</span>"}},{"Plain":" $\\{\\operatorname{Emb}(\\sqcup_k\\mathbb{R}^n,M)\\}$ <span lang=\"zh\">对应的函子</span>, <span lang=\"zh\">则</span> $D_M$ <span lang=\"zh\">为单子</span> $D_n$ <span lang=\"zh\">上的右模</span>:</p>\n<ul>\n<li>$D_n X$ <span lang=\"zh\">的直观是</span> “<span lang=\"zh\">将</span> $X$ <span lang=\"zh\">的若干元素放在</span> $\\mathbb{R}^n$ <span lang=\"zh\">的不交圆盘上</span>” <span lang=\"zh\">的构形的空间</span>;</li>\n<li>$D_M X$ <span lang=\"zh\">的直观是</span> “<span lang=\"zh\">将</span> $X$ <span lang=\"zh\">的若干元素放在</span> $M$ <span lang=\"zh\">的不交圆盘上</span>” <span lang=\"zh\">的构形的空间</span>;</li>\n<li><span lang=\"zh\">因此</span> $D_M D_n X$ <span lang=\"zh\">的一个元素的直观是</span> $M$ <span lang=\"zh\">的若干个不交圆盘</span>, <span lang=\"zh\">每个之中又有若干个不交的小圆盘</span>, <span lang=\"zh\">每个小圆盘上放了</span> $X$ <span lang=\"zh\">的一个元素</span>;</li>\n<li><span lang=\"zh\">映射</span> $D_M D_n X \\to D_M X$ <span lang=\"zh\">直观上是将上述构形中的小圆盘直接视为</span> $M$ <span lang=\"zh\">上的圆盘</span>, <span lang=\"zh\">得到</span> $D_M X$ <span lang=\"zh\">的元素</span>.</li>\n</ul>\n<p>$M$ <span lang=\"zh\">上取值于</span> "},{"Local":{"url":"/En-代数","text":"$\\mathbb E_n$-<span lang=\"zh\">代数</span>"}},{"Plain":" $A$ <span lang=\"zh\">的</span>"},{"Local":{"url":"/分解同调","text":"<span lang=\"zh\">分解同调</span>"}},{"Plain":"<span lang=\"zh\">可表示为双边杠构造的</span>"},{"Local":{"url":"/几何实现(单纯图表的余极限)","text":"<span lang=\"zh\">几何实现</span>"}},{"Plain":"\n$$\r\n\\int_M A = |B(D_M, D_n, A)|.\r\n$$</p>\n"}]}}}]}