{"sections":[{"slug":"杠构造","section":{"metadata":{"slug":{"Plain":"杠构造"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">杠构造</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"杠构造"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">观念</span></h2>\n<p><span lang=\"zh\">对于范畴</span> $\\mathcal C$ <span lang=\"zh\">上的</span>"},{"Local":{"url":"/单子","text":"<span lang=\"zh\">单子</span>"}},{"Plain":" $T$ <span lang=\"zh\">以及其上的</span>"},{"Local":{"url":"/单子上的代数","text":"<span lang=\"zh\">代数</span>"}},{"Plain":" $A$, <span lang=\"zh\">杠构造</span> (bar construction) <span lang=\"zh\">给出</span>"},{"Local":{"url":"/单子上的代数","text":"<span lang=\"zh\">代数</span>"}},{"Plain":"<span lang=\"zh\">范畴</span> $\\mathcal C^T$ <span lang=\"zh\">中的一个</span>"},{"Local":{"url":"/单纯对象","text":"<span lang=\"zh\">增广单纯对象</span>"}},{"Plain":"\n$$\r\n\\cdots \\to^3 TTA \\rightrightarrows TA \\to A,\r\n$$\n<span lang=\"zh\">作为</span> $\\mathcal C$ <span lang=\"zh\">的单纯对象</span>, <span lang=\"zh\">它是</span> $A$ <span lang=\"zh\">的一种</span>"},{"Local":{"url":"/消解","text":"<span lang=\"zh\">消解</span>"}},{"Plain":", <span lang=\"zh\">又称</span><strong><span lang=\"zh\">杠消解</span></strong> (bar resolution).</p>\n<h2><span lang=\"zh\">定义</span></h2>\n<p><span lang=\"zh\">给定</span>"},{"Local":{"url":"/单子","text":"<span lang=\"zh\">单子</span>"}},{"Plain":" $T$ <span lang=\"zh\">以及</span> $T$-<span lang=\"zh\">代数</span> $A$, <span lang=\"zh\">杠构造</span> (bar construction) <span lang=\"zh\">是</span>"},{"Local":{"url":"/单纯对象","text":"<span lang=\"zh\">增广单纯对象</span>"}},{"Plain":"\n$$\r\nB(T,A) = (\\cdots \\to^3 TTA \\rightrightarrows TA \\to A),\r\n$$\n<span lang=\"zh\">其中的结构映射由</span> $T$ <span lang=\"zh\">与</span> $A$ <span lang=\"zh\">的结构映射给出</span>. <span lang=\"zh\">例如两个映射</span> $TTA \\to TA$ <span lang=\"zh\">分别来自</span> $T$ <span lang=\"zh\">带有的自然变换</span> $T^2\\to T$ <span lang=\"zh\">以及</span> $A$ <span lang=\"zh\">的结构映射</span> $TA\\to A$.</p>\n<p><span lang=\"zh\">为具体理解</span> $B(T,A)$ <span lang=\"zh\">的构造</span>, <span lang=\"zh\">只需注意到</span> $T \\colon \\mathcal C^T \\to \\mathcal C^T$ <span lang=\"zh\">为</span>"},{"Local":{"url":"/单子上的代数","text":"<span lang=\"zh\">代数</span>"}},{"Plain":"<span lang=\"zh\">范畴</span> $\\mathcal C^T$ <span lang=\"zh\">上的</span>"},{"Local":{"url":"/余单子","text":"<span lang=\"zh\">余单子</span>"}},{"Plain":", <span lang=\"zh\">也即</span>$\\operatorname{End}(\\mathcal C^T)$ <span lang=\"zh\">中的</span>"},{"Local":{"url":"/结合余代数","text":"<span lang=\"zh\">结合余代数</span>"}},{"Plain":", <span lang=\"zh\">从而由</span>"},{"Local":{"url":"/单纯形范畴","text":"<span lang=\"zh\">增广单纯形范畴</span>"}},{"Plain":" $\\Delta_+$ <span lang=\"zh\">的性质</span>, <span lang=\"zh\">其对应一个幺半函子</span>\n$$\r\n\\operatorname{Bar}_T\\colon\r\n\\Delta_+^{\\text{op}}\\to\\operatorname{End}(\\mathcal C^T).\r\n$$\n<span lang=\"zh\">将</span> $\\operatorname{Bar}_T$ <span lang=\"zh\">进一步复合</span> “<span lang=\"zh\">在</span> $A$ <span lang=\"zh\">处取值</span>” <span lang=\"zh\">函子</span> $\\mathrm{ev}_A\\colon \\operatorname{End}(\\mathcal C^T) \\to \\mathcal C^T$, <span lang=\"zh\">得到函子</span>\n$$\r\n\\operatorname{Bar}_T(A)\\colon \\Delta_+^{\\text{op}}\\to\\mathcal C^T.\r\n$$\n<span lang=\"zh\">最后再复合</span> $U$, <span lang=\"zh\">就得到</span>"},{"Local":{"url":"/单纯对象","text":"<span lang=\"zh\">增广单纯对象</span>"}},{"Plain":"\n$$\r\nB(T,A)\\colon \\Delta_+^{\\text{op}}\\to\\mathcal C.\r\n$$</p>\n<h3><span lang=\"zh\">推广</span></h3>\n<p><span lang=\"zh\">杠构造的推广见</span>"},{"Local":{"url":"/双边杠构造","text":"<span lang=\"zh\">双边杠构造</span>"}},{"Plain":", "},{"Local":{"url":"/单纯杠构造","text":"<span lang=\"zh\">单纯杠构造</span>"}},{"Plain":". <span lang=\"zh\">使用双边杠构造的记号</span>, <span lang=\"zh\">有</span> $\\operatorname{Bar}_T(A)=B(F,T,A)$, $B(T,A)=B(T,T,A)$. <span lang=\"zh\">另见</span>"},{"Local":{"url":"/循环杠构造","text":"<span lang=\"zh\">循环杠构造</span>"}},{"Plain":".</p>\n<h2><span lang=\"zh\">例</span></h2>\n<h3><span lang=\"zh\">群</span></h3>\n<p><span lang=\"zh\">设</span></p>\n"}]}}}]}