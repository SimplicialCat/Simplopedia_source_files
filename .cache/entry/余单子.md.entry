{"sections":[{"slug":"余单子","section":{"metadata":{"slug":{"Plain":"余单子"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">余单子</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"余单子"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">定义</span></h2>\n<p><span lang=\"zh\">一个范畴</span> $\\mathcal C$ <span lang=\"zh\">中的</span><strong><span lang=\"zh\">余单子</span></strong> (comonad) <span lang=\"zh\">是</span> $\\operatorname{End}(\\mathcal C)$ <span lang=\"zh\">中的</span>"},{"Local":{"url":"/结合余代数","text":"<span lang=\"zh\">结合余代数</span>"}},{"Plain":".</p>\n<p><strong><span lang=\"zh\">注意</span></strong>. <span lang=\"zh\">余单子</span><strong><span lang=\"zh\">不是</span></strong> $\\mathcal C^{\\text{op}}$ <span lang=\"zh\">中的</span>"},{"Local":{"url":"/单子","text":"<span lang=\"zh\">单子</span>"}},{"Plain":".</p>\n<h2><span lang=\"zh\">例</span></h2>\n<h2><span lang=\"zh\">性质</span></h2>\n<h3><span lang=\"zh\">余单子与单纯对象</span></h3>\n<p><span lang=\"zh\">由于</span>"},{"Local":{"url":"/单纯形范畴","text":"<span lang=\"zh\">单纯形范畴</span>"}},{"Plain":" $\\Delta$ <span lang=\"zh\">是</span> “<span lang=\"zh\">一个对象生成的自由</span>"},{"Local":{"url":"/幺半范畴","text":"<span lang=\"zh\">幺半范畴</span>"}},{"Plain":"”, <span lang=\"zh\">任意幺半范畴</span> $M$ <span lang=\"zh\">中的幺半对象都对应着函子</span> $\\Delta \\to M$, <span lang=\"zh\">也即</span> $M^{\\text{op}}$ <span lang=\"zh\">中的</span>"},{"Local":{"url":"/单纯对象","text":"<span lang=\"zh\">单纯集</span>"}},{"Plain":".</p>\n"}]}}}]}