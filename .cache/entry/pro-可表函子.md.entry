{"sections":[{"slug":"pro-可表函子","section":{"metadata":{"slug":{"Plain":"pro-可表函子"},"ext":{"Plain":"md"},"title":{"Plain":"pro-<span lang=\"zh\">可表函子</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"pro-可表函子"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">定义</span></h2>\n<p><span lang=\"zh\">范畴</span> $\\mathcal C$ <span lang=\"zh\">到</span> $\\mathsf{Set}$ <span lang=\"zh\">的</span> <strong>pro-<span lang=\"zh\">可表函子</span></strong><span lang=\"zh\">是</span> $\\mathsf{Fun}(\\mathcal C,\\mathsf{Set})^{\\mathrm{op}}$ <span lang=\"zh\">中</span>"},{"Local":{"url":"/可表函子","text":"<span lang=\"zh\">可表函子</span>"}},{"Plain":"<span lang=\"zh\">的余滤极限</span>, <span lang=\"zh\">对应</span> $\\mathcal C$ <span lang=\"zh\">的</span> "},{"Local":{"url":"/pro-对象","text":"pro-<span lang=\"zh\">对象</span>"}},{"Plain":".</p>\n<p><span lang=\"zh\">当然</span>, pro-<span lang=\"zh\">可表函子</span> $\\mathcal C\\to\\mathsf{Set}$ <span lang=\"zh\">也是</span> $\\mathsf{Fun}(\\mathcal C,\\mathsf{Set})$ <span lang=\"zh\">中</span>"},{"Local":{"url":"/可表函子","text":"<span lang=\"zh\">可表函子</span>"}},{"Plain":"<span lang=\"zh\">的</span>"},{"Local":{"url":"/滤余极限","text":"<span lang=\"zh\">滤余极限</span>"}},{"Plain":".</p>\n"}]}}}]}