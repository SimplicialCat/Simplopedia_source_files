{"sections":[{"slug":"谱对象","section":{"metadata":{"slug":{"Plain":"谱对象"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">谱对象</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"谱对象"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">观念</span></h2>\n<p>$(\\infty,1)$-<span lang=\"zh\">范畴</span> $\\mathcal C$ <span lang=\"zh\">的</span><strong><span lang=\"zh\">谱对象</span></strong><span lang=\"zh\">可想象为其中</span> “$\\infty$-"},{"Local":{"url":"/连通性","text":"<span lang=\"zh\">连通</span>"}},{"Plain":"” <span lang=\"zh\">的对象</span>; $\\mathcal C$ <span lang=\"zh\">中一般的对象通过</span> “<span lang=\"zh\">取无穷多次</span>"},{"Local":{"url":"/纬悬","text":"<span lang=\"zh\">纬悬</span>"}},{"Plain":"<span lang=\"zh\">操作</span>” <span lang=\"zh\">成为谱对象</span>, <span lang=\"zh\">而谱对象通过</span> “<span lang=\"zh\">取无穷多次</span>"},{"Local":{"url":"/环路空间","text":"<span lang=\"zh\">环路空间</span>"}},{"Plain":"” <span lang=\"zh\">成为</span> $\\mathcal C$ <span lang=\"zh\">中的对象</span>.</p>\n<p><span lang=\"zh\">谱对象构成的范畴是</span>"},{"Local":{"url":"/稳定无穷范畴","text":"<span lang=\"zh\">稳定范畴</span>"}},{"Plain":", <span lang=\"zh\">称为原范畴的</span>"},{"Local":{"url":"/稳定化","text":"<span lang=\"zh\">稳定化</span>"}},{"Plain":".</p>\n"}]}}}]}