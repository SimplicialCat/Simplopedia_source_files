{"sections":[{"slug":"结合余代数","section":{"metadata":{"slug":{"Plain":"结合余代数"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">结合余代数</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"结合余代数"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<p>"},{"Local":{"url":"/幺半范畴","text":"<span lang=\"zh\">幺半范畴</span>"}},{"Plain":" $(\\mathcal C,\\otimes)$ <span lang=\"zh\">中的</span><strong><span lang=\"zh\">结合余代数</span></strong><span lang=\"zh\">是对偶范畴</span> $(\\mathcal C^{\\mathrm{op}},\\otimes)$ <span lang=\"zh\">中的</span>"},{"Local":{"url":"/结合代数","text":"<span lang=\"zh\">结合代数</span>"}},{"Plain":".</p>\n<h2><span lang=\"zh\">例</span></h2>\n<h3><span lang=\"zh\">有限积范畴的对象</span></h3>\n<p><span lang=\"zh\">设范畴</span> $\\mathcal C$ <span lang=\"zh\">具有有限</span>"},{"Local":{"url":"/积幺半范畴","text":"<span lang=\"zh\">积</span>"}},{"Plain":" (<span lang=\"zh\">这个条件是重要的</span>, <span lang=\"zh\">不能替换为一般的幺半范畴</span>). <span lang=\"zh\">那么</span> $(\\mathcal C,\\times)$ <span lang=\"zh\">的每个对象均有一个余代数结构</span>, <span lang=\"zh\">余乘法为</span>"},{"Local":{"url":"/对角线","text":"<span lang=\"zh\">对角线</span>"}},{"Plain":" $\\Delta\\colon X\\to X\\times X$.\n<span lang=\"zh\">同时</span>, <span lang=\"zh\">每个态射</span> $Y\\to X$ <span lang=\"zh\">均为余代数同态</span>, <span lang=\"zh\">且赋予</span> $Y$ <span lang=\"zh\">以</span> $X$-<span lang=\"zh\">余模结构</span>\n$$\r\nY\\overset{\\Delta_Y}{\\to} Y\\times Y \\to X\\times Y.\r\n$$</p>\n"}]}}}]}