{"sections":[{"slug":"E2-代数","section":{"metadata":{"slug":{"Plain":"E2-代数"},"ext":{"Plain":"md"},"title":{"Plain":"E2 <span lang=\"zh\">代数</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"E2 代数"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">观念</span></h2>\n<p>$\\mathbb E_2$-<span lang=\"zh\">代数是</span>"},{"Local":{"url":"/结合代数","text":"<span lang=\"zh\">结合代数</span>"}},{"Plain":"<span lang=\"zh\">中的</span>"},{"Local":{"url":"/结合代数","text":"<span lang=\"zh\">结合代数</span>"}},{"Plain":", <span lang=\"zh\">是若干元素可以</span><strong><span lang=\"zh\">放在二维平面上</span></strong><span lang=\"zh\">结合起来的结构</span>. <span lang=\"zh\">给定</span> $n$ <span lang=\"zh\">个元素</span> $x_1,\\cdots,x_n$, <span lang=\"zh\">对二维平面上的</span> $n$ <span lang=\"zh\">个点的每种构形</span>, <span lang=\"zh\">都有一种方法将它们结合起来</span>.</p>\n<p>$\\mathbb E_2$-<span lang=\"zh\">代数是</span> "},{"Local":{"url":"/En-代数","text":"$\\mathbb E_n$-<span lang=\"zh\">代数</span>"}},{"Plain":"<span lang=\"zh\">的</span> $n=2$ <span lang=\"zh\">情形</span>.</p>\n<h2><span lang=\"zh\">性质</span></h2>\n<p><span lang=\"zh\">在</span> $1$-<span lang=\"zh\">范畴中</span>, <span lang=\"zh\">由</span> "},{"Local":{"url":"/Eckmann--Hilton论证","text":"Eckmann–Hilton <span lang=\"zh\">论证</span>"}},{"Plain":", $\\mathbb E_2$-<span lang=\"zh\">代数等同于</span>"},{"Local":{"url":"/交换代数","text":"<span lang=\"zh\">交换代数</span>"}},{"Plain":".</p>\n<h2><span lang=\"zh\">例</span></h2>\n<p><span lang=\"zh\">范畴的范畴</span> $(\\mathsf{Cat},\\times)$ <span lang=\"zh\">中的</span> $\\mathbb E_2$-<span lang=\"zh\">代数称为</span><strong></strong>"},{"Local":{"url":"/辫幺半范畴","text":"<span lang=\"zh\">辫幺半范畴</span>"}},{"Plain":" (braided monoidal category).</p>\n"}]}}}]}