{"sections":[{"slug":"内语言","section":{"metadata":{"slug":{"Plain":"内语言"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">内语言</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"内语言"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">观念</span></h2>\n<p>"},{"Local":{"url":"/Trinitarianism","text":"<span lang=\"zh\">三位一体</span>"}},{"Plain":"</p>\n<h2><span lang=\"zh\">定义</span></h2>\n<h3><span lang=\"zh\">一阶语言</span></h3>\n<p><span lang=\"zh\">每个范畴都有一个</span>"},{"Local":{"url":"/一阶语言","text":"<span lang=\"zh\">一阶语言</span>"}},{"Plain":", <span lang=\"zh\">以其对象为类型</span>, <span lang=\"zh\">态射为函数符号</span>; <span lang=\"zh\">这称为范畴的</span><strong><span lang=\"zh\">内语言</span></strong>. <span lang=\"zh\">当范畴具有越多范畴论性质时</span>, <span lang=\"zh\">其内语言就越丰富</span>.</p>\n<h2><span lang=\"zh\">例</span></h2>\n<p><span lang=\"zh\">集合范畴</span> $\\mathsf{Set}$ <span lang=\"zh\">的内语言就是通常的数学的语言</span>.</p>\n<h2><span lang=\"zh\">相关概念</span></h2>\n<ul>\n<li>"},{"Local":{"url":"/意象的内语言","text":"<span lang=\"zh\">意象的内语言</span>"}},{"Plain":"</li>\n</ul>\n"}]}}}]}