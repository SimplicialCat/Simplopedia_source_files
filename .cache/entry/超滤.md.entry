{"sections":[{"slug":"超滤","section":{"metadata":{"slug":{"Plain":"超滤"},"ext":{"Plain":"md"},"title":{"Plain":"“<span lang=\"zh\">超滤</span>”"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"“超滤”"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">定义</span></h2>\n<h3><span lang=\"zh\">集合上的超滤</span></h3>\n<p><span lang=\"zh\">集合</span> $S$ <span lang=\"zh\">上的超滤是</span> $S$ <span lang=\"zh\">的子集的</span> "},{"Local":{"url":"/Boole环","text":"Boole <span lang=\"zh\">环</span>"}},{"Plain":" $2^S$ <span lang=\"zh\">到</span> $2$ <span lang=\"zh\">的同态</span>, <span lang=\"zh\">也即</span> $2^S$ <span lang=\"zh\">的素理想</span>.</p>\n<h2><span lang=\"zh\">相关概念</span></h2>\n<p>"},{"Local":{"url":"/Stone对偶","text":"Stone <span lang=\"zh\">对偶</span>"}},{"Plain":"</p>\n"}]}}}]}