{"metadata":{"author":[{"Lazy":[{"Local":{"url":"SimplicialCat","text":"SimplicialCat"}}]},4],"ext":[{"Plain":"md"},1],"slug":[{"Plain":"超滤"},0],"title":[{"Plain":"“超滤”"},2],"tag":[{"Plain":"百科"},3]},"content":{"Lazy":[{"Plain":"\n<h2>定义</h2>\n<h3>集合上的超滤</h3>\n<p>集合 $S$ 上的超滤是 $S$ 的子集的 "},{"Local":{"url":"Boole环","text":"Boole 环"}},{"Plain":" $2^S$ 到 $2$ 的同态, 也即 $2^S$ 的素理想.</p>\n<h2>相关概念</h2>\n<p>"},{"Local":{"url":"Stone对偶","text":"Stone 对偶"}},{"Plain":"</p>\n"}]}}