{"sections":[{"slug":"陈--Gauss--Bonnet定理","section":{"metadata":{"slug":{"Plain":"陈--Gauss--Bonnet定理"},"ext":{"Plain":"md"},"title":{"Plain":"“<span lang=\"zh\">陈</span>–Gauss–Bonnet <span lang=\"zh\">定理</span>”"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"“陈–Gauss–Bonnet 定理”"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<p><span lang=\"zh\">设</span> $M$ <span lang=\"zh\">为紧可定向</span> $2n$ <span lang=\"zh\">维</span> Riemann <span lang=\"zh\">流形</span>, $\\Omega$ <span lang=\"zh\">为</span> $M$ <span lang=\"zh\">上的</span>"},{"Local":{"url":"/曲率形式","text":"<span lang=\"zh\">曲率形式</span>"}},{"Plain":", <span lang=\"zh\">则</span> $M$ <span lang=\"zh\">的</span> "},{"Local":{"url":"/Euler示性数","text":"Euler <span lang=\"zh\">示性数</span>"}},{"Plain":"<span lang=\"zh\">可由曲率形式的</span> Pfaffian <span lang=\"zh\">计算</span>:\n$$\r\n\\chi(M) = \\frac{1}{(2\\pi)^n}\\int_M \\operatorname{Pf}(\\Omega).\r\n$$\n<span lang=\"zh\">这个结论是</span> "},{"Local":{"url":"/Atiyah--Singer指标定理","text":"Atiyah–Singer <span lang=\"zh\">指标定理</span>"}},{"Plain":"<span lang=\"zh\">的特例</span>.</p>\n<p>$\\dfrac{1}{(2\\pi)^n}\\operatorname{Pf}(\\Omega)$ <span lang=\"zh\">是流形</span> $M$ <span lang=\"zh\">的</span> "},{"Local":{"url":"/Euler类","text":"Euler <span lang=\"zh\">类</span>"}},{"Plain":". <span lang=\"zh\">它不依赖于</span> $M$ <span lang=\"zh\">上</span> Riemann <span lang=\"zh\">度量的选取</span>.</p>\n"}]}}}]}