{"sections":[{"slug":"Dirac算子","section":{"metadata":{"slug":{"Plain":"Dirac算子"},"ext":{"Plain":"md"},"title":{"Plain":"Dirac <span lang=\"zh\">算子</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"Dirac 算子"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">定义</span></h2>\n<p><span lang=\"zh\">设</span> $E$ <span lang=\"zh\">是</span> $\\mathbb Z_2$-<span lang=\"zh\">分次向量丛</span>. <span lang=\"zh\">对于</span> $E$ <span lang=\"zh\">上的微分算子</span> $D$, <span lang=\"zh\">若</span> $D$ <span lang=\"zh\">反转奇偶</span>, <span lang=\"zh\">且</span> $D^2$ <span lang=\"zh\">为</span>"},{"Local":{"url":"/广义Laplace算子","text":"<span lang=\"zh\">广义</span> Laplace <span lang=\"zh\">算子</span>"}},{"Plain":", <span lang=\"zh\">则称</span> $D$ <span lang=\"zh\">为</span> Dirac <span lang=\"zh\">算子</span>.</p>\n"}]}}}]}