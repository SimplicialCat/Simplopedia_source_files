{"metadata":{"author":[{"Plain":"Francis Borceux, Enrico Vitale"},4],"tag":[{"Plain":"参考资料"},3],"slug":[{"Plain":"BorceuxVitaleAzumayaCategory"},0],"title":[{"Plain":"Azumaya categories"},2],"ext":[{"Plain":"md"},1]},"content":{"Plain":"\n<blockquote>\n<p>We define the notions of Azumaya category and Brauer group in category theory enriched over some very general base category $\\mathcal V$.</p>\n</blockquote>\n"}}