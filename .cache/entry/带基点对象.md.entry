{"sections":[{"slug":"带基点对象","section":{"metadata":{"slug":{"Plain":"带基点对象"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">带基点对象</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"带基点对象"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">定义</span></h2>\n<p><span lang=\"zh\">范畴</span> $\\mathcal C$ <span lang=\"zh\">中带基点对象的范畴是其</span>"},{"Local":{"url":"/终对象","text":"<span lang=\"zh\">终对象</span>"}},{"Plain":"<span lang=\"zh\">下的</span>"},{"Local":{"url":"/仰范畴","text":"<span lang=\"zh\">仰范畴</span>"}},{"Plain":" $\\mathcal C_{*/}$.</p>\n<h2><span lang=\"zh\">性质</span></h2>\n<h3><span lang=\"zh\">极限</span>, <span lang=\"zh\">余极限</span></h3>\n<p><span lang=\"zh\">作为一种</span>"},{"Local":{"url":"/仰范畴","text":"<span lang=\"zh\">仰范畴</span>"}},{"Plain":", <span lang=\"zh\">带基点对象的范畴中的极限</span> (<span lang=\"zh\">余极限</span>) <span lang=\"zh\">可用原范畴中的极限</span> (<span lang=\"zh\">余极限</span>) <span lang=\"zh\">表示</span>:</p>\n<ul>\n<li><span lang=\"zh\">带基点对象的</span>"},{"Local":{"url":"/极限","text":"<span lang=\"zh\">极限</span>"}},{"Plain":"<span lang=\"zh\">等同于原范畴中的极限</span>.</li>\n<li><span lang=\"zh\">带基点对象的</span>"},{"Local":{"url":"/余极限","text":"<span lang=\"zh\">余极限</span>"}},{"Plain":"<span lang=\"zh\">等同于原图表加上基点到各对象的态射后所得图表的余极限</span>. <span lang=\"zh\">例如带基点对象</span> $X,Y$ <span lang=\"zh\">的</span>"},{"Local":{"url":"/和(范畴论)","text":"<span lang=\"zh\">和</span>"}},{"Plain":"<span lang=\"zh\">是原范畴中</span> $X \\leftarrow * \\to Y$ <span lang=\"zh\">的</span>"},{"Local":{"url":"/推出","text":"<span lang=\"zh\">推出</span>"}},{"Plain":".</li>\n</ul>\n<h2><span lang=\"zh\">例</span></h2>\n<p>"},{"Local":{"url":"/Ani_pt","text":"$\\mathsf{Ani}_*$"}},{"Plain":"</p>\n"}]}}}]}