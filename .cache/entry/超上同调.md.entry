{"sections":[{"slug":"超上同调","section":{"metadata":{"slug":{"Plain":"超上同调"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">超上同调</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"超上同调"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<p><span lang=\"zh\">普通的</span>"},{"Local":{"url":"/层上同调","text":"<span lang=\"zh\">层上同调</span>"}},{"Plain":"<span lang=\"zh\">计算的是</span> (<span lang=\"zh\">层的链复形范畴中的</span>) Eilenberg–Maclane <span lang=\"zh\">对象的</span>"},{"Local":{"url":"/上同调","text":"<span lang=\"zh\">上同调</span>"}},{"Plain":"; <span lang=\"zh\">放宽限制</span>, <span lang=\"zh\">考虑层范畴中一般链复形的上同调</span>, <span lang=\"zh\">称之为超上同调</span>.</p>\n<h2><span lang=\"zh\">例</span></h2>\n<p><span lang=\"zh\">代数几何中</span> "},{"Local":{"url":"/deRham上同调","text":"de Rham <span lang=\"zh\">上同调</span>"}},{"Plain":"<span lang=\"zh\">是</span> "},{"Local":{"url":"/deRham复形","text":"de Rham <span lang=\"zh\">复形</span>"}},{"Plain":"<span lang=\"zh\">的超上同调</span>.</p>\n"}]}}}]}