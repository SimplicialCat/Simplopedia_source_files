{"sections":[{"slug":"Goerss–Hopkins–Miller定理","section":{"metadata":{"slug":{"Plain":"Goerss–Hopkins–Miller定理"},"ext":{"Plain":"md"},"title":{"Plain":"“Goerss–Hopkins–Miller <span lang=\"zh\">定理</span>”"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"“Goerss–Hopkins–Miller 定理”"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">陈述</span></h2>\n<p><span lang=\"zh\">存在椭圆曲线</span> (<span lang=\"zh\">形式群律</span>) <span lang=\"zh\">到</span> "},{"Local":{"url":"/E∞-环","text":"E∞-<span lang=\"zh\">环</span>"}},{"Plain":"<span lang=\"zh\">的函子性的对应</span>, <span lang=\"zh\">以表现椭圆曲线对应的</span>"},{"Local":{"url":"/椭圆上同调","text":"<span lang=\"zh\">椭圆上同调</span>"}},{"Plain":"<span lang=\"zh\">理论</span>. <span lang=\"zh\">这使得</span>"},{"Local":{"url":"/椭圆曲线的模叠","text":"<span lang=\"zh\">椭圆曲线的模叠</span>"}},{"Plain":"<span lang=\"zh\">带有一个</span> E∞-<span lang=\"zh\">环结构层</span>. <span lang=\"zh\">这个函子的极限</span>, <span lang=\"zh\">即结构层的全局截面</span>, <span lang=\"zh\">是</span> "},{"Local":{"url":"/tmf","text":"tmf"}},{"Plain":".</p>\n"}]}}}]}