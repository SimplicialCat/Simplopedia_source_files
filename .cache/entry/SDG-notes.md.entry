{"sections":[{"slug":"SDG-notes","section":{"metadata":{"slug":{"Plain":"SDG-notes"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">综合微分几何讲稿</span>"},"taxon":{"Plain":"<span lang=\"zh\">讲义</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"综合微分几何讲稿"},"data-taxon":{"Plain":"讲义"}},"content":{"Lazy":[{"Plain":"\n<p><span lang=\"zh\">这一系列是我</span> 2023 <span lang=\"zh\">年</span> 7 <span lang=\"zh\">月参加国际基础科学大会期间</span>, <span lang=\"zh\">住在集贤山庄时</span>, <span lang=\"zh\">与同学们交流所写的讲稿</span>.</p>\n"},{"Embed":{"url":"/SDG-0-SIAM.md","title":null,"option":{"numbering":false,"details_open":false,"catalog":true}}},{"Embed":{"url":"/SDG-1-D.md","title":null,"option":{"numbering":false,"details_open":false,"catalog":true}}},{"Embed":{"url":"/SDG-2-int.md","title":null,"option":{"numbering":false,"details_open":false,"catalog":true}}},{"Embed":{"url":"/SDG-3-man.md","title":null,"option":{"numbering":false,"details_open":false,"catalog":true}}},{"Embed":{"url":"/SDG-4-tan.md","title":null,"option":{"numbering":false,"details_open":false,"catalog":true}}},{"Embed":{"url":"/SDG-4-Weil.md","title":null,"option":{"numbering":false,"details_open":false,"catalog":true}}},{"Embed":{"url":"/SDG-5-diff.md","title":null,"option":{"numbering":false,"details_open":false,"catalog":true}}}]}}}]}