{"sections":[{"slug":"绝对Galois群","section":{"metadata":{"slug":{"Plain":"绝对Galois群"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">绝对</span> Galois <span lang=\"zh\">群</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"绝对 Galois 群"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">观念</span></h2>\n<p><span lang=\"zh\">域</span> $k$ <span lang=\"zh\">的绝对</span> Galois <span lang=\"zh\">群是</span> $\\operatorname{Spec}k$ <span lang=\"zh\">的</span>"},{"Local":{"url":"/平展基本群","text":"<span lang=\"zh\">平展基本群</span>"}},{"Plain":".</p>\n<h2><span lang=\"zh\">定义</span></h2>\n<p><span lang=\"zh\">域</span> $K$ <span lang=\"zh\">的绝对</span> Galois <span lang=\"zh\">群是可分闭包</span> $K^{\\text{sep}}$ <span lang=\"zh\">的</span> Galois <span lang=\"zh\">群</span>.</p>\n<h2><span lang=\"zh\">性质</span></h2>\n<p><span lang=\"zh\">对于</span>"},{"Local":{"url":"/函数域","text":"<span lang=\"zh\">函数域</span>"}},{"Plain":" $F$, <span lang=\"zh\">记</span> $\\Gamma=\\operatorname{Gal}(\\overline{F}/F)$ <span lang=\"zh\">为其绝对</span> Galois <span lang=\"zh\">群</span>, "},{"Local":{"url":"/GrothendieckGalois理论","text":"Grothendieck Galois <span lang=\"zh\">理论</span>"}},{"Plain":"<span lang=\"zh\">表明如下两个范畴等价</span>:</p>\n<ul>\n<li><span lang=\"zh\">带连续</span> $\\Gamma$-<span lang=\"zh\">作用的有限集的范畴</span>;</li>\n<li><span lang=\"zh\">有限可分</span> $F$-<span lang=\"zh\">代数的范畴</span>.</li>\n</ul>\n<p><span lang=\"zh\">其中第一个范畴到第二个范畴的函子将带</span> $\\Gamma$-<span lang=\"zh\">作用的有限集</span> $A$ <span lang=\"zh\">映射到</span> $((F^{\\text{sep}})^{\\oplus A})^\\Gamma$.</p>\n<h2><span lang=\"zh\">例</span></h2>\n<h3>$\\mathbb F_p$</h3>\n<p>"},{"Local":{"url":"/有限域","text":"<span lang=\"zh\">有限域</span>"}},{"Plain":" $\\mathbb F_p$ <span lang=\"zh\">的绝对</span> Galois <span lang=\"zh\">群</span> $\\operatorname{Gal}(\\overline{\\mathbb F_p}/\\mathbb F_p)$ <span lang=\"zh\">同构于</span>"},{"Local":{"url":"/整数环的pro-有限完备化","text":"<span lang=\"zh\">整数环的</span> pro-<span lang=\"zh\">有限完备化</span>"}},{"Plain":" $\\widehat {\\mathbb{Z}}:=\\operatorname{lim}_n \\mathbb{Z}/n\\simeq\\operatorname{lim}_n\\operatorname{Gal}(\\mathbb F_{p^n}/\\mathbb F_p)$. <span lang=\"zh\">其中</span> $1\\in\\widehat {\\mathbb{Z}}$ <span lang=\"zh\">是</span> "},{"Local":{"url":"/Frobenius态射","text":"Frobenius <span lang=\"zh\">态射</span>"}},{"Plain":", <span lang=\"zh\">它是</span> $\\operatorname{Gal}(\\overline{\\mathbb F_p}/\\mathbb F_p)$ <span lang=\"zh\">的一个拓扑生成元</span> (<span lang=\"zh\">即生成稠密子群的元素</span>).</p>\n"}]}}}]}