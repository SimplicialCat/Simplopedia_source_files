{"sections":[{"slug":"正规化子","section":{"metadata":{"slug":{"Plain":"正规化子"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">正规化子</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"正规化子"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<p><span lang=\"zh\">对于子群</span> $S \\subset G$,\n<span lang=\"zh\">其正规化子</span> $N_G(S)$ <span lang=\"zh\">是最大的使得</span> $S$ <span lang=\"zh\">在其中正规的子群</span>.\n<span lang=\"zh\">商群</span> $N_G(S) / S$ <span lang=\"zh\">又叫</span> $S$ <span lang=\"zh\">对应的</span> "},{"Local":{"url":"/Weyl群","text":"Weyl <span lang=\"zh\">群</span>"}},{"Plain":".</p>\n"}]}}}]}