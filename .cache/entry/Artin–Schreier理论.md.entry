{"sections":[{"slug":"Artin–Schreier理论","section":{"metadata":{"slug":{"Plain":"Artin–Schreier理论"},"ext":{"Plain":"md"},"title":{"Plain":"Artin–Schreier <span lang=\"zh\">理论</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"Artin–Schreier 理论"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<p><span lang=\"zh\">设</span> $X$ <span lang=\"zh\">为</span> $\\mathbb F_p$-"},{"Local":{"url":"/概形","text":"<span lang=\"zh\">概形</span>"}},{"Plain":", <span lang=\"zh\">则有</span> $X$ <span lang=\"zh\">的</span>"},{"Local":{"url":"/平展意象","text":"<span lang=\"zh\">平展意象</span>"}},{"Plain":"<span lang=\"zh\">中的</span> Abel <span lang=\"zh\">群的正合列</span>\n$$\r\n0\\to \\mathbb{Z}/p\\to \\mathbb A^1 \\overset{\\mathrm{Frob}-1}{\\to} \\mathbb A^1\\to 0,\r\n$$\n<span lang=\"zh\">其中</span> $\\mathrm{Frob}$ <span lang=\"zh\">为</span> "},{"Local":{"url":"/Frobenius态射","text":"Frobenius <span lang=\"zh\">态射</span>"}},{"Plain":".\n<span lang=\"zh\">它给出</span> ("},{"Local":{"url":"/平展上同调","text":"<span lang=\"zh\">平展</span>"}},{"Plain":") "},{"Local":{"url":"/上同调","text":"<span lang=\"zh\">上同调</span>"}},{"Plain":"<span lang=\"zh\">的长正合列</span>\n$$\r\n\\begin{aligned}\r\n    0 &amp;\\to \\mathbb{Z}/p\\to \\mathcal O(X) \\overset{\\mathrm{Frob}-1}{\\to} \\mathcal O(X) \\\\\r\n    &amp;\\to H^1(X,\\mathbb{Z}/p) \\to H^1(X,\\mathbb A^1) \\overset{\\mathrm{Frob}-1}{\\to} H^1(X,\\mathbb A^1)\\\\\r\n    &amp;\\to\\cdots.\r\n\\end{aligned}\r\n$$</p>\n<p><span lang=\"zh\">对应于</span> $a\\in\\mathcal O(X)$ <span lang=\"zh\">的</span> $\\mathbb{Z}/p$-"},{"Local":{"url":"/主丛","text":"<span lang=\"zh\">主丛</span>"}},{"Plain":"<span lang=\"zh\">为拉回</span>\n$$\r\n\\begin{array}\r\n    {ccc}\r\n    ? &amp; \\to &amp; \\mathbb A^1\\\\\r\n    \\downarrow &amp; &amp; \\downarrow \\mathclap{\\hspace{2.5em}\\scriptsize \\operatorname{Frob} - 1}\\\\\r\n    X &amp; \\underset{a}{\\to} &amp; \\mathbb A^1,\r\n\\end{array}\r\n$$\n<span lang=\"zh\">即</span>\n$$\r\n\\begin{aligned}\r\n    X' &amp;= \\{(x,t)\\in X\\times\\mathbb A^1\\mid t^p-t= a(x)\\}\r\n    \\\\&amp;=\\underline{\\operatorname{Spec}}_X (\\mathcal O_X [t]/(t^p-t-a)).\r\n\\end{aligned}\r\n$$</p>\n<h2><span lang=\"zh\">例</span></h2>\n<p><span lang=\"zh\">设</span> $X=\\operatorname{Spec} A$, $A$ <span lang=\"zh\">为</span> $\\mathbb F_p$-<span lang=\"zh\">代数</span>. <span lang=\"zh\">此时</span> $H^1(X,\\mathbb A^1)=0$, <span lang=\"zh\">故</span> $X$ <span lang=\"zh\">上的所有</span> $\\mathbb{Z}/p$-"},{"Local":{"url":"/主丛","text":"<span lang=\"zh\">主丛</span>"}},{"Plain":"<span lang=\"zh\">均形如</span> $\\operatorname{Spec} A[t]/(t^p-t-a)$, <span lang=\"zh\">而这个主丛平凡当且仅当</span> $a$ <span lang=\"zh\">形如</span> $b^p-b\\,(b\\in A)$.</p>\n"}]}}}]}