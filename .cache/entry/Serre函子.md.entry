{"sections":[{"slug":"Serre函子","section":{"metadata":{"slug":{"Plain":"Serre函子"},"ext":{"Plain":"md"},"title":{"Plain":"“Serre <span lang=\"zh\">函子</span>”"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"“Serre 函子”"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<p>Serre <span lang=\"zh\">函子实现了</span> "},{"Local":{"url":"/Serre对偶","text":"Serre <span lang=\"zh\">对偶</span>"}},{"Plain":".</p>\n<h2><span lang=\"zh\">定义</span></h2>\n<p><span lang=\"zh\">设</span> $\\mathsf A$ <span lang=\"zh\">为</span> $k$-"},{"Local":{"url":"/线性范畴","text":"<span lang=\"zh\">线性范畴</span>"}},{"Plain":". Serre <span lang=\"zh\">函子是</span> $k$-<span lang=\"zh\">线性等价</span> $\\mathsf A\\to \\mathsf A$, <span lang=\"zh\">具有自然同构</span>\n$$\r\n\\operatorname{Hom}(A,B)\\to \\operatorname{Hom}(B,S(A))^*.\r\n$$</p>\n<h2><span lang=\"zh\">例</span></h2>\n<p><span lang=\"zh\">设</span> $X$ <span lang=\"zh\">是</span> $k$ <span lang=\"zh\">上的光滑射影代数簇</span>, <span lang=\"zh\">那么</span>\n$$\r\nS_X \\colon D^b(X)\\to D^b(X)\r\n$$\n<span lang=\"zh\">为</span> Serre <span lang=\"zh\">函子</span>.</p>\n"}]}}}]}