{"sections":[{"slug":"剩余域","section":{"metadata":{"slug":{"Plain":"剩余域"},"ext":{"Plain":"md"},"title":{"Plain":"“<span lang=\"zh\">剩余域</span>”"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"“剩余域”"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<p>"},{"Local":{"url":"/局部环","text":"<span lang=\"zh\">局部环</span>"}},{"Plain":"<span lang=\"zh\">的剩余域是它唯一的极大理想的商</span>.</p>\n<p><span lang=\"zh\">设</span> $(K,\\|{-}\\|)$ <span lang=\"zh\">为</span>"},{"Local":{"url":"/非Archimedes赋值域","text":"<span lang=\"zh\">非</span> Archimedes <span lang=\"zh\">赋值域</span>"}},{"Plain":", $\\mathcal O_K=\\{x\\in K\\mid \\|x\\|\\leq 1\\}$ <span lang=\"zh\">为其</span>"},{"Local":{"url":"/赋值环","text":"<span lang=\"zh\">赋值环</span>"}},{"Plain":", <span lang=\"zh\">其唯一的极大理想为</span> $\\mathfrak m=\\{x\\in K\\mid\\|x\\|&lt;1\\}$. <span lang=\"zh\">此时称</span> $\\mathcal O_K/\\mathfrak m$ <span lang=\"zh\">为</span> $K$ <span lang=\"zh\">的剩余域</span>.</p>\n<h2><span lang=\"zh\">例</span></h2>\n<p>"},{"Local":{"url":"/整概形","text":"<span lang=\"zh\">整概形</span>"}},{"Plain":" $X$ <span lang=\"zh\">的</span>"},{"Local":{"url":"/一般点","text":"<span lang=\"zh\">一般点</span>"}},{"Plain":" $\\eta$ <span lang=\"zh\">处的剩余域同构于茎</span> $\\mathcal O_{X,\\eta}$ <span lang=\"zh\">的分式域</span>.</p>\n"}]}}}]}