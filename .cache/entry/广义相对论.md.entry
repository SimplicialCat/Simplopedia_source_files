{"sections":[{"slug":"广义相对论","section":{"metadata":{"slug":{"Plain":"广义相对论"},"ext":{"Plain":"md"},"title":{"Plain":"“<span lang=\"zh\">广义相对论</span>”"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"“广义相对论”"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<p><span lang=\"zh\">广义相对论是</span> Einstein <span lang=\"zh\">在几何学与等效原理的基础上建立的理论</span>.</p>\n<h2><span lang=\"zh\">几何基础</span></h2>\n<p><span lang=\"zh\">广义相对论的几何基础是</span> Riemann <span lang=\"zh\">几何</span>.</p>\n<h2><span lang=\"zh\">等效原理</span></h2>\n<p>Einstein <span lang=\"zh\">等效原理是说</span>, <span lang=\"zh\">重力场与参考系的加速是一回事</span>.</p>\n<h2><span lang=\"zh\">相关概念</span></h2>\n<p>"},{"Local":{"url":"/黑洞","text":"<span lang=\"zh\">黑洞</span>"}},{"Plain":"</p>\n"}]}}}]}