{"sections":[{"slug":"平展基本群","section":{"metadata":{"slug":{"Plain":"平展基本群"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">平展基本群</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"平展基本群"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">观念</span></h2>\n<p>"},{"Local":{"url":"/概形","text":"<span lang=\"zh\">概形</span>"}},{"Plain":"<span lang=\"zh\">的平展基本群是其</span>"},{"Local":{"url":"/平展意象","text":"<span lang=\"zh\">平展意象</span>"}},{"Plain":"<span lang=\"zh\">的</span>"},{"Local":{"url":"/∞-意象的形","text":"<span lang=\"zh\">形</span>"}},{"Plain":"<span lang=\"zh\">的</span>"},{"Local":{"url":"/基本群","text":"<span lang=\"zh\">基本群</span>"}},{"Plain":".</p>\n<h2><span lang=\"zh\">定义</span></h2>\n<h3><span lang=\"zh\">传统</span></h3>\n<p><span lang=\"zh\">参考</span> "},{"Local":{"url":"/MilneLEC","text":"Milne <span lang=\"zh\">平展上同调讲义</span>"}},{"Plain":".\n<span lang=\"zh\">对于概形</span> $X$, <span lang=\"zh\">记</span> $\\mathsf{FEt}_{/X}$ <span lang=\"zh\">为指向</span> $X$ <span lang=\"zh\">的有限平展映射的范畴</span>. <span lang=\"zh\">对于</span>"},{"Local":{"url":"/几何点","text":"<span lang=\"zh\">几何点</span>"}},{"Plain":" $\\bar x \\to X$,\n<span lang=\"zh\">定义</span>"},{"Local":{"url":"/纤维函子","text":"<span lang=\"zh\">纤维函子</span>"}},{"Plain":" $F \\colon \\mathsf{FEt}_{/X}\\to\\mathsf{Set}$,\n$$\r\nF(Y\\to X) := \\operatorname{Hom}_X(\\bar x,Y).\r\n$$\n<span lang=\"zh\">函子</span> $F$ <span lang=\"zh\">是</span> "},{"Local":{"url":"/pro-可表函子","text":"pro-<span lang=\"zh\">可表</span>"}},{"Plain":"<span lang=\"zh\">的</span>. <span lang=\"zh\">记</span> $\\widetilde {X}$ <span lang=\"zh\">为</span> $F$ <span lang=\"zh\">的表示</span> "},{"Local":{"url":"/pro-对象","text":"pro-<span lang=\"zh\">对象</span>"}},{"Plain":", <span lang=\"zh\">定义</span>\n$$\r\n\\pi_1(X,\\bar x) := \\operatorname{Aut}_{\\mathsf{ProFEt}_{/X}}(\\widetilde {X}) = \\operatorname{lim}\\operatorname{Aut}_{\\mathsf{FEt}_{/X}}(X_i)\r\n$$\n<span lang=\"zh\">后一个等式来自</span> "},{"Local":{"url":"/pro-对象","text":"pro-<span lang=\"zh\">对象</span>"}},{"Plain":"<span lang=\"zh\">的态射的计算</span>. ("},{"Local":{"url":"/todo","text":"todo"}},{"Plain":")</p>\n<h2><span lang=\"zh\">性质</span></h2>\n<h3><span lang=\"zh\">与主丛的关系</span></h3>\n<p><span lang=\"zh\">设</span> $X$ <span lang=\"zh\">为连通概形</span>, $G$ <span lang=\"zh\">为有限群</span>, <span lang=\"zh\">则</span> $X$ <span lang=\"zh\">的</span> $G$-<span lang=\"zh\">系数</span> $1$ <span lang=\"zh\">阶</span>"},{"Local":{"url":"/非Abel上同调","text":"<span lang=\"zh\">非</span> Abel"}},{"Plain":" "},{"Local":{"url":"/平展上同调","text":"<span lang=\"zh\">平展上同调</span>"}},{"Plain":"<span lang=\"zh\">等同于</span> $X$ <span lang=\"zh\">的平展基本群到</span> $G$ <span lang=\"zh\">的同态</span>:\n$$\r\nH^1(X_{\\mathrm{\\'et}},G) \\simeq \\operatorname{Hom}_{\\mathrm{cts}}(\\pi_1(X,\\bar x),G).\r\n$$</p>\n<h2><span lang=\"zh\">例</span></h2>\n<p><span lang=\"zh\">设基环</span> $k$ <span lang=\"zh\">为特征</span> $0$ <span lang=\"zh\">代数闭域</span>, $\\mathbb G_m$ <span lang=\"zh\">的有限平展覆叠为</span> $(-)^n\\colon \\mathbb G_m \\to\\mathbb G_m$.</p>\n"}]}}}]}