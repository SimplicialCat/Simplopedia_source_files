{"sections":[{"slug":"分解代数","section":{"metadata":{"slug":{"Plain":"分解代数"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">分解代数</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"分解代数"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">观念</span></h2>\n<p><span lang=\"zh\">分解代数是一个</span>"},{"Local":{"url":"/算畴上的代数","text":"<span lang=\"zh\">算畴上的代数</span>"}},{"Plain":", <span lang=\"zh\">这个</span>"},{"Local":{"url":"/算畴","text":"<span lang=\"zh\">算畴</span>"}},{"Plain":"<span lang=\"zh\">类似于</span>"},{"Local":{"url":"/小n-方块算畴","text":"<span lang=\"zh\">小方块算畴</span>"}},{"Plain":", <span lang=\"zh\">但是嵌入在特定的空间中</span>.</p>\n<h2><span lang=\"zh\">定义</span></h2>\n<h3><span lang=\"zh\">预分解代数</span></h3>\n<p><span lang=\"zh\">设</span> $X$ <span lang=\"zh\">为拓扑空间</span>. <span lang=\"zh\">考虑如下</span>"},{"Local":{"url":"/算畴","text":"<span lang=\"zh\">算畴</span>"}},{"Plain":" $\\mathsf{Fact}_X$:</p>\n<ul>\n<li><span lang=\"zh\">其对象为</span> $X$ <span lang=\"zh\">的开集</span>;</li>\n<li><span lang=\"zh\">多重态射集</span> $\\operatorname{Hom}((U_i),V)$ <span lang=\"zh\">仅当</span> $U_i$ <span lang=\"zh\">互相不交且包含于</span> $V$ <span lang=\"zh\">时为单点集</span>, <span lang=\"zh\">否则为空集</span>.</li>\n</ul>\n<p><span lang=\"zh\">称</span> $\\mathsf{Fact}_X$ <span lang=\"zh\">上的</span>"},{"Local":{"url":"/算畴上的代数","text":"<span lang=\"zh\">代数</span>"}},{"Plain":"<span lang=\"zh\">为</span><strong><span lang=\"zh\">预分解代数</span></strong>.</p>\n<h3><span lang=\"zh\">作为</span> Ran <span lang=\"zh\">空间上的对象</span></h3>\n<p><span lang=\"zh\">设</span> $\\mathcal C$ <span lang=\"zh\">为空间</span> $X$ <span lang=\"zh\">上的</span>"},{"Local":{"url":"/分解范畴","text":"<span lang=\"zh\">分解范畴</span>"}},{"Plain":". <span lang=\"zh\">定义</span> $\\mathcal C$ <span lang=\"zh\">中的</span><strong><span lang=\"zh\">分解代数</span></strong> $A$ <span lang=\"zh\">为如下资料</span>:</p>\n<ul>\n<li><span lang=\"zh\">对象</span> $A\\in\\mathcal C_{\\mathrm{Ran}}$,</li>\n<li><span lang=\"zh\">等价</span> $\\mathrm{union}^!(A)\\simeq A\\boxtimes A$, <span lang=\"zh\">其中</span> $\\mathrm{union} \\colon (\\mathrm{Ran}\\times\\mathrm{Ran})_{\\mathrm{disj}}\\to\\mathrm{Ran}$ <span lang=\"zh\">是</span> “<span lang=\"zh\">两个不交的有限点集的并</span>”, <span lang=\"zh\">左端是</span> $\\mathrm{union}^*(\\mathcal C)|_{\\mathrm{disj}}$ <span lang=\"zh\">的对象</span>, <span lang=\"zh\">而右端是</span> $(\\mathcal C\\boxtimes\\mathcal C)_{\\mathrm{disj}}$ <span lang=\"zh\">的对象</span>.</li>\n</ul>\n<p><span lang=\"zh\">通常的分解代数是这种定义的</span> $\\mathcal C=\\mathsf{Vect}$ <span lang=\"zh\">的特例</span>.</p>\n<h3><span lang=\"zh\">作为参数化算畴上的代数</span></h3>\n<p><span lang=\"zh\">要将</span> (<span lang=\"zh\">代数几何中的</span>) <span lang=\"zh\">分解代数实现为一个</span>"},{"Local":{"url":"/算畴上的代数","text":"<span lang=\"zh\">算畴上的代数</span>"}},{"Plain":", <span lang=\"zh\">可以考虑一个</span> $\\mathsf{Aff}$ <span lang=\"zh\">上的参数化算畴</span>…</p>\n"}]}}}]}