{"sections":[{"slug":"单Lie代数","section":{"metadata":{"slug":{"Plain":"单Lie代数"},"ext":{"Plain":"md"},"title":{"Plain":"“<span lang=\"zh\">单</span> Lie <span lang=\"zh\">代数</span>”"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"“单 Lie 代数”"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">定义</span></h2>\n<p><span lang=\"zh\">设</span> $\\mathfrak g$ <span lang=\"zh\">为有限维</span> Lie <span lang=\"zh\">代数</span>. <span lang=\"zh\">若</span> $\\mathfrak g$ <span lang=\"zh\">非</span> Abel, <span lang=\"zh\">且没有非平凡的理想</span>, <span lang=\"zh\">则称之为</span><strong><span lang=\"zh\">单</span> Lie <span lang=\"zh\">代数</span></strong>.</p>\n<h2><span lang=\"zh\">相关概念</span></h2>\n<p>"},{"Local":{"url":"/单Lie群","text":"<span lang=\"zh\">单</span> Lie <span lang=\"zh\">群</span>"}},{"Plain":"</p>\n<p>"},{"Local":{"url":"/半单Lie代数","text":"<span lang=\"zh\">半单</span> Lie <span lang=\"zh\">代数</span>"}},{"Plain":"</p>\n"}]}}}]}