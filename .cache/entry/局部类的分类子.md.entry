{"sections":[{"slug":"局部类的分类子","section":{"metadata":{"slug":{"Plain":"局部类的分类子"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">局部类</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"局部类"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<p><span lang=\"zh\">设</span> $\\Sigma$ <span lang=\"zh\">为</span>"},{"Local":{"url":"/意象","text":"<span lang=\"zh\">意象</span>"}},{"Plain":" $\\mathcal C$ <span lang=\"zh\">中映射的</span>"},{"Local":{"url":"/局部类","text":"<span lang=\"zh\">局部类</span>"}},{"Plain":" (<span lang=\"zh\">关于</span>"},{"Local":{"url":"/基变换","text":"<span lang=\"zh\">基变换</span>"}},{"Plain":"<span lang=\"zh\">与</span>"},{"Local":{"url":"/和(范畴论)","text":"<span lang=\"zh\">余积</span>"}},{"Plain":"<span lang=\"zh\">封闭</span>, <span lang=\"zh\">且被</span>"},{"Local":{"url":"/意象中的满射","text":"<span lang=\"zh\">满射</span>"}},{"Plain":"<span lang=\"zh\">的</span>"},{"Local":{"url":"/基变换","text":"<span lang=\"zh\">基变换</span>"}},{"Plain":"<span lang=\"zh\">探测</span>).\n<span lang=\"zh\">定义</span> $\\Sigma$ <span lang=\"zh\">的</span><strong><span lang=\"zh\">分类子</span></strong><span lang=\"zh\">为态射</span> $f_\\Sigma\\colon Y_\\Sigma \\to X_\\Sigma$, <span lang=\"zh\">又称为</span> $\\Sigma$ <span lang=\"zh\">中的</span><strong><span lang=\"zh\">万有态射</span></strong>, <span lang=\"zh\">满足</span> “$\\Sigma$ <span lang=\"zh\">的任何态射都是其基变换</span>”; <span lang=\"zh\">具体地</span>, <span lang=\"zh\">对任意对象</span> $X$,\n$$\r\n\\operatorname{Hom}(X,X_\\Sigma) \\to (\\mathcal C_{/X})^\\simeq,\r\ng\\mapsto g^*f_\\Sigma\r\n$$\n<span lang=\"zh\">的像恰为</span> $\\mathcal C_{/X}$ <span lang=\"zh\">中由</span> $\\Sigma$ <span lang=\"zh\">中的态射构成的子</span>"},{"Local":{"url":"/生象","text":"<span lang=\"zh\">生象</span>"}},{"Plain":". <span lang=\"zh\">由</span>"},{"Local":{"url":"/米田引理","text":"<span lang=\"zh\">米田引理</span>"}},{"Plain":", <span lang=\"zh\">分类子一旦存在</span>, <span lang=\"zh\">就是唯一的</span>.</p>\n<h2><span lang=\"zh\">例</span></h2>\n<ul>\n<li><span lang=\"zh\">单射</span> ($(-1)$-"},{"Local":{"url":"/截断性","text":"<span lang=\"zh\">截断</span>"}},{"Plain":"<span lang=\"zh\">映射</span>) <span lang=\"zh\">的分类子叫做</span>"},{"Local":{"url":"/子对象分类子","text":"<span lang=\"zh\">子对象分类子</span>"}},{"Plain":".</li>\n</ul>\n"}]}}}]}