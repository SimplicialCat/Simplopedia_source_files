{"sections":[{"slug":"完备格","section":{"metadata":{"slug":{"Plain":"完备格"},"ext":{"Plain":"md"},"title":{"Plain":"“<span lang=\"zh\">完备格</span>”"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"“完备格”"},"data-taxon":{"Plain":"百科"}},"content":{"Plain":"\n<p><span lang=\"zh\">完备格是指</span> (<span lang=\"zh\">视为范畴</span>) <span lang=\"zh\">存在所有小极限与小余极限</span> (<span lang=\"zh\">换言之</span>, <span lang=\"zh\">存在所有小积与小余积</span>) <span lang=\"zh\">的格</span>.</p>\n"}}}]}