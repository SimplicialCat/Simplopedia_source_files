{"sections":[{"slug":"Stein流形","section":{"metadata":{"slug":{"Plain":"Stein流形"},"ext":{"Plain":"md"},"title":{"Plain":"“Stein <span lang=\"zh\">流形</span>”"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"alias":{"Plain":"Stein <span lang=\"zh\">空间</span>"},"page-title":{"Plain":"“Stein 流形”"},"data-taxon":{"Plain":"百科"}},"content":{"Plain":"\n\n<p><span lang=\"zh\">复</span> $n$ <span lang=\"zh\">维空间的复子流形称为</span> Stein <span lang=\"zh\">流形</span>. <span lang=\"zh\">它是代数几何中仿射概形的类比</span>.</p>\n"}}}]}