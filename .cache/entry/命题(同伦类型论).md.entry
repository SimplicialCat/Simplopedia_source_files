{"sections":[{"slug":"命题(同伦类型论)","section":{"metadata":{"slug":{"Plain":"命题(同伦类型论)"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">命题</span> (<span lang=\"zh\">同伦类型论</span>)"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"命题 (同伦类型论)"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">定义</span></h2>\n<p><span lang=\"zh\">在</span>"},{"Local":{"url":"/同伦类型论","text":"<span lang=\"zh\">同伦类型论</span>"}},{"Plain":"<span lang=\"zh\">中</span>, <span lang=\"zh\">称类型</span> $A$ <span lang=\"zh\">是命题</span>, <span lang=\"zh\">是指</span> $A$ <span lang=\"zh\">的任意两个元素都相等</span>, <span lang=\"zh\">即</span>\n$$\r\n\\mathsf{isProp}(A) := \\prod_{x,y : A} x =_A y.\r\n$$</p>\n<h2><span lang=\"zh\">性质</span></h2>\n<p><span lang=\"zh\">对于命题</span> $A$, <span lang=\"zh\">若</span> $A$ <span lang=\"zh\">有一个元素</span>, <span lang=\"zh\">那么</span> $A$ "},{"Local":{"url":"/可缩(同伦类型论)","text":"<span lang=\"zh\">可缩</span>"}},{"Plain":".</p>\n<h2><span lang=\"zh\">相关概念</span></h2>\n<p>"},{"Local":{"url":"/真值","text":"<span lang=\"zh\">真值</span>"}},{"Plain":"</p>\n"}]}}}]}