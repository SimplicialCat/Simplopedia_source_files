{"sections":[{"slug":"Cat","section":{"metadata":{"slug":{"Plain":"Cat"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">范畴的范畴</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"subject":{"Lazy":[{"Local":{"url":"/范畴论","text":"<span lang=\"zh\">范畴论</span>"}}]},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"范畴的范畴"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">观念</span></h2>\n<p><span lang=\"zh\">一般而言</span>, <span lang=\"zh\">某种范畴构成的全体是一个更高一阶的</span>"},{"Local":{"url":"/高阶范畴","text":"<span lang=\"zh\">高阶范畴</span>"}},{"Plain":".</p>\n<h2><span lang=\"zh\">定义</span></h2>\n<h3><span lang=\"zh\">作为完备</span> Segal <span lang=\"zh\">对象的范畴</span></h3>\n<p><span lang=\"zh\">见</span> "},{"Local":{"url":"/Segal空间","text":"Segal <span lang=\"zh\">空间</span>"}},{"Plain":".</p>\n<h2><span lang=\"zh\">性质</span></h2>\n<h3><span lang=\"zh\">余极限</span></h3>\n"}]}}}]}