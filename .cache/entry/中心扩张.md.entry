{"sections":[{"slug":"中心扩张","section":{"metadata":{"slug":{"Plain":"中心扩张"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">中心扩张</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"中心扩张"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">定义</span></h2>\n<h3><span lang=\"zh\">抽象</span></h3>\n<p>"},{"Local":{"url":"/群","text":"<span lang=\"zh\">群</span>"}},{"Plain":"<span lang=\"zh\">的中心扩张是群的</span>"},{"Local":{"url":"/群短正合列","text":"<span lang=\"zh\">短正合列</span>"}},{"Plain":"\n$$\r\nA \\to G' \\to G,\r\n$$\n<span lang=\"zh\">带有</span> $A$ <span lang=\"zh\">上的</span> $\\mathbb E_2$-<span lang=\"zh\">群结构</span>, <span lang=\"zh\">以及一个映射</span>\n$$\r\n\\mathbf{B}G \\to \\mathbf{B}^2 A,\r\n$$\n<span lang=\"zh\">使得有如下</span>"},{"Local":{"url":"/纤维列","text":"<span lang=\"zh\">纤维列</span>"}},{"Plain":":\n$$\r\n\\begin{aligned}\r\n    A&amp;\\to G' \\to G\\\\\r\n    \\to \\mathbf{B}A&amp;\\to \\mathbf{B}G' \\to \\mathbf{B}G\\\\\r\n    \\to\\mathbf{B}^2 A.\r\n\\end{aligned}\r\n$$</p>\n"}]}}}]}