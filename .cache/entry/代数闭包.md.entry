{"sections":[{"slug":"代数闭包","section":{"metadata":{"slug":{"Plain":"代数闭包"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">代数闭包</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"代数闭包"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<p>"},{"Local":{"url":"/域","text":"<span lang=\"zh\">域</span>"}},{"Plain":" $F$ <span lang=\"zh\">的代数闭包是满足如下条件的域扩张</span> $F\\hookrightarrow\\overline{F}$:</p>\n<ul>\n<li>$F \\hookrightarrow \\overline{F}$ <span lang=\"zh\">为代数扩张</span>;</li>\n<li>$\\overline{F}$ <span lang=\"zh\">为代数闭域</span>.</li>\n</ul>\n<p><span lang=\"zh\">代数闭包在同构意义下唯一</span>, <span lang=\"zh\">但可能有非平凡自同构</span>.</p>\n"}]}}}]}