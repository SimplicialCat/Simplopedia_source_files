{"sections":[{"slug":"关系2-范畴","section":{"metadata":{"slug":{"Plain":"关系2-范畴"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">关系</span> 2-<span lang=\"zh\">范畴</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"关系 2-范畴"},"data-taxon":{"Plain":"百科"}},"content":{"Plain":"\n<p><span lang=\"zh\">设</span> $\\mathcal C$ <span lang=\"zh\">是有拉回的范畴</span>, <span lang=\"zh\">则可定义一个</span> $2$-<span lang=\"zh\">范畴</span> $\\mathsf{Corr}(\\mathcal C)$, <span lang=\"zh\">称为</span><strong><span lang=\"zh\">关系</span> $2$-<span lang=\"zh\">范畴</span></strong> ($2$-category of correspondences), <span lang=\"zh\">其对象为</span> $\\mathcal C$ <span lang=\"zh\">的对象</span>,\n$$\r\n\\operatorname{Hom}_{\\mathsf{Corr}(\\mathcal C)}(X,Y) = \\{X \\leftarrow Z \\to Y\\}.\r\n$$</p>\n"}}}]}