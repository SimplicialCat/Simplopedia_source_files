{"sections":[{"slug":"紧投射生成元","section":{"metadata":{"slug":{"Plain":"紧投射生成元"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">紧投射生成元</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"subject":{"Lazy":[{"Local":{"url":"/范畴论","text":"<span lang=\"zh\">范畴论</span>"}}]},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"紧投射生成元"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<p><strong><span lang=\"zh\">紧投射生成元</span></strong> (compact projective generator) <span lang=\"zh\">大致是指范畴中的</span>"},{"Local":{"url":"/可表现对象","text":"<span lang=\"zh\">紧</span>"}},{"Plain":", "},{"Local":{"url":"/投射对象","text":"<span lang=\"zh\">投射</span>"}},{"Plain":"<span lang=\"zh\">的</span>"},{"Local":{"url":"/生成元(范畴论)","text":"<span lang=\"zh\">生成元</span>"}},{"Plain":", <span lang=\"zh\">根据不同的范畴种类有稍微不同的概念</span>.</p>\n<h2><span lang=\"zh\">定义</span></h2>\n<h3><span lang=\"zh\">模范畴</span> (Abel <span lang=\"zh\">范畴</span>)</h3>\n<p><span lang=\"zh\">在</span> (<span lang=\"zh\">非交换</span>) <span lang=\"zh\">环</span> $A$ <span lang=\"zh\">上的右模范畴</span> $\\mathsf{RMod}(A)$ <span lang=\"zh\">中</span>,</p>\n<ul>\n<li><span lang=\"zh\">对象</span> $M$ <span lang=\"zh\">为</span>"},{"Local":{"url":"/生成元(范畴论)","text":"<span lang=\"zh\">生成元</span>"}},{"Plain":", <span lang=\"zh\">即</span> $\\operatorname{Hom}(M,-)$ <span lang=\"zh\">忠实</span>, <span lang=\"zh\">当且仅当</span> $A$ <span lang=\"zh\">为某个有限直和</span> $M^n$ <span lang=\"zh\">的直和项</span>;</li>\n<li><span lang=\"zh\">对象</span> $M$ <span lang=\"zh\">为有限生成</span>"},{"Local":{"url":"/投射对象","text":"<span lang=\"zh\">投射对象</span>"}},{"Plain":", <span lang=\"zh\">即</span> $\\operatorname{Hom}(M,-)$ <span lang=\"zh\">保持滤余极限且保持满射</span> ("},{"Local":{"url":"/余等化子","text":"<span lang=\"zh\">余等化子</span>"}},{"Plain":"), <span lang=\"zh\">当且仅当</span> $M$ <span lang=\"zh\">为某个有限生成自由模</span> $A^n$ <span lang=\"zh\">的直和项</span>.</li>\n</ul>\n"}]}}}]}