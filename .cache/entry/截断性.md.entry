{"sections":[{"slug":"截断性","section":{"metadata":{"slug":{"Plain":"截断性"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">截断性</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"截断性"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">观念</span></h2>\n<h2><span lang=\"zh\">定义</span></h2>\n<p><span lang=\"zh\">固定一个</span> "},{"Local":{"url":"/∞-意象","text":"$\\infty$-<span lang=\"zh\">意象</span>"}},{"Plain":" (<span lang=\"zh\">或更一般的</span>"},{"Local":{"url":"/可表现范畴","text":"<span lang=\"zh\">可表现范畴</span>"}},{"Plain":") $\\mathcal C$, <span lang=\"zh\">例如</span>"},{"Local":{"url":"/生象","text":"<span lang=\"zh\">生象</span>"}},{"Plain":"<span lang=\"zh\">的范畴</span> "},{"Local":{"url":"/Ani","text":"$\\mathsf{Ani}$"}},{"Plain":".</p>\n<h3><span lang=\"zh\">归纳定义</span></h3>\n<p><span lang=\"zh\">我们对</span> $n\\geq -2$ <span lang=\"zh\">归纳定义</span> $\\mathcal X$ <span lang=\"zh\">中的对象和态射的</span> $n$-<span lang=\"zh\">截断性</span>. <span lang=\"zh\">态射</span> $X\\to Y$ $n$-<span lang=\"zh\">截断就是指其在</span>"},{"Local":{"url":"/俯意象","text":"<span lang=\"zh\">俯意象</span>"}},{"Plain":" $\\mathcal C_{/Y}$ <span lang=\"zh\">中是</span> $n$-<span lang=\"zh\">截断对象</span>.</p>\n<p>$n=-2$:</p>\n<ul>\n<li>$(-2)$-<span lang=\"zh\">截断对象就是</span>"},{"Local":{"url":"/终对象","text":"<span lang=\"zh\">终对象</span>"}},{"Plain":" $*$.</li>\n<li>$(-2)$-<span lang=\"zh\">截断态射就是</span><strong><span lang=\"zh\">等价</span></strong>.</li>\n</ul>\n<p>$n\\geq -1$:</p>\n<ul>\n<li><span lang=\"zh\">对象</span> $X$ <span lang=\"zh\">是</span> $n$-<span lang=\"zh\">截断对象当且仅当</span>"},{"Local":{"url":"/对角线","text":"<span lang=\"zh\">对角线</span>"}},{"Plain":" $\\Delta_X\\colon X\\to X\\times X$ <span lang=\"zh\">是</span> $(n-1)$-<span lang=\"zh\">截断态射</span>.</li>\n<li><span lang=\"zh\">态射</span> $f\\colon X\\to Y$ <span lang=\"zh\">是</span> $n$-<span lang=\"zh\">截断态射当且仅当其在</span> $\\mathcal C_{/Y}$ <span lang=\"zh\">中是</span> $n$-<span lang=\"zh\">截断对象</span>, <span lang=\"zh\">即</span> $\\Delta_f \\colon X \\to X\\times_Y X$ <span lang=\"zh\">是</span> $(n-1)$-<span lang=\"zh\">截断态射</span>.</li>\n</ul>\n<p>$n$-<span lang=\"zh\">截断的归纳定义是如下</span>"},{"Local":{"url":"/同伦类型论","text":"<span lang=\"zh\">同伦类型论</span>"}},{"Plain":" (<span lang=\"zh\">见</span>"},{"Local":{"url":"/截断性(同伦类型论)","text":"<span lang=\"zh\">截断性</span> (<span lang=\"zh\">同伦类型论</span>)"}},{"Plain":") <span lang=\"zh\">命题的</span>"},{"Local":{"url":"/范畴语义","text":"<span lang=\"zh\">范畴语义</span>"}},{"Plain":":\n$X$ <span lang=\"zh\">是</span> $n$-<span lang=\"zh\">截断的</span>, <span lang=\"zh\">当且仅当对任意</span> $a,b \\in X$,\n$$\r\na =_X b\r\n$$\n<span lang=\"zh\">是</span> $(n-1)$-<span lang=\"zh\">截断的</span>.</p>\n<h3><span lang=\"zh\">通过局部性定义</span></h3>\n<p><span lang=\"zh\">定义</span> $n$-<span lang=\"zh\">截断对象为关于如下态射族的</span>"},{"Local":{"url":"/局部对象","text":"<span lang=\"zh\">局部对象</span>"}},{"Plain":":\n$$\r\n\\{A\\times S^{n+1} \\to A\\}.\r\n$$\n<span lang=\"zh\">其中</span> $S^{n+1}$ <span lang=\"zh\">是</span> $(n+1)$ <span lang=\"zh\">维</span>"},{"Local":{"url":"/球面","text":"<span lang=\"zh\">球面</span>"}},{"Plain":".</p>\n<p>$n$-<span lang=\"zh\">截断的局部对象定义是如下</span>"},{"Local":{"url":"/同伦类型论","text":"<span lang=\"zh\">同伦类型论</span>"}},{"Plain":"<span lang=\"zh\">命题的</span>"},{"Local":{"url":"/范畴语义","text":"<span lang=\"zh\">范畴语义</span>"}},{"Plain":":\n$X$ <span lang=\"zh\">是</span> $n$-<span lang=\"zh\">截断的</span>, <span lang=\"zh\">当且仅当任意映射</span> $S^n \\to X$ <span lang=\"zh\">都穿过某一个点</span> $x\\in X$. <span lang=\"zh\">注意这句话不能在外部</span> (<span lang=\"zh\">通常</span>) <span lang=\"zh\">语言中理解</span>.</p>\n<h3><span lang=\"zh\">同伦类型论</span></h3>\n<p><span lang=\"zh\">见</span>"},{"Local":{"url":"/截断性(同伦类型论)","text":"<span lang=\"zh\">截断性</span> (<span lang=\"zh\">同伦类型论</span>)"}},{"Plain":".</p>\n<h2><span lang=\"zh\">例</span></h2>\n<p>$n=-1$:</p>\n<ul>\n<li>$(-1)$-<span lang=\"zh\">截断对象就是</span>"},{"Local":{"url":"/子终对象","text":"<span lang=\"zh\">子终对象</span>"}},{"Plain":", <span lang=\"zh\">又称</span>"},{"Local":{"url":"/真值","text":"<span lang=\"zh\">真值</span>"}},{"Plain":".</li>\n<li>$(-1)$-<span lang=\"zh\">截断态射就是</span>"},{"Local":{"url":"/单射","text":"<span lang=\"zh\">单射</span>"}},{"Plain":".</li>\n</ul>\n<h2><span lang=\"zh\">性质</span></h2>\n<h2><span lang=\"zh\">相关概念</span></h2>\n<p>"},{"Local":{"url":"/连通性","text":"<span lang=\"zh\">连通性</span>"}},{"Plain":"</p>\n<p>"},{"Local":{"url":"/连通-截断分解","text":"($n$-<span lang=\"zh\">连通</span>, $n$-<span lang=\"zh\">截断</span>) <span lang=\"zh\">分解</span>"}},{"Plain":"</p>\n"}]}}}]}