{"sections":[{"slug":"对象的生象","section":{"metadata":{"slug":{"Plain":"对象的生象"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">对象的生象</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"对象的生象"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<p><span lang=\"zh\">将一个范畴中的不可逆态射去除</span>, <span lang=\"zh\">仅保留可逆态射</span>, <span lang=\"zh\">得到一个</span>"},{"Local":{"url":"/生象","text":"<span lang=\"zh\">生象</span>"}},{"Plain":", <span lang=\"zh\">称为其对象的生象</span>, <span lang=\"zh\">又叫</span><strong><span lang=\"zh\">核</span></strong> (core), <strong><span lang=\"zh\">极大子群胚</span></strong> (maximal subgroupoid).</p>\n"}]}}}]}