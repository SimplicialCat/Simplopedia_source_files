{"sections":[{"slug":"分离态射","section":{"metadata":{"slug":{"Plain":"分离态射"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">分离态射</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"分离态射"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">定义</span></h2>\n<p>"},{"Local":{"url":"/概形","text":"<span lang=\"zh\">概形</span>"}},{"Plain":"<span lang=\"zh\">的态射</span> $f\\colon X\\to Y$ <span lang=\"zh\">称为</span><strong><span lang=\"zh\">分离</span></strong> (separated) <span lang=\"zh\">态射</span>, <span lang=\"zh\">是指</span>"},{"Local":{"url":"/对角线","text":"<span lang=\"zh\">对角线</span>"}},{"Plain":" $X\\to X\\times_Y X$ <span lang=\"zh\">是</span>"},{"Local":{"url":"/闭嵌入","text":"<span lang=\"zh\">闭嵌入</span>"}},{"Plain":".</p>\n<p><span lang=\"zh\">概形</span> $X$ <span lang=\"zh\">称为分离概形是指</span> $X\\to\\operatorname{Spec}(\\mathbb{Z})$ <span lang=\"zh\">是分离态射</span>.</p>\n<h2><span lang=\"zh\">例</span></h2>\n<h2><span lang=\"zh\">相关概念</span></h2>\n<p>"},{"Local":{"url":"/分离几何态射","text":"<span lang=\"zh\">分离几何态射</span>"}},{"Plain":"</p>\n"}]}}}]}