{"metadata":{"title":[{"Plain":"空意象"},2],"slug":[{"Plain":"空意象"},0],"ext":[{"Plain":"md"},1],"subject":[{"Lazy":[{"Local":{"url":"意象理论","text":"意象理论"}}]},4],"author":[{"Lazy":[{"Local":{"url":"SimplicialCat","text":"SimplicialCat"}}]},5],"tag":[{"Plain":"百科"},3]},"content":{"Lazy":[{"Plain":"\n<h2>定义</h2>\n<p>空意象是终范畴 $1$, 也即空空间对应的"},{"Local":{"url":"意象","text":"意象"}},{"Plain":".</p>\n"}]}}