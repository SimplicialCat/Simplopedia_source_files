{"sections":[{"slug":"逆环路空间","section":{"metadata":{"slug":{"Plain":"逆环路空间"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">逆环路空间</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"逆环路空间"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">观念</span></h2>\n<p><span lang=\"zh\">群</span> $G$ <span lang=\"zh\">的逆环路空间是</span> $G$-"},{"Local":{"url":"/主丛","text":"<span lang=\"zh\">主齐性空间</span>"}},{"Plain":"<span lang=\"zh\">的</span>"},{"Local":{"url":"/生象","text":"<span lang=\"zh\">生象</span>"}},{"Plain":", <span lang=\"zh\">也即</span>"},{"Local":{"url":"/主丛","text":"<span lang=\"zh\">主丛</span>"}},{"Plain":"<span lang=\"zh\">的</span>"},{"Local":{"url":"/分类空间","text":"<span lang=\"zh\">分类空间</span>"}},{"Plain":".</p>\n<p><span lang=\"zh\">在</span> "},{"Local":{"url":"/∞-意象","text":"$\\infty$-<span lang=\"zh\">意象</span>"}},{"Plain":" $\\mathcal X$ <span lang=\"zh\">中</span>, <span lang=\"zh\">逆环路空间函子给出了</span>"},{"Local":{"url":"/群","text":"<span lang=\"zh\">群</span>"}},{"Plain":"<span lang=\"zh\">的范畴</span> $\\mathsf{Grp}(\\mathcal X)$ <span lang=\"zh\">到带基点连通对象的范畴</span> $\\mathcal X^{\\geq 1}_{*/}$ <span lang=\"zh\">的等价</span>.</p>\n<p><span lang=\"zh\">更一般地</span>, $n$ <span lang=\"zh\">阶逆环路空间给出了</span> "},{"Local":{"url":"/En-代数","text":"$\\mathbb E_n$-<span lang=\"zh\">群</span>"}},{"Plain":"<span lang=\"zh\">的范畴到带基点</span> $n$-"},{"Local":{"url":"/连通性","text":"<span lang=\"zh\">连合</span>"}},{"Plain":"<span lang=\"zh\">对象的范畴</span> $\\mathcal X^{\\geq n}_{*/}$ <span lang=\"zh\">的等价</span>.</p>\n<p><span lang=\"zh\">对象</span> $X$ <span lang=\"zh\">到</span> "},{"Local":{"url":"/En-代数","text":"$\\mathbb E_n$-<span lang=\"zh\">群</span>"}},{"Plain":" $A$ <span lang=\"zh\">的</span> $n$ <span lang=\"zh\">阶逆环路空间</span> $\\mathbf{B}^n A$ <span lang=\"zh\">的映射同伦类称为</span> $n$ <span lang=\"zh\">阶</span>"},{"Local":{"url":"/上同调","text":"<span lang=\"zh\">上同调</span>"}},{"Plain":" $H^n(X,A)$.</p>\n<h2><span lang=\"zh\">定义</span></h2>\n<h3><span lang=\"zh\">通过几何实现</span></h3>\n<p><span lang=\"zh\">在</span> "},{"Local":{"url":"/∞-意象","text":"$\\infty$-<span lang=\"zh\">意象</span>"}},{"Plain":"<span lang=\"zh\">中</span>, <span lang=\"zh\">群</span> $G$ <span lang=\"zh\">的逆环路空间是</span>"},{"Local":{"url":"/单纯对象","text":"<span lang=\"zh\">单纯对象</span>"}},{"Plain":"\n$$\r\n\\mathbf{B}^\\bullet G = (\\cdots G\\times G\\times G \\to^4 G\\times G \\to^3 G\\rightrightarrows *)\r\n$$\n<span lang=\"zh\">的</span>"},{"Local":{"url":"/几何实现(单纯图表的余极限)","text":"<span lang=\"zh\">几何实现</span>"}},{"Plain":" (<span lang=\"zh\">余极限</span>).</p>\n<p><span lang=\"zh\">而在拓扑空间的</span> $1$-<span lang=\"zh\">范畴中</span>, <span lang=\"zh\">拓扑群</span> $G$ <span lang=\"zh\">的逆环路空间可</span>"},{"Local":{"url":"/几何实现","text":"<span lang=\"zh\">实现</span>"}},{"Plain":"<span lang=\"zh\">为拓扑空间</span>\n$$\r\n\\begin{aligned}\r\n    |\\mathbf{B}G| &amp;= \\bigcup_{(g_1,\\cdots,g_n)} |\\Delta^n|\\\\\r\n    &amp; = \\bigcup_n \\underbrace{G * G * \\cdots * G}_n.\r\n\\end{aligned}\r\n$$</p>\n<h2><span lang=\"zh\">例</span></h2>\n<ul>\n<li>$\\mathbf{B}\\mathbb{Z} \\simeq S^1$.</li>\n<li>$\\mathbf{B}\\mathbb{Z}/2 \\simeq \\mathbb RP^\\infty$.</li>\n<li>$\\mathbf{B}S^1 \\simeq \\mathbb{C}P^{\\infty}$.</li>\n<li>$\\mathbf{B}\\mathrm{O}(n)\\simeq\\mathbf{B}\\mathrm{GL}_n(\\mathbb{R})=\\text{Gr}_n(\\mathbb{R}^{\\infty})$ <span lang=\"zh\">是</span> "},{"Local":{"url":"/Grassmann流形","text":"Grassmann <span lang=\"zh\">流形</span>"}},{"Plain":", <span lang=\"zh\">其</span> $\\mathbb{Z}_2$ <span lang=\"zh\">系数上同调类为</span> "},{"Local":{"url":"/Stiefel--Whitney类","text":"Stiefel–Whitney <span lang=\"zh\">类</span>"}},{"Plain":":$$\r\n      H^*(\\mathbf{B}\\mathrm{O}(n);\\mathbb{Z}_2)=\\mathbb{Z}_2[w_1,\\cdots,w_n],\r\n  $$<span lang=\"zh\">其中</span> $w_k\\in H^k$.</li>\n<li>$\\mathbf{B}\\mathrm{U}(n)\\simeq\\mathbf{B}\\mathrm{GL}_n(\\mathbb{C})=\\text{Gr}_n(\\mathbb{C}^{\\infty})$ <span lang=\"zh\">是复</span> "},{"Local":{"url":"/Grassmann流形","text":"Grassmann <span lang=\"zh\">流形</span>"}},{"Plain":", <span lang=\"zh\">其</span> $\\mathbb{Z}$ <span lang=\"zh\">系数上同调为</span>"},{"Local":{"url":"/陈类","text":"<span lang=\"zh\">陈类</span>"}},{"Plain":":$$\r\n      H^*(\\mathbf{B}\\mathrm{U}(n);\\mathbb{Z})=\\mathbb{Z}[c_1,\\cdots,c_n],\r\n  $$<span lang=\"zh\">其中</span> $c_k\\in H^{2k}$.</li>\n</ul>\n<h2><span lang=\"zh\">性质</span></h2>\n<h3><span lang=\"zh\">函子性与关联丛</span></h3>\n<p><span lang=\"zh\">对于</span>"},{"Local":{"url":"/群","text":"<span lang=\"zh\">群</span>"}},{"Plain":"<span lang=\"zh\">同态</span> $\\varphi\\colon H\\to G$, <span lang=\"zh\">有</span> $H$ <span lang=\"zh\">通过</span> $\\varphi$ <span lang=\"zh\">在</span> $G$ <span lang=\"zh\">上的左乘</span>"},{"Local":{"url":"/群作用","text":"<span lang=\"zh\">作用</span>"}},{"Plain":".\n<span lang=\"zh\">映射</span> $\\mathbf{B}\\varphi\\colon \\mathbf{B}H\\to \\mathbf{B}G$ <span lang=\"zh\">是</span> $\\mathbf{B}H$ <span lang=\"zh\">上的万有</span> $H$-"},{"Local":{"url":"/主丛","text":"<span lang=\"zh\">主丛</span>"}},{"Plain":"<span lang=\"zh\">通过该作用</span>"},{"Local":{"url":"/关联丛","text":"<span lang=\"zh\">关联</span>"}},{"Plain":"<span lang=\"zh\">的</span> $G$-"},{"Local":{"url":"/主丛","text":"<span lang=\"zh\">主丛</span>"}},{"Plain":"<span lang=\"zh\">的分类映射</span>.</p>\n<h3><span lang=\"zh\">与</span> Eilenberg–Maclane <span lang=\"zh\">空间的关系</span></h3>\n<p><span lang=\"zh\">对于离散群</span> $G$, <span lang=\"zh\">其分类空间</span> $\\mathbf{B}G$ <span lang=\"zh\">是</span> "},{"Local":{"url":"/Eilenberg–MacLane空间","text":"Eilenberg–Maclane <span lang=\"zh\">空间</span>"}},{"Plain":" $K(G,1)$.</p>\n<h3><span lang=\"zh\">上同调</span></h3>\n<p><span lang=\"zh\">若</span> $G$ <span lang=\"zh\">紧或半单</span>, "},{"Local":{"url":"/陈--Weil理论","text":"<span lang=\"zh\">陈</span>–Weil <span lang=\"zh\">理论</span>"}},{"Plain":"<span lang=\"zh\">给出同构</span>\n$$\r\nH^*(\\mathbf{B}G;\\mathbb{C})\\simeq \\mathbb{C}[\\mathfrak g]^G.\r\n$$\n<span lang=\"zh\">其中</span> $\\mathbb{C}[\\mathfrak g]^G$ <span lang=\"zh\">称为</span>"},{"Local":{"url":"/不变多项式","text":"<span lang=\"zh\">不变多项式</span>"}},{"Plain":"<span lang=\"zh\">代数</span>, <span lang=\"zh\">从而由不变多项式可以给出</span>"},{"Local":{"url":"/示性类","text":"<span lang=\"zh\">示性类</span>"}},{"Plain":".</p>\n<h2><span lang=\"zh\">模型</span></h2>\n<h3>Milnor <span lang=\"zh\">构造</span></h3>\n<p>Milnor <span lang=\"zh\">将分类空间</span> $BG$ <span lang=\"zh\">构造为</span> $n$ <span lang=\"zh\">重连接</span> $G * G * \\cdots * G$ <span lang=\"zh\">的余极限</span>. (<span lang=\"zh\">这个构造关于</span> $G$ <span lang=\"zh\">有函子性</span>.)</p>\n<p><span lang=\"zh\">等价地</span>, $BG$ <span lang=\"zh\">可构造为单对象范畴</span> $G$ <span lang=\"zh\">的</span>"},{"Local":{"url":"/脉","text":"<span lang=\"zh\">脉</span>"}},{"Plain":"<span lang=\"zh\">的</span>"},{"Local":{"url":"/几何实现","text":"<span lang=\"zh\">几何实现</span>"}},{"Plain":".</p>\n<h3><span lang=\"zh\">有限群</span></h3>\n<p><span lang=\"zh\">对任意有限群</span> $G$, <span lang=\"zh\">取</span> $G$ <span lang=\"zh\">的酉表示</span>, <span lang=\"zh\">则可得</span> $G$ <span lang=\"zh\">在</span> $S^\\infty\\subset \\mathbb{C}^{\\infty}$ <span lang=\"zh\">上的自由作用</span>, <span lang=\"zh\">从而构造</span> $\\mathbf{B}G$.</p>\n"}]}}}]}