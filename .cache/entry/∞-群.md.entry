{"metadata":{"title":[{"Plain":"∞-群"},2],"slug":[{"Plain":"∞-群"},0],"ext":[{"Plain":"md"},1],"author":[{"Lazy":[{"Local":{"url":"SimplicialCat","text":"SimplicialCat"}}]},4],"taxon":[{"Plain":"百科. "},3]},"content":{"Lazy":[{"Plain":"<p>$\\infty$-群是指 "},{"Local":{"url":"Ani","text":"$\\mathsf{Ani}$"}},{"Plain":" 中的 "},{"Local":{"url":"结合代数","text":"$\\mathbb E_1$"}},{"Plain":"-群, 也等同于只有一个对象的 $\\infty$-群胚, 也即 "},{"Local":{"url":"Ani","text":"$\\mathsf{Ani}$"}},{"Plain":" 中的"},{"Local":{"url":"群胚对象","text":"群胚对象"}},{"Plain":" $X\\colon \\Delta^{\\mathrm{op}}\\to\\mathsf{Ani}$, 满足 $X_0=1$.</p>\n"}]}}