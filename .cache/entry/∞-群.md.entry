{"sections":[{"slug":"∞-群","section":{"metadata":{"slug":{"Plain":"∞-群"},"ext":{"Plain":"md"},"title":{"Plain":"∞-<span lang=\"zh\">群</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"∞-群"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<p>$\\infty$-<span lang=\"zh\">群是指</span> "},{"Local":{"url":"/Ani","text":"$\\mathsf{Ani}$"}},{"Plain":" <span lang=\"zh\">中的</span> "},{"Local":{"url":"/结合代数","text":"$\\mathbb E_1$"}},{"Plain":"-<span lang=\"zh\">群</span>, <span lang=\"zh\">也等同于只有一个对象的</span> $\\infty$-<span lang=\"zh\">群胚</span>, <span lang=\"zh\">也即</span> "},{"Local":{"url":"/Ani","text":"$\\mathsf{Ani}$"}},{"Plain":" <span lang=\"zh\">中的</span>"},{"Local":{"url":"/群胚对象","text":"<span lang=\"zh\">群胚对象</span>"}},{"Plain":" $X\\colon \\Delta^{\\mathrm{op}}\\to\\mathsf{Ani}$, <span lang=\"zh\">满足</span> $X_0=1$.</p>\n"}]}}}]}