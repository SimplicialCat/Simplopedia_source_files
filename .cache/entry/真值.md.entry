{"sections":[{"slug":"真值","section":{"metadata":{"slug":{"Plain":"真值"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">真值</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"真值"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">定义</span></h2>\n<ul>\n<li><span lang=\"zh\">在经典逻辑中</span>, <span lang=\"zh\">真值只有两个</span>: $\\top$ (<span lang=\"zh\">真</span>), $\\bot$ (<span lang=\"zh\">假</span>).</li>\n<li><span lang=\"zh\">在</span>"},{"Local":{"url":"/意象","text":"<span lang=\"zh\">意象</span>"}},{"Plain":"<span lang=\"zh\">中</span>, <span lang=\"zh\">真值是</span>"},{"Local":{"url":"/子终对象","text":"<span lang=\"zh\">子终对象</span>"}},{"Plain":", <span lang=\"zh\">即终对象</span> $1$ <span lang=\"zh\">的子对象</span>.</li>\n<li><span lang=\"zh\">在</span>"},{"Local":{"url":"/同伦类型论","text":"<span lang=\"zh\">同伦类型论</span>"}},{"Plain":"<span lang=\"zh\">中</span>, <span lang=\"zh\">真值是</span> $(-1)$-"},{"Local":{"url":"/截断性","text":"<span lang=\"zh\">截断</span>"}},{"Plain":"<span lang=\"zh\">类型</span>. <span lang=\"zh\">见</span>"},{"Local":{"url":"/命题(同伦类型论)","text":"<span lang=\"zh\">命题</span> (<span lang=\"zh\">同伦类型论</span>)"}},{"Plain":".</li>\n</ul>\n"}]}}}]}