{"sections":[{"slug":"半直积","section":{"metadata":{"slug":{"Plain":"半直积"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">半直积</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"半直积"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">定义</span></h2>\n<p><span lang=\"zh\">设</span>"},{"Local":{"url":"/群","text":"<span lang=\"zh\">群</span>"}},{"Plain":" $H$ "},{"Local":{"url":"/群作用","text":"<span lang=\"zh\">作用</span>"}},{"Plain":"<span lang=\"zh\">于群</span> $N$, <span lang=\"zh\">即作用于带基点连通对象</span> $\\mathbf{B}N\\in\\mathsf{Ani}_{*/}^{\\geq 1}$, <span lang=\"zh\">其商</span> $(\\mathbf{B}N) / H$ <span lang=\"zh\">是一个群</span> $G = N \\rtimes H$ <span lang=\"zh\">的</span>"},{"Local":{"url":"/逆环路空间","text":"<span lang=\"zh\">逆环路空间</span>"}},{"Plain":", <span lang=\"zh\">这个群称为</span><strong><span lang=\"zh\">半直积</span></strong> (semidirect product).</p>\n<h2><span lang=\"zh\">性质</span></h2>\n<h3><span lang=\"zh\">分裂短正合列</span></h3>\n<p><span lang=\"zh\">半直积</span> $G = N\\rtimes H$ <span lang=\"zh\">给出右分裂的</span>"},{"Local":{"url":"/群短正合列","text":"<span lang=\"zh\">短正合列</span>"}},{"Plain":"\n$$\r\n1\\to N \\to G \\to H \\to 1,\r\n$$\n<span lang=\"zh\">其中</span> $G\\to H$ <span lang=\"zh\">有群同态截面</span> $H\\to G$, <span lang=\"zh\">这是因为</span> $H$ <span lang=\"zh\">在</span> $\\mathbf{B}N$ <span lang=\"zh\">上的作用保持基点</span>, <span lang=\"zh\">即有</span> $\\mathsf{Ani}_{/\\mathbf{B}H}$ <span lang=\"zh\">中的映射</span> $\\mathbf{B}H \\to (\\mathbf{B}N)/H = \\mathbf{B}G$.</p>\n<h2><span lang=\"zh\">例</span></h2>\n"}]}}}]}