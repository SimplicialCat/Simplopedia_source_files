{"sections":[{"slug":"积(范畴论)","section":{"metadata":{"slug":{"Plain":"积(范畴论)"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">积</span> (<span lang=\"zh\">范畴论</span>)"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"积 (范畴论)"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">定义</span></h2>\n<p><strong><span lang=\"zh\">积</span></strong> (product), <span lang=\"zh\">是以集合</span> (<span lang=\"zh\">离散范畴</span>) <span lang=\"zh\">为指标的</span>"},{"Local":{"url":"/极限","text":"<span lang=\"zh\">极限</span>"}},{"Plain":".</p>\n<h2><span lang=\"zh\">相关概念</span></h2>\n<p>"},{"Local":{"url":"/和(范畴论)","text":"<span lang=\"zh\">和</span> (<span lang=\"zh\">范畴论</span>)"}},{"Plain":"</p>\n"}]}}}]}