{"sections":[{"slug":"生成元(范畴论)","section":{"metadata":{"slug":{"Plain":"生成元(范畴论)"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">生成元</span> (<span lang=\"zh\">范畴论</span>)"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"subject":{"Lazy":[{"Local":{"url":"/范畴论","text":"<span lang=\"zh\">范畴论</span>"}}]},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"生成元 (范畴论)"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">定义</span></h2>\n<p><span lang=\"zh\">范畴</span> $\\mathcal C$ <span lang=\"zh\">的对象</span> $X$ <span lang=\"zh\">称为</span><strong><span lang=\"zh\">生成元</span></strong><span lang=\"zh\">是指</span> $\\operatorname{Hom}(X,-)\\colon \\mathcal C\\to\\mathsf{Set}$ <span lang=\"zh\">忠实</span>; <span lang=\"zh\">换言之</span>, <span lang=\"zh\">仅考虑</span> $X$ <span lang=\"zh\">出发的</span>"},{"Local":{"url":"/广义元素","text":"<span lang=\"zh\">广义元素</span>"}},{"Plain":"<span lang=\"zh\">的去向</span>, <span lang=\"zh\">就能区分处</span> $\\mathcal C$ <span lang=\"zh\">中的态射</span>.</p>\n<p><span lang=\"zh\">若范畴</span> $\\mathcal C$ <span lang=\"zh\">具有余积</span>, <span lang=\"zh\">则对象</span> $X$ <span lang=\"zh\">为生成元等价于对任意对象</span> $Y$,\n$$\r\n\\bigsqcup_{X\\to Y}X \\to Y\r\n$$\n<span lang=\"zh\">为</span>"},{"Local":{"url":"/满射(范畴论)","text":"<span lang=\"zh\">满射</span>"}},{"Plain":".</p>\n"}]}}}]}