{"sections":[{"slug":"理想类群","section":{"metadata":{"slug":{"Plain":"理想类群"},"ext":{"Plain":"md"},"title":{"Plain":"“<span lang=\"zh\">理想类群</span>”"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"“理想类群”"},"data-taxon":{"Plain":"百科"}},"content":{"Plain":"\n<h2><span lang=\"zh\">例</span></h2>\n<p>$\\mathbb{Z}[\\sqrt{-5}]$ <span lang=\"zh\">的理想类群是</span> $\\mathbb{Z}/2$. <span lang=\"zh\">例如</span> $I=(2,1+\\sqrt{-5})$ <span lang=\"zh\">不是主理想</span>, <span lang=\"zh\">但</span> $I^2=(2)$ <span lang=\"zh\">是主理想</span>.</p>\n"}}}]}