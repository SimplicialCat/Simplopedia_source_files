{"sections":[{"slug":"KL公理","section":{"metadata":{"slug":{"Plain":"KL公理"},"ext":{"Plain":"md"},"title":{"Plain":"Kock–Lawvere <span lang=\"zh\">公理</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"subject":{"Lazy":[{"Local":{"url":"/综合微分几何","text":"<span lang=\"zh\">综合微分几何</span>"}}]},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"Kock–Lawvere 公理"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">定义</span></h2>\n<p><span lang=\"zh\">在</span>"},{"Local":{"url":"/综合微分几何","text":"<span lang=\"zh\">综合微分几何</span>"}},{"Plain":"<span lang=\"zh\">中</span>, <span lang=\"zh\">记</span> $D$ <span lang=\"zh\">为</span>"},{"Local":{"url":"/一阶无穷小线段","text":"<span lang=\"zh\">一阶无穷小线段</span>"}},{"Plain":", $R$ <span lang=\"zh\">为</span>"},{"Local":{"url":"/直线(SDG)","text":"<span lang=\"zh\">直线</span>"}},{"Plain":".</p>\n<p><span lang=\"zh\">关于</span> $D$ <span lang=\"zh\">的</span> Kock–Lawvere <span lang=\"zh\">公理陈述如下</span>.</p>\n<p><strong><span lang=\"zh\">公理</span></strong>. <span lang=\"zh\">对任意函数</span> $f\\colon D\\to R$, <span lang=\"zh\">存在唯一的</span> $a,b\\in R$, <span lang=\"zh\">使得对任意</span> $d\\in D$,\n$$\r\nf(d) = a + d \\cdot b.\r\n$$</p>\n"}]}}}]}