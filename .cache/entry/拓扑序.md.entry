{"sections":[{"slug":"拓扑序","section":{"metadata":{"slug":{"Plain":"拓扑序"},"ext":{"Plain":"md"},"title":{"Plain":"“<span lang=\"zh\">拓扑序</span>”"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"“拓扑序”"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<p>#<span lang=\"zh\">数学物理</span></p>\n<p><span lang=\"zh\">拓扑序</span> (topological order) <span lang=\"zh\">是指有长程纠缠的量子物态</span>. <span lang=\"zh\">所谓长程纠缠</span>, <span lang=\"zh\">是指不能被局部线性等距变换消除的纠缠</span>.</p>\n<table><thead><tr><th></th><th><span lang=\"zh\">非对称</span></th><th><span lang=\"zh\">对称</span></th></tr></thead><tbody>\n<tr><td><span lang=\"zh\">短程纠缠</span></td><td><span lang=\"zh\">平凡物态</span></td><td>"},{"Local":{"url":"/对称保护拓扑物态","text":"<span lang=\"zh\">对称保护拓扑物态</span>"}},{"Plain":"</td></tr>\n<tr><td><span lang=\"zh\">长程纠缠</span></td><td><span lang=\"zh\">拓扑序</span></td><td></td></tr>\n</tbody></table>\n"}]}}}]}