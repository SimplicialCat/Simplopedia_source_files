{"sections":[{"slug":"无点拓扑学","section":{"metadata":{"slug":{"Plain":"无点拓扑学"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">无点拓扑学</span>"},"taxon":{"Plain":"<span lang=\"zh\">观念</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"无点拓扑学"},"data-taxon":{"Plain":"观念"}},"content":{"Lazy":[{"Plain":"\n<blockquote>\n<p><span lang=\"zh\">你可曾见过一个点</span>?</p>\n</blockquote>\n<h2><span lang=\"zh\">观念</span></h2>\n<p><strong><span lang=\"zh\">无点拓扑学</span></strong> (point-free topology) <span lang=\"zh\">研究不以</span><strong><span lang=\"zh\">点集</span></strong><span lang=\"zh\">为基础的拓扑或几何对象</span>; <span lang=\"zh\">换言之</span>, <span lang=\"zh\">这些对象不是以</span><strong><span lang=\"zh\">点</span></strong><span lang=\"zh\">的集合加上一些结构定义的</span>, <span lang=\"zh\">而是直接以</span><strong><span lang=\"zh\">子空间</span></strong><span lang=\"zh\">或</span><strong><span lang=\"zh\">层</span></strong><span lang=\"zh\">等结构构成的代数对象</span> (<span lang=\"zh\">见</span>"},{"Local":{"url":"/代数-几何对偶","text":"<span lang=\"zh\">代数</span>–<span lang=\"zh\">几何对偶</span>"}},{"Plain":") <span lang=\"zh\">定义的</span>.</p>\n<p><span lang=\"zh\">由于不依赖点集</span>, <span lang=\"zh\">无点拓扑学与一些非经典的</span>, <span lang=\"zh\">特别是不依赖</span>"},{"Local":{"url":"/排中律","text":"<span lang=\"zh\">排中律</span>"}},{"Plain":"<span lang=\"zh\">和</span>"},{"Local":{"url":"/选择公理","text":"<span lang=\"zh\">选择公理</span>"}},{"Plain":"<span lang=\"zh\">的逻辑体系</span> (<span lang=\"zh\">如</span>"},{"Local":{"url":"/直觉主义逻辑","text":"<span lang=\"zh\">直觉主义逻辑</span>"}},{"Plain":") <span lang=\"zh\">关系密切</span>.</p>\n"}]}}}]}