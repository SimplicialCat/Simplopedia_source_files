{"sections":[{"slug":"Euler类","section":{"metadata":{"slug":{"Plain":"Euler类"},"ext":{"Plain":"md"},"title":{"Plain":"“Euler <span lang=\"zh\">类</span>”"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"“Euler 类”"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<p><span lang=\"zh\">对于</span> $r$ <span lang=\"zh\">维实向量丛</span> $E\\to X$, <span lang=\"zh\">其</span> Euler <span lang=\"zh\">类是</span> "},{"Local":{"url":"/Thom类","text":"Thom <span lang=\"zh\">类</span>"}},{"Plain":" $u\\in H^r(E)$ <span lang=\"zh\">拉回到</span> $H^r(X)$ <span lang=\"zh\">中的像</span>.</p>\n<h2><span lang=\"zh\">与</span> Euler <span lang=\"zh\">数的关系</span></h2>\n<p><span lang=\"zh\">可定向流形的切丛的</span> Euler <span lang=\"zh\">类在整个流形上的积分等于流形的</span> "},{"Local":{"url":"/Euler示性数","text":"Euler <span lang=\"zh\">示性数</span>"}},{"Plain":".</p>\n<h2><span lang=\"zh\">与曲率</span> 2-<span lang=\"zh\">形式的关系</span></h2>\n<p><span lang=\"zh\">当存在度量</span>"},{"Local":{"url":"/联络","text":"<span lang=\"zh\">联络</span>"}},{"Plain":"<span lang=\"zh\">时</span>, Euler <span lang=\"zh\">类可用</span>"},{"Local":{"url":"/曲率形式","text":"<span lang=\"zh\">曲率形式</span>"}},{"Plain":"<span lang=\"zh\">的</span> "},{"Local":{"url":"/Pfaff型","text":"Pfaff <span lang=\"zh\">型</span>"}},{"Plain":"<span lang=\"zh\">构造</span>.</p>\n<h2><span lang=\"zh\">与陈类的联系</span></h2>\n<p>$d$ <span lang=\"zh\">维</span>"},{"Local":{"url":"/复向量丛","text":"<span lang=\"zh\">复向量丛</span>"}},{"Plain":"<span lang=\"zh\">可为</span> (<span lang=\"zh\">带定向</span>) <span lang=\"zh\">实向量丛</span>, <span lang=\"zh\">其</span> Euler <span lang=\"zh\">类是最高</span>"},{"Local":{"url":"/陈类","text":"<span lang=\"zh\">陈类</span>"}},{"Plain":"\n$$\r\ne(E) = c_d(E)\\in H^{2d}(X).\r\n$$</p>\n"}]}}}]}