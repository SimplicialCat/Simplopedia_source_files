{"sections":[{"slug":"Tate不动点","section":{"metadata":{"slug":{"Plain":"Tate不动点"},"ext":{"Plain":"md"},"title":{"Plain":"Tate <span lang=\"zh\">不动点</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"Tate 不动点"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">定义</span></h2>\n<p><span lang=\"zh\">参考</span> "},{"Local":{"url":"/NikolausScholzeTCH","text":"Nikolaus–Scholze"}},{"Plain":".</p>\n<p><span lang=\"zh\">定义</span> Tate <span lang=\"zh\">不动点为如下余纤维</span>:\n$$\r\nX^{tC_p} := \\operatorname{cofib}(X_{hC_p} \\overset{\\mathrm{Nm}}{\\to} X^{hC_p}).\r\n$$</p>\n<h2><span lang=\"zh\">相关概念</span></h2>\n<p>"},{"Local":{"url":"/Tate对角线","text":"Tate <span lang=\"zh\">对角线</span>"}},{"Plain":"</p>\n"}]}}}]}