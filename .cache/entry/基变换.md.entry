{"sections":[{"slug":"基变换","section":{"metadata":{"slug":{"Plain":"基变换"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">基变换</span>"},"taxon":{"Plain":"<span lang=\"zh\">观念</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"基变换"},"data-taxon":{"Plain":"观念"}},"content":{"Lazy":[{"Plain":"\n<p><span lang=\"zh\">基变换是</span>"},{"Local":{"url":"/相对","text":"<span lang=\"zh\">相对观点</span>"}},{"Plain":"<span lang=\"zh\">在不同基底空间之间的转换</span>.</p>\n<p><span lang=\"zh\">几何对象之间的基变换常常是指</span>"},{"Local":{"url":"/拉回","text":"<span lang=\"zh\">拉回</span>"}},{"Plain":". <span lang=\"zh\">对于拉回图</span>\n$$\r\n\\begin{array}\r\n\t{ccc}\r\n\tX' &amp; \\overset{u'}{\\to} &amp; X \\\\\r\n\t\\!\\!\\!\\!\\!\\! {}^{f'}\\downarrow &amp;&amp; \\downarrow {}^{f} \\!\\!\\!\\!\\! \\\\\r\n\tY' &amp; \\underset{u}{\\to} &amp; Y\r\n\\end{array}\r\n$$\n<span lang=\"zh\">有自然变换</span>\n$$\r\nu^* f_* \\to f'_* u^{\\prime *},\r\n$$\n<span lang=\"zh\">称为基变换映射</span>. <span lang=\"zh\">在许多条件下这个映射是同构</span>.</p>\n<h2><span lang=\"zh\">例</span></h2>\n<h3><span lang=\"zh\">平坦基变换</span></h3>\n<p><span lang=\"zh\">若</span> $u$ <span lang=\"zh\">为</span>"},{"Local":{"url":"/平坦态射","text":"<span lang=\"zh\">平坦态射</span>"}},{"Plain":", <span lang=\"zh\">则基变换映射为同构</span>. <span lang=\"zh\">这个事实的一个应用是</span> "},{"Local":{"url":"/Kunneth公式","text":"Kunneth <span lang=\"zh\">公式</span>"}},{"Plain":"\n$$\r\n\\Gamma(E\\boxtimes F)\\simeq \\Gamma E\\otimes \\Gamma F.\r\n$$</p>\n"}]}}}]}