{"sections":[{"slug":"奇异上同调","section":{"metadata":{"slug":{"Plain":"奇异上同调"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">奇异上同调</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"subject":{"Plain":"<span lang=\"zh\">代数拓扑</span>"},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"奇异上同调"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">观念</span></h2>\n<p><span lang=\"zh\">拓扑空间的</span><strong><span lang=\"zh\">奇异上同调</span></strong><span lang=\"zh\">是其</span>"},{"Local":{"url":"/数学对象的表现","text":"<span lang=\"zh\">表现</span>"}},{"Plain":"<span lang=\"zh\">的</span>"},{"Local":{"url":"/生象","text":"<span lang=\"zh\">生象</span>"}},{"Plain":"<span lang=\"zh\">的</span>"},{"Local":{"url":"/上同调","text":"<span lang=\"zh\">上同调</span>"}},{"Plain":".</p>\n<p><span lang=\"zh\">拓扑空间</span> $X$ "},{"Local":{"url":"/数学对象的表现","text":"<span lang=\"zh\">表现</span>"}},{"Plain":"<span lang=\"zh\">的</span>"},{"Local":{"url":"/生象","text":"<span lang=\"zh\">生象</span>"}},{"Plain":"<span lang=\"zh\">即是其</span>"},{"Local":{"url":"/奇异单纯集","text":"<span lang=\"zh\">奇异单纯集</span>"}},{"Plain":" $\\operatorname{Sing}X$ "},{"Local":{"url":"/数学对象的表现","text":"<span lang=\"zh\">表现</span>"}},{"Plain":"<span lang=\"zh\">的</span>"},{"Local":{"url":"/生象","text":"<span lang=\"zh\">生象</span>"}},{"Plain":".</p>\n<h2><span lang=\"zh\">定义</span></h2>\n<h2><span lang=\"zh\">性质</span></h2>\n<h3><span lang=\"zh\">与层上同调的联系</span></h3>\n<p><strong><span lang=\"zh\">定理</span></strong>. <span lang=\"zh\">对于局部可缩拓扑空间</span> $X$ <span lang=\"zh\">与</span> Abel <span lang=\"zh\">群</span> $A$, <span lang=\"zh\">奇异上同调</span> $H^n(X,A)$ <span lang=\"zh\">自然同构于</span>"},{"Local":{"url":"/层上同调","text":"<span lang=\"zh\">层上同调</span>"}},{"Plain":" $H^n(X,\\underline{A})$.</p>\n"}]}}}]}