{"sections":[{"slug":"列表","section":{"metadata":{"slug":{"Plain":"列表"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">列表</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"列表"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">定义</span></h2>\n<h3><span lang=\"zh\">作为类型</span></h3>\n<p><span lang=\"zh\">类型</span> $A$ <span lang=\"zh\">的列表类型</span> $\\operatorname{List}A$ <span lang=\"zh\">是如下定义的</span>"},{"Local":{"url":"/归纳类型","text":"<span lang=\"zh\">归纳类型</span>"}},{"Plain":":</p>\n<ul>\n<li><span lang=\"zh\">空列表</span> $(\\,\\,)$ <span lang=\"zh\">是</span> $\\operatorname{List}A$ <span lang=\"zh\">的元素</span>;</li>\n<li><span lang=\"zh\">对于</span> $a : A$, $s : \\operatorname{List}A$, <span lang=\"zh\">有</span> $(a,s) : \\operatorname{List}A$.</li>\n</ul>\n"}]}}}]}