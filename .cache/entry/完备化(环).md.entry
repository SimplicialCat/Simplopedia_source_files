{"sections":[{"slug":"完备化(环)","section":{"metadata":{"slug":{"Plain":"完备化(环)"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">完备化</span> (<span lang=\"zh\">环</span>)"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"完备化 (环)"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">观念</span></h2>\n<p><span lang=\"zh\">环关于理想的完备化给出了</span>"},{"Local":{"url":"/仿射概形","text":"<span lang=\"zh\">仿射概形</span>"}},{"Plain":"<span lang=\"zh\">的</span>"},{"Local":{"url":"/闭嵌入","text":"<span lang=\"zh\">闭子概形</span>"}},{"Plain":"<span lang=\"zh\">的</span>"},{"Local":{"url":"/形式邻域","text":"<span lang=\"zh\">形式邻域</span>"}},{"Plain":".</p>\n<p><span lang=\"zh\">另见</span>"},{"Local":{"url":"/完备化(稳定同伦论)","text":"<span lang=\"zh\">完备化</span> (<span lang=\"zh\">稳定同伦论</span>)"}},{"Plain":"</p>\n<h2><span lang=\"zh\">定义</span></h2>\n<p><span lang=\"zh\">环</span> $R$ <span lang=\"zh\">关于理想</span> $I$ <span lang=\"zh\">的完备化为</span>\n$$\r\n\\operatorname{lim}_nR/I^n.\r\n$$</p>\n<h2><span lang=\"zh\">例</span></h2>\n<p><span lang=\"zh\">整数环</span> $\\mathbb{Z}$ <span lang=\"zh\">关于</span> $(p)$ <span lang=\"zh\">的完备化为</span> "},{"Local":{"url":"/p-进整数","text":"$p$-<span lang=\"zh\">进整数环</span>"}},{"Plain":" $\\mathbb{Z}_p=\\operatorname{lim}_n \\mathbb{Z}/p^n$.</p>\n<h2><span lang=\"zh\">相关概念</span></h2>\n<p>"},{"Local":{"url":"/形式谱","text":"<span lang=\"zh\">形式谱</span>"}},{"Plain":", "},{"Local":{"url":"/完备化(域)","text":"<span lang=\"zh\">完备化</span> (<span lang=\"zh\">域</span>)"}},{"Plain":"</p>\n"}]}}}]}