{"sections":[{"slug":"有限单群分类","section":{"metadata":{"slug":{"Plain":"有限单群分类"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">有限单群分类</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"有限单群分类"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">陈述</span></h2>\n<ul>\n<li><span lang=\"zh\">素数阶循环群</span></li>\n<li>$A_n$, $n\\geq 5$</li>\n<li>"},{"Local":{"url":"/FSLT","text":"Lie <span lang=\"zh\">型有限单群</span>"}},{"Plain":" $A_n(q)$, $B_n(q)$, $C_n(q)$, $D_n(q)$, $G_2(q)$, $F_4(q)$, $E_6(q)$, $E_7(q)$, $E_8(q)$, <span lang=\"zh\">其中</span> $q=p^n$ <span lang=\"zh\">为素数幂</span></li>\n<li>${^2A}_n(q^2)$, ${^2A}_n(q^2)$,</li>\n<li>…</li>\n</ul>\n"}]}}}]}