{"sections":[{"slug":"KO","section":{"metadata":{"slug":{"Plain":"KO"},"ext":{"Plain":"md"},"title":{"Plain":"“KO”"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"“KO”"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<p>$\\mathrm {KO}$ <span lang=\"zh\">是来自实向量丛</span> K-<span lang=\"zh\">理论的</span>"},{"Local":{"url":"/环谱","text":"<span lang=\"zh\">环谱</span>"}},{"Plain":".</p>\n<p><span lang=\"zh\">对于空间</span> $X$, <span lang=\"zh\">定义</span> Abel <span lang=\"zh\">群</span> $\\mathrm {KO}(X)$ <span lang=\"zh\">为</span> $X$ <span lang=\"zh\">上实向量丛关于直和构成的幺半群的群化</span>, $\\widetilde {\\mathrm {KO}}(X):=\\ker(\\mathrm {KO}(X) \\to \\mathrm {KO}(*))$. $\\widetilde {\\mathrm {KO}}$ <span lang=\"zh\">被</span> $\\mathbb{Z}\\times\\mathrm {BO}$ <span lang=\"zh\">表示</span>. <span lang=\"zh\">由于</span> $\\mathbb{Z}\\times\\mathrm {BO}\\simeq\\Omega^8 (\\mathbb{Z}\\times\\mathrm {BO})$, <span lang=\"zh\">这定义了一个谱</span> $\\mathrm {KO}$.</p>\n"}]}}}]}