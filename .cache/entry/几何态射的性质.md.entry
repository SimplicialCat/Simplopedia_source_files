{"metadata":{"author":[{"Lazy":[{"Local":{"url":"SimplicialCat","text":"SimplicialCat"}}]},4],"slug":[{"Plain":"几何态射的性质"},0],"ext":[{"Plain":"md"},1],"title":[{"Plain":"“几何态射的性质”"},2],"tag":[{"Plain":"百科"},3]},"content":{"Lazy":[{"Plain":"\n<p>设 $f\\colon \\mathcal F\\to\\mathcal E$ 为"},{"Local":{"url":"几何态射","text":"几何态射"}},{"Plain":".</p>\n<table><thead><tr><th>名称</th><th>范畴论定义</th><th>逻辑定义</th></tr></thead><tbody>\n<tr><td>开映射</td><td>$f^*$ 为 Heyting 函子</td><td>$f^*$ 保持任意量词 $\\forall$</td></tr>\n<tr><td>嵌入</td><td></td><td>$f_*$ 保持任意量词 $\\forall$</td></tr>\n</tbody></table>\n"}]}}