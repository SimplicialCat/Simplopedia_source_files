{"metadata":{"author":[{"Lazy":[{"Local":{"url":"SimplicialCat","text":"SimplicialCat"}}]},4],"slug":[{"Plain":"平模态"},0],"title":[{"Plain":"平模态"},2],"ext":[{"Plain":"md"},1],"tag":[{"Plain":"百科"},3]},"content":{"Lazy":[{"Plain":"\n<h2>性质</h2>\n<h3>伴随三元组</h3>\n<p>我们有"},{"Local":{"url":"形模态","text":"形模态"}},{"Plain":"-平模态-"},{"Local":{"url":"尖模态","text":"尖模态"}},{"Plain":"的伴随三元组\n$$\r\nʃ \\dashv \\flat \\dashv \\sharp.\r\n$$</p>\n<h2>相关概念</h2>\n<p>"},{"Local":{"url":"deRham上同调","text":"de Rham 上同调"}},{"Plain":"</p>\n"}]}}