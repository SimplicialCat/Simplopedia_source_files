{"sections":[{"slug":"茎","section":{"metadata":{"slug":{"Plain":"茎"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">茎</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"茎"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">定义</span></h2>\n<p><strong><span lang=\"zh\">茎</span></strong> (stalk) <span lang=\"zh\">是</span>"},{"Local":{"url":"/意象的点","text":"<span lang=\"zh\">意象的点</span>"}},{"Plain":"<span lang=\"zh\">的</span>"},{"Local":{"url":"/逆像","text":"<span lang=\"zh\">逆像</span>"}},{"Plain":"<span lang=\"zh\">函子</span>.</p>\n<p><span lang=\"zh\">茎的元素称为</span><strong><span lang=\"zh\">芽</span></strong> (germ).</p>\n<h2><span lang=\"zh\">例</span></h2>\n<h3><span lang=\"zh\">丛的截面</span></h3>\n<p><span lang=\"zh\">对于</span>"},{"Local":{"url":"/纤维丛","text":"<span lang=\"zh\">纤维丛</span>"}},{"Plain":" $p\\colon E\\to B$, <span lang=\"zh\">点</span> $b\\in B$ <span lang=\"zh\">处的一个</span><strong><span lang=\"zh\">截面芽</span></strong> (germ of sections) <span lang=\"zh\">是</span> $(U,s)$ <span lang=\"zh\">的等价类</span>, <span lang=\"zh\">其中</span> $U$ <span lang=\"zh\">是</span> $b$ <span lang=\"zh\">的邻域</span>, $s$ <span lang=\"zh\">是</span> $p$ <span lang=\"zh\">在</span> $U$ <span lang=\"zh\">上的截面</span>. "},{"Local":{"url":"/等价关系","text":"<span lang=\"zh\">等价关系</span>"}},{"Plain":"<span lang=\"zh\">是对于更小的邻域</span> $V\\subset U$, $(U,s)\\sim (V,s|_V)$. <span lang=\"zh\">这就是说截面芽的集合为</span>"},{"Local":{"url":"/余极限","text":"<span lang=\"zh\">余极限</span>"}},{"Plain":"\n$$\r\n\\operatorname{colim}_U \\Gamma(U,p).\r\n$$\n<span lang=\"zh\">注意这是一个</span>"},{"Local":{"url":"/滤余极限","text":"<span lang=\"zh\">滤余极限</span>"}},{"Plain":".</p>\n"}]}}}]}