{"sections":[{"slug":"拟紧态射","section":{"metadata":{"slug":{"Plain":"拟紧态射"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">拟紧态射</span>"},"subject":{"Lazy":[{"Local":{"url":"/代数几何","text":"<span lang=\"zh\">代数几何</span>"}}]},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"拟紧态射"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">定义</span></h2>\n<p><span lang=\"zh\">对于</span>"},{"Local":{"url":"/概形","text":"<span lang=\"zh\">概形</span>"}},{"Plain":"<span lang=\"zh\">的态射</span> $f\\colon X\\to Y$, <span lang=\"zh\">若</span> $X$ <span lang=\"zh\">的每个仿射开集的原像均为</span>"},{"Local":{"url":"/拟紧概形","text":"<span lang=\"zh\">拟紧概形</span>"}},{"Plain":", <span lang=\"zh\">则称</span> $f$ <span lang=\"zh\">为</span><strong><span lang=\"zh\">拟紧态射</span></strong>.</p>\n<p><span lang=\"zh\">定义中</span> “<span lang=\"zh\">每个仿射开集</span>” <span lang=\"zh\">的要求可以仅对某个开覆盖验证</span>.</p>\n<h2><span lang=\"zh\">相关概念</span></h2>\n<p>"},{"Local":{"url":"/拟分离态射","text":"<span lang=\"zh\">拟分离态射</span>"}},{"Plain":"</p>\n"}]}}}]}