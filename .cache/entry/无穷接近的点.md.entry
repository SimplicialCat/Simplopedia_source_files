{"sections":[{"slug":"无穷接近的点","section":{"metadata":{"slug":{"Plain":"无穷接近的点"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">无穷接近的点</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"无穷接近的点"},"data-taxon":{"Plain":"百科"}},"content":{"Plain":"\n<h2><span lang=\"zh\">定义</span></h2>\n<p><span lang=\"zh\">设</span> $X$ <span lang=\"zh\">为</span> $k$-<span lang=\"zh\">概形</span>, $R$ <span lang=\"zh\">为</span> $k$-<span lang=\"zh\">代数</span>, $I$ <span lang=\"zh\">为</span> $R$ <span lang=\"zh\">的幂零根</span> (nilpotent radical). <span lang=\"zh\">若</span> $X$ <span lang=\"zh\">的两个</span> $R$-<span lang=\"zh\">点</span> $x,y$ <span lang=\"zh\">在映射</span>\n$$\r\nX(R)\\to X(R/I)\r\n$$\n<span lang=\"zh\">下的像相同</span>, <span lang=\"zh\">则称其为</span><strong><span lang=\"zh\">无穷接近的点</span></strong> (infinitesimally close points).</p>\n"}}}]}