{"sections":[{"slug":"环路空间","section":{"metadata":{"slug":{"Plain":"环路空间"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">环路空间</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"环路空间"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">定义</span></h2>\n<p><span lang=\"zh\">设</span> "},{"Local":{"url":"/无穷范畴","text":"$\\infty$-<span lang=\"zh\">范畴</span>"}},{"Plain":" $\\mathcal C$ <span lang=\"zh\">有终对象</span> $*$. <span lang=\"zh\">对于</span>"},{"Local":{"url":"/带基点对象","text":"<span lang=\"zh\">带基点对象</span>"}},{"Plain":" $x\\colon *\\to X$, <span lang=\"zh\">定义其</span><strong><span lang=\"zh\">环路空间</span></strong> $\\Omega X = \\Omega (X,x)$ <span lang=\"zh\">是如下拉回</span>,\n$$\r\n\\begin{array}\r\n    {ccc}\r\n    \\Omega (X,x) &amp; \\to &amp; * \\\\\r\n    \\downarrow &amp; &amp; \\downarrow \\\\\r\n    * &amp; \\to &amp; X.\r\n\\end{array}\r\n$$</p>\n"}]}}}]}