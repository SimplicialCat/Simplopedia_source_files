{"metadata":{"ext":[{"Plain":"md"},1],"author":[{"Lazy":[{"Local":{"url":"SimplicialCat","text":"SimplicialCat"}}]},4],"slug":[{"Plain":"Hamilton向量场"},0],"title":[{"Plain":"“Hamilton 向量场”"},2],"tag":[{"Plain":"百科"},3]},"content":{"Lazy":[{"Plain":"\n<h2>定义</h2>\n<p>"},{"Local":{"url":"辛流形","text":"辛流形"}},{"Plain":" $(M,\\omega)$ 上由一个函数 $H$ (称作 Hamilton 量) 确定的向量场 $X_H$, 满足 $dH(Y)=\\omega(X_H,Y)$.</p>\n<h2>相关概念</h2>\n<p>"},{"Local":{"url":"动量映射","text":"动量映射"}},{"Plain":"</p>\n"}]}}