{"sections":[{"slug":"Hamilton向量场","section":{"metadata":{"slug":{"Plain":"Hamilton向量场"},"ext":{"Plain":"md"},"title":{"Plain":"“Hamilton <span lang=\"zh\">向量场</span>”"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"“Hamilton 向量场”"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">定义</span></h2>\n<p>"},{"Local":{"url":"/辛流形","text":"<span lang=\"zh\">辛流形</span>"}},{"Plain":" $(M,\\omega)$ <span lang=\"zh\">上由一个函数</span> $H$ (<span lang=\"zh\">称作</span> Hamilton <span lang=\"zh\">量</span>) <span lang=\"zh\">确定的向量场</span> $X_H$, <span lang=\"zh\">满足</span> $dH(Y)=\\omega(X_H,Y)$.</p>\n<h2><span lang=\"zh\">相关概念</span></h2>\n<p>"},{"Local":{"url":"/动量映射","text":"<span lang=\"zh\">动量映射</span>"}},{"Plain":"</p>\n"}]}}}]}