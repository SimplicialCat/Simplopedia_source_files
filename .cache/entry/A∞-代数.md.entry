{"sections":[{"slug":"A∞-代数","section":{"metadata":{"slug":{"Plain":"A∞-代数"},"ext":{"Plain":"md"},"title":{"Plain":"A∞-<span lang=\"zh\">代数</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"A∞-代数"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">观念</span></h2>\n<p>$A_\\infty$-<span lang=\"zh\">代数就是</span>"},{"Local":{"url":"/结合代数","text":"<span lang=\"zh\">结合代数</span>"}},{"Plain":", <span lang=\"zh\">不过这个名字的出现往往意味着人们要用</span> "},{"Local":{"url":"/A∞-算畴","text":"$A_\\infty$-<span lang=\"zh\">算畴</span>"}},{"Plain":"<span lang=\"zh\">的一些具体</span>"},{"Local":{"url":"/数学对象的表现","text":"<span lang=\"zh\">表现</span>"}},{"Plain":"<span lang=\"zh\">来谈论结合代数</span>, <span lang=\"zh\">即所谓</span> “"},{"Local":{"url":"/融贯","text":"<span lang=\"zh\">融贯</span>"}},{"Plain":"” "},{"Local":{"url":"/结合代数","text":"<span lang=\"zh\">结合代数</span>"}},{"Plain":".</p>\n<p><span lang=\"zh\">拓扑空间范畴中的</span> $A_\\infty$-<span lang=\"zh\">代数又叫</span> "},{"Local":{"url":"/A∞-空间","text":"$A_\\infty$-<span lang=\"zh\">空间</span>"}},{"Plain":".</p>\n<p><span lang=\"zh\">有的文献中</span> “$A_\\infty$-<span lang=\"zh\">代数</span>” <span lang=\"zh\">特指</span>"},{"Local":{"url":"/链复形无穷范畴","text":"<span lang=\"zh\">链复形无穷范畴</span>"}},{"Plain":"<span lang=\"zh\">中的</span> $A_\\infty$-<span lang=\"zh\">代数</span>.</p>\n<h2><span lang=\"zh\">例</span></h2>\n<h3><span lang=\"zh\">链复形</span> $A_\\infty$-<span lang=\"zh\">代数</span></h3>\n"}]}}}]}