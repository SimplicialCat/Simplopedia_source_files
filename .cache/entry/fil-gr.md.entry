{"sections":[{"slug":"fil-gr","section":{"metadata":{"slug":{"Plain":"fil-gr"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">滤与分次的叠观点</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"subject":{"Lazy":[{"Local":{"url":"/代数几何","text":"<span lang=\"zh\">代数几何</span>"}}]},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"滤与分次的叠观点"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">陈述</span></h2>\n<h3><span lang=\"zh\">分次与半群作用</span></h3>\n<p><span lang=\"zh\">设</span> $N$ <span lang=\"zh\">为交换幺半群</span>, <span lang=\"zh\">则环</span> $A$ <span lang=\"zh\">上的</span> $N$-"},{"Local":{"url":"/分次代数","text":"<span lang=\"zh\">分次</span>"}},{"Plain":"<span lang=\"zh\">等同于仿射概形</span> $\\operatorname{Spec}A$ <span lang=\"zh\">上的</span> $\\operatorname{Spec}\\mathbb{Z}[N]$-"},{"Local":{"url":"/群作用","text":"<span lang=\"zh\">作用</span>"}},{"Plain":". <span lang=\"zh\">详见</span>"},{"Local":{"url":"/分次代数","text":"<span lang=\"zh\">分次代数</span>"}},{"Plain":".</p>\n<p><span lang=\"zh\">考虑</span> $N=\\mathbb{Z}$ <span lang=\"zh\">的特殊情形</span>, <span lang=\"zh\">记</span> $\\mathbb G_m = \\operatorname{Spec}\\mathbb{Z}[x^{\\pm 1}] = \\operatorname{Spec}\\mathbb{Z}[\\mathbb{Z}]$ <span lang=\"zh\">为</span>"},{"Local":{"url":"/乘法群概形","text":"<span lang=\"zh\">乘法群概形</span>"}},{"Plain":". <span lang=\"zh\">那么环</span> $A$ <span lang=\"zh\">上的</span> $\\mathbb{Z}$-"},{"Local":{"url":"/分次代数","text":"<span lang=\"zh\">分次</span>"}},{"Plain":"<span lang=\"zh\">等同于</span> $\\mathbb G_m$ <span lang=\"zh\">在</span>"},{"Local":{"url":"/仿射概形","text":"<span lang=\"zh\">仿射概形</span>"}},{"Plain":" $\\operatorname{Spec}A$ <span lang=\"zh\">上的</span>"},{"Local":{"url":"/群作用","text":"<span lang=\"zh\">作用</span>"}},{"Plain":". <span lang=\"zh\">在</span>"},{"Local":{"url":"/相对","text":"<span lang=\"zh\">相对</span>"}},{"Plain":"<span lang=\"zh\">情形中</span>, "},{"Local":{"url":"/概形","text":"<span lang=\"zh\">概形</span>"}},{"Plain":" $X$ <span lang=\"zh\">上的</span>"},{"Local":{"url":"/拟凝聚层","text":"<span lang=\"zh\">拟凝聚</span>"}},{"Plain":"<span lang=\"zh\">代数</span> $A$ <span lang=\"zh\">上的</span> $\\mathbb{Z}$-"},{"Local":{"url":"/分次代数","text":"<span lang=\"zh\">分次</span>"}},{"Plain":"<span lang=\"zh\">等同于</span>"},{"Local":{"url":"/相对谱","text":"<span lang=\"zh\">相对谱</span>"}},{"Plain":" $\\operatorname{Spec}_X A$ <span lang=\"zh\">上的</span> $\\mathbb G_m$-"},{"Local":{"url":"/群作用","text":"<span lang=\"zh\">作用</span>"}},{"Plain":".</p>\n<p><span lang=\"zh\">分次环</span> $A$ <span lang=\"zh\">上的分次模</span> $M$ <span lang=\"zh\">相当于</span> $\\operatorname{Spec}A$ <span lang=\"zh\">上的</span> $\\mathbb G_m$-<span lang=\"zh\">等变拟凝聚层</span>, <span lang=\"zh\">也即商叠</span> $\\operatorname{Spec}A / \\mathbb G_m$ <span lang=\"zh\">上的</span>"},{"Local":{"url":"/拟凝聚层","text":"<span lang=\"zh\">拟凝聚层</span>"}},{"Plain":". <span lang=\"zh\">具体地</span>, <span lang=\"zh\">考虑两个作用</span> $\\mathrm{act},\\mathrm{triv} \\colon \\mathbb G_m\\times\\operatorname{Spec}A\\to\\operatorname{Spec}A$, <span lang=\"zh\">对应两个环同态</span> $A\\to A[x^{\\pm 1}]$, <span lang=\"zh\">那么</span> $\\operatorname{Spec}A$ <span lang=\"zh\">上的</span> $\\mathbb G_m$-<span lang=\"zh\">等变拟凝聚层是</span> $A$-<span lang=\"zh\">模</span> $M$ <span lang=\"zh\">带有同构</span>\n$$\r\nM\\otimes_{A,\\mathrm{act}}A[x^{\\pm 1}] \\simeq M\\otimes_{A,\\mathrm{triv}}A[x^{\\pm 1}],\r\n$$\n<span lang=\"zh\">这至少给出一个映射</span> $M \\to M[x^{\\pm 1}]$, <span lang=\"zh\">它将</span> $M$ <span lang=\"zh\">的</span> $n$ <span lang=\"zh\">次齐次元素</span> $m$ <span lang=\"zh\">映射到</span> $m x^n \\in M[x^{\\pm 1}]$.</p>\n<h3><span lang=\"zh\">滤</span></h3>\n<p>"},{"Local":{"url":"/A1-Gm","text":"<span lang=\"zh\">仿射直线对乘法群的商</span>"}},{"Plain":" $\\mathbb A^1 / \\mathbb G_m$</p>\n<p>…</p>\n"}]}}}]}