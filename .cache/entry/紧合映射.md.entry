{"sections":[{"slug":"紧合映射","section":{"metadata":{"slug":{"Plain":"紧合映射"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">紧合映射</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"紧合映射"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">定义</span></h2>\n<h3><span lang=\"zh\">拓扑空间</span></h3>\n<p><span lang=\"zh\">拓扑空间的映射</span> $f\\colon X\\to Y$ <span lang=\"zh\">称作</span><strong><span lang=\"zh\">紧合映射</span></strong>, <span lang=\"zh\">是指每个紧集的原像都是紧集</span>.</p>\n<p><span lang=\"zh\">等价的定义是</span> $f$ <span lang=\"zh\">为</span>"},{"Local":{"url":"/闭映射","text":"<span lang=\"zh\">闭映射</span>"}},{"Plain":", <span lang=\"zh\">且每个纤维</span> ($Y$ <span lang=\"zh\">中的点的原像</span>) <span lang=\"zh\">为紧集</span>.</p>\n<h3><span lang=\"zh\">概形</span></h3>\n<p>"},{"Local":{"url":"/概形","text":"<span lang=\"zh\">概形</span>"}},{"Plain":"<span lang=\"zh\">的</span><strong><span lang=\"zh\">紧合映射</span></strong><span lang=\"zh\">是</span>"},{"Local":{"url":"/分离态射","text":"<span lang=\"zh\">分离</span>"}},{"Plain":" (separated) <span lang=\"zh\">且</span>"},{"Local":{"url":"/泛闭映射","text":"<span lang=\"zh\">泛闭</span>"}},{"Plain":" (universally closed) <span lang=\"zh\">的映射</span>.</p>\n<h2><span lang=\"zh\">性质</span></h2>\n<p><span lang=\"zh\">对于拓扑空间</span> $X,Y$, <span lang=\"zh\">设</span> $X$ Hausdorff, $Y$ <span lang=\"zh\">局部紧</span>, <span lang=\"zh\">则</span> $f\\colon X\\to Y$ <span lang=\"zh\">紧合等价于</span> $f$ <span lang=\"zh\">是闭映射</span>, <span lang=\"zh\">且每个纤维</span> $f^{-1}(y)$ <span lang=\"zh\">都是紧集</span>.</p>\n<h2><span lang=\"zh\">例</span></h2>\n<p>"},{"Local":{"url":"/射影空间","text":"<span lang=\"zh\">射影空间</span>"}},{"Plain":" $\\mathbb P^n_k \\to \\operatorname{Spec}k$ <span lang=\"zh\">为紧合映射</span>.</p>\n<h2><span lang=\"zh\">与凝聚层的关系</span></h2>\n<p><span lang=\"zh\">紧合映射的</span>"},{"Local":{"url":"/导出前推","text":"<span lang=\"zh\">导出前推</span>"}},{"Plain":"<span lang=\"zh\">保持</span>"},{"Local":{"url":"/凝聚层","text":"<span lang=\"zh\">凝聚层</span>"}},{"Plain":".</p>\n"}]}}}]}