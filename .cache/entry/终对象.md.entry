{"sections":[{"slug":"终对象","section":{"metadata":{"slug":{"Plain":"终对象"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">终对象</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"终对象"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">观念</span></h2>\n<p><span lang=\"zh\">在范畴</span> $\\mathcal C$ <span lang=\"zh\">对象</span> $X$ <span lang=\"zh\">上的</span>"},{"Local":{"url":"/俯范畴","text":"<span lang=\"zh\">俯范畴</span>"}},{"Plain":" $\\mathcal C_{/X}$ (<span lang=\"zh\">见</span>"},{"Local":{"url":"/相对","text":"<span lang=\"zh\">相对观点</span>"}},{"Plain":")<span lang=\"zh\">中</span>, <span lang=\"zh\">终对象就是</span> $X$ <span lang=\"zh\">自身</span>.</p>\n"}]}}}]}