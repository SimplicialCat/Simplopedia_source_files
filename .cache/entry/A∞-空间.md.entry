{"sections":[{"slug":"A∞-空间","section":{"metadata":{"slug":{"Plain":"A∞-空间"},"ext":{"Plain":"md"},"title":{"Plain":"“A∞-<span lang=\"zh\">空间</span>”"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"“A∞-空间”"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<p>Stasheff <span lang=\"zh\">的</span> A∞-<span lang=\"zh\">空间理论说明一个</span> H-<span lang=\"zh\">空间</span> $X$ <span lang=\"zh\">是</span>"},{"Local":{"url":"/环路空间","text":"<span lang=\"zh\">环路空间</span>"}},{"Plain":" (<span lang=\"zh\">也即有</span>"},{"Local":{"url":"/分类空间","text":"<span lang=\"zh\">分类空间</span>"}},{"Plain":") <span lang=\"zh\">当且仅当它满足结合律的所有高阶</span>"},{"Local":{"url":"/融贯","text":"<span lang=\"zh\">融贯</span>"}},{"Plain":"<span lang=\"zh\">同伦</span>.</p>\n<h2><span lang=\"zh\">例</span></h2>\n<p>"},{"Local":{"url":"/环路空间","text":"<span lang=\"zh\">环路空间</span>"}},{"Plain":"<span lang=\"zh\">自然构成</span> $A_\\infty$-<span lang=\"zh\">空间</span>.</p>\n<h2><span lang=\"zh\">相关概念</span></h2>\n<p>"},{"Local":{"url":"/Abel∞-群","text":"Abel ∞-<span lang=\"zh\">群</span>"}},{"Plain":"</p>\n"}]}}}]}