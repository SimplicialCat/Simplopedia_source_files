{"sections":[{"slug":"Grassmann变量","section":{"metadata":{"slug":{"Plain":"Grassmann变量"},"ext":{"Plain":"md"},"title":{"Plain":"“Grassmann <span lang=\"zh\">变量</span>”"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"“Grassmann 变量”"},"data-taxon":{"Plain":"百科"}},"content":{"Plain":"\n<p>Grassmann <span lang=\"zh\">变量通常是指外代数</span>, <span lang=\"zh\">或一般的超交换代数的元素</span>.</p>\n"}}}]}