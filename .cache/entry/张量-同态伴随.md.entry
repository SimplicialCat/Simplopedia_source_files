{"sections":[{"slug":"张量-同态伴随","section":{"metadata":{"slug":{"Plain":"张量-同态伴随"},"ext":{"Plain":"md"},"title":{"Plain":"“<span lang=\"zh\">张量</span>-<span lang=\"zh\">同态伴随</span>”"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"“张量-同态伴随”"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<p><span lang=\"zh\">对于</span> (<span lang=\"zh\">不一定交换的</span>) <span lang=\"zh\">环</span> $R,S$, <span lang=\"zh\">设</span> $M$ <span lang=\"zh\">为左</span> $R$ <span lang=\"zh\">右</span> $S$ <span lang=\"zh\">模</span>, <span lang=\"zh\">则有一对</span>"},{"Local":{"url":"/伴随","text":"<span lang=\"zh\">伴随</span>"}},{"Plain":"<span lang=\"zh\">函子</span>\n$$\r\n(M\\otimes_S - ) \\dashv \\operatorname{Hom}_R(M,-)\\colon  R\\mathsf {Mod} \\longleftrightarrows S\\mathsf {Mod}.\r\n$$\n<span lang=\"zh\">即对左</span> $S$-<span lang=\"zh\">模</span> $A$ <span lang=\"zh\">与左</span> $R$-<span lang=\"zh\">模</span> $B$, <span lang=\"zh\">有自然同构</span>\n$$\r\n\\operatorname{Hom}_R(M\\otimes_S A ,B) \\simeq \\operatorname{Hom}_S(A, \\operatorname{Hom}_R(M,B)).\r\n$$</p>\n<p><span lang=\"zh\">在</span>"},{"Local":{"url":"/代数-几何对偶","text":"<span lang=\"zh\">代数</span>-<span lang=\"zh\">几何对偶</span>"}},{"Plain":"<span lang=\"zh\">中</span>, <span lang=\"zh\">这对伴随可类比</span>"},{"Local":{"url":"/直像-逆像伴随","text":"<span lang=\"zh\">直像</span>-<span lang=\"zh\">逆像伴随</span>"}},{"Plain":".</p>\n<h2><span lang=\"zh\">性质</span></h2>\n<p>$M\\otimes_S -$ <span lang=\"zh\">为右正合函子</span>, <span lang=\"zh\">而</span> $\\operatorname{Hom}_R(M,-)$ <span lang=\"zh\">为左正合函子</span>.</p>\n<p><span lang=\"zh\">若</span> $M$ <span lang=\"zh\">为平坦</span> $S$-<span lang=\"zh\">模</span>, <span lang=\"zh\">则</span> $M\\otimes_S -$ <span lang=\"zh\">同时也是左正合函子</span>.</p>\n<h2><span lang=\"zh\">相关概念</span></h2>\n<p>"},{"Local":{"url":"/Frobenius互反律","text":"Frobenius <span lang=\"zh\">互反律</span>"}},{"Plain":"</p>\n<p>"},{"Local":{"url":"/标量扩张","text":"<span lang=\"zh\">标量扩张</span>"}},{"Plain":" $\\dashv$ "},{"Local":{"url":"/标量限制","text":"<span lang=\"zh\">标量限制</span>"}},{"Plain":" $\\dashv$ "},{"Local":{"url":"/标量余扩张","text":"<span lang=\"zh\">标量余扩张</span>"}},{"Plain":"</p>\n<p>"},{"Local":{"url":"/几何态射","text":"<span lang=\"zh\">几何态射</span>"}},{"Plain":"</p>\n"}]}}}]}