{"sections":[{"slug":"完美域","section":{"metadata":{"slug":{"Plain":"完美域"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">完美域</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"完美域"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<p><span lang=\"zh\">设</span> $k$ <span lang=\"zh\">为域</span>. <span lang=\"zh\">若如下等价条件之一成立</span>, <span lang=\"zh\">则称</span> $k$ <span lang=\"zh\">为</span><strong><span lang=\"zh\">完美域</span></strong> (perfect field):</p>\n<ul>\n<li>$k$ <span lang=\"zh\">的任何代数扩张都</span>"},{"Local":{"url":"/可分扩张","text":"<span lang=\"zh\">可分</span>"}},{"Plain":".</li>\n<li>$k$ <span lang=\"zh\">是</span> $0$ <span lang=\"zh\">特征域</span>, <span lang=\"zh\">或者</span> $k$ <span lang=\"zh\">是</span> $p$ <span lang=\"zh\">特征域</span> ($p$ <span lang=\"zh\">为素数</span>) <span lang=\"zh\">且</span> $k$ <span lang=\"zh\">的</span> "},{"Local":{"url":"/Frobenius态射","text":"Frobenius <span lang=\"zh\">映射</span>"}},{"Plain":"<span lang=\"zh\">为同构</span>.</li>\n</ul>\n"}]}}}]}