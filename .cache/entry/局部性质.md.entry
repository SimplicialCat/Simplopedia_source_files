{"sections":[{"slug":"局部性质","section":{"metadata":{"slug":{"Plain":"局部性质"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">局部性质</span>"},"taxon":{"Plain":"<span lang=\"zh\">观念</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"局部性质"},"data-taxon":{"Plain":"观念"}},"content":{"Lazy":[{"Plain":"\n<p><span lang=\"zh\">对于</span>"},{"Local":{"url":"/Grothendieck拓扑","text":"<span lang=\"zh\">覆盖结构</span>"}},{"Plain":" $J$, <span lang=\"zh\">以及态射的某种性质</span> $P$,</p>\n<ul>\n<li><span lang=\"zh\">称</span> $P$ <span lang=\"zh\">为</span><strong><span lang=\"zh\">源的局部性质</span></strong> (local on the source), <span lang=\"zh\">是指对任意</span> $J$-<span lang=\"zh\">覆盖</span> $\\{U_i \\to X\\}$, <span lang=\"zh\">态射</span> $X\\to Y$ <span lang=\"zh\">有性质</span> $P$ <span lang=\"zh\">当且仅当每个复合</span> $U_i \\to X\\to Y$ <span lang=\"zh\">有性质</span> $P$.</li>\n<li><span lang=\"zh\">称</span> $P$ <span lang=\"zh\">为</span><strong><span lang=\"zh\">目标的局部性质</span></strong> (local on the target), <span lang=\"zh\">是指对任意</span> $J$-<span lang=\"zh\">覆盖</span> $\\{U_i \\to X\\}$, <span lang=\"zh\">态射</span> $Y\\to X$ <span lang=\"zh\">有性质</span> $P$ <span lang=\"zh\">当且仅当每个</span>"},{"Local":{"url":"/基变换","text":"<span lang=\"zh\">基变换</span>"}},{"Plain":" $U_i\\times_X Y \\to X$ <span lang=\"zh\">有性质</span> $P$.</li>\n</ul>\n"}]}}}]}