{"metadata":{"author":[{"Lazy":[{"Local":{"url":"SimplicialCat","text":"SimplicialCat"}}]},4],"slug":[{"Plain":"数域"},0],"title":[{"Plain":"数域"},2],"ext":[{"Plain":"md"},1],"tag":[{"Plain":"百科"},3]},"content":{"Lazy":[{"Plain":"\n<p>数域是指 $\\mathbb{Q}$ 的有限扩张, 即由有理系数多项式的根生成的域.</p>\n<h2>相关概念</h2>\n<p>"},{"Local":{"url":"函数域类比","text":"函数域类比"}},{"Plain":"</p>\n"}]}}