{"sections":[{"slug":"数域","section":{"metadata":{"slug":{"Plain":"数域"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">数域</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"数域"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<p><span lang=\"zh\">数域是指</span> $\\mathbb{Q}$ <span lang=\"zh\">的有限扩张</span>, <span lang=\"zh\">即由有理系数多项式的根生成的域</span>.</p>\n<h2><span lang=\"zh\">相关概念</span></h2>\n<p>"},{"Local":{"url":"/函数域类比","text":"<span lang=\"zh\">函数域类比</span>"}},{"Plain":"</p>\n"}]}}}]}