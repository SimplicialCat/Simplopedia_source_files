{"sections":[{"slug":"理想层","section":{"metadata":{"slug":{"Plain":"理想层"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">理想层</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"理想层"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<p><span lang=\"zh\">理想层是环</span>"},{"Local":{"url":"/层","text":"<span lang=\"zh\">层</span>"}},{"Plain":"<span lang=\"zh\">的理想</span>. "},{"Local":{"url":"/环化空间","text":"<span lang=\"zh\">环化空间</span>"}},{"Plain":"<span lang=\"zh\">的理想层对应</span>"},{"Local":{"url":"/闭嵌入","text":"<span lang=\"zh\">闭子空间</span>"}},{"Plain":".</p>\n<h2><span lang=\"zh\">定义</span></h2>\n<p><span lang=\"zh\">设</span> $(X,A)$ <span lang=\"zh\">为</span>"},{"Local":{"url":"/环化空间","text":"<span lang=\"zh\">环化空间</span>"}},{"Plain":", <span lang=\"zh\">则</span> $A$ <span lang=\"zh\">作为</span> $A$-<span lang=\"zh\">模的子</span> $A$-<span lang=\"zh\">模称为理想层</span>.</p>\n<h2><span lang=\"zh\">例</span></h2>\n<p><span lang=\"zh\">设</span> $Z$ <span lang=\"zh\">是局部</span> "},{"Local":{"url":"/Noether概形","text":"Noether <span lang=\"zh\">概形</span>"}},{"Plain":" $X$ <span lang=\"zh\">的</span>"},{"Local":{"url":"/闭嵌入","text":"<span lang=\"zh\">闭子概形</span>"}},{"Plain":", <span lang=\"zh\">在</span> $Z$ <span lang=\"zh\">上消失的正则函数层</span> $I_{Z/X}$ <span lang=\"zh\">是</span> $\\mathcal O_X$ <span lang=\"zh\">的理想层</span>, <span lang=\"zh\">它是</span> $X$ <span lang=\"zh\">上的</span>"},{"Local":{"url":"/凝聚层","text":"<span lang=\"zh\">凝聚层</span>"}},{"Plain":".</p>\n<p><span lang=\"zh\">另见</span>"},{"Local":{"url":"/(余)切丛","text":"<span lang=\"zh\">切丛</span>"}},{"Plain":", "},{"Local":{"url":"/(余)法丛","text":"<span lang=\"zh\">法丛</span>"}},{"Plain":".</p>\n"}]}}}]}