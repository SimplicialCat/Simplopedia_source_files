{"sections":[{"slug":"直像","section":{"metadata":{"slug":{"Plain":"直像"},"ext":{"Plain":"md"},"title":{"Plain":"“<span lang=\"zh\">直像</span>”"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"alias":{"Plain":"<span lang=\"zh\">前推</span>"},"page-title":{"Plain":"“直像”"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n\n<p><span class=\"link external\"><a href=\"https://stacks.math.columbia.edu/tag/03PV\" title=\"Stacks 页面 [https://stacks.math.columbia.edu/tag/03PV]\">Stacks <span lang=\"zh\">页面</span></a></span></p>\n<p><span lang=\"zh\">直像是</span>"},{"Local":{"url":"/六函子","text":"<span lang=\"zh\">六函子</span>"}},{"Plain":"<span lang=\"zh\">之一</span>.</p>\n<p><span lang=\"zh\">对拓扑空间</span> $X,Y$, <span lang=\"zh\">映射</span> $f\\colon X\\to Y$ <span lang=\"zh\">诱导直像函子</span> $f_*\\colon \\operatorname{Sh}(X)\\to \\operatorname{Sh(Y)}$. <span lang=\"zh\">直像是逆像函子</span> $f^*$ <span lang=\"zh\">的右</span>"},{"Local":{"url":"/伴随","text":"<span lang=\"zh\">伴随</span>"}},{"Plain":". <span lang=\"zh\">见</span>"},{"Local":{"url":"/直像-逆像伴随","text":"<span lang=\"zh\">直像</span>-<span lang=\"zh\">逆像伴随</span>"}},{"Plain":".</p>\n<p><span lang=\"zh\">有人将前推写成</span> “<span lang=\"zh\">积分</span>” <span lang=\"zh\">符号</span>. <span lang=\"zh\">这与</span> "},{"Local":{"url":"/Fourier--向井变换","text":"Fourier–<span lang=\"zh\">向井变换</span>"}},{"Plain":"<span lang=\"zh\">有关</span>.</p>\n<h2><span lang=\"zh\">定义</span></h2>\n<p><span lang=\"zh\">设</span> $f\\colon X\\to Y$ <span lang=\"zh\">是</span> "},{"Local":{"url":"/Noether概形","text":"Noether <span lang=\"zh\">概形</span>"}},{"Plain":"<span lang=\"zh\">的态射</span>. <span lang=\"zh\">直像是左正合函子</span>\n$$\r\nf_*\\colon \\mathsf {Qcoh}(X) \\to \\mathsf {Qcoh}(Y).\r\n$$</p>\n<h2><span lang=\"zh\">例</span></h2>\n<p><span lang=\"zh\">对于态射</span> $X\\to \\operatorname{pt}$, <span lang=\"zh\">直像相当于</span>"},{"Local":{"url":"/整体截面","text":"<span lang=\"zh\">整体截面</span>"}},{"Plain":"<span lang=\"zh\">函子</span>. <span lang=\"zh\">例如</span> $f\\colon \\mathbb A^1\\to\\text{pt}$. <span lang=\"zh\">那么</span>\n$$\r\nf_*\\mathcal O_{\\mathbb A^1}= H^0(\\mathbb A^1,\\mathcal O_{\\mathbb A^1})=K[T].\r\n$$\n$K[T]$ <span lang=\"zh\">是</span> $K$ <span lang=\"zh\">上的无限维空间</span>, <span lang=\"zh\">这说明对于一般的态射</span>, <span lang=\"zh\">直像不保持</span>"},{"Local":{"url":"/凝聚层","text":"<span lang=\"zh\">凝聚层</span>"}},{"Plain":".</p>\n<p><span lang=\"zh\">对于</span>"},{"Local":{"url":"/紧合映射","text":"<span lang=\"zh\">紧合映射</span>"}},{"Plain":", <span lang=\"zh\">直像以及</span>"},{"Local":{"url":"/导出前推","text":"<span lang=\"zh\">导出前推</span>"}},{"Plain":"<span lang=\"zh\">保持凝聚层</span>.</p>\n"}]}}}]}