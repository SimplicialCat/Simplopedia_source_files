{"metadata":{"slug":[{"Plain":"闭映射"},0],"title":[{"Plain":"闭映射"},2],"author":[{"Lazy":[{"Local":{"url":"SimplicialCat","text":"SimplicialCat"}}]},4],"ext":[{"Plain":"md"},1],"tag":[{"Plain":"百科"},3]},"content":{"Lazy":[{"Plain":"\n<h2>定义</h2>\n<p>拓扑空间或"},{"Local":{"url":"概形","text":"概形"}},{"Plain":"的<strong>闭映射</strong>是指闭集的像均为闭集的映射.</p>\n"}]}}