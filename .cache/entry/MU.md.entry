{"sections":[{"slug":"MU","section":{"metadata":{"slug":{"Plain":"MU"},"ext":{"Plain":"md"},"title":{"Plain":"MU"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"subject":{"Lazy":[{"Local":{"url":"/稳定同伦论","text":"<span lang=\"zh\">稳定同伦论</span>"}}]},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"MU"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<p>$MU$ <span lang=\"zh\">是复向量丛的万有</span> "},{"Local":{"url":"/Thom谱","text":"Thom <span lang=\"zh\">谱</span>"}},{"Plain":", <span lang=\"zh\">它表示了复配边上同调理论</span>. $MU$ <span lang=\"zh\">是</span> "},{"Local":{"url":"/MO","text":"MO"}},{"Plain":" <span lang=\"zh\">的类比</span>.</p>\n<p><span lang=\"zh\">作为</span>"},{"Local":{"url":"/序列谱","text":"<span lang=\"zh\">序列谱</span>"}},{"Plain":", $MU$ <span lang=\"zh\">的第</span> $2k$ <span lang=\"zh\">项为万有</span> $k$ <span lang=\"zh\">阶复向量丛的</span> Thom <span lang=\"zh\">谱</span>.</p>\n<h2><span lang=\"zh\">复配边上同调理论</span></h2>\n<p><span lang=\"zh\">对于空间</span> $X$, $\\mathrm {MU}^*(X)$ <span lang=\"zh\">是</span> $X$ <span lang=\"zh\">上一种流形的配边</span> (bordism) <span lang=\"zh\">类</span>, <span lang=\"zh\">其稳定法丛上带有近复结构</span>.</p>\n"}]}}}]}