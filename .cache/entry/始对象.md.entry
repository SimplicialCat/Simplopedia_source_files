{"metadata":{"author":[{"Lazy":[{"Local":{"url":"SimplicialCat","text":"SimplicialCat"}}]},4],"taxon":[{"Plain":"百科. "},3],"ext":[{"Plain":"md"},1],"slug":[{"Plain":"始对象"},0],"title":[{"Plain":"始对象"},2]},"content":{"Lazy":[{"Plain":"\n<h2>定义</h2>\n<p>始对象是到任意对象有唯一态射的对象.</p>\n<p>始对象是空的"},{"Local":{"url":"余极限","text":"余极限"}},{"Plain":".</p>\n"}]}}