{"sections":[{"slug":"始对象","section":{"metadata":{"slug":{"Plain":"始对象"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">始对象</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"始对象"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">定义</span></h2>\n<p><span lang=\"zh\">始对象是到任意对象有唯一态射的对象</span>.</p>\n<p><span lang=\"zh\">始对象是空的</span>"},{"Local":{"url":"/余极限","text":"<span lang=\"zh\">余极限</span>"}},{"Plain":".</p>\n"}]}}}]}