{"sections":[{"slug":"生象化","section":{"metadata":{"slug":{"Plain":"生象化"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">生象化</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"生象化"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">观念</span></h2>\n<p><span lang=\"zh\">许多代数结构</span> (<span lang=\"zh\">环</span>, <span lang=\"zh\">模</span>, <span lang=\"zh\">交换代数等</span>) <span lang=\"zh\">可在</span>"},{"Local":{"url":"/生象","text":"<span lang=\"zh\">生象</span>"}},{"Plain":"<span lang=\"zh\">语境中谈论</span>, <span lang=\"zh\">例如</span>"},{"Local":{"url":"/生象环","text":"<span lang=\"zh\">生象环</span>"}},{"Plain":"; <span lang=\"zh\">此时其构成的范畴</span> (<span lang=\"zh\">例如</span> $\\mathsf{AniRing}$) <span lang=\"zh\">与集合语境中的相应范畴</span> (<span lang=\"zh\">例如普通环的范畴</span> $\\mathsf{Ring}$) <span lang=\"zh\">有特定的联系</span>, <span lang=\"zh\">这种联系就是</span><strong><span lang=\"zh\">生象化</span></strong>.</p>\n<p><span lang=\"zh\">生象化是一种</span> “<span lang=\"zh\">非</span> Abel "},{"Local":{"url":"/导出范畴","text":"<span lang=\"zh\">导出范畴</span>"}},{"Plain":"”.</p>\n<h2><span lang=\"zh\">定义</span></h2>\n<p><span lang=\"zh\">设</span> $\\mathcal C$ <span lang=\"zh\">为余完备</span>"},{"Local":{"url":"/紧生成范畴","text":"<span lang=\"zh\">紧生成</span>"}},{"Plain":" $(1,1)$-<span lang=\"zh\">范畴</span>, <span lang=\"zh\">其</span><strong><span lang=\"zh\">生象化</span></strong> (animation) $\\mathsf{Ani}(\\mathcal C)$ <span lang=\"zh\">定义为</span> $\\mathcal C^{\\mathrm{cpt}}$ <span lang=\"zh\">在</span>"},{"Local":{"url":"/筛范畴","text":"<span lang=\"zh\">筛余极限</span>"}},{"Plain":"<span lang=\"zh\">下自由生成的</span> $(\\infty,1)$-<span lang=\"zh\">范畴</span>, <span lang=\"zh\">也即</span> $\\mathsf{Fun}((\\mathcal C^{\\mathrm{cpt}})^{\\mathrm{op}},\\mathsf{Ani})$ <span lang=\"zh\">中由</span>"},{"Local":{"url":"/可表函子","text":"<span lang=\"zh\">可表函子</span>"}},{"Plain":"<span lang=\"zh\">在筛余极限下生成的子范畴</span>.</p>\n<h2><span lang=\"zh\">例</span></h2>\n<p>"},{"Local":{"url":"/生象","text":"<span lang=\"zh\">生象</span>"}},{"Plain":"<span lang=\"zh\">的范畴</span> $\\mathsf{Ani}$ <span lang=\"zh\">是集合范畴</span> $\\mathsf{Set}$ <span lang=\"zh\">的生象化</span>.</p>\n<p>"},{"Local":{"url":"/生象环","text":"<span lang=\"zh\">生象环</span>"}},{"Plain":"<span lang=\"zh\">的范畴</span> $\\mathsf{AniRing}$ <span lang=\"zh\">是环范畴</span> $\\mathsf{Ring}$ <span lang=\"zh\">的生象化</span>.</p>\n"}]}}}]}