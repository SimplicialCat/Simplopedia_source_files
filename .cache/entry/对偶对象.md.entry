{"metadata":{"author":[{"Lazy":[{"Local":{"url":"SimplicialCat","text":"SimplicialCat"}}]},4],"ext":[{"Plain":"md"},1],"tag":[{"Plain":"百科"},3],"slug":[{"Plain":"对偶对象"},0],"title":[{"Plain":"对偶对象"},2]},"content":{"Lazy":[{"Plain":"\n<h2>定义</h2>\n<p>在"},{"Local":{"url":"闭范畴","text":"闭范畴"}},{"Plain":" $\\mathcal C$ 中, 若存在对象 $D$, 满足"},{"Local":{"url":"内蕴态射对象","text":"内蕴态射对象"}},{"Plain":" $[-,D]\\colon \\mathcal C\\to\\mathcal C^{\\text{op}}$ 为等价, 则称之为对偶对象.</p>\n<h2>相关概念</h2>\n<p>"},{"Local":{"url":"Poincaré--Verdier对偶","text":"Poincaré–Verdier 对偶"}},{"Plain":", "},{"Local":{"url":"Cartier对偶","text":"Cartier 对偶"}},{"Plain":"</p>\n"}]}}