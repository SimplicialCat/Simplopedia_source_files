{"sections":[{"slug":"同伦(余)极限","section":{"metadata":{"slug":{"Plain":"同伦(余)极限"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">同伦</span> (<span lang=\"zh\">余</span>) <span lang=\"zh\">极限</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"同伦 (余) 极限"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">定义</span></h2>\n<h3><span lang=\"zh\">单纯集</span></h3>\n<p>"},{"Local":{"url":"/单纯集","text":"<span lang=\"zh\">单纯集</span>"}},{"Plain":"<span lang=\"zh\">映射</span> $f\\colon A\\to B$, $g\\colon A\\to C$ <span lang=\"zh\">的同伦推出是单纯集</span>\n$$\r\nB\\sqcup_{\\{0\\}\\times A} (\\Delta^1\\times A) \\sqcup_{\\{1\\}\\times A} C.\r\n$$</p>\n<h3><span lang=\"zh\">单纯模型范畴</span></h3>\n<p><span lang=\"zh\">在单纯模型范畴中</span>, <span lang=\"zh\">一个图是同伦极限图当且仅当在相应的</span>"},{"Local":{"url":"/拟范畴","text":"<span lang=\"zh\">拟范畴</span>"}},{"Plain":"<span lang=\"zh\">中它构成极限图</span>.</p>\n"}]}}}]}