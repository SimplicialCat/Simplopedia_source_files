{"sections":[{"slug":"球面","section":{"metadata":{"slug":{"Plain":"球面"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">球面</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"球面"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">定义</span></h2>\n<h3><span lang=\"zh\">归纳定义</span></h3>\n<p>$n=-1$:</p>\n<ul>\n<li>$(-1)$ <span lang=\"zh\">维球面</span> $S^{-1}$ <span lang=\"zh\">是空集</span> (<span lang=\"zh\">始对象</span>).</li>\n</ul>\n<p>$n\\geq 0$:</p>\n<ul>\n<li>$n$ <span lang=\"zh\">维球面</span> $S^n$ <span lang=\"zh\">是如下的</span>"},{"Local":{"url":"/推出","text":"<span lang=\"zh\">推出</span>"}},{"Plain":":$$\\begin{array}{ccc}S^{n-1} &amp; \\to &amp; * \\\\downarrow &amp; &amp; \\downarrow \\</li>\n</ul>\n<ul>\n<li>&amp; \\to &amp; S^{n}.\\end{array}$$</li>\n</ul>\n<h2><span lang=\"zh\">性质</span></h2>\n"}]}}}]}