{"sections":[{"slug":"Fano簇","section":{"metadata":{"slug":{"Plain":"Fano簇"},"ext":{"Plain":"md"},"title":{"Plain":"“Fano <span lang=\"zh\">簇</span>”"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"“Fano 簇”"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<p>"},{"Local":{"url":"/典范丛","text":"<span lang=\"zh\">典范丛</span>"}},{"Plain":"<span lang=\"zh\">的逆</span> $\\omega_X^{-1}$ <span lang=\"zh\">是丰沛层</span>.</p>\n<h2><span lang=\"zh\">例</span></h2>\n<ul>\n<li>"},{"Local":{"url":"/射影空间","text":"<span lang=\"zh\">射影空间</span>"}},{"Plain":" $\\mathbb P^N$ <span lang=\"zh\">是</span> Fano <span lang=\"zh\">簇</span>.</li>\n<li><span lang=\"zh\">设</span> $D$ <span lang=\"zh\">是</span> $\\mathbb P^N$ <span lang=\"zh\">的余一维子簇</span>, <span lang=\"zh\">由伴随公式</span> $K_D = (K_X +D )\\big|_D=(-(N+1)H+\\deg(D) H)\\big|_D$ ($H$ <span lang=\"zh\">为</span>"},{"Local":{"url":"/超平面类","text":"<span lang=\"zh\">超平面丛</span>"}},{"Plain":"), <span lang=\"zh\">当</span> $\\deg(D) \\leq n$ <span lang=\"zh\">时</span>, $D$ <span lang=\"zh\">是</span> Fano <span lang=\"zh\">簇</span>.</li>\n</ul>\n"}]}}}]}