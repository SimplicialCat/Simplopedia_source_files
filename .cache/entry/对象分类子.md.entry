{"sections":[{"slug":"对象分类子","section":{"metadata":{"slug":{"Plain":"对象分类子"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">对象分类子</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"对象分类子"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">观念</span></h2>\n<p><span lang=\"zh\">在一些范畴</span> (<span lang=\"zh\">尤其是</span>"},{"Local":{"url":"/意象","text":"<span lang=\"zh\">意象</span>"}},{"Plain":") <span lang=\"zh\">中</span>, <span lang=\"zh\">我们常常将态射</span>\n$$\r\n\\begin{array}\r\n{c}\r\nY\\\\\r\n\\downarrow\\\\\r\nX\r\n\\end{array}\r\n$$\n<span lang=\"zh\">视为对象</span> $X$ <span lang=\"zh\">上的</span><strong><span lang=\"zh\">一族</span></strong><span lang=\"zh\">对象</span>; <span lang=\"zh\">进而我们希望这个族由一个映射</span> $X\\to O$ <span lang=\"zh\">分类</span>. <span lang=\"zh\">这里</span> $O$ <span lang=\"zh\">是</span> “<span lang=\"zh\">对象的</span>"},{"Local":{"url":"/分类空间","text":"<span lang=\"zh\">分类空间</span>"}},{"Plain":"”.</p>\n<h2><span lang=\"zh\">定义</span></h2>\n<p><strong><span lang=\"zh\">定义</span></strong> (<span lang=\"zh\">意象的对象分类子</span>). "},{"Local":{"url":"/∞-意象","text":"<span lang=\"zh\">意象</span>"}},{"Plain":" $\\mathcal C$ <span lang=\"zh\">的</span><strong><span lang=\"zh\">对象分类子</span></strong> (object classifier) <span lang=\"zh\">是一个保持极限的函子</span> $O\\colon \\mathcal C^{\\mathrm{op}} \\to\\mathsf{Ani}$, <span lang=\"zh\">使得</span>\n$$\r\n\\operatorname{Hom}(X,O) \\simeq (\\mathcal C_{/X})^\\simeq.\r\n$$</p>\n<h2><span lang=\"zh\">相关概念</span></h2>\n<p>"},{"Local":{"url":"/子对象分类子","text":"<span lang=\"zh\">子对象分类子</span>"}},{"Plain":", "},{"Local":{"url":"/局部类","text":"<span lang=\"zh\">局部类</span>"}},{"Plain":"</p>\n"}]}}}]}