{"sections":[{"slug":"AKLT模型","section":{"metadata":{"slug":{"Plain":"AKLT模型"},"ext":{"Plain":"md"},"title":{"Plain":"“AKLT <span lang=\"zh\">模型</span>”"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"“AKLT 模型”"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<p>#<span lang=\"zh\">数学物理</span></p>\n<p>AKLT <span lang=\"zh\">模型是一维</span>"},{"Local":{"url":"/量子Heisenberg模型","text":"<span lang=\"zh\">量子</span> Heisenberg <span lang=\"zh\">模型</span>"}},{"Plain":"<span lang=\"zh\">的推广</span>.</p>\n<p>Hamilton <span lang=\"zh\">量</span>\n$$\r\nH_{\\text{AKLT}} = \\sum \\frac{1}{2} S_i \\cdot S_j + \\frac{1}{6} (S_i \\cdot S_j)^2,\r\n$$\n<span lang=\"zh\">其中</span> $S_i$ <span lang=\"zh\">为</span>"},{"Local":{"url":"/自旋","text":"<span lang=\"zh\">自旋</span>"}},{"Plain":" $1$ <span lang=\"zh\">的算子</span>.</p>\n"}]}}}]}