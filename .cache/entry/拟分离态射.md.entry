{"sections":[{"slug":"拟分离态射","section":{"metadata":{"slug":{"Plain":"拟分离态射"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">拟分离态射</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"subject":{"Lazy":[{"Local":{"url":"/代数几何","text":"<span lang=\"zh\">代数几何</span>"}}]},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"拟分离态射"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">定义</span></h2>\n<p><span lang=\"zh\">对于概形态射</span> $f\\colon X\\to Y$, <span lang=\"zh\">若</span>"},{"Local":{"url":"/对角线","text":"<span lang=\"zh\">对角线</span>"}},{"Plain":" $\\Delta_f\\colon X\\to X\\times_Y X$ <span lang=\"zh\">为</span>"},{"Local":{"url":"/拟紧态射","text":"<span lang=\"zh\">拟紧态射</span>"}},{"Plain":", <span lang=\"zh\">则称</span> $f$ <span lang=\"zh\">为</span><strong><span lang=\"zh\">拟分离态射</span></strong> (quasi-separated morphism).</p>\n<h2><span lang=\"zh\">相关概念</span></h2>\n<p>"},{"Local":{"url":"/分离态射","text":"<span lang=\"zh\">分离态射</span>"}},{"Plain":"</p>\n"}]}}}]}