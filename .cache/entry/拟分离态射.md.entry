{"metadata":{"slug":[{"Plain":"拟分离态射"},0],"tag":[{"Plain":"百科"},3],"ext":[{"Plain":"md"},1],"author":[{"Lazy":[{"Local":{"url":"SimplicialCat","text":"SimplicialCat"}}]},5],"subject":[{"Lazy":[{"Local":{"url":"代数几何","text":"代数几何"}}]},4],"title":[{"Plain":"拟分离态射"},2]},"content":{"Lazy":[{"Plain":"\n<h2>定义</h2>\n<p>对于概形态射 $f\\colon X\\to Y$, 若"},{"Local":{"url":"对角线","text":"对角线"}},{"Plain":" $\\Delta_f\\colon X\\to X\\times_Y X$ 为"},{"Local":{"url":"拟紧态射","text":"拟紧态射"}},{"Plain":", 则称 $f$ 为<strong>拟分离态射</strong> (quasi-separated morphism).</p>\n<h2>相关概念</h2>\n<p>"},{"Local":{"url":"分离态射","text":"分离态射"}},{"Plain":"</p>\n"}]}}