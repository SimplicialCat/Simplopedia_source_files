{"metadata":{"title":[{"Plain":"去心形式圆盘"},2],"tag":[{"Plain":"百科"},3],"author":[{"Lazy":[{"Local":{"url":"SimplicialCat","text":"SimplicialCat"}}]},4],"slug":[{"Plain":"去心形式圆盘"},0],"ext":[{"Plain":"md"},1]},"content":{"Lazy":[{"Plain":"\n<h2>观念</h2>\n<p>去心形式圆盘是"},{"Local":{"url":"形式圆盘","text":"形式圆盘"}},{"Plain":"去掉它的圆心.</p>\n<h2>相关概念</h2>\n<p>"},{"Local":{"url":"环路群","text":"环路群"}},{"Plain":"</p>\n"}]}}