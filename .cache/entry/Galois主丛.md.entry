{"metadata":{"author":[{"Lazy":[{"Local":{"url":"SimplicialCat","text":"SimplicialCat"}}]},4],"ext":[{"Plain":"md"},1],"slug":[{"Plain":"Galois主丛"},0],"title":[{"Plain":"Galois 主丛"},2],"tag":[{"Plain":"百科"},3]},"content":{"Lazy":[{"Plain":"\n<h2>定义</h2>\n<p>固定"},{"Local":{"url":"意象","text":"意象"}},{"Plain":" $\\mathcal X$ 上的一个"},{"Local":{"url":"群","text":"群"}},{"Plain":" $G$. 关于 $G$ 的 <strong>Galois 主丛</strong>是满足如下等价条件的 $G$-"},{"Local":{"url":"主丛","text":"主丛"}},{"Plain":" $P$:</p>\n<ul>\n<li>群同态 $G\\to \\operatorname{Aut}(P)$ 为同构.</li>\n<li>$G$-"},{"Local":{"url":"群作用","text":"作用"}},{"Plain":"函子 $\\mathbf{B}G \\to \\mathcal X$ 为全忠实函子.</li>\n</ul>\n<h2>例</h2>\n<h3>Galois 覆叠</h3>\n"}]}}