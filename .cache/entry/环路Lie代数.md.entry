{"sections":[{"slug":"环路Lie代数","section":{"metadata":{"slug":{"Plain":"环路Lie代数"},"ext":{"Plain":"md"},"title":{"Plain":"“<span lang=\"zh\">环路</span> Lie <span lang=\"zh\">代数</span>”"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"“环路 Lie 代数”"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<p>$$\r\nL\\mathfrak g := \\mathfrak g\\otimes k[t,t^{-1}]\r\n$$\n<span lang=\"zh\">另一种定义是</span>\n$$\r\nL\\mathfrak g := \\mathfrak g\\otimes_k k((t))\r\n$$</p>\n<p>"},{"Local":{"url":"/环路群","text":"<span lang=\"zh\">环路群</span>"}},{"Plain":"</p>\n"}]}}}]}