{"sections":[{"slug":"筛","section":{"metadata":{"slug":{"Plain":"筛"},"ext":{"Plain":"md"},"title":{"Plain":"“<span lang=\"zh\">筛</span>”"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"“筛”"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<p><span lang=\"zh\">对于小范畴</span> $\\mathsf{C}$ <span lang=\"zh\">与其中的对象</span> $c$, <span lang=\"zh\">我们称</span> $\\operatorname{Hom}(-,c)$ <span lang=\"zh\">的子函子为</span> $c$ <span lang=\"zh\">上的</span><strong><span lang=\"zh\">筛</span></strong> (sieve). <span lang=\"zh\">等价地</span>, $c$ <span lang=\"zh\">上的筛是指向</span> $c$ <span lang=\"zh\">的一族箭头</span> $S$, <span lang=\"zh\">满足</span> $f\\in S \\Rightarrow f\\circ g\\in S$.</p>\n<p><span lang=\"zh\">筛可用于定义</span>"},{"Local":{"url":"/子对象分类子","text":"<span lang=\"zh\">子对象分类子</span>"}},{"Plain":".</p>\n<p><span lang=\"zh\">相关概念</span>: "},{"Local":{"url":"/Grothendieck拓扑","text":"Grothendieck <span lang=\"zh\">拓扑</span>"}},{"Plain":"</p>\n"}]}}}]}