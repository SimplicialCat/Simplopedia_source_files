{"metadata":{"slug":[{"Plain":"自函子的迹"},0],"tag":[{"Plain":"百科"},3],"ext":[{"Plain":"md"},1],"author":[{"Lazy":[{"Local":{"url":"SimplicialCat","text":"SimplicialCat"}}]},4],"title":[{"Plain":"自函子的迹"},2]},"content":{"Lazy":[{"Plain":"\n<p>设 $\\mathcal{C}$ 是"},{"Local":{"url":"可对偶对象","text":"可对偶"}},{"Plain":" "},{"Local":{"url":"微分分次范畴","text":"DG 范畴"}},{"Plain":", 则可定义 $\\mathcal C$ 的自函子 $F\\colon \\mathcal C\\to\\mathcal C$ 的"},{"Local":{"url":"迹","text":"迹"}},{"Plain":" $\\operatorname{Tr}(F) \\in \\mathsf{Vect}$.</p>\n<h2>例</h2>\n"}]}}