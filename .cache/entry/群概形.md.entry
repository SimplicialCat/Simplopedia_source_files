{"sections":[{"slug":"群概形","section":{"metadata":{"slug":{"Plain":"群概形"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">群概形</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"群概形"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">观念</span></h2>\n<p><span lang=\"zh\">群概形是</span>"},{"Local":{"url":"/概形","text":"<span lang=\"zh\">概形</span>"}},{"Plain":"<span lang=\"zh\">范畴中的</span>"},{"Local":{"url":"/群","text":"<span lang=\"zh\">群</span>"}},{"Plain":".</p>\n<h2><span lang=\"zh\">定义</span></h2>\n<p><span lang=\"zh\">设</span> $S$ <span lang=\"zh\">为</span>"},{"Local":{"url":"/概形","text":"<span lang=\"zh\">概形</span>"}},{"Plain":". $S$-<span lang=\"zh\">群概形是指</span> $S$-<span lang=\"zh\">概形范畴中的</span>"},{"Local":{"url":"/群","text":"<span lang=\"zh\">群对象</span>"}},{"Plain":", <span lang=\"zh\">即</span> $S$-<span lang=\"zh\">概形</span> $G$, <span lang=\"zh\">配备了态射</span> $m\\colon G\\times_S G \\to G$, $i\\colon G\\to G$, $e\\colon S\\to G$ <span lang=\"zh\">满足结合律</span>, <span lang=\"zh\">单位元与逆元的性质</span>.</p>\n<p><span lang=\"zh\">由</span>"},{"Local":{"url":"/米田引理","text":"<span lang=\"zh\">米田引理</span>"}},{"Plain":", <span lang=\"zh\">这等价于</span> $\\operatorname{Hom}(-,G)$ <span lang=\"zh\">上有函子性的群结构</span>, <span lang=\"zh\">也即</span> $\\operatorname{Hom}(-,G)\\colon \\mathsf{Sch}^{\\mathrm{op}} \\to \\mathsf{Set}$ <span lang=\"zh\">穿过遗忘函子</span> $\\mathsf{Grp} \\to \\mathsf{Set}$.</p>\n<h2><span lang=\"zh\">例</span></h2>\n<p>"},{"Local":{"url":"/PGLn","text":"$\\mathrm{PGL}_n$"}},{"Plain":"</p>\n"}]}}}]}