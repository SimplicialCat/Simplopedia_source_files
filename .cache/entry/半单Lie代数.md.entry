{"sections":[{"slug":"半单Lie代数","section":{"metadata":{"slug":{"Plain":"半单Lie代数"},"ext":{"Plain":"md"},"title":{"Plain":"“<span lang=\"zh\">半单</span> Lie <span lang=\"zh\">代数</span>”"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"“半单 Lie 代数”"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">定义</span></h2>\n<p><span lang=\"zh\">设</span> $\\mathfrak g$ <span lang=\"zh\">为有限维</span> Lie <span lang=\"zh\">代数</span>. <span lang=\"zh\">若</span> $\\mathfrak g$ <span lang=\"zh\">没有非零的</span>"},{"Local":{"url":"/可解","text":"<span lang=\"zh\">可解</span> Lie <span lang=\"zh\">代数</span>"}},{"Plain":"<span lang=\"zh\">理想</span>, <span lang=\"zh\">即</span> $\\operatorname{rad}\\mathfrak g = 0$ ($\\operatorname{rad}\\mathfrak g$ <span lang=\"zh\">是</span> $\\mathfrak g$ <span lang=\"zh\">的</span>"},{"Local":{"url":"/根","text":"<span lang=\"zh\">根</span> (Lie <span lang=\"zh\">代数</span>)"}},{"Plain":"), <span lang=\"zh\">则称之为</span><strong><span lang=\"zh\">半单</span> Lie <span lang=\"zh\">代数</span></strong>.</p>\n<h2><span lang=\"zh\">性质</span></h2>\n<p><span lang=\"zh\">半单</span> Lie <span lang=\"zh\">代数是</span>"},{"Local":{"url":"/单Lie代数","text":"<span lang=\"zh\">单</span> Lie <span lang=\"zh\">代数</span>"}},{"Plain":"<span lang=\"zh\">的直和</span>.</p>\n"}]}}}]}