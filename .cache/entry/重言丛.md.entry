{"sections":[{"slug":"重言丛","section":{"metadata":{"slug":{"Plain":"重言丛"},"ext":{"Plain":"md"},"title":{"Plain":"“<span lang=\"zh\">重言丛</span>”"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"“重言丛”"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h3>$\\mathbb P^1$ <span lang=\"zh\">上的重言丛</span></h3>\n<p>$\\mathbb P^1$ <span lang=\"zh\">上的重言丛</span> $\\mathcal O(-1)$ <span lang=\"zh\">恰好是一个点对应的</span>"},{"Local":{"url":"/理想层","text":"<span lang=\"zh\">理想层</span>"}},{"Plain":", <span lang=\"zh\">有短正合列</span>\n$$\r\n0\\to \\mathcal O(-1) \\to \\mathcal O \\to\\mathcal O_p\\to 0.\r\n$$\n<span lang=\"zh\">见</span>"},{"Local":{"url":"/除子","text":"<span lang=\"zh\">除子</span>"}},{"Plain":".</p>\n"}]}}}]}