{"sections":[{"slug":"概形闭包","section":{"metadata":{"slug":{"Plain":"概形闭包"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">概形闭包</span>"},"subject":{"Lazy":[{"Local":{"url":"/代数几何","text":"<span lang=\"zh\">代数几何</span>"}}]},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"概形闭包"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">定义</span></h2>\n<p><span lang=\"zh\">设</span> $i\\colon Y\\to X$ <span lang=\"zh\">是</span>"},{"Local":{"url":"/拟紧态射","text":"<span lang=\"zh\">拟紧</span>"}},{"Plain":"<span lang=\"zh\">的</span>"},{"Local":{"url":"/局部闭嵌入","text":"<span lang=\"zh\">局部闭嵌入</span>"}},{"Plain":". <span lang=\"zh\">那么</span> $i_*\\mathcal O_Y$ <span lang=\"zh\">是</span>"},{"Local":{"url":"/拟凝聚层","text":"<span lang=\"zh\">拟凝聚</span>"}},{"Plain":" $\\mathcal O_X$-<span lang=\"zh\">模</span>. <span lang=\"zh\">考虑理想</span>\n$$\r\n\\mathcal I = \\ker (\\mathcal O_X \\to i_*\\mathcal O_Y).\r\n$$\n<span lang=\"zh\">定义</span> $Y$ <span lang=\"zh\">的</span><strong><span lang=\"zh\">概形闭包</span></strong> (scheme-theoretic closure) <span lang=\"zh\">为商代数的</span>"},{"Local":{"url":"/相对谱","text":"<span lang=\"zh\">相对谱</span>"}},{"Plain":"\n$$\r\n\\overline{Y} := \\operatorname{Spec}_X (\\mathcal O_X / \\mathcal I).\r\n$$\n<span lang=\"zh\">由</span>"},{"Local":{"url":"/相对谱","text":"<span lang=\"zh\">相对谱</span>"}},{"Plain":"<span lang=\"zh\">的性质</span>, <span lang=\"zh\">代数同态</span> $\\mathcal O_X / \\mathcal I \\to i_*\\mathcal O_Y$ <span lang=\"zh\">给出</span> $X$-<span lang=\"zh\">概形的映射</span> $Y \\to \\overline{Y}$.</p>\n<h2><span lang=\"zh\">性质</span></h2>\n<p><strong><span lang=\"zh\">命题</span></strong>. <span lang=\"zh\">设</span> $i\\colon Y\\to X$ <span lang=\"zh\">是</span>"},{"Local":{"url":"/拟紧态射","text":"<span lang=\"zh\">拟紧</span>"}},{"Plain":"<span lang=\"zh\">的</span>"},{"Local":{"url":"/局部闭嵌入","text":"<span lang=\"zh\">局部闭嵌入</span>"}},{"Plain":", <span lang=\"zh\">则</span> $Y\\to \\overline{Y}$ <span lang=\"zh\">是开嵌入</span>.</p>\n<p><em><span lang=\"zh\">证明</span></em>. <span lang=\"zh\">设</span> $i \\colon Y\\to X$ <span lang=\"zh\">是一个</span>"},{"Local":{"url":"/闭嵌入","text":"<span lang=\"zh\">闭嵌入</span>"}},{"Plain":" $i'\\colon Y\\to U$ <span lang=\"zh\">后接一个开嵌入</span> $U\\to X$.</p>\n<p><span lang=\"zh\">因为</span> $U\\to X$ <span lang=\"zh\">为开嵌入</span>, <span lang=\"zh\">所以</span> $(i_*\\mathcal O_Y)|_U = i'_*\\mathcal O_Y$.</p>\n<p><span lang=\"zh\">因为</span> $i'_*$ <span lang=\"zh\">为闭嵌入</span>, $\\mathcal O_U \\to i'_*\\mathcal O_Y$ <span lang=\"zh\">为</span> (<span lang=\"zh\">集合值层的</span>) <span lang=\"zh\">满射</span>. <span lang=\"zh\">又</span> $\\ker (\\mathcal O_U \\to i'_*\\mathcal O_Y) = \\ker (\\mathcal O_X \\to i_*\\mathcal O_Y)|_U = \\mathcal I|_U$,\n<span lang=\"zh\">故</span>\n$$\r\ni'_*\\mathcal O_Y=\\mathcal O_U / \\mathcal I|_U= (\\mathcal O_X /\\mathcal I)|_U.\r\n$$\n<span lang=\"zh\">那么</span>\n$$\r\n\\begin{aligned}\r\n\\overline{Y}\\times_X U\r\n&amp;\\simeq\\operatorname{Spec}_U ((\\mathcal O_X /\\mathcal I)|_U)\\\\\r\n&amp;\\simeq\\operatorname{Spec}_U (i'_*\\mathcal O_Y)\\\\\r\n&amp;\\simeq Y.\r\n\\end{aligned}\r\n$$\n<span lang=\"zh\">因此</span> $Y\\to\\overline{Y}$ <span lang=\"zh\">是</span> $U\\to X$ <span lang=\"zh\">的</span>"},{"Local":{"url":"/基变换","text":"<span lang=\"zh\">基变换</span>"}},{"Plain":", <span lang=\"zh\">从而是开嵌入</span>.</p>\n"}]}}}]}