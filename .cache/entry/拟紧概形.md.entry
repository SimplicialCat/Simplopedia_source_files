{"metadata":{"author":[{"Lazy":[{"Local":{"url":"SimplicialCat","text":"SimplicialCat"}}]},5],"subject":[{"Lazy":[{"Local":{"url":"代数几何","text":"代数几何"}}]},3],"slug":[{"Plain":"拟紧概形"},0],"title":[{"Plain":"拟紧概形"},2],"ext":[{"Plain":"md"},1],"tag":[{"Plain":"百科"},4]},"content":{"Lazy":[{"Plain":"\n<h2>定义</h2>\n<p>对于"},{"Local":{"url":"概形","text":"概形"}},{"Plain":" $X$, 若以下等价条件成立, 则称之为<strong>拟紧</strong>概形:</p>\n<ul>\n<li>$X$ 的底层拓扑空间满足任何开覆盖有有限子覆盖;</li>\n<li>$X$ 具有一个有限的仿射开覆盖.</li>\n</ul>\n<p>拟紧概形的"},{"Local":{"url":"相对","text":"相对"}},{"Plain":"版本是"},{"Local":{"url":"拟紧态射","text":"拟紧态射"}},{"Plain":".</p>\n"}]}}