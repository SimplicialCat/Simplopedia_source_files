{"sections":[{"slug":"景的态射","section":{"metadata":{"slug":{"Plain":"景的态射"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">景的态射</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"景的态射"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<p><span lang=\"zh\">景的态射</span> $f\\colon (\\mathcal C,J) \\to (\\mathcal D,K)$ <span lang=\"zh\">是诱导</span>"},{"Local":{"url":"/意象","text":"<span lang=\"zh\">意象</span>"}},{"Plain":"<span lang=\"zh\">之间的</span>"},{"Local":{"url":"/几何态射","text":"<span lang=\"zh\">几何态射</span>"}},{"Plain":"\n$$\r\nf\\colon \\operatorname{Sh}(\\mathcal D,K) \\to \\operatorname{Sh}(\\mathcal C,J)\r\n$$\n<span lang=\"zh\">的函子</span> $f\\colon \\mathcal C\\to\\mathcal D$.</p>\n<p><span lang=\"zh\">注意这个态射的方向和</span> $f\\colon \\mathcal C\\to\\mathcal D$ <span lang=\"zh\">的方向相反</span>.</p>\n<p>(todo)</p>\n"}]}}}]}