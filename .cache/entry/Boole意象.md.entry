{"sections":[{"slug":"Boole意象","section":{"metadata":{"slug":{"Plain":"Boole意象"},"ext":{"Plain":"md"},"title":{"Plain":"“Boole <span lang=\"zh\">意象</span>”"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"“Boole 意象”"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">定义</span></h2>\n<p><span lang=\"zh\">若</span>"},{"Local":{"url":"/意象","text":"<span lang=\"zh\">意象</span>"}},{"Plain":" $\\mathcal E$ <span lang=\"zh\">中的内蕴</span> "},{"Local":{"url":"/Heyting代数","text":"Heyting <span lang=\"zh\">代数</span>"}},{"Plain":" $\\Omega$ (<span lang=\"zh\">即</span>"},{"Local":{"url":"/子对象分类子","text":"<span lang=\"zh\">子对象分类子</span>"}},{"Plain":") <span lang=\"zh\">实为内蕴</span> Bool <span lang=\"zh\">代数</span>, <span lang=\"zh\">则称其为</span> Bool <span lang=\"zh\">意象</span>.</p>\n<p><strong><span lang=\"zh\">命题</span></strong>. <span lang=\"zh\">对于意象</span> $\\mathcal E$, <span lang=\"zh\">下列条件等价</span>.</p>\n<ul>\n<li>$\\mathcal E$ <span lang=\"zh\">为</span> Bool <span lang=\"zh\">意象</span>;</li>\n<li>"},{"Local":{"url":"/否定","text":"<span lang=\"zh\">否定</span>"}},{"Plain":"<span lang=\"zh\">算子</span> $\\neg\\colon \\Omega\\to\\Omega$ <span lang=\"zh\">满足</span> $\\neg\\neg = \\operatorname{id}$;</li>\n<li><span lang=\"zh\">对任意对象</span> $E\\in\\mathcal E$, "},{"Local":{"url":"/Heyting代数","text":"Heyting <span lang=\"zh\">代数</span>"}},{"Plain":" $\\operatorname{Sub}(E)$ <span lang=\"zh\">实为</span> "},{"Local":{"url":"/Boole代数","text":"Boole <span lang=\"zh\">代数</span>"}},{"Plain":";</li>\n<li><span lang=\"zh\">对任意子对象</span> $S\\rightarrowtail E$, <span lang=\"zh\">有</span> $\\neg S \\vee S = E$;</li>\n<li><span lang=\"zh\">态射</span> $\\text{true}\\colon 1\\to\\Omega$ <span lang=\"zh\">和</span> $\\text{false}=\\neg\\circ \\text{true}$ <span lang=\"zh\">给出同构</span> $1+1\\simeq \\Omega$.</li>\n</ul>\n"}]}}}]}