{"sections":[{"slug":"Schur引理","section":{"metadata":{"slug":{"Plain":"Schur引理"},"ext":{"Plain":"md"},"title":{"Plain":"Schur <span lang=\"zh\">引理</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"Schur 引理"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">陈述</span></h2>\n<p><span lang=\"zh\">设</span> $X,Y$ <span lang=\"zh\">为</span> "},{"Local":{"url":"/Abel范畴","text":"Abel <span lang=\"zh\">范畴</span>"}},{"Plain":" $\\mathcal C$ <span lang=\"zh\">中的</span>"},{"Local":{"url":"/单对象","text":"<span lang=\"zh\">单对象</span>"}},{"Plain":", <span lang=\"zh\">则</span></p>\n<ul>\n<li><span lang=\"zh\">任一态射</span> $X \\to Y$ <span lang=\"zh\">为同构或</span> $0$;</li>\n<li>$X$ <span lang=\"zh\">的自同构环</span> $\\operatorname{End}(X)$ <span lang=\"zh\">为除环</span>.</li>\n</ul>\n"}]}}}]}