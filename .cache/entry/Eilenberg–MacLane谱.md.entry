{"sections":[{"slug":"Eilenberg–MacLane谱","section":{"metadata":{"slug":{"Plain":"Eilenberg–MacLane谱"},"ext":{"Plain":"md"},"title":{"Plain":"Eilenberg–MacLane <span lang=\"zh\">谱</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"Eilenberg–MacLane 谱"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<p><span lang=\"zh\">对于</span> Abel <span lang=\"zh\">群</span> $A$, <span lang=\"zh\">其</span> Eilenberg–MacLane <span lang=\"zh\">谱</span> $HA$ <span lang=\"zh\">为表示</span> $A$-<span lang=\"zh\">系数上同调的谱</span>.</p>\n<p>"},{"Local":{"url":"/连合谱","text":"<span lang=\"zh\">连合谱</span>"}},{"Plain":"<span lang=\"zh\">等同于</span> "},{"Local":{"url":"/Abel∞-群","text":"Abel ∞-<span lang=\"zh\">群</span>"}},{"Plain":", <span lang=\"zh\">在此对应下</span> $HA$ <span lang=\"zh\">对应</span> Abel <span lang=\"zh\">群</span> $A$ <span lang=\"zh\">自身</span>.</p>\n<h2><span lang=\"zh\">相关概念</span></h2>\n<p>"},{"Local":{"url":"/t-结构","text":"t-<span lang=\"zh\">结构</span>"}},{"Plain":"</p>\n"}]}}}]}