{"sections":[{"slug":"拉直","section":{"metadata":{"slug":{"Plain":"拉直"},"ext":{"Plain":"md"},"title":{"Plain":"“<span lang=\"zh\">拉直</span>”"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"“拉直”"},"data-taxon":{"Plain":"百科"}},"content":{"Plain":"\n<p>Lurie</p>\n<blockquote>\n<p>$G$-<span lang=\"zh\">主丛</span> $V \\to X$ <span lang=\"zh\">与</span> $X \\to BG$ <span lang=\"zh\">的对应是一种拉直</span>–<span lang=\"zh\">还原</span>. <span lang=\"zh\">将映射</span> $X\\to BG$ <span lang=\"zh\">理解为</span> $X$ <span lang=\"zh\">到拓扑空间范畴的函子</span>, <span lang=\"zh\">那么其拉直即为</span> $V \\to X$. (<span lang=\"zh\">来自单纯群网友</span>)</p>\n</blockquote>\n"}}}]}