{"sections":[{"slug":"相对射影谱","section":{"metadata":{"slug":{"Plain":"相对射影谱"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">相对射影谱</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"subject":{"Lazy":[{"Local":{"url":"/代数几何","text":"<span lang=\"zh\">代数几何</span>"}}]},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"相对射影谱"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">观念</span></h2>\n<p><span lang=\"zh\">相对射影谱是</span>"},{"Local":{"url":"/射影谱","text":"<span lang=\"zh\">射影谱</span>"}},{"Plain":"<span lang=\"zh\">的</span>"},{"Local":{"url":"/相对","text":"<span lang=\"zh\">相对</span>"}},{"Plain":"<span lang=\"zh\">版本</span>.</p>\n<h2><span lang=\"zh\">定义</span></h2>\n<p><span lang=\"zh\">设</span> $S$ <span lang=\"zh\">是</span>"},{"Local":{"url":"/概形","text":"<span lang=\"zh\">概形</span>"}},{"Plain":" $Y$ <span lang=\"zh\">上的</span>"},{"Local":{"url":"/拟凝聚层","text":"<span lang=\"zh\">拟凝聚</span>"}},{"Plain":" $\\mathbb{Z}_{\\geq 0}$-"},{"Local":{"url":"/分次代数","text":"<span lang=\"zh\">分次</span> $\\mathcal O_Y$-<span lang=\"zh\">代数</span>"}},{"Plain":". <span lang=\"zh\">定义其相对射影谱</span> $\\operatorname{Proj}_Y(S)$ <span lang=\"zh\">为</span> $Y$ <span lang=\"zh\">上的概形</span>, <span lang=\"zh\">使得对于仿射开集</span> $U\\subset Y$, $\\operatorname{Proj}_Y(S)|_U\\simeq\\operatorname{Proj}(S(U))$.</p>\n<h3><span lang=\"zh\">函子式</span></h3>\n<p><span lang=\"zh\">相对射影谱</span> $\\operatorname{Proj}(S)$ <span lang=\"zh\">表示的函子</span>\n$\\operatorname{Proj}(S) \\colon \\mathsf{Sch}_{/Y}^{\\mathrm{op}} \\to \\mathsf{Set}$ <span lang=\"zh\">为</span>\n$$\r\n(p\\colon X\\to Y) \\mapsto \\{(L\\colon X\\,\\text{上的线丛},\\psi\\colon p^*S \\twoheadrightarrow \\operatorname{Sym}_{\\mathcal O_X}L)\\}/\\text{同构}.\r\n$$\n<span lang=\"zh\">注意</span> $\\psi\\colon p^*S \\twoheadrightarrow \\operatorname{Sym}_{\\mathcal O_X}L$ <span lang=\"zh\">为满射等价于</span> $\\psi_1\\colon S_1\\to L$ <span lang=\"zh\">为满射</span>.</p>\n<h2><span lang=\"zh\">性质</span></h2>\n<h3><span lang=\"zh\">基变换相容性</span></h3>\n<p><strong><span lang=\"zh\">命题</span></strong>. <span lang=\"zh\">设</span> $f\\colon Y' \\to Y$ <span lang=\"zh\">为概形映射</span>, <span lang=\"zh\">则有</span>\n$$\r\n\\operatorname{Proj}_Y(S)\\otimes_Y Y' \\simeq\\operatorname{Proj}_{Y'}(f^*S).\r\n$$</p>\n<h2><span lang=\"zh\">例</span></h2>\n<p><span lang=\"zh\">概形</span> $X$ <span lang=\"zh\">上</span>"},{"Local":{"url":"/线丛","text":"<span lang=\"zh\">线丛</span>"}},{"Plain":"<span lang=\"zh\">的相对射影谱就是</span> $X$ <span lang=\"zh\">自身</span>.</p>\n<p><span lang=\"zh\">对于</span>"},{"Local":{"url":"/向量丛","text":"<span lang=\"zh\">向量丛</span>"}},{"Plain":" $E$, $\\operatorname{Proj}\\operatorname{Sym}_{\\mathcal O_X}E = P(E)$ <span lang=\"zh\">是其</span>"},{"Local":{"url":"/射影丛","text":"<span lang=\"zh\">射影丛</span>"}},{"Plain":".</p>\n"}]}}}]}