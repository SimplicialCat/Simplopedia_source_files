{"metadata":{"ext":[{"Plain":"md"},1],"slug":[{"Plain":"Weyl张量"},0],"title":[{"Plain":"“Weyl 张量”"},2],"tag":[{"Plain":"百科"},3],"author":[{"Lazy":[{"Local":{"url":"SimplicialCat","text":"SimplicialCat"}}]},4]},"content":{"Lazy":[{"Plain":"\n<h2>临界点</h2>\n<p>在 $4$ 维情形, "},{"Local":{"url":"Kähler--Einstein度量","text":"Kähler–Einstein 度量"}},{"Plain":"包含于泛函\n$$\r\n\\int_M |W|^2 \\, dV\r\n$$\n的临界点.</p>\n"}]}}