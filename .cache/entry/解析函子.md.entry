{"sections":[{"slug":"解析函子","section":{"metadata":{"slug":{"Plain":"解析函子"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">解析函子</span> (<span lang=\"zh\">算畴理论</span>)"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"解析函子 (算畴理论)"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<p><strong><span lang=\"zh\">解析函子</span></strong><span lang=\"zh\">是解析函数</span> (<span lang=\"zh\">形式幂级数</span>) <span lang=\"zh\">的</span>"},{"Local":{"url":"/范畴化","text":"<span lang=\"zh\">范畴化</span>"}},{"Plain":", <span lang=\"zh\">有多个不同场合的相互关联的概念</span>.</p>\n<p><span lang=\"zh\">注意这个概念不同于</span> "},{"Local":{"url":"/Goodwillie演算","text":"Goodwillie <span lang=\"zh\">演算</span>"}},{"Plain":"<span lang=\"zh\">中的</span>"},{"Local":{"url":"/解析函子(Goodwillie)","text":"<span lang=\"zh\">解析函子</span>"}},{"Plain":".</p>\n<h2><span lang=\"zh\">定义</span></h2>\n<h2><span lang=\"zh\">性质</span></h2>\n<h3><span lang=\"zh\">与多项式函子的关系</span></h3>\n<p><span lang=\"zh\">见</span>"},{"Local":{"url":"/多项式函子","text":"<span lang=\"zh\">多项式函子</span>"}},{"Plain":".</p>\n"}]}}}]}