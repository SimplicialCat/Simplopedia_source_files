{"metadata":{"tag":[{"Plain":"百科"},3],"ext":[{"Plain":"md"},1],"author":[{"Lazy":[{"Local":{"url":"SimplicialCat","text":"SimplicialCat"}}]},4],"slug":[{"Plain":"分离几何态射"},0],"title":[{"Plain":"“分离几何态射”"},2]},"content":{"Lazy":[{"Plain":"\n<p>称"},{"Local":{"url":"意象","text":"意象"}},{"Plain":"之间的几何态射 $f\\colon X\\to Y$ 分离, 是指 $X\\to X\\times_Y X$ 为"},{"Local":{"url":"紧合几何态射","text":"紧合几何态射"}},{"Plain":".</p>\n"}]}}