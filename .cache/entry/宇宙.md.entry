{"sections":[{"slug":"宇宙","section":{"metadata":{"slug":{"Plain":"宇宙"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">宇宙</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"subejct":{"Lazy":[{"Local":{"url":"/类型论","text":"<span lang=\"zh\">类型论</span>"}}]},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"宇宙"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<p><span lang=\"zh\">在</span>"},{"Local":{"url":"/类型论","text":"<span lang=\"zh\">类型论</span>"}},{"Plain":"<span lang=\"zh\">中</span>, <span lang=\"zh\">每个类型都是某个类型</span> $\\mathcal U$ <span lang=\"zh\">的元素</span>, <span lang=\"zh\">称这种类型</span> $\\mathcal U$ <span lang=\"zh\">为</span><strong><span lang=\"zh\">宇宙</span></strong>.</p>\n<p><span lang=\"zh\">一个宇宙</span><strong><span lang=\"zh\">不是</span></strong><span lang=\"zh\">自身的元素</span>, <span lang=\"zh\">而是更上一层的宇宙的元素</span>.</p>\n"}]}}}]}