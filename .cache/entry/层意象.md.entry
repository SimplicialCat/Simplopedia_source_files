{"sections":[{"slug":"层意象","section":{"metadata":{"slug":{"Plain":"层意象"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">层意象</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"层意象"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<p><span lang=\"zh\">层意象是</span>"},{"Local":{"url":"/景","text":"<span lang=\"zh\">景</span>"}},{"Plain":"<span lang=\"zh\">上的</span>"},{"Local":{"url":"/景上的层","text":"<span lang=\"zh\">层</span>"}},{"Plain":"<span lang=\"zh\">构成的</span>"},{"Local":{"url":"/意象","text":"<span lang=\"zh\">意象</span>"}},{"Plain":", <span lang=\"zh\">也即由</span>"},{"Local":{"url":"/景","text":"<span lang=\"zh\">景</span>"}},{"Plain":"<span lang=\"zh\">所</span>"},{"Local":{"url":"/数学对象的表现","text":"<span lang=\"zh\">表现</span>"}},{"Plain":"<span lang=\"zh\">的</span>"},{"Local":{"url":"/意象","text":"<span lang=\"zh\">意象</span>"}},{"Plain":".</p>\n<p><span lang=\"zh\">几何对象</span> (<span lang=\"zh\">如拓扑空间</span>, <span lang=\"zh\">代数簇</span>, <span lang=\"zh\">概形</span>) <span lang=\"zh\">上的层意象可视为几何对象在意象范畴中的化身</span>.</p>\n<p><span lang=\"zh\">层意象的</span>"},{"Local":{"url":"/意象的内语言","text":"<span lang=\"zh\">内语言</span>"}},{"Plain":"<span lang=\"zh\">具有</span>"},{"Local":{"url":"/层语义","text":"<span lang=\"zh\">层语义</span>"}},{"Plain":".</p>\n"}]}}}]}