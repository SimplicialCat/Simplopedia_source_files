{"sections":[{"slug":"约化Lie代数","section":{"metadata":{"slug":{"Plain":"约化Lie代数"},"ext":{"Plain":"md"},"title":{"Plain":"“<span lang=\"zh\">约化</span> Lie <span lang=\"zh\">代数</span>”"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"“约化 Lie 代数”"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<p><span lang=\"zh\">约化</span> Lie <span lang=\"zh\">代数</span> (reductive Lie algebras) <span lang=\"zh\">是指</span>"},{"Local":{"url":"/伴随表示","text":"<span lang=\"zh\">伴随表示</span>"}},{"Plain":"<span lang=\"zh\">完全可约的</span> Lie <span lang=\"zh\">代数</span>. $\\mathfrak g$ <span lang=\"zh\">是约化</span> Lie <span lang=\"zh\">代数的性质等价于</span></p>\n<ul>\n<li>$\\mathfrak g$ <span lang=\"zh\">是一个</span>"},{"Local":{"url":"/半单Lie代数","text":"<span lang=\"zh\">半单</span> Lie <span lang=\"zh\">代数</span>"}},{"Plain":"<span lang=\"zh\">与一个</span> Abel Lie <span lang=\"zh\">代数的直和</span>;</li>\n<li>$\\mathfrak g$ <span lang=\"zh\">的根</span> (radical) $\\mathfrak r(\\mathfrak g)$ <span lang=\"zh\">等于其中心</span> $\\mathfrak z(\\mathfrak g)$ (<span lang=\"zh\">根总是包含中心</span>); …</li>\n</ul>\n"}]}}}]}