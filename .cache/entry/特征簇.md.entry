{"sections":[{"slug":"特征簇","section":{"metadata":{"slug":{"Plain":"特征簇"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">特征簇</span> (<span lang=\"zh\">微分算子</span>)"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"特征簇 (微分算子)"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">观念</span></h2>\n<p>"},{"Local":{"url":"/线性微分算子","text":"<span lang=\"zh\">线性微分算子</span>"}},{"Plain":"<span lang=\"zh\">的</span><strong><span lang=\"zh\">特征簇</span></strong> (characteristic variety) $\\operatorname{Ch}(M)$ <span lang=\"zh\">是其</span>"},{"Local":{"url":"/主象征","text":"<span lang=\"zh\">象征</span>"}},{"Plain":"<span lang=\"zh\">的零点集</span>; <span lang=\"zh\">有时特征簇也成为</span><strong><span lang=\"zh\">奇异支集</span></strong> (singular support), <span lang=\"zh\">记为</span> $\\operatorname{SS}(M)$. <span lang=\"zh\">特征簇起源于</span>"},{"Local":{"url":"/微局部分析","text":"<span lang=\"zh\">微局部分析</span>"}},{"Plain":".</p>\n<p><span lang=\"zh\">另见</span>"},{"Local":{"url":"/特征簇(群)","text":"<span lang=\"zh\">特征簇</span> (<span lang=\"zh\">群</span>)"}},{"Plain":".</p>\n<h2><span lang=\"zh\">定义</span></h2>\n<p><span lang=\"zh\">对于凝聚</span> $\\mathcal D_X$-<span lang=\"zh\">模</span> $M$, <span lang=\"zh\">其特征簇</span> $\\operatorname{ch}(M)\\subset T^*X$ <span lang=\"zh\">定义为</span> $M$ <span lang=\"zh\">的关联分次模</span> (<span lang=\"zh\">对于合适的滤过</span>) <span lang=\"zh\">的支集</span>. <span lang=\"zh\">例如</span>, <span lang=\"zh\">若</span> $M$ <span lang=\"zh\">为平坦联络</span>, <span lang=\"zh\">则</span> $\\operatorname{ch}(M)$ <span lang=\"zh\">为</span> $T^*X$ <span lang=\"zh\">的零截面</span>.</p>\n<p><span lang=\"zh\">常相位曲面</span> (constant phase surface)</p>\n<h2><span lang=\"zh\">例</span></h2>\n<p>$X=\\mathbb A^n$, $\\mathcal D_X$ <span lang=\"zh\">的全局截面是</span> "},{"Local":{"url":"/Weyl代数","text":"Weyl <span lang=\"zh\">代数</span>"}},{"Plain":", <span lang=\"zh\">其生成元为</span> $x_1,\\cdots,x_n,\\partial_1,\\cdots,\\partial_n$, <span lang=\"zh\">交换关系为</span> $[x_i,\\partial_j]=\\delta_{ij}$. <span lang=\"zh\">考虑微分算子阶数的滤过结构</span>, <span lang=\"zh\">则在</span>"},{"Local":{"url":"/关联分次代数","text":"<span lang=\"zh\">关联分次代数</span>"}},{"Plain":"<span lang=\"zh\">的层面上</span>, <span lang=\"zh\">所有</span> $x_i,\\partial_j$ <span lang=\"zh\">互相交换</span>: <span lang=\"zh\">我们得到的是</span> $T^*\\mathbb A^n$ <span lang=\"zh\">的坐标环</span>, <span lang=\"zh\">即</span> $2n$ <span lang=\"zh\">元多项式环</span>.</p>\n"}]}}}]}