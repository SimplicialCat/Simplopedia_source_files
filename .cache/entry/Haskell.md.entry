{"sections":[{"slug":"Haskell","section":{"metadata":{"slug":{"Plain":"Haskell"},"ext":{"Plain":"md"},"title":{"Plain":"“Haskell”"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"“Haskell”"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<p>Haskell <span lang=\"zh\">是一种</span>"},{"Local":{"url":"/函数式编程","text":"<span lang=\"zh\">函数式编程</span>"}},{"Plain":"<span lang=\"zh\">语言</span>.</p>\n<h2><span lang=\"zh\">下载与配置</span></h2>\n<p><span lang=\"zh\">下载</span>\nhttps://www.haskell.org/downloads/</p>\n<h2><span lang=\"zh\">例</span></h2>\n<p><code>:t (2+)  </code>(2+) :: Num a =&gt; a -&gt; a</p>\n<p><code>take 5 [1,4..]  </code>[1,4,7,10,13]</p>\n<p><code>f x y = x + y  </code>:t f\n`f :: Num a =&gt; a -&gt; a -&gt; a</p>\n<p><code>f x = x &lt; 3  </code>:t f\n`f :: (Ord a, Num a) =&gt; a -&gt; Bool</p>\n<p><code>g = (&lt;3)  </code>:t g\n`g :: (Ord a, Num a) =&gt; a -&gt; Bool</p>\n<p><code>f x y = (x == y)  </code>:t f\n`f :: Eq a =&gt; a -&gt; a -&gt; Bool</p>\n"}]}}}]}