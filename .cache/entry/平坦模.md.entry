{"sections":[{"slug":"平坦模","section":{"metadata":{"slug":{"Plain":"平坦模"},"ext":{"Plain":"md"},"title":{"Plain":"“<span lang=\"zh\">平坦模</span>”"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"“平坦模”"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">定义</span></h2>\n<p><span lang=\"zh\">根据</span> MO <span lang=\"zh\">上的一篇回答</span>,</p>\n<p>$A$-<span lang=\"zh\">模</span> $M$ <span lang=\"zh\">平坦当且仅当对任意理想</span> $I$,\n$$\r\nI\\otimes_A M \\to IM\r\n$$\n<span lang=\"zh\">为同构</span>. <span lang=\"zh\">其直观为</span>, $I$ <span lang=\"zh\">对应</span> $\\operatorname{spec}A$ <span lang=\"zh\">的</span>"},{"Local":{"url":"/闭嵌入","text":"<span lang=\"zh\">闭子概形</span>"}},{"Plain":" $\\operatorname{spec}(A/I)$,</p>\n"}]}}}]}