{"sections":[{"slug":"逆像","section":{"metadata":{"slug":{"Plain":"逆像"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">逆像</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"逆像"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<p><strong><span lang=\"zh\">逆像</span></strong> (inverse image) <span lang=\"zh\">是指</span>"},{"Local":{"url":"/意象","text":"<span lang=\"zh\">意象</span>"}},{"Plain":"<span lang=\"zh\">的</span>"},{"Local":{"url":"/几何态射","text":"<span lang=\"zh\">几何态射</span>"}},{"Plain":"<span lang=\"zh\">的左伴随部分</span>.</p>\n<h2><span lang=\"zh\">定义</span></h2>\n<p><span lang=\"zh\">对于</span>"},{"Local":{"url":"/景的态射","text":"<span lang=\"zh\">景的态射</span>"}},{"Plain":" $f\\colon (\\mathcal C,J) \\to (\\mathcal D,K)$, <span lang=\"zh\">定义</span> $(\\mathcal C,J)$ <span lang=\"zh\">上的层</span> $F$ <span lang=\"zh\">的逆像</span> $f^*F$ <span lang=\"zh\">为</span>\n$$\r\nf^*F(d) = \\operatorname{colim}_{f(c) \\to d} F(c),\r\n$$\n<span lang=\"zh\">也即沿</span> $f$ <span lang=\"zh\">的左</span> "},{"Local":{"url":"/Kan扩张","text":"Kan <span lang=\"zh\">扩张</span>"}},{"Plain":".</p>\n<h2><span lang=\"zh\">相关概念</span></h2>\n<p>"},{"Local":{"url":"/直像-逆像伴随","text":"<span lang=\"zh\">拓扑空间上的直像</span>-<span lang=\"zh\">逆像伴随</span>"}},{"Plain":"</p>\n"}]}}}]}