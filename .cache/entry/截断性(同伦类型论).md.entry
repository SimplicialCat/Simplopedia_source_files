{"sections":[{"slug":"截断性(同伦类型论)","section":{"metadata":{"slug":{"Plain":"截断性(同伦类型论)"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">截断性</span> (<span lang=\"zh\">同伦类型论</span>)"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"subject":{"Lazy":[{"Local":{"url":"/同伦类型论","text":"<span lang=\"zh\">同伦类型论</span>"}}]},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"截断性 (同伦类型论)"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">定义</span></h2>\n<p><span lang=\"zh\">在同伦类型论中</span>, "},{"Local":{"url":"/归纳类型","text":"<span lang=\"zh\">归纳</span>"}},{"Plain":"<span lang=\"zh\">定义类型</span> $A$ <span lang=\"zh\">上的谓词</span>\n$$\r\n\\mathsf{Is}\\text{-}n\\text{-}\\mathsf{Type}(A):=\r\n\\begin{cases}\r\n    \\mathsf{IsContr} (A) &amp; n=-2\\\\\r\n    \\prod_{x,y\\colon A}\\mathsf{Is}\\text{-}(n-1)\\text{-}\\mathsf{Type}(x=_A y) &amp; n&gt;-2.\r\n\\end{cases}\r\n$$</p>\n"}]}}}]}