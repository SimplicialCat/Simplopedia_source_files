{"sections":[{"slug":"双代数","section":{"metadata":{"slug":{"Plain":"双代数"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">双代数</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"双代数"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">定义</span></h2>\n<p>"},{"Local":{"url":"/幺半范畴","text":"<span lang=\"zh\">幺半范畴</span>"}},{"Plain":" $\\mathcal C$ <span lang=\"zh\">中的双代数是其</span>"},{"Local":{"url":"/结合代数","text":"<span lang=\"zh\">结合代数</span>"}},{"Plain":"<span lang=\"zh\">范畴中的</span>"},{"Local":{"url":"/结合余代数","text":"<span lang=\"zh\">结合余代数</span>"}},{"Plain":", <span lang=\"zh\">也是其</span>"},{"Local":{"url":"/结合余代数","text":"<span lang=\"zh\">结合余代数</span>"}},{"Plain":"<span lang=\"zh\">范畴中的</span>"},{"Local":{"url":"/结合代数","text":"<span lang=\"zh\">结合代数</span>"}},{"Plain":".</p>\n<h3><span lang=\"zh\">传统定义</span></h3>\n<p>"},{"Local":{"url":"/对称幺半范畴","text":"<span lang=\"zh\">对称幺半</span> $1$-<span lang=\"zh\">范畴</span>"}},{"Plain":"<span lang=\"zh\">中的</span><strong><span lang=\"zh\">双代数</span></strong> (bialgebra) $(A,m,\\eta,\\epsilon,\\Delta)$ <span lang=\"zh\">是对象</span> $A$ <span lang=\"zh\">配备如下资料</span>,</p>\n<ul>\n<li><span lang=\"zh\">乘法</span> $m\\colon A\\otimes A \\to A$,</li>\n<li><span lang=\"zh\">单位</span> $\\eta\\colon 1 \\to A$ ($1$ <span lang=\"zh\">为幺半范畴的单位</span>),</li>\n<li><span lang=\"zh\">余单位</span> $\\epsilon\\colon A\\to 1$,</li>\n<li><span lang=\"zh\">余乘法</span> $\\Delta\\colon A\\to A\\otimes A$,</li>\n</ul>\n<p><span lang=\"zh\">满足</span></p>\n<ul>\n<li>$(A,m,\\eta)$ <span lang=\"zh\">为</span>"},{"Local":{"url":"/结合代数","text":"<span lang=\"zh\">结合代数</span>"}},{"Plain":",</li>\n<li>$(A,\\Delta,\\epsilon)$ <span lang=\"zh\">为</span>"},{"Local":{"url":"/结合余代数","text":"<span lang=\"zh\">结合余代数</span>"}},{"Plain":",</li>\n<li>$\\Delta,\\epsilon$ <span lang=\"zh\">均为结合代数的同态</span>,</li>\n<li>$m,\\eta$ <span lang=\"zh\">均为结合余代数的同态</span>.</li>\n</ul>\n<h2><span lang=\"zh\">性质</span></h2>\n<h3><span lang=\"zh\">模范畴</span></h3>\n<p>"},{"Local":{"url":"/对称幺半范畴","text":"<span lang=\"zh\">对称幺半范畴</span>"}},{"Plain":" $\\mathcal C$ <span lang=\"zh\">中</span>, <span lang=\"zh\">双代数</span> $A$ <span lang=\"zh\">上的</span> (<span lang=\"zh\">左</span>) <span lang=\"zh\">模范畴具有</span>"},{"Local":{"url":"/幺半范畴","text":"<span lang=\"zh\">幺半范畴</span>"}},{"Plain":"<span lang=\"zh\">结构</span>, <span lang=\"zh\">两个</span> $A$-<span lang=\"zh\">模的张量积上的</span> $A$-<span lang=\"zh\">模结构为</span>\n$$\r\n\\begin{aligned}\r\nA\\otimes M\\otimes N &amp;\\overset{\\Delta}{\\to} A\\otimes A\\otimes M \\otimes N \\\\&amp;\\to A\\otimes M\\otimes A\\otimes N \\\\&amp;\\to  M\\otimes N.\r\n\\end{aligned}\r\n$$\n<span lang=\"zh\">抽象地看</span>, <span lang=\"zh\">这是由于</span> $\\mathsf{Mod}(-)\\colon \\mathsf{Alg}^{\\mathrm{op}} \\to \\mathsf{Cat}$ <span lang=\"zh\">为</span>"},{"Local":{"url":"/松幺半函子","text":"<span lang=\"zh\">松幺半函子</span>"}},{"Plain":", <span lang=\"zh\">故将</span> $\\mathsf{Alg}^{\\mathrm{op}}$ <span lang=\"zh\">中的代数</span> $A$ <span lang=\"zh\">变为</span> $\\mathsf{Cat}$ <span lang=\"zh\">中的代数</span>; $\\mathsf{Mod}(A)$ <span lang=\"zh\">上的幺半结构为</span>\n$$\r\n\\mathsf{Mod}(A)\\times\\mathsf{Mod}(A)\\overset{\\otimes}{\\to}\\mathsf{Mod}(A\\otimes A) \\overset{\\Delta^*}{\\to}\\mathsf{Mod}(A).\r\n$$</p>\n"}]}}}]}