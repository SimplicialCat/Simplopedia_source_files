{"sections":[{"slug":"Leray谱序列","section":{"metadata":{"slug":{"Plain":"Leray谱序列"},"ext":{"Plain":"md"},"title":{"Plain":"Leray <span lang=\"zh\">谱序列</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"Leray 谱序列"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">观念</span></h2>\n<p><span lang=\"zh\">设</span>\n$$\r\nf = (f^*\\dashv f_*)\\colon \\mathcal Y \\to \\mathcal X\r\n$$\n<span lang=\"zh\">为</span> "},{"Local":{"url":"/∞-意象","text":"$\\infty$-<span lang=\"zh\">意象</span>"}},{"Plain":"<span lang=\"zh\">之间的</span>"},{"Local":{"url":"/几何态射","text":"<span lang=\"zh\">几何态射</span>"}},{"Plain":", <span lang=\"zh\">记</span> $\\Gamma_{\\mathcal X}$ <span lang=\"zh\">为</span> $\\mathcal X \\to\\mathsf{Ani}$ <span lang=\"zh\">的直像部分</span>, <span lang=\"zh\">即</span>"},{"Local":{"url":"/整体截面","text":"<span lang=\"zh\">整体截面</span>"}},{"Plain":". <span lang=\"zh\">那么</span>\n$$\r\n    \\Gamma_{\\mathcal Y} = \\Gamma_{\\mathcal X}\\circ f_*.\r\n$$</p>\n<p><span lang=\"zh\">设</span> $F\\in\\mathsf{Sp}(\\mathcal Y)$ <span lang=\"zh\">为</span> $\\mathcal Y$ <span lang=\"zh\">的</span>"},{"Local":{"url":"/稳定化","text":"<span lang=\"zh\">稳定化</span>"}},{"Plain":"<span lang=\"zh\">的对象</span>. <span lang=\"zh\">考虑</span> $\\mathsf{Sp}(\\mathcal X)$ <span lang=\"zh\">的标准</span> "},{"Local":{"url":"/t-结构","text":"t-<span lang=\"zh\">结构</span>"}},{"Plain":"<span lang=\"zh\">给出的</span> $f_* F$ <span lang=\"zh\">的</span> "},{"Local":{"url":"/Postnikov塔","text":"Postnikov <span lang=\"zh\">滤</span>"}},{"Plain":", <span lang=\"zh\">再以</span> $\\Gamma_{\\mathcal X}$ <span lang=\"zh\">作用得到一个</span>"},{"Local":{"url":"/滤过","text":"<span lang=\"zh\">滤过</span>"}},{"Local":{"url":"/谱","text":"<span lang=\"zh\">谱</span>"}},{"Plain":"\n$$\r\n\\cdots\\to\r\n\\Gamma_{\\mathcal X}(\\tau_{\\leq q-1}f_*F)\r\n\\to\r\n\\Gamma_{\\mathcal X}(\\tau_{\\leq q}f_*F)\r\n\\to\\cdots.\r\n$$\n<span lang=\"zh\">这个滤过谱对应的</span>"},{"Local":{"url":"/滤对象的谱序列","text":"<span lang=\"zh\">谱序列</span>"}},{"Plain":"<span lang=\"zh\">称为</span> <strong>Leray <span lang=\"zh\">谱序列</span></strong>.</p>\n"}]}}}]}