{"sections":[{"slug":"+构造","section":{"metadata":{"slug":{"Plain":"+构造"},"ext":{"Plain":"md"},"title":{"Plain":"<ul>\n<li><span lang=\"zh\">构造</span></li>\n</ul>\n"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"\n构造\n\n"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<p>“+ <span lang=\"zh\">构造</span>” <span lang=\"zh\">是预层范畴的一个自函子</span>, <span lang=\"zh\">可用于</span>"},{"Local":{"url":"/层化","text":"<span lang=\"zh\">层化</span>"}},{"Plain":".</p>\n<h2><span lang=\"zh\">定义</span></h2>\n<p><span lang=\"zh\">设</span> $(C,J)$ <span lang=\"zh\">为</span>"},{"Local":{"url":"/景","text":"<span lang=\"zh\">景</span>"}},{"Plain":", <span lang=\"zh\">其上的</span> “+ <span lang=\"zh\">构造</span>” <span lang=\"zh\">可等价地定义如下</span>:</p>\n<ul>\n<li>$A^+(U) = \\operatorname{colim}_{S\\to \\mathbf y(U)}\\operatorname{Hom}(S,A)$, <span lang=\"zh\">其中</span> $S\\to\\mathbf y(U)$ <span lang=\"zh\">为覆盖筛</span>;</li>\n<li>$A^+ = r_!s_* A$, <span lang=\"zh\">其中</span> $r\\colon J\\to C$ <span lang=\"zh\">是覆盖</span> $\\mathrm {Cov}\\colon C^{\\mathrm {op}}\\to\\mathsf {Poset}$ <span lang=\"zh\">的</span> "},{"Local":{"url":"/Grothendieck构造","text":"Grothendieck <span lang=\"zh\">构造</span>"}},{"Plain":", $s\\colon C\\to J$ <span lang=\"zh\">是取每个对象的极大筛</span>.</li>\n</ul>\n<p><span lang=\"zh\">由定义</span>, <span lang=\"zh\">存在典范的映射</span> $A \\to A^+$.</p>\n<h2><span lang=\"zh\">性质</span></h2>\n"}]}}}]}