{"sections":[{"slug":"Postnikov塔","section":{"metadata":{"slug":{"Plain":"Postnikov塔"},"ext":{"Plain":"md"},"title":{"Plain":"Postnikov <span lang=\"zh\">塔</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"Postnikov 塔"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">定义</span></h2>\n<p>"},{"Local":{"url":"/生象","text":"<span lang=\"zh\">生象</span>"}},{"Plain":" (<span lang=\"zh\">或一般的</span> "},{"Local":{"url":"/∞-意象","text":"$\\infty$-<span lang=\"zh\">意象</span>"}},{"Plain":"<span lang=\"zh\">的对象</span>) $X$ <span lang=\"zh\">的</span> <strong>Postnikov <span lang=\"zh\">塔</span></strong><span lang=\"zh\">是对</span> $X$ <span lang=\"zh\">逐级</span>"},{"Local":{"url":"/截断性","text":"<span lang=\"zh\">截断</span>"}},{"Plain":"<span lang=\"zh\">所得的滤</span>\n$$\r\n\\cdots \\to \\tau_{\\leq 1} X \\to \\tau_{\\leq 0} X \\to \\tau_{\\leq -1} X \\to \\tau_{\\leq -2} X = *.\r\n$$</p>\n<h2><span lang=\"zh\">性质</span></h2>\n<h3><span lang=\"zh\">纤维</span></h3>\n<p><span lang=\"zh\">对于</span> $n\\geq 1$, <span lang=\"zh\">映射</span> $\\tau_{\\leq n} X \\to \\tau_{\\leq n-1} X$ <span lang=\"zh\">的纤维为</span> "},{"Local":{"url":"/Eilenberg–MacLane空间","text":"Eilenberg–MacLane <span lang=\"zh\">空间</span>"}},{"Plain":" $K(\\pi_n(X),n)$.</p>\n<p><span lang=\"zh\">在一般的</span>"},{"Local":{"url":"/∞-意象","text":"<span lang=\"zh\">意象</span>"}},{"Plain":" $\\mathcal C$ <span lang=\"zh\">中</span>, Postnikov <span lang=\"zh\">塔中的映射</span> $\\tau_{\\leq n} X \\to \\tau_{\\leq n-1} X$ <span lang=\"zh\">是</span>"},{"Local":{"url":"/俯意象","text":"<span lang=\"zh\">俯意象</span>"}},{"Plain":" $\\mathcal C_{/ \\tau_{\\leq n-1}X}$ <span lang=\"zh\">中的</span> $n$-<span lang=\"zh\">截断</span> $(n-1)$-<span lang=\"zh\">连通对象</span>, <span lang=\"zh\">即</span> $n$-"},{"Local":{"url":"/束","text":"<span lang=\"zh\">束</span>"}},{"Plain":".</p>\n<h2><span lang=\"zh\">相关概念</span>