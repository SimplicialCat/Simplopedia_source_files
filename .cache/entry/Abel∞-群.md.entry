{"sections":[{"slug":"Abel∞-群","section":{"metadata":{"slug":{"Plain":"Abel∞-群"},"ext":{"Plain":"md"},"title":{"Plain":"E∞-<span lang=\"zh\">群</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"E∞-群"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">观念</span></h2>\n<p>$\\mathbb E_{\\infty}$-<span lang=\"zh\">群又称</span> Abel $\\infty$-<span lang=\"zh\">群</span>, <span lang=\"zh\">是</span>"},{"Local":{"url":"/算畴","text":"<span lang=\"zh\">算畴</span>"}},{"Plain":" "},{"Local":{"url":"/E∞-算畴","text":"$\\mathbb E_\\infty$"}},{"Plain":"<span lang=\"zh\">上的</span>"},{"Local":{"url":"/算畴上的代数","text":"<span lang=\"zh\">代数</span>"}},{"Plain":".</p>\n<p><span lang=\"zh\">见</span> "},{"Local":{"url":"/En-代数","text":"$\\mathbb E_n$-<span lang=\"zh\">代数</span>"}},{"Plain":".</p>\n<h2><span lang=\"zh\">例</span></h2>\n<p>"},{"Local":{"url":"/对称幺半∞-范畴","text":"<span lang=\"zh\">对称幺半</span> ∞-<span lang=\"zh\">范畴</span>"}},{"Plain":"<span lang=\"zh\">的</span>"},{"Local":{"url":"/对象的生象","text":"<span lang=\"zh\">对象的生象</span>"}},{"Plain":"<span lang=\"zh\">具有</span> $\\mathbb E_\\infty$-<span lang=\"zh\">代数结构</span>.</p>\n<p><span lang=\"zh\">每个</span>"},{"Local":{"url":"/谱","text":"<span lang=\"zh\">谱</span>"}},{"Plain":"<span lang=\"zh\">通过函子</span> $\\Omega^\\infty$ <span lang=\"zh\">给出一个</span> $\\mathbb E_\\infty$-<span lang=\"zh\">群</span>, <span lang=\"zh\">直观上取出非负阶的同伦信息</span>.</p>\n<h2><span lang=\"zh\">相关概念</span></h2>\n<p>"},{"Local":{"url":"/连合谱","text":"<span lang=\"zh\">连合谱</span>"}},{"Plain":"</p>\n"}]}}}]}