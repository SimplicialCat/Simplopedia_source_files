{"sections":[{"slug":"环面码","section":{"metadata":{"slug":{"Plain":"环面码"},"ext":{"Plain":"md"},"title":{"Plain":"“<span lang=\"zh\">环面码</span>”"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"“环面码”"},"data-taxon":{"Plain":"百科"}},"content":{"Plain":"\n<blockquote>\n<p>The <strong>toric code</strong> is a canonical example of a system with topological order and <strong>anyonic excitations</strong>.</p>\n</blockquote>\n"}}}]}