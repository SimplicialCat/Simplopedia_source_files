{"sections":[{"slug":"Borel子群","section":{"metadata":{"slug":{"Plain":"Borel子群"},"ext":{"Plain":"md"},"title":{"Plain":"Borel <span lang=\"zh\">子群</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"Borel 子群"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<p>Borel <span lang=\"zh\">子群是</span> Lie <span lang=\"zh\">群</span> (<span lang=\"zh\">或代数群</span>) <span lang=\"zh\">极大的</span>"},{"Local":{"url":"/可解群","text":"<span lang=\"zh\">可解</span>"}},{"Plain":"<span lang=\"zh\">闭子群</span>.</p>\n<h2><span lang=\"zh\">性质</span></h2>\n<p>Borel <span lang=\"zh\">子群两两共轭</span>.</p>\n<p><span lang=\"zh\">每个</span> Borel <span lang=\"zh\">子群</span> $B \\subset G$ <span lang=\"zh\">都等于其</span>"},{"Local":{"url":"/正规化子","text":"<span lang=\"zh\">正规化子</span>"}},{"Plain":" $N_G(B)$.</p>\n<p><span lang=\"zh\">任何两个</span> Borel <span lang=\"zh\">子群的交都包含一个</span>"},{"Local":{"url":"/极大环面","text":"<span lang=\"zh\">极大环面</span>"}},{"Plain":".</p>\n<p>(<span lang=\"zh\">特征</span> $0$) Borel <span lang=\"zh\">子群的</span> Lie <span lang=\"zh\">代数是</span> "},{"Local":{"url":"/Borel子代数","text":"Borel <span lang=\"zh\">子代数</span>"}},{"Plain":".</p>\n<h2><span lang=\"zh\">例</span></h2>\n<p>$\\mathrm {GL}_n$ <span lang=\"zh\">的一个</span> Borel <span lang=\"zh\">子群是上三角矩阵的子群</span>.</p>\n"}]}}}]}