{"metadata":{"ext":[{"Plain":"md"},1],"tag":[{"Plain":"百科"},3],"author":[{"Lazy":[{"Local":{"url":"SimplicialCat","text":"SimplicialCat"}}]},4],"slug":[{"Plain":"Dolbeault--Dirac算子"},0],"title":[{"Plain":"“Dolbeault–Dirac 算子”"},2]},"content":{"Lazy":[{"Plain":"\n<p>在具有自旋结构的 "},{"Local":{"url":"Kähler流形","text":"Kähler 流形"}},{"Plain":"上, "},{"Local":{"url":"Dolbeault算子","text":"Dolbeault 上同调"}},{"Plain":"与其伴随算子之和是 "},{"Local":{"url":"Dirac算子","text":"Dirac 算子"}},{"Plain":", 其"},{"Local":{"url":"解析指标","text":"解析指标"}},{"Plain":"等于 "},{"Local":{"url":"Todd类","text":"Todd 类"}},{"Plain":".</p>\n"}]}}