{"sections":[{"slug":"凝聚环","section":{"metadata":{"slug":{"Plain":"凝聚环"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">凝聚环</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"凝聚环"},"data-taxon":{"Plain":"百科"}},"content":{"Plain":"\n<h2><span lang=\"zh\">定义</span></h2>\n<p><span lang=\"zh\">称交换环</span> $A$ <strong><span lang=\"zh\">凝聚</span></strong><span lang=\"zh\">是指其任意理想</span> $I$ <span lang=\"zh\">作为</span> $A$-<span lang=\"zh\">模有限表现</span>.</p>\n<h2><span lang=\"zh\">例</span></h2>\n"}}}]}