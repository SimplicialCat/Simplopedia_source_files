{"sections":[{"slug":"deRham定理","section":{"metadata":{"slug":{"Plain":"deRham定理"},"ext":{"Plain":"md"},"title":{"Plain":"de Rham <span lang=\"zh\">定理</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"de Rham 定理"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">陈述</span></h2>\n<p><span lang=\"zh\">设</span> $X$ <span lang=\"zh\">为实流形</span>, <span lang=\"zh\">则常值层</span> $\\mathbb{R}$ <span lang=\"zh\">的</span> "},{"Local":{"url":"/层上同调","text":"<span lang=\"zh\">层上同调</span>"}},{"Plain":"<span lang=\"zh\">可由</span> "},{"Local":{"url":"/deRham上同调","text":"de Rham <span lang=\"zh\">上同调</span>"}},{"Plain":"<span lang=\"zh\">计算</span>:\n$$\r\nH^p(X, \\mathbb{R}) \\simeq H^p_{dR}(X).\r\n$$</p>\n<h2><span lang=\"zh\">证明</span></h2>\n<p><span lang=\"zh\">考虑</span> $p$-<span lang=\"zh\">形式层</span> $\\mathcal A^p$, <span lang=\"zh\">则有常值层</span> $\\mathbb{R}$ <span lang=\"zh\">的</span>"},{"Local":{"url":"/细层","text":"<span lang=\"zh\">细层</span>"}},{"Plain":"<span lang=\"zh\">消解</span>\n$$\r\n0 \\to \\mathbb{R} \\to \\mathcal A^0 \\to \\mathcal A^1 \\to \\cdots\r\n$$\n(<span lang=\"zh\">其正合性是由于</span> "},{"Local":{"url":"/Poincaré引理","text":"Poincaré <span lang=\"zh\">引理</span>"}},{"Plain":"), <span lang=\"zh\">故由细层消解的性质</span>,\n$$\r\nH^p(X,\\mathbb{R}) \\simeq H^p(\\Gamma(\\mathcal A^\\bullet)).\r\n$$</p>\n<h2><span lang=\"zh\">相关概念</span></h2>\n<p>"},{"Local":{"url":"/Hodge理论","text":"Hodge <span lang=\"zh\">理论</span>"}},{"Plain":", "},{"Local":{"url":"/Dolbeault上同调","text":"Dolbeault <span lang=\"zh\">上同调</span>"}},{"Plain":"</p>\n"}]}}}]}