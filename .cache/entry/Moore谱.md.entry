{"sections":[{"slug":"Moore谱","section":{"metadata":{"slug":{"Plain":"Moore谱"},"ext":{"Plain":"md"},"title":{"Plain":"Moore <span lang=\"zh\">谱</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"Moore 谱"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">观念</span></h2>\n<h2><span lang=\"zh\">定义</span></h2>\n<p><span lang=\"zh\">给定</span> Abel <span lang=\"zh\">群</span> $G$, <span lang=\"zh\">其</span> Moore <span lang=\"zh\">谱</span> $MG$ <span lang=\"zh\">由如下性质刻画</span>:</p>\n<ul>\n<li>$\\pi_{&lt;0}MG \\simeq 0$;</li>\n<li>$\\pi_0 MG \\simeq G$;</li>\n<li>$H_{&gt;0}(MG,\\mathbb{Z})\\simeq 0$, <span lang=\"zh\">其中</span> $H_n(MG,\\mathbb{Z}) \\simeq \\pi_{n}(MG\\wedge H\\mathbb{Z})$, $H\\mathbb{Z}$ <span lang=\"zh\">为</span> "},{"Local":{"url":"/Eilenberg–MacLane谱","text":"Eilenberg–MacLane <span lang=\"zh\">谱</span>"}},{"Plain":".</li>\n</ul>\n"}]}}}]}