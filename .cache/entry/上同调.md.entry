{"sections":[{"slug":"上同调","section":{"metadata":{"slug":{"Plain":"上同调"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">上同调</span>"},"taxon":{"Plain":"<span lang=\"zh\">观念</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"上同调"},"data-taxon":{"Plain":"观念"}},"content":{"Lazy":[{"Plain":"\n<p><span lang=\"zh\">在一个</span>"},{"Local":{"url":"/无穷范畴","text":"<span lang=\"zh\">无穷范畴</span>"}},{"Plain":" $\\mathcal C$ <span lang=\"zh\">中</span>, <span lang=\"zh\">对象</span> $X$ <span lang=\"zh\">的取值于对象</span> $A$ (<span lang=\"zh\">或称以</span> $A$ <span lang=\"zh\">为</span><strong><span lang=\"zh\">系数</span></strong>) <span lang=\"zh\">的</span> $n$ <span lang=\"zh\">阶上同调为</span>\n$$\r\nH^n(X,A) :=\\pi_0\\operatorname{Hom}_{\\mathcal{C}}(X,\\mathbf{B}^nA),\r\n$$\n<span lang=\"zh\">其中</span> $\\mathbf{B}$ <span lang=\"zh\">表示</span>"},{"Local":{"url":"/逆环路空间","text":"<span lang=\"zh\">逆环路空间</span>"}},{"Plain":"<span lang=\"zh\">函子</span>.</p>\n<ul>\n<li><span lang=\"zh\">我们主要关心的</span> $\\mathcal C$ <span lang=\"zh\">是</span> "},{"Local":{"url":"/∞-意象","text":"$\\infty$-<span lang=\"zh\">意象</span>"}},{"Plain":", <span lang=\"zh\">特别是</span>"},{"Local":{"url":"/景","text":"<span lang=\"zh\">景</span>"}},{"Plain":"<span lang=\"zh\">上取值于</span> "},{"Local":{"url":"/Ani","text":"$\\mathsf{Ani}$"}},{"Plain":" <span lang=\"zh\">的</span>"},{"Local":{"url":"/层意象","text":"<span lang=\"zh\">层意象</span>"}},{"Plain":". <span lang=\"zh\">通常对象</span> $X$ <span lang=\"zh\">就取为</span>"},{"Local":{"url":"/终对象","text":"<span lang=\"zh\">终对象</span>"}},{"Plain":", <span lang=\"zh\">也即一个点对应的</span>"},{"Local":{"url":"/常值层","text":"<span lang=\"zh\">常值层</span>"}},{"Plain":".</li>\n<li><span lang=\"zh\">一般地</span>, <span lang=\"zh\">定义</span> $A$-<span lang=\"zh\">系数的</span> $n$ <span lang=\"zh\">阶上同调需要</span> $A$ <span lang=\"zh\">具有</span> "},{"Local":{"url":"/En-代数","text":"$\\mathbb E_n$-<span lang=\"zh\">群</span>"}},{"Plain":"<span lang=\"zh\">结构</span>. <span lang=\"zh\">要想能够对所有正整数</span> $n$ <span lang=\"zh\">定义</span> $A$-<span lang=\"zh\">系数的</span> $n$ <span lang=\"zh\">阶上同调</span>, <span lang=\"zh\">也就是</span> $A$ <span lang=\"zh\">具有任意阶的</span>"},{"Local":{"url":"/逆环路空间","text":"<span lang=\"zh\">逆环路空间</span>"}},{"Plain":", <span lang=\"zh\">必须要</span> $A$ <span lang=\"zh\">为</span> Abel <span lang=\"zh\">群</span>, <span lang=\"zh\">又叫</span> "},{"Local":{"url":"/E∞-群","text":"$\\mathbb E_\\infty$-<span lang=\"zh\">群</span>"}},{"Plain":".</li>\n<li><span lang=\"zh\">通常的上同调是对</span> Abel <span lang=\"zh\">群</span> $A$ <span lang=\"zh\">定义的</span>; <span lang=\"zh\">但也可以考虑</span> Abel <span lang=\"zh\">群之外的系数对象</span>, <span lang=\"zh\">称之为</span>"},{"Local":{"url":"/非Abel上同调","text":"<span lang=\"zh\">非</span> Abel <span lang=\"zh\">上同调</span>"}},{"Plain":".</li>\n</ul>\n<h2><span lang=\"zh\">例</span></h2>\n<ul>\n<li>"},{"Local":{"url":"/奇异上同调","text":"<span lang=\"zh\">奇异上同调</span>"}},{"Plain":"<span lang=\"zh\">是</span> "},{"Local":{"url":"/Ani","text":"$\\mathsf{Ani}$"}},{"Plain":" <span lang=\"zh\">中以普通</span> Abel <span lang=\"zh\">群</span> $A$ (<span lang=\"zh\">视为离散</span> "},{"Local":{"url":"/E∞-群","text":"$\\mathbb E_\\infty$-<span lang=\"zh\">群</span>"}},{"Plain":") <span lang=\"zh\">为系数的上同调</span>. <span lang=\"zh\">对于普通</span> Abel <span lang=\"zh\">群</span> $A$, <span lang=\"zh\">其</span> $n$ <span lang=\"zh\">阶</span>"},{"Local":{"url":"/逆环路空间","text":"<span lang=\"zh\">逆环路空间</span>"}},{"Plain":" $\\mathbf{B}^n A$ <span lang=\"zh\">是</span> "},{"Local":{"url":"/Eilenberg–MacLane空间","text":"Eilenberg–MacLane<span lang=\"zh\">空间</span>"}},{"Plain":".</li>\n<li>"},{"Local":{"url":"/层上同调","text":"(Abel) <span lang=\"zh\">层上同调</span>"}},{"Plain":"<span lang=\"zh\">是</span>"},{"Local":{"url":"/层意象","text":"<span lang=\"zh\">层意象</span>"}},{"Plain":"<span lang=\"zh\">中以</span> "},{"Local":{"url":"/E∞-群","text":"$\\mathbb E_\\infty$-<span lang=\"zh\">群对象</span>"}},{"Plain":"<span lang=\"zh\">为系数的上同调</span>.</li>\n<li><span lang=\"zh\">特别地</span>, "},{"Local":{"url":"/群","text":"<span lang=\"zh\">群</span>"}},{"Plain":" $G$ <span lang=\"zh\">的以</span> $G$-<span lang=\"zh\">表示</span> $V$ <span lang=\"zh\">为系数的</span>"},{"Local":{"url":"/群上同调","text":"<span lang=\"zh\">群上同调</span>"}},{"Plain":"<span lang=\"zh\">是其</span>"},{"Local":{"url":"/逆环路空间","text":"<span lang=\"zh\">逆环路空间</span>"}},{"Plain":" $\\mathbf{B}G$ <span lang=\"zh\">上的</span> "},{"Local":{"url":"/E∞-群","text":"$\\mathbb E_\\infty$-<span lang=\"zh\">群对象</span>"}},{"Plain":" $V / G \\to \\mathbf{B}G$ <span lang=\"zh\">的上同调</span>.</li>\n</ul>\n<h2><span lang=\"zh\">性质</span></h2>\n<h3>Abel <span lang=\"zh\">情形的计算</span></h3>\n<p>Abel <span lang=\"zh\">上同调能够计算的原因是</span>:</p>\n<ul>\n<li>"},{"Local":{"url":"/E∞-群","text":"$\\mathbb E_\\infty$-<span lang=\"zh\">群</span>"}},{"Plain":"<span lang=\"zh\">等同于</span>"},{"Local":{"url":"/连合谱","text":"<span lang=\"zh\">连合谱</span>"}},{"Plain":";</li>\n<li><span lang=\"zh\">对于普通</span> Abel <span lang=\"zh\">群</span> (<span lang=\"zh\">即</span> $\\mathbb{Z}$-<span lang=\"zh\">模</span>) $A$, <span lang=\"zh\">其</span> $n$ <span lang=\"zh\">阶</span>"},{"Local":{"url":"/逆环路空间","text":"<span lang=\"zh\">逆环路空间</span>"}},{"Plain":" $\\mathbf{B}^n A$ <span lang=\"zh\">作为</span>"},{"Local":{"url":"/谱对象","text":"<span lang=\"zh\">谱对象</span>"}},{"Plain":"<span lang=\"zh\">是</span> $\\mathbb{Z}$-<span lang=\"zh\">模谱</span> $A[n]$;</li>\n<li><span lang=\"zh\">进而</span>"},{"Local":{"url":"/生象","text":"<span lang=\"zh\">生象</span>"}},{"Plain":" $X$ <span lang=\"zh\">到</span> $\\mathbf{B}^n A$ <span lang=\"zh\">的映射等同于</span>\n<ul>\n<li>$X$ <span lang=\"zh\">自由生成的</span> "},{"Local":{"url":"/E∞-群","text":"$\\mathbb E_\\infty$-<span lang=\"zh\">群</span>"}},{"Plain":" $\\Omega^{\\infty}\\Sigma^{\\infty}_+ X$ <span lang=\"zh\">到</span> $\\mathbf{B}^n A$ <span lang=\"zh\">的映射</span>,</li>\n<li>$X$ <span lang=\"zh\">的</span>"},{"Local":{"url":"/纬悬谱","text":"<span lang=\"zh\">纬悬谱</span>"}},{"Plain":" $\\Sigma^{\\infty}_+ X$ <span lang=\"zh\">到</span> $A[n]$ <span lang=\"zh\">的映射</span>,</li>\n<li>$X$ <span lang=\"zh\">自由生成的</span> $\\mathbb{Z}$-<span lang=\"zh\">模谱</span> $\\mathbb{Z}[X]:= \\Sigma^\\infty_+ X \\wedge \\mathrm{H}\\mathbb{Z}$ <span lang=\"zh\">到</span> $A[n]$ <span lang=\"zh\">的映射</span>;</li>\n</ul>\n</li>\n<li>$\\mathbb{Z}$-<span lang=\"zh\">模谱可</span>"},{"Local":{"url":"/数学对象的表现","text":"<span lang=\"zh\">表现</span>"}},{"Plain":"<span lang=\"zh\">为</span> (<span lang=\"zh\">非负次数</span>) $\\mathbb{Z}$-<span lang=\"zh\">链复形</span>, <span lang=\"zh\">然后应用各种</span>"},{"Local":{"url":"/消解","text":"<span lang=\"zh\">消解</span>"}},{"Plain":"<span lang=\"zh\">手段计算</span>.</li>\n</ul>\n<p><span lang=\"zh\">在上述讨论中也可将</span> “<span lang=\"zh\">生象</span>” <span lang=\"zh\">替换为任何</span> "},{"Local":{"url":"/∞-意象","text":"$\\infty$-<span lang=\"zh\">意象</span>"}},{"Plain":"<span lang=\"zh\">的对象</span> (<span lang=\"zh\">换言之</span>, <span lang=\"zh\">视为</span>"},{"Local":{"url":"/意象的内语言","text":"<span lang=\"zh\">意象的内语言</span>"}},{"Plain":"<span lang=\"zh\">中的讨论</span>). <span lang=\"zh\">不过具体的消解手段还是要根据具体的意象和</span>"},{"Local":{"url":"/景","text":"<span lang=\"zh\">景</span>"}},{"Plain":"<span lang=\"zh\">来选取</span>.</p>\n<h3><span lang=\"zh\">意象之间的比较</span></h3>\n<p><span lang=\"zh\">设</span>\n$$\r\nf = (f^*\\dashv f_*)\\colon \\mathcal Y \\to \\mathcal X\r\n$$\n<span lang=\"zh\">为</span> "},{"Local":{"url":"/∞-意象","text":"$\\infty$-<span lang=\"zh\">意象</span>"}},{"Plain":"<span lang=\"zh\">之间的</span>"},{"Local":{"url":"/几何态射","text":"<span lang=\"zh\">几何态射</span>"}},{"Plain":". "},{"Local":{"url":"/todo","text":"todo"}},{"Plain":"</p>\n"}]}}}]}