{"sections":[{"slug":"纤维丛","section":{"metadata":{"slug":{"Plain":"纤维丛"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">纤维丛</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"纤维丛"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">观念</span></h2>\n<p><span lang=\"zh\">纤维丛是一种</span>"},{"Local":{"url":"/相对","text":"<span lang=\"zh\">相对</span>"}},{"Plain":"<span lang=\"zh\">的空间</span>, <span lang=\"zh\">其每个纤维具有相同的同构类</span>, <span lang=\"zh\">局部上形如乘积空间</span>, <span lang=\"zh\">而整体上可能不平凡</span>.</p>\n<p><span lang=\"zh\">任何纤维丛都</span>"},{"Local":{"url":"/关联丛","text":"<span lang=\"zh\">关联</span>"}},{"Plain":"<span lang=\"zh\">于一个唯一的</span>"},{"Local":{"url":"/主丛","text":"<span lang=\"zh\">主丛</span>"}},{"Plain":".</p>\n"}]}}}]}