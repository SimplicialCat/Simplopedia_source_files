{"metadata":{"ext":[{"Plain":"md"},1],"slug":[{"Plain":"伴随函子定理"},0],"author":[{"Lazy":[{"Local":{"url":"SimplicialCat","text":"SimplicialCat"}}]},4],"title":[{"Plain":"伴随函子定理"},2],"tag":[{"Plain":"百科"},3]},"content":{"Lazy":[{"Plain":"\n<h2>陈述</h2>\n<p><strong>定理</strong>. 设 $\\mathcal C$ 为"},{"Local":{"url":"可表现范畴","text":"可表现范畴"}},{"Plain":", $\\mathcal D$ 为局部小范畴. 函子 $F\\colon \\mathcal C \\to \\mathcal D$ 有右"},{"Local":{"url":"伴随","text":"伴随"}},{"Plain":"当且仅当它保持"},{"Local":{"url":"余极限","text":"余极限"}},{"Plain":".</p>\n"}]}}