{"sections":[{"slug":"陪集空间","section":{"metadata":{"slug":{"Plain":"陪集空间"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">陪集空间</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"陪集空间"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<p><span lang=\"zh\">对于群</span> $G$ <span lang=\"zh\">的子群</span> $H$, <span lang=\"zh\">陪集空间</span> $G / H$ <span lang=\"zh\">是</span> $G$ <span lang=\"zh\">关于</span> $H$ <span lang=\"zh\">的右乘作用的商空间</span>.</p>\n<p><span lang=\"zh\">陪集空间</span> $G / H$ <span lang=\"zh\">也可以表示为</span>\n$$\r\n{*} \\times_{\\mathbf{B}G} \\mathbf{B}H,\r\n$$\n<span lang=\"zh\">也即</span> $G$ <span lang=\"zh\">关于子群</span> $*$ <span lang=\"zh\">和</span> $H$ <span lang=\"zh\">的</span>"},{"Local":{"url":"/双陪集空间","text":"<span lang=\"zh\">双陪集空间</span>"}},{"Plain":".</p>\n"}]}}}]}