{"sections":[{"slug":"小平嵌入","section":{"metadata":{"slug":{"Plain":"小平嵌入"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">小平嵌入</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"小平嵌入"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">陈述</span></h2>\n<h3><span lang=\"zh\">复几何</span></h3>\n<p><span lang=\"zh\">设</span> $M$ <span lang=\"zh\">是</span> $n$ <span lang=\"zh\">维紧复流形</span>, <span lang=\"zh\">其上有正</span>"},{"Local":{"url":"/线丛","text":"<span lang=\"zh\">线丛</span>"}},{"Plain":" $L$, <span lang=\"zh\">则对于足够大的</span> $n_0$, $M$ <span lang=\"zh\">可嵌入射影空间</span> $\\mathbb P^{n_0}$.</p>\n<h3><span lang=\"zh\">代数几何</span></h3>\n"}]}}}]}