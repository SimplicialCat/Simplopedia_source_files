{"sections":[{"slug":"卷积","section":{"metadata":{"slug":{"Plain":"卷积"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">卷积</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"卷积"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">定义</span></h2>\n<h3><span lang=\"zh\">群上</span></h3>\n<p>"},{"Local":{"url":"/群","text":"<span lang=\"zh\">群</span>"}},{"Plain":" $G$ <span lang=\"zh\">上的函数或层通过乘法映射</span> $m\\colon G\\times G\\to G$ <span lang=\"zh\">作卷积</span>:\n$$\r\nf * g := m_! (f \\boxtimes g).\r\n$$\n<span lang=\"zh\">其中</span> $m_!$ <span lang=\"zh\">的直观为沿纤维求和</span> ("},{"Local":{"url":"/依值和","text":"<span lang=\"zh\">依值和</span>"}},{"Plain":").</p>\n"}]}}}]}