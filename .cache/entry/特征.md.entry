{"sections":[{"slug":"特征","section":{"metadata":{"slug":{"Plain":"特征"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">特征</span>, <span lang=\"zh\">余特征</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"特征, 余特征"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">定义</span></h2>\n<h3>Lie <span lang=\"zh\">群</span></h3>\n<p>Lie <span lang=\"zh\">群</span> $G$ <span lang=\"zh\">的</span><strong><span lang=\"zh\">特征</span></strong> (character) <span lang=\"zh\">是</span> $G$ <span lang=\"zh\">到</span> $S^1$ (<span lang=\"zh\">或</span> $\\mathbb{C}^\\times$) <span lang=\"zh\">的同态</span>, <strong><span lang=\"zh\">余特征</span></strong> (cocharacter) <span lang=\"zh\">是</span> $S^1$ <span lang=\"zh\">到</span> $G$ <span lang=\"zh\">的同态</span>.</p>\n<p><span lang=\"zh\">紧</span> Lie <span lang=\"zh\">群</span> $G$ <span lang=\"zh\">的特征</span> $G \\to U(1)$ <span lang=\"zh\">由其在任意一个</span>"},{"Local":{"url":"/极大环面","text":"<span lang=\"zh\">极大环面</span>"}},{"Plain":" $T\\subset G$ <span lang=\"zh\">上的取值完全决定</span>. <span lang=\"zh\">因此也称极大环面</span> $T$ <span lang=\"zh\">的特征为</span> $G$ <span lang=\"zh\">的特征</span>.</p>\n<p>"},{"Local":{"url":"/Weyl群","text":"Weyl <span lang=\"zh\">群</span>"}},{"Plain":" $W$ <span lang=\"zh\">作用于特征晶格上</span>, <span lang=\"zh\">由关于</span>"},{"Local":{"url":"/根","text":"<span lang=\"zh\">根</span>"}},{"Plain":"<span lang=\"zh\">的反射生成</span>.</p>\n<h3><span lang=\"zh\">代数群</span></h3>\n<p><span lang=\"zh\">代数群</span> $G$ <span lang=\"zh\">的</span><strong><span lang=\"zh\">特征</span></strong><span lang=\"zh\">是</span> $G$ <span lang=\"zh\">到</span> "},{"Local":{"url":"/乘法群概形","text":"$\\mathbb G_m$"}},{"Plain":" <span lang=\"zh\">的同态</span>, <span lang=\"zh\">余特征是</span> $\\mathbb{G}_m$ <span lang=\"zh\">到</span> $G$ <span lang=\"zh\">的同态</span>..</p>\n<h2><span lang=\"zh\">例</span></h2>\n<p>$\\mathrm{SL}_3$ <span lang=\"zh\">的特征晶格是秩为</span> $2$ <span lang=\"zh\">的自由</span> $\\mathbb{Z}$-<span lang=\"zh\">模</span>.</p>\n"}]}}}]}