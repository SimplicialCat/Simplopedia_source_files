{"sections":[{"slug":"谱","section":{"metadata":{"slug":{"Plain":"谱"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">谱</span> (<span lang=\"zh\">稳定同伦论</span>)"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"subject":{"Lazy":[{"Local":{"url":"/稳定同伦论","text":"<span lang=\"zh\">稳定同伦论</span>"}}]},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"谱 (稳定同伦论)"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<p><span lang=\"zh\">本页面讨论</span>"},{"Local":{"url":"/稳定同伦论","text":"<span lang=\"zh\">稳定同伦论</span>"}},{"Plain":"<span lang=\"zh\">中的谱</span>. <span lang=\"zh\">另一个无关的概念是</span>"},{"Local":{"url":"/代数-几何对偶","text":"<span lang=\"zh\">代数</span>–<span lang=\"zh\">几何对偶</span>"}},{"Plain":"<span lang=\"zh\">中的</span>"},{"Local":{"url":"/谱(代数)","text":"<span lang=\"zh\">谱</span>"}},{"Plain":".</p>\n<h2><span lang=\"zh\">观念</span></h2>\n<p><span lang=\"zh\">带基点</span>"},{"Local":{"url":"/生象","text":"<span lang=\"zh\">生象</span>"}},{"Plain":" $X,Y$ <span lang=\"zh\">之间的</span><strong><span lang=\"zh\">稳定映射空间</span></strong>\n$$\r\n\\operatorname{Hom}_s(X,Y) :=\\operatorname{colim}_k \\operatorname{Hom}(\\Sigma^k X,\\Sigma^k Y)\r\n$$\n<span lang=\"zh\">具有自然的</span> "},{"Local":{"url":"/E∞-群","text":"$\\mathbb E_\\infty$-<span lang=\"zh\">群</span>"}},{"Plain":"<span lang=\"zh\">结构</span>. <span lang=\"zh\">特别地</span>, "},{"Local":{"url":"/稳定同伦群","text":"<span lang=\"zh\">稳定同伦群</span>"}},{"Plain":" $\\pi_n^s(X)=\\pi_0\\operatorname{Hom}_s(S^n,X)$ <span lang=\"zh\">是</span> Abel <span lang=\"zh\">群</span>.</p>\n<p><span lang=\"zh\">我们希望将</span>"},{"Local":{"url":"/生象","text":"<span lang=\"zh\">生象</span>"}},{"Plain":"<span lang=\"zh\">的范畴</span>"},{"Local":{"url":"/稳定化","text":"<span lang=\"zh\">稳定化</span>"}},{"Plain":", <span lang=\"zh\">使得稳定化后的映射空间是上述的余极限</span>, <span lang=\"zh\">也即形式上令</span> $\\Sigma$ <span lang=\"zh\">可逆</span>. <span lang=\"zh\">参见</span>"},{"Local":{"url":"/形式取逆","text":"<span lang=\"zh\">形式取逆</span>"}},{"Plain":".</p>\n<p><span lang=\"zh\">对于具有有限极限和有限余极限的范畴</span>, <span lang=\"zh\">存在伴随</span> $\\Sigma \\dashv \\Omega$:\n$$\r\n\\text{Map}(\\Sigma X,Y)\\simeq *\\times_{\\text{Map}(X,Y)}*\\simeq \\text{Map}(X,\\Omega Y).\r\n$$</p>\n<p><span lang=\"zh\">谱的范畴</span> "},{"Local":{"url":"/Sp","text":"$\\mathsf{Sp}$"}},{"Plain":" <span lang=\"zh\">是</span>"},{"Local":{"url":"/生象","text":"<span lang=\"zh\">生象</span>"}},{"Plain":"<span lang=\"zh\">范畴的</span>"},{"Local":{"url":"/稳定化","text":"<span lang=\"zh\">稳定化</span>"}},{"Plain":"\n$$\r\n\\mathsf{Sp} := \\lim\\Big(\\cdots\\overset{\\Omega}{\\longrightarrow} \\mathsf{Ani}_*\r\n\\overset{\\Omega}{\\longrightarrow} \\mathsf{Ani}_*\\Big)\r\n\\in \\mathsf{Cat}_{\\infty}.\r\n$$\n<span lang=\"zh\">其构造思路大致是</span>: <span lang=\"zh\">从带基点</span>"},{"Local":{"url":"/生象","text":"<span lang=\"zh\">生象</span>"}},{"Plain":"<span lang=\"zh\">范畴</span> $\\mathsf{Ani}_*$ <span lang=\"zh\">开始</span>, <span lang=\"zh\">强行让</span>"},{"Local":{"url":"/纬悬","text":"<span lang=\"zh\">纬悬</span>"}},{"Plain":" $\\Sigma$ <span lang=\"zh\">变得可逆</span>, <span lang=\"zh\">得到一个新的范畴</span>.</p>\n<p><span lang=\"zh\">谱的</span>"},{"Local":{"url":"/数学对象的表现","text":"<span lang=\"zh\">表现</span>"}},{"Plain":"<span lang=\"zh\">包括</span>"},{"Local":{"url":"/序列谱","text":"<span lang=\"zh\">序列谱</span>"}},{"Plain":", "},{"Local":{"url":"/坐标无关谱","text":"<span lang=\"zh\">坐标无关谱</span>"}},{"Plain":"<span lang=\"zh\">等</span>.</p>\n<h2><span lang=\"zh\">定义</span></h2>\n<p><span lang=\"zh\">见</span>"},{"Local":{"url":"/序列谱","text":"<span lang=\"zh\">序列谱</span>"}},{"Plain":".</p>\n<h2><span lang=\"zh\">例</span></h2>\n<h3><span lang=\"zh\">纬悬谱</span></h3>\n<p><span lang=\"zh\">设</span> $X$ <span lang=\"zh\">为带基点空间</span>, $X$ <span lang=\"zh\">的</span>"},{"Local":{"url":"/纬悬谱","text":"<span lang=\"zh\">纬悬谱</span>"}},{"Plain":" $\\Sigma^{\\infty}X$ <span lang=\"zh\">可定义为</span>"},{"Local":{"url":"/序列谱","text":"<span lang=\"zh\">序列谱</span>"}},{"Plain":" $\\{\\Sigma^q X\\}_{q\\geq 0}$ <span lang=\"zh\">以及恒等映射</span> $\\Sigma\\Sigma^q X\\to\\Sigma^{q+1}X$.</p>\n<p><span lang=\"zh\">对于正整数</span> $n$, <span lang=\"zh\">定义</span> $\\Sigma^{\\infty -n}X$ <span lang=\"zh\">为如下</span>"},{"Local":{"url":"/序列谱","text":"<span lang=\"zh\">序列谱</span>"}},{"Plain":": <span lang=\"zh\">第</span> $n$ <span lang=\"zh\">项以前为单点</span>, <span lang=\"zh\">第</span> $q\\geq n$ <span lang=\"zh\">项为</span> $\\Sigma^{q-n}X$.</p>\n<p><span lang=\"zh\">特别地</span>, <span lang=\"zh\">称</span> $X=S^0$ <span lang=\"zh\">的纬悬谱为</span>"},{"Local":{"url":"/球谱","text":"<span lang=\"zh\">球谱</span>"}},{"Plain":" (sphere spectrum).</p>\n<h3><span lang=\"zh\">谱化</span></h3>\n<p><span lang=\"zh\">对于预谱</span> $T_\\bullet$, <span lang=\"zh\">若</span> $T_q\\to \\Omega T_{q+1}$ <span lang=\"zh\">为嵌入</span>, <span lang=\"zh\">可定义一个谱</span> $(LT)_\\bullet$,\n$$\r\n(LT)_q:=\\operatorname{colim}_{l}\\Omega^l T_{q+l},\r\n$$\n<span lang=\"zh\">称为</span> $T$ <span lang=\"zh\">的谱化</span> (spectrification). <span lang=\"zh\">谱化是谱到预谱的遗忘的左伴随</span>.</p>\n<p><span lang=\"zh\">特别地</span>, <span lang=\"zh\">对于</span> $T=\\{\\Sigma^q X\\}_{q\\geq 0}$, <span lang=\"zh\">有</span> $(LT)_0=\\operatorname{colim}_l \\Omega^l\\Sigma^l X$, <span lang=\"zh\">记后者为</span> $QX$.</p>\n<h2><span lang=\"zh\">性质</span></h2>\n<p><span lang=\"zh\">谱的范畴</span> "},{"Local":{"url":"/Sp","text":"$\\mathsf{Sp}$"}},{"Plain":" <span lang=\"zh\">是</span>"},{"Local":{"url":"/稳定无穷范畴","text":"<span lang=\"zh\">稳定</span> ∞-<span lang=\"zh\">范畴</span>"}},{"Plain":".</p>\n<p><span lang=\"zh\">有</span>"},{"Local":{"url":"/对称幺半∞-范畴","text":"<span lang=\"zh\">对称幺半函子</span>"}},{"Plain":"\n$$\r\n(\\mathsf{Set},\\times) \\to (\\mathsf{Ani},\\times) \\overset{(-)_+}{\\to} (\\mathsf{Ani}_{*/},\\wedge) \\overset{\\Sigma_{\\infty}}{\\to} (\\mathsf{Sp},\\wedge).\r\n$$</p>\n<h2><span lang=\"zh\">谱的同伦群与同调群</span></h2>\n<p><span lang=\"zh\">对于</span>"},{"Local":{"url":"/序列谱","text":"<span lang=\"zh\">序列谱</span>"}},{"Plain":" $T_\\bullet$, <span lang=\"zh\">定义</span>\n$$\r\n\\pi_n(T_\\bullet)=\\operatorname{colim}_l \\pi_{n+l}T_l,\r\n$$\n$$\r\nH_n(T_\\bullet,R)=\\operatorname{colim}_q\\widetilde {H}_{n+q}(T_q,R).\r\n$$\n<span lang=\"zh\">但这样无法定义上同调</span>, <span lang=\"zh\">因为箭头的方向</span>.</p>\n<h2><span lang=\"zh\">相关概念</span></h2>\n<p>"},{"Local":{"url":"/稳定化","text":"<span lang=\"zh\">稳定化</span>"}},{"Plain":", "},{"Local":{"url":"/稳定同伦范畴","text":"<span lang=\"zh\">稳定同伦范畴</span>"}},{"Plain":", "},{"Local":{"url":"/E∞-空间","text":"Abel ∞-<span lang=\"zh\">群</span>"}},{"Plain":"</p>\n"}]}}}]}