{"sections":[{"slug":"叠","section":{"metadata":{"slug":{"Plain":"叠"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">叠</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"叠"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">观念</span></h2>\n<p><strong><span lang=\"zh\">叠</span></strong><span lang=\"zh\">是</span>"},{"Local":{"url":"/景","text":"<span lang=\"zh\">景</span>"}},{"Plain":"<span lang=\"zh\">上取值于</span>"},{"Local":{"url":"/高阶范畴","text":"<span lang=\"zh\">高阶范畴</span>"}},{"Plain":"<span lang=\"zh\">的</span>"},{"Local":{"url":"/景上的层","text":"<span lang=\"zh\">层</span>"}},{"Plain":", <span lang=\"zh\">也即高阶</span>"},{"Local":{"url":"/意象","text":"<span lang=\"zh\">意象</span>"}},{"Plain":"<span lang=\"zh\">的对象</span>.</p>\n<h2><span lang=\"zh\">例</span></h2>\n<p><span lang=\"zh\">对于</span> Lie <span lang=\"zh\">群</span> $G$ <span lang=\"zh\">有一个叠</span> $\\mathbf{B}G$, <span lang=\"zh\">它是一个函子</span> $\\mathsf {Mfd}^{\\text{op}}\\to\\mathsf {Grpd}$, <span lang=\"zh\">将流形</span> $U$ <span lang=\"zh\">对应到</span> $U$ <span lang=\"zh\">上的</span> $G$-"},{"Local":{"url":"/主丛","text":"<span lang=\"zh\">主丛</span>"}},{"Plain":"<span lang=\"zh\">的群胚</span>, <span lang=\"zh\">将态射</span> $U\\to V$ <span lang=\"zh\">对应到主丛的拉回</span>.</p>\n"}]}}}]}