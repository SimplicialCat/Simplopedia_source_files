{"sections":[{"slug":"代数叠","section":{"metadata":{"slug":{"Plain":"代数叠"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">代数叠</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"代数叠"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<p><span lang=\"zh\">代数叠又叫</span> Artin <span lang=\"zh\">叠</span>, <span lang=\"zh\">是仿射概形的范畴上具有</span> (<span lang=\"zh\">平坦</span>) <span lang=\"zh\">坐标卡以及适当的可表性的</span>"},{"Local":{"url":"/叠","text":"<span lang=\"zh\">叠</span>"}},{"Plain":".</p>\n"}]}}}]}