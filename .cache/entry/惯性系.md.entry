{"sections":[{"slug":"惯性系","section":{"metadata":{"slug":{"Plain":"惯性系"},"ext":{"Plain":"md"},"title":{"Plain":"“<span lang=\"zh\">惯性系</span>”"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"“惯性系”"},"data-taxon":{"Plain":"百科"}},"content":{"Plain":"\n<p><span lang=\"zh\">狭义相对论中的惯性观者对应类时测地线</span>.</p>\n<p><span lang=\"zh\">光子相对于任何惯性系的速度均为</span> $c$.</p>\n"}}}]}