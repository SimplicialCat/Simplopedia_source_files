{"sections":[{"slug":"黑洞","section":{"metadata":{"slug":{"Plain":"黑洞"},"ext":{"Plain":"md"},"title":{"Plain":"“<span lang=\"zh\">黑洞</span>”"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"“黑洞”"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<p><span lang=\"zh\">黑洞是</span>"},{"Local":{"url":"/广义相对论","text":"<span lang=\"zh\">广义相对论</span>"}},{"Plain":"<span lang=\"zh\">中时空极度扭曲的一个区域</span>, <span lang=\"zh\">使得光无法从中逃脱</span>.</p>\n<p><span lang=\"zh\">黑洞的边界称为事件视界</span> (event horizon).</p>\n<h2><span lang=\"zh\">例</span></h2>\n<p>"},{"Local":{"url":"/Schwarzschild度规","text":"Schwarzschild <span lang=\"zh\">度规</span>"}},{"Plain":", "},{"Local":{"url":"/Kerr度规","text":"Kerr <span lang=\"zh\">度规</span>"}},{"Plain":"</p>\n<h2><span lang=\"zh\">性质</span></h2>\n<h3><span lang=\"zh\">唯一性</span></h3>\n<h3><span lang=\"zh\">稳定性</span></h3>\n<h3>Penrose <span lang=\"zh\">不等式</span></h3>\n"}]}}}]}