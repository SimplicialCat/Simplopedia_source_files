{"sections":[{"slug":"导出前推","section":{"metadata":{"slug":{"Plain":"导出前推"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">导出前推</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"导出前推"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">观念</span></h2>\n<p><span lang=\"zh\">导出前推是</span>"},{"Local":{"url":"/无穷范畴","text":"<span lang=\"zh\">无穷范畴</span>"}},{"Plain":"<span lang=\"zh\">语境中的</span>"},{"Local":{"url":"/推前","text":"<span lang=\"zh\">前推</span>"}},{"Plain":"<span lang=\"zh\">的一个</span>"},{"Local":{"url":"/数学对象的表现","text":"<span lang=\"zh\">模型</span>"}},{"Plain":".</p>\n<h2><span lang=\"zh\">定义</span></h2>\n<p>"},{"Local":{"url":"/前推","text":"<span lang=\"zh\">直像</span>"}},{"Plain":"<span lang=\"zh\">函子</span> $f_*\\colon Mod(X,\\mathcal{O}_X)\\to Mod(Y,\\mathcal{O}_Y)$ <span lang=\"zh\">有右</span>"},{"Local":{"url":"/导出函子","text":"<span lang=\"zh\">导出函子</span>"}},{"Plain":" $Rf_*\\colon D(X,\\mathcal{O}_X)\\to D(Y,\\mathcal{O}_Y)$.</p>\n<p><span lang=\"zh\">设有</span>"},{"Local":{"url":"/内射消解","text":"<span lang=\"zh\">内射消解</span>"}},{"Plain":" $F\\to I^\\bullet$, <span lang=\"zh\">定义</span> $R^if_*F = H^i(f_*I^\\bullet)$.</p>\n<h2><span lang=\"zh\">例</span></h2>\n<p><span lang=\"zh\">到一个点上的导出前推是</span>"},{"Local":{"url":"/层上同调","text":"<span lang=\"zh\">层上同调</span>"}},{"Plain":".</p>\n<h2><span lang=\"zh\">性质</span></h2>\n<p><span lang=\"zh\">对于</span> "},{"Local":{"url":"/Noether概形","text":"Noether <span lang=\"zh\">概形</span>"}},{"Plain":" $X$, $\\mathsf {Qcoh}(X)$ <span lang=\"zh\">有足够多内射对象</span>.</p>\n<h3><span lang=\"zh\">高阶直像消失</span></h3>\n<p><strong><span lang=\"zh\">定理</span></strong>. <span lang=\"zh\">对于</span> $i&gt;\\dim X$, $R^i f_* \\mathcal F = 0$.</p>\n"}]}}}]}