{"sections":[{"slug":"消解","section":{"metadata":{"slug":{"Plain":"消解"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">消解</span>"},"taxon":{"Plain":"<span lang=\"zh\">观念</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"消解"},"data-taxon":{"Plain":"观念"}},"content":{"Lazy":[{"Plain":"\n<p><strong><span lang=\"zh\">消解</span></strong> (resolution) <span lang=\"zh\">是将一个数学对象</span>"},{"Local":{"url":"/数学对象的表现","text":"<span lang=\"zh\">表现</span>"}},{"Plain":"<span lang=\"zh\">为某种更容易计算的形式的过程</span>; <span lang=\"zh\">例如在</span>"},{"Local":{"url":"/带弱等价的范畴","text":"<span lang=\"zh\">带弱等价的范畴</span>"}},{"Plain":"<span lang=\"zh\">中</span>, <span lang=\"zh\">将一个对象替换为与之</span>"},{"Local":{"url":"/弱等价","text":"<span lang=\"zh\">弱等价</span>"}},{"Plain":"<span lang=\"zh\">的具有某种更好性质的对象</span>, <span lang=\"zh\">以方便某些计算</span>.</p>\n<h2><span lang=\"zh\">例</span></h2>\n<ul>\n<li>"},{"Local":{"url":"/内射消解","text":"<span lang=\"zh\">内射消解</span>"}},{"Plain":"</li>\n<li>"},{"Local":{"url":"/杠构造","text":"<span lang=\"zh\">杠消解</span>"}},{"Plain":"</li>\n</ul>\n"}]}}}]}