{"sections":[{"slug":"指数序列","section":{"metadata":{"slug":{"Plain":"指数序列"},"ext":{"Plain":"md"},"title":{"Plain":"“<span lang=\"zh\">指数序列</span>”"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"“指数序列”"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<p><span lang=\"zh\">指数序列是指紧复流形上层的正合列</span>\n$$\r\n 0 \\to \\mathbb{Z} \\to \\mathcal O_M \\overset{\\exp}{\\to} \\mathcal O^*_M \\to 0.\r\n$$</p>\n<h2><span lang=\"zh\">相关概念</span></h2>\n<p>"},{"Local":{"url":"/陈类","text":"<span lang=\"zh\">陈类</span>"}},{"Plain":", "},{"Local":{"url":"/Picard群","text":"Picard <span lang=\"zh\">群</span>"}},{"Plain":"</p>\n"}]}}}]}