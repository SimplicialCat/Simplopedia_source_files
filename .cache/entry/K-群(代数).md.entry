{"sections":[{"slug":"K-群(代数)","section":{"metadata":{"slug":{"Plain":"K-群(代数)"},"ext":{"Plain":"md"},"title":{"Plain":"“K-<span lang=\"zh\">群</span> (<span lang=\"zh\">代数</span>)”"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"“K-群 (代数)”"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">定义</span></h2>\n<h3><span lang=\"zh\">代数簇</span></h3>\n<p><span lang=\"zh\">设</span> $X$ <span lang=\"zh\">是</span>"},{"Local":{"url":"/代数簇","text":"<span lang=\"zh\">代数簇</span>"}},{"Plain":", <span lang=\"zh\">考虑</span> $X$ <span lang=\"zh\">上有限秩向量丛的范畴</span> $\\mathcal P(X)$. <span lang=\"zh\">定义</span> $K_0(X)$ <span lang=\"zh\">为</span> $\\mathcal P(X)$ <span lang=\"zh\">的同构类在</span> “<span lang=\"zh\">短正合列中间等于两边之和</span>” <span lang=\"zh\">的关系下生成的交换群</span>.</p>\n<h3><span lang=\"zh\">仿射簇</span></h3>\n<p><span lang=\"zh\">在</span> $X=\\operatorname{spec}R$ <span lang=\"zh\">的情形</span>, $X$ <span lang=\"zh\">上的向量丛对应</span> $R$ <span lang=\"zh\">上的有限生成</span>"},{"Local":{"url":"/投射模","text":"<span lang=\"zh\">投射模</span>"}},{"Plain":".</p>\n<h2><span lang=\"zh\">相关概念</span></h2>\n<p>"},{"Local":{"url":"/K-群(拓扑)","text":"K-<span lang=\"zh\">群</span> (<span lang=\"zh\">拓扑</span>)"}},{"Plain":", "},{"Local":{"url":"/向量丛-投射模类比","text":"<span lang=\"zh\">向量丛</span>-<span lang=\"zh\">投射模类比</span>"}},{"Plain":"</p>\n"}]}}}]}