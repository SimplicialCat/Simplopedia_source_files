{"sections":[{"slug":"群短正合列","section":{"metadata":{"slug":{"Plain":"群短正合列"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">群的短正合列</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"群的短正合列"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">性质</span></h2>\n<h3><span lang=\"zh\">纤维列</span></h3>\n<p><span lang=\"zh\">群的短正合列</span> $K \\to G \\to H$ <span lang=\"zh\">给出</span>"},{"Local":{"url":"/纤维列","text":"<span lang=\"zh\">纤维列</span>"}},{"Plain":"\n$$\r\nK\\to G \\to H\\to\\mathbf{B}K \\to \\mathbf{B}G \\to\\mathbf{B}H,\r\n$$\n<span lang=\"zh\">从而有以下看法</span>:</p>\n<ul>\n<li>$\\mathbf{B}K\\to\\mathbf{B}G$ <span lang=\"zh\">是一个</span> $H$-"},{"Local":{"url":"/主丛","text":"<span lang=\"zh\">主丛</span>"}},{"Plain":";</li>\n<li>$H\\to \\mathbf{B}K$ <span lang=\"zh\">是一个</span> $G$-"},{"Local":{"url":"/主丛","text":"<span lang=\"zh\">主丛</span>"}},{"Plain":";</li>\n<li>$G\\to H$ <span lang=\"zh\">是一个</span> $K$-"},{"Local":{"url":"/主丛","text":"<span lang=\"zh\">主丛</span>"}},{"Plain":";</li>\n</ul>\n<p><span lang=\"zh\">换言之</span>,</p>\n<ul>\n<li>$H$ <span lang=\"zh\">在</span> $\\mathbf{B}K$ <span lang=\"zh\">上有一</span>"},{"Local":{"url":"/群作用","text":"<span lang=\"zh\">作用</span>"}},{"Plain":", <span lang=\"zh\">其商为</span> $(\\mathbf{B}K) / H = \\mathbf{B}G$;</li>\n<li>$G$ <span lang=\"zh\">在</span> $H$ <span lang=\"zh\">上有一</span>"},{"Local":{"url":"/群作用","text":"<span lang=\"zh\">作用</span>"}},{"Plain":", <span lang=\"zh\">其商为</span> $H / G = \\mathbf{B}K$;</li>\n<li>$K$ <span lang=\"zh\">在</span> $G$ <span lang=\"zh\">上有一</span>"},{"Local":{"url":"/群作用","text":"<span lang=\"zh\">作用</span>"}},{"Plain":", <span lang=\"zh\">其商为</span> $G / K = H$.</li>\n</ul>\n<h3><span lang=\"zh\">分裂短正合列</span></h3>\n<p><span lang=\"zh\">称短正合列</span> $K \\to G \\to H$ <strong><span lang=\"zh\">分裂</span></strong> (split) <span lang=\"zh\">是指</span> $G \\to H$ <span lang=\"zh\">有作为群同态的</span><strong><span lang=\"zh\">截面</span></strong> $H\\to G$. <span lang=\"zh\">分裂的短正合列中</span>, $G$ <span lang=\"zh\">是</span> $K$ <span lang=\"zh\">与</span> $H$ <span lang=\"zh\">的</span>"},{"Local":{"url":"/半直积","text":"<span lang=\"zh\">半直积</span>"}},{"Plain":".</p>\n"}]}}}]}