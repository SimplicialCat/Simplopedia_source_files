{"sections":[{"slug":"射影空间","section":{"metadata":{"slug":{"Plain":"射影空间"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">射影空间</span> (<span lang=\"zh\">代数几何</span>)"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"subject":{"Lazy":[{"Local":{"url":"/代数几何","text":"<span lang=\"zh\">代数几何</span>"}}]},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"射影空间 (代数几何)"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">观念</span></h2>\n<p><span lang=\"zh\">线性空间的射影空间是直线的</span>"},{"Local":{"url":"/模空间","text":"<span lang=\"zh\">模空间</span>"}},{"Plain":", <span lang=\"zh\">是</span> "},{"Local":{"url":"/乘法群概形","text":"$\\mathbb G_m$"}},{"Plain":"-<span lang=\"zh\">作用的商</span>.</p>\n<h2><span lang=\"zh\">定义</span></h2>\n<p><span lang=\"zh\">射影空间</span> $\\mathbb P^n$ <span lang=\"zh\">是</span> $\\mathbb{Z}[x_0,x_1,\\cdots,x_n]$ <span lang=\"zh\">的</span>"},{"Local":{"url":"/射影谱","text":"<span lang=\"zh\">射影谱</span>"}},{"Plain":".</p>\n<h2><span lang=\"zh\">性质</span></h2>\n<h3><span lang=\"zh\">射影空间上的线丛</span></h3>\n<p>$O(1)$ <span lang=\"zh\">是</span>"},{"Local":{"url":"/正线丛","text":"<span lang=\"zh\">正线丛</span>"}},{"Plain":", <span lang=\"zh\">又称</span>"},{"Local":{"url":"/超平面丛","text":"<span lang=\"zh\">超平面丛</span>"}},{"Plain":", <span lang=\"zh\">其</span>"},{"Local":{"url":"/整体截面","text":"<span lang=\"zh\">整体截面</span>"}},{"Plain":"<span lang=\"zh\">是</span> $1$ <span lang=\"zh\">次齐次多项式</span>.</p>\n<p>"},{"Local":{"url":"/重言丛","text":"<span lang=\"zh\">重言丛</span>"}},{"Plain":"<span lang=\"zh\">是</span> $O(1)$ <span lang=\"zh\">的对偶</span> $O(-1)$.</p>\n"}]}}}]}