{"metadata":{"author":[{"Lazy":[{"Local":{"url":"SimplicialCat","text":"SimplicialCat"}}]},4],"ext":[{"Plain":"md"},1],"slug":[{"Plain":"积幺半范畴"},0],"title":[{"Plain":"积幺半范畴"},2],"tag":[{"Plain":"百科"},3]},"content":{"Lazy":[{"Plain":"\n<h2>定义</h2>\n<p>积幺半范畴 (Cartesian monoidal category) 是以"},{"Local":{"url":"积(范畴论)","text":"范畴论乘积"}},{"Plain":"为张量积的"},{"Local":{"url":"幺半范畴","text":"幺半范畴"}},{"Plain":", 从而是"},{"Local":{"url":"对称幺半范畴","text":"对称幺半范畴"}},{"Plain":".</p>\n"}]}}