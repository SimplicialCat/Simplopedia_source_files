{"metadata":{"author":[{"Lazy":[{"Local":{"url":"SimplicialCat","text":"SimplicialCat"}}]},5],"tag":[{"Plain":"百科"},3],"title":[{"Plain":"完备化 (稳定同伦论)"},2],"ext":[{"Plain":"md"},1],"subject":[{"Lazy":[{"Local":{"url":"稳定同伦论","text":"稳定同伦论"}}]},4],"slug":[{"Plain":"完备化(稳定同伦论)"},0]},"content":{"Lazy":[{"Plain":"\n<h2>观念</h2>\n<h2>定义</h2>\n<p>对于素数 $p$, "},{"Local":{"url":"Moore谱","text":"Moore 谱"}},{"Plain":" $M\\mathbb{Z}/p$ 处的"},{"Local":{"url":"Bousfield局部化","text":"局部化"}},{"Plain":"称为 $p$-<strong>完备化</strong>.</p>\n"}]}}