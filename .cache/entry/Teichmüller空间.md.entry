{"sections":[{"slug":"Teichmüller空间","section":{"metadata":{"slug":{"Plain":"Teichmüller空间"},"ext":{"Plain":"md"},"title":{"Plain":"“Teichmüller <span lang=\"zh\">空间</span>”"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"“Teichmüller 空间”"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<p>Teichmüller <span lang=\"zh\">空间是给定</span> $2$ <span lang=\"zh\">维流形</span> $\\Sigma$ <span lang=\"zh\">上复结构的模空间</span>, <span lang=\"zh\">其关于</span> $\\Sigma$ <span lang=\"zh\">所有自同胚的商是</span>"},{"Local":{"url":"/曲线的模空间","text":"<span lang=\"zh\">曲线的模空间</span>"}},{"Plain":".</p>\n"}]}}}]}