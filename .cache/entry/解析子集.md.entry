{"sections":[{"slug":"解析子集","section":{"metadata":{"slug":{"Plain":"解析子集"},"ext":{"Plain":"md"},"title":{"Plain":"“<span lang=\"zh\">解析子集</span>”"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"“解析子集”"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">定义</span></h2>\n<p><span lang=\"zh\">设</span> $M$ <span lang=\"zh\">为</span>"},{"Local":{"url":"/复流形","text":"<span lang=\"zh\">复流形</span>"}},{"Plain":". <span lang=\"zh\">对于子集</span> $A \\subset M$, <span lang=\"zh\">称</span> $A$ <span lang=\"zh\">为解析子集</span>, <span lang=\"zh\">是指</span> $A$ <span lang=\"zh\">在局部上可以写成</span> (<span lang=\"zh\">不恒为零的</span>) <span lang=\"zh\">全纯函数的零点集</span>.</p>\n<p><span lang=\"zh\">称</span> $A$ <span lang=\"zh\">为超曲面</span> (<span lang=\"zh\">余维数</span> $1$ <span lang=\"zh\">的解析子集</span>), <span lang=\"zh\">是指</span> $A$ <span lang=\"zh\">在局部上可以写成一个全纯函数的零点集</span>.</p>\n"}]}}}]}