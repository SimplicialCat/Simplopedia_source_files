{"sections":[{"slug":"泛包络代数(算畴)","section":{"metadata":{"slug":{"Plain":"泛包络代数(算畴)"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">泛包络代数</span> (<span lang=\"zh\">算畴上的代数</span>)"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"泛包络代数 (算畴上的代数)"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">定义</span></h2>\n<p>(<span lang=\"zh\">单色</span>, <span lang=\"zh\">对称</span>) "},{"Local":{"url":"/算畴","text":"<span lang=\"zh\">算畴</span>"}},{"Plain":"<span lang=\"zh\">上的</span>"},{"Local":{"url":"/算畴上的代数","text":"<span lang=\"zh\">代数</span>"}},{"Plain":" $A$ <span lang=\"zh\">的</span><strong><span lang=\"zh\">泛包络代数</span></strong> $\\mathcal U A$ <span lang=\"zh\">是一个</span>"},{"Local":{"url":"/结合代数","text":"<span lang=\"zh\">结合代数</span>"}},{"Plain":", <span lang=\"zh\">满足</span> $A$-"},{"Local":{"url":"/OpAlgMod","text":"<span lang=\"zh\">模</span>"}},{"Plain":"<span lang=\"zh\">等同于</span> $\\mathcal UA$-"},{"Local":{"url":"/结合代数上的模","text":"<span lang=\"zh\">模</span>"}},{"Plain":". (<span lang=\"zh\">前者是算畴上的代数上的模</span>, <span lang=\"zh\">后者是结合代数上的模</span>, <span lang=\"zh\">两个概念不太一样</span>.)</p>\n<h3><span lang=\"zh\">生成元</span>–<span lang=\"zh\">关系</span></h3>\n<p><span lang=\"zh\">将</span>"},{"Local":{"url":"/算畴","text":"<span lang=\"zh\">算畴</span>"}},{"Plain":" $\\mathcal O$ <span lang=\"zh\">视为</span>"},{"Local":{"url":"/对称序列","text":"<span lang=\"zh\">对称序列</span>"}},{"Plain":" $\\{\\mathcal O(n)\\}$, <span lang=\"zh\">则其上的</span>"},{"Local":{"url":"/算畴上的代数","text":"<span lang=\"zh\">代数</span>"}},{"Plain":" $A$ <span lang=\"zh\">的</span><strong><span lang=\"zh\">泛包络代数</span></strong> $\\mathcal U A$ <span lang=\"zh\">有如下生成元</span>–<span lang=\"zh\">关系</span>"},{"Local":{"url":"/数学对象的表现","text":"<span lang=\"zh\">表现</span>"}},{"Plain":": <span lang=\"zh\">直观上</span>, <span lang=\"zh\">想象一个一般的</span> $A$-"},{"Local":{"url":"/OpAlgMod","text":"<span lang=\"zh\">模</span>"}},{"Plain":" $M$,</p>\n<ul>\n<li>$\\mathcal UA$ <span lang=\"zh\">的生成元为</span> “<span lang=\"zh\">算子</span>” $f(a_1,\\cdots,a_{n-1},-)\\colon M\\to M$, $f\\in\\mathcal O(n)$, $a_i\\in A\\,(i=1,\\cdots,n-1)$;</li>\n<li><span lang=\"zh\">生成元之间有如下关系</span> (<span lang=\"zh\">以</span> $a$ <span lang=\"zh\">表示</span> $A$ <span lang=\"zh\">的若干个元素</span>):\n<ul>\n<li>$f(g(a),-) = h(a,-)$, <span lang=\"zh\">其中</span> $h = f \\circ (g,\\mathrm{id})$;</li>\n<li>$f(a,-) g(a',-) = k(a,a',-)$, <span lang=\"zh\">其中</span> $k = f\\circ (\\mathrm{id},g)$.</li>\n</ul>\n</li>\n</ul>\n<h2><span lang=\"zh\">例</span></h2>\n<h3>$\\mathbb E_n$-<span lang=\"zh\">代数</span></h3>\n<p>$\\mathbb E_n$-<span lang=\"zh\">代数</span> $A$ <span lang=\"zh\">的泛包络代数为</span> “<span lang=\"zh\">球壳</span>” $S^{n-1}\\times\\mathbb{R}$ <span lang=\"zh\">上的</span>"},{"Local":{"url":"/分解同调","text":"<span lang=\"zh\">分解同调</span>"}},{"Plain":"\n$$\r\n\\int_{S^{n-1}\\times\\mathbb{R}}A.\r\n$$</p>\n<p><span lang=\"zh\">例如</span> $n=1$ <span lang=\"zh\">时</span>, $\\mathbb E_1$-<span lang=\"zh\">代数</span> $A$ <span lang=\"zh\">的泛包络代数为</span> $A\\otimes A^{\\mathrm{op}}$.</p>\n<h3>Lie <span lang=\"zh\">代数</span></h3>\n<p>"},{"Local":{"url":"/Lie代数","text":"Lie <span lang=\"zh\">代数</span>"}},{"Plain":"<span lang=\"zh\">的</span>"},{"Local":{"url":"/泛包络代数","text":"<span lang=\"zh\">泛包络代数</span>"}},{"Plain":"<span lang=\"zh\">是算畴上的代数的泛包络代数的特例</span>.</p>\n"}]}}}]}