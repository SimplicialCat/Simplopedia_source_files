{"sections":[{"slug":"交换代数","section":{"metadata":{"slug":{"Plain":"交换代数"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">交换代数</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"交换代数"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<p><span lang=\"zh\">交换代数又称</span> $\\mathbb E_\\infty$-<span lang=\"zh\">代数</span>, <span lang=\"zh\">即</span>"},{"Local":{"url":"/E∞-算畴","text":"<span lang=\"zh\">交换算畴</span>"}},{"Plain":"<span lang=\"zh\">上的代数</span>.</p>\n<h2><span lang=\"zh\">定义</span></h2>\n<h3><span lang=\"zh\">使用语法范畴</span></h3>\n<h4><span lang=\"zh\">积幺半范畴</span></h4>\n<p><span lang=\"zh\">在</span>"},{"Local":{"url":"/积幺半范畴","text":"<span lang=\"zh\">积幺半范畴</span>"}},{"Plain":"<span lang=\"zh\">中</span>, <span lang=\"zh\">交换代数是交换幺半群的</span> "},{"Local":{"url":"/Lawvere理论","text":"Lawvere <span lang=\"zh\">理论</span>"}},{"Plain":"<span lang=\"zh\">的模型</span>, <span lang=\"zh\">即其</span>"},{"Local":{"url":"/语法范畴","text":"<span lang=\"zh\">语法范畴</span>"}},{"Plain":"<span lang=\"zh\">为有限生成自由交换幺半群的范畴的对偶</span>, <span lang=\"zh\">具体地</span>:</p>\n<ul>\n<li><span lang=\"zh\">其对象为有限集</span>;</li>\n<li><span lang=\"zh\">态射</span> $\\{x_1,\\cdots,x_n\\}\\to \\{y_1,\\cdots,y_m\\}$ <span lang=\"zh\">为自然数的</span> $m\\times n$ <span lang=\"zh\">矩阵</span>; <span lang=\"zh\">等价地</span>, <span lang=\"zh\">一个态射是</span> $\\{y_1,\\cdots,y_m\\}$ <span lang=\"zh\">到</span> $\\{x_1,\\cdots,x_n\\}$ <span lang=\"zh\">生成的自由交换幺半群的一个集合映射</span>.</li>\n</ul>\n<p><span lang=\"zh\">那么</span>"},{"Local":{"url":"/积幺半范畴","text":"<span lang=\"zh\">积幺半范畴</span>"}},{"Plain":" $\\mathcal C$ <span lang=\"zh\">中的交换代数即是上述范畴到</span> $\\mathcal C$ <span lang=\"zh\">的保持有限</span>"},{"Local":{"url":"/积(范畴论)","text":"<span lang=\"zh\">积</span>"}},{"Plain":"<span lang=\"zh\">的函子</span>.</p>\n<p><span lang=\"zh\">另一种定义只需提供较少的信息</span>. <span lang=\"zh\">考虑</span>"},{"Local":{"url":"/带基点对象","text":"<span lang=\"zh\">带基点</span>"}},{"Plain":"<span lang=\"zh\">有限集的范畴</span> $\\mathsf{Fin}_*$ (<span lang=\"zh\">这个范畴也等价于有限集与</span>"},{"Local":{"url":"/部分映射","text":"<span lang=\"zh\">部分映射</span>"}},{"Plain":"<span lang=\"zh\">的范畴</span>).\n<span lang=\"zh\">对于</span>"},{"Local":{"url":"/积幺半范畴","text":"<span lang=\"zh\">积幺半范畴</span>"}},{"Plain":" $\\mathcal C$, <span lang=\"zh\">其中的交换代数可等价地定义为函子</span> $F\\colon \\mathsf{Fin}_* \\to \\mathcal C$, <span lang=\"zh\">满足</span>\n$$\r\nF(n) \\to \\prod_{i=1}^n F(1)\r\n$$\n<span lang=\"zh\">为等价</span>. "},{"Local":{"url":"/LurieHA","text":"Lurie HA"}},{"Plain":" <span lang=\"zh\">本质上使用的是这种定义</span>.</p>\n<h4><span lang=\"zh\">一般对称幺半范畴</span></h4>\n<p><span lang=\"zh\">一般的</span>"},{"Local":{"url":"/对称幺半范畴","text":"<span lang=\"zh\">对称幺半范畴</span>"}},{"Plain":"<span lang=\"zh\">中</span>, <span lang=\"zh\">交换代数可用</span> "},{"Local":{"url":"/PROP","text":"PROP"}},{"Plain":" <span lang=\"zh\">定义</span>. <span lang=\"zh\">具体地</span>, <span lang=\"zh\">考虑有限集的范畴</span> $\\mathsf{Fin}$ <span lang=\"zh\">配备</span>"},{"Local":{"url":"/和(范畴论)","text":"<span lang=\"zh\">余积</span>"}},{"Plain":"<span lang=\"zh\">幺半结构</span>. <span lang=\"zh\">对任意对称幺半范畴</span> $\\mathcal C$, <span lang=\"zh\">其中的交换代数等同于对称幺半函子</span> $\\mathsf{Fin} \\to \\mathcal C$.</p>\n"}]}}}]}