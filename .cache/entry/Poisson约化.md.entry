{"sections":[{"slug":"Poisson约化","section":{"metadata":{"slug":{"Plain":"Poisson约化"},"ext":{"Plain":"md"},"title":{"Plain":"Poisson <span lang=\"zh\">约化</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"Poisson 约化"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<p><span lang=\"zh\">设</span> $M$ <span lang=\"zh\">为</span> "},{"Local":{"url":"/Poisson流形","text":"Poisson <span lang=\"zh\">流形</span>"}},{"Plain":", <span lang=\"zh\">带有</span> Lie <span lang=\"zh\">群</span> $G$ <span lang=\"zh\">的典范作用</span>, <span lang=\"zh\">则轨道空间</span> $M / G$ (<span lang=\"zh\">若仍为流形</span>) <span lang=\"zh\">具有</span> Poisson <span lang=\"zh\">流形结构</span>, <span lang=\"zh\">满足</span>\n$$\r\n\\{f,g\\}_{M / G} ([m]) = \\{f,g\\}_M(m).\r\n$$\n<span lang=\"zh\">其中</span> $f,g$ <span lang=\"zh\">为</span> $M/G$ <span lang=\"zh\">上的光滑函数</span>, <span lang=\"zh\">也即</span> $M$ <span lang=\"zh\">上的</span> $G$-<span lang=\"zh\">等变光滑函数</span>.</p>\n"}]}}}]}