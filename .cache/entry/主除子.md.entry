{"sections":[{"slug":"主除子","section":{"metadata":{"slug":{"Plain":"主除子"},"ext":{"Plain":"md"},"title":{"Plain":"“<span lang=\"zh\">主除子</span>”"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"“主除子”"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">定义</span></h2>\n<p><span lang=\"zh\">设</span> $f$ <span lang=\"zh\">是</span>"},{"Local":{"url":"/复流形","text":"<span lang=\"zh\">复流形</span>"}},{"Plain":" $M$ <span lang=\"zh\">上的亚纯函数</span>, <span lang=\"zh\">除子</span> $(f)$ <span lang=\"zh\">称为主除子</span> (principal divisor).</p>\n<h2><span lang=\"zh\">性质</span></h2>\n<p><span lang=\"zh\">主除子在除子与</span>"},{"Local":{"url":"/线丛","text":"<span lang=\"zh\">线丛</span>"}},{"Plain":"<span lang=\"zh\">的对应中对应平凡线丛</span>.</p>\n"}]}}}]}