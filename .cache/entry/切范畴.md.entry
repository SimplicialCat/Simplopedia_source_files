{"metadata":{"author":[{"Lazy":[{"Local":{"url":"SimplicialCat","text":"SimplicialCat"}}]},4],"ext":[{"Plain":"md"},1],"slug":[{"Plain":"切范畴"},0],"tag":[{"Plain":"百科"},3],"title":[{"Plain":"切范畴"},2]},"content":{"Lazy":[{"Plain":"\n<h2>定义</h2>\n<p>设 $\\mathcal C$ 为"},{"Local":{"url":"可表现范畴","text":"可表现范畴"}},{"Plain":". 对于 $\\mathcal C$ 的对象 $X$, 定义其<strong>切范畴</strong>为"},{"Local":{"url":"俯范畴","text":"俯范畴"}},{"Plain":"的"},{"Local":{"url":"稳定化","text":"稳定化"}},{"Plain":"\n$$\r\nT_X\\mathcal C := \\operatorname{Stab}(\\mathcal C_{/X}).\r\n$$</p>\n"}]}}