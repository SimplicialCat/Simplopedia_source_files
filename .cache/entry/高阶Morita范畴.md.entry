{"sections":[{"slug":"高阶Morita范畴","section":{"metadata":{"slug":{"Plain":"高阶Morita范畴"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">高阶</span> Morita <span lang=\"zh\">范畴</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"高阶 Morita 范畴"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">观念</span></h2>\n<p><span lang=\"zh\">设</span> $n\\in\\mathbb{N}_{\\geq 0}$ <span lang=\"zh\">为自然数</span>, $\\mathcal C$ <span lang=\"zh\">为对称幺半</span> $(\\infty ,1)$-<span lang=\"zh\">范畴</span> (<span lang=\"zh\">或更一般的</span> "},{"Local":{"url":"/En-代数","text":"$\\mathbb E_n$-<span lang=\"zh\">幺半</span>"}},{"Plain":" $(\\infty ,1)$-<span lang=\"zh\">范畴</span>), <span lang=\"zh\">可构造一个</span> $(\\infty ,n+1)$-<span lang=\"zh\">范畴</span> $\\mathsf{Morita}_{n}(\\mathcal C)$,</p>\n<ul>\n<li>$\\mathsf{Morita}_{n}(\\mathcal C)$ <span lang=\"zh\">的对象为</span> $\\mathcal C$ <span lang=\"zh\">中的</span> "},{"Local":{"url":"/En-代数","text":"$\\mathbb E_n$-<span lang=\"zh\">代数</span>"}},{"Plain":";</li>\n<li>$\\mathsf{Morita}_{n}(\\mathcal C)$ <span lang=\"zh\">的对象为</span> $\\mathcal C$ <span lang=\"zh\">中两个对象</span> $A,B$ <span lang=\"zh\">之间的态射范畴为双模范畴</span> $\\mathsf{BiMod}(A,B)$ <span lang=\"zh\">的低一阶的</span> Morita <span lang=\"zh\">范畴</span>$$\r\n\\operatorname{Hom}_{\\mathsf{Morita}_{n}(\\mathcal C)}(A,B)=\\mathsf{Morita}_{(n-1)}(\\mathsf{BiMod}(A,B)).\r\n$$</li>\n</ul>\n<p><span lang=\"zh\">作为归纳定义的起点</span>, <span lang=\"zh\">定义</span> $\\mathsf{Morita}_0(\\mathcal C) = \\mathcal C$.</p>\n<p><span lang=\"zh\">当</span> $n=1$ <span lang=\"zh\">时这就是通常的</span> "},{"Local":{"url":"/Morita范畴","text":"Morita <span lang=\"zh\">范畴</span>"}},{"Plain":".</p>\n<p><span lang=\"zh\">与通常的</span> Morita <span lang=\"zh\">范畴类似</span>, <span lang=\"zh\">高阶</span> Morita <span lang=\"zh\">范畴也可视为由</span>"},{"Local":{"url":"/高阶模","text":"<span lang=\"zh\">高阶模范畴</span>"}},{"Plain":"<span lang=\"zh\">构成的范畴</span>, <span lang=\"zh\">其中</span> $\\mathbb E_n$-<span lang=\"zh\">代数</span> $A$ <span lang=\"zh\">代表的是它上面的</span> $n$ <span lang=\"zh\">阶模范畴</span> $\\mathsf{Mod}(\\mathsf{Mod}(\\cdots\\mathsf{Mod}(A)\\cdots))$.</p>\n<h2><span lang=\"zh\">性质</span></h2>\n<h3><span lang=\"zh\">分解同调与拓扑场论</span></h3>\n<p><span lang=\"zh\">对称幺半</span> $(\\infty ,1)$-<span lang=\"zh\">范畴</span> $\\mathcal C$ <span lang=\"zh\">中的</span> "},{"Local":{"url":"/En-代数","text":"$\\mathbb E_n$-<span lang=\"zh\">代数</span>"}},{"Plain":" $A$ <span lang=\"zh\">给出一个取值于</span> Morita <span lang=\"zh\">范畴</span> $\\mathsf{Morita}_{n}(\\mathcal C)$ <span lang=\"zh\">的</span> $n$ <span lang=\"zh\">维</span>"},{"Local":{"url":"/拓扑场论","text":"<span lang=\"zh\">拓扑场论</span>"}},{"Plain":" $\\mathsf{Bord}_n^{\\mathrm{fr}} \\to \\mathsf{Morita}_{n}(\\mathcal C)$. <span lang=\"zh\">对于自然数</span> $0\\leq k\\leq n$, <span lang=\"zh\">该函子将</span> $\\mathsf{Bord}_n^{\\mathrm{fr}}$ <span lang=\"zh\">中的</span> $k$-<span lang=\"zh\">态射</span> ($k$ <span lang=\"zh\">维标架配边</span>) $M$ <span lang=\"zh\">对应到</span>"},{"Local":{"url":"/分解同调","text":"<span lang=\"zh\">分解同调</span>"}},{"Plain":"\n$$\r\nM \\mapsto \\int_{M\\times\\mathbb{R}^{n-k}}A.\r\n$$\n<span lang=\"zh\">注意</span> $\\int_{M\\times\\mathbb{R}^{n-k}}A$ <span lang=\"zh\">具有</span> $\\mathbb E_{n-k}$-<span lang=\"zh\">结构</span>.\n<span lang=\"zh\">特别地</span>, <span lang=\"zh\">该函子将一个点</span> $\\mathrm{pt}$ <span lang=\"zh\">对应到</span> $\\mathbb E_n$-<span lang=\"zh\">代数</span> $A$ <span lang=\"zh\">自身</span>.</p>\n"}]}}}]}