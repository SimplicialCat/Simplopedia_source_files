{"sections":[{"slug":"可表函子","section":{"metadata":{"slug":{"Plain":"可表函子"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">可表函子</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"可表函子"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">定义</span></h2>\n<p><span lang=\"zh\">可表函子是</span>"},{"Local":{"url":"/米田嵌入","text":"<span lang=\"zh\">米田嵌入</span>"}},{"Plain":"<span lang=\"zh\">的像</span>. <span lang=\"zh\">对于范畴</span> $\\mathcal C$ <span lang=\"zh\">的对象</span> $X$,</p>\n<ul>\n<li><span lang=\"zh\">称函子</span> $\\mathbf{y}(X):=\\operatorname{Hom}(-,X)\\colon \\mathcal C^{\\mathrm{op}} \\to \\mathsf{Set}$ <span lang=\"zh\">为对象</span> $X$ <strong><span lang=\"zh\">表示</span></strong><span lang=\"zh\">的函子</span>;</li>\n<li><span lang=\"zh\">称函子</span> $\\operatorname{Hom}(X,-)\\colon \\mathcal C \\to \\mathsf{Set}$ <span lang=\"zh\">为对象</span> $X$ <strong><span lang=\"zh\">余表示</span></strong><span lang=\"zh\">的函子</span>.</li>\n</ul>\n"}]}}}]}