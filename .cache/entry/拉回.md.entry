{"sections":[{"slug":"拉回","section":{"metadata":{"slug":{"Plain":"拉回"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">拉回</span> (<span lang=\"zh\">范畴论</span>)"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"拉回 (范畴论)"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<p><span lang=\"zh\">在一个范畴中</span>, <strong><span lang=\"zh\">拉回</span></strong> (pullback) <span lang=\"zh\">一般是指以如下范畴为指标范畴的</span>"},{"Local":{"url":"/极限","text":"<span lang=\"zh\">极限</span>"}},{"Plain":":\n$$\r\n\\begin{array}\r\n{ccc}\r\n&amp;&amp;\\bullet\\\\\r\n&amp;&amp;\\downarrow\\\\\r\n\\bullet &amp; \\to &amp;\\bullet\r\n\\end{array}\r\n$$\n“<span lang=\"zh\">多个对象指向一个对象</span>” <span lang=\"zh\">的指标范畴的极限也可称为拉回</span>.</p>\n<p><span lang=\"zh\">另见</span>"},{"Local":{"url":"/推前","text":"<span lang=\"zh\">拉回</span> (<span lang=\"zh\">纤维范畴</span>)"}},{"Plain":".</p>\n"}]}}}]}