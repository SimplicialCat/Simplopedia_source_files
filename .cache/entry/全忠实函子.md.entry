{"sections":[{"slug":"全忠实函子","section":{"metadata":{"slug":{"Plain":"全忠实函子"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">全忠实函子</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"全忠实函子"},"data-taxon":{"Plain":"百科"}},"content":{"Plain":"\n<p><strong><span lang=\"zh\">全忠实函子</span></strong> (fully faithful functor) <span lang=\"zh\">又称</span><strong><span lang=\"zh\">全子范畴</span></strong> (full subcategory), <span lang=\"zh\">是满足如下条件的函子</span> $F\\colon \\mathcal C\\to\\mathcal D$: <span lang=\"zh\">对任意对象</span> $X,Y\\in\\mathcal C$, <span lang=\"zh\">映射</span> $\\mathcal C(X,Y) \\to \\mathcal D(F(X),F(Y))$ <span lang=\"zh\">为等价</span>.</p>\n"}}}]}