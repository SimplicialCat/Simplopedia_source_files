{"sections":[{"slug":"BTop_n","section":{"metadata":{"slug":{"Plain":"BTop_n"},"ext":{"Plain":"md"},"title":{"Plain":"BTop_n"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"BTop_n"},"data-taxon":{"Plain":"百科"}},"content":{"Plain":"\n<p>$\\mathsf{BTop}(n)$ <span lang=\"zh\">是</span> $n$ <span lang=\"zh\">维流形范畴</span> $\\mathsf{Mfd}_n$ <span lang=\"zh\">中由一个对象</span> $\\mathbb{R}^n$ <span lang=\"zh\">构成的全子范畴</span>, <span lang=\"zh\">是</span></p>\n"}}}]}