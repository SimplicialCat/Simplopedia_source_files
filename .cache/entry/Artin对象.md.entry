{"sections":[{"slug":"Artin对象","section":{"metadata":{"slug":{"Plain":"Artin对象"},"ext":{"Plain":"md"},"title":{"Plain":"“Artin <span lang=\"zh\">对象</span>”"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"“Artin 对象”"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<p><span lang=\"zh\">在</span> "},{"Local":{"url":"/Abel范畴","text":"Abel <span lang=\"zh\">范畴</span>"}},{"Plain":"<span lang=\"zh\">中</span>, <span lang=\"zh\">满足子对象的降链条件的对象称为</span> Artin <span lang=\"zh\">对象</span>. <span lang=\"zh\">例如</span>, Artin <span lang=\"zh\">模就是指满足子模的降链条件的模</span>.</p>\n<p><span lang=\"zh\">另见</span> "},{"Local":{"url":"/Artin环","text":"Artin <span lang=\"zh\">环</span>"}},{"Plain":".</p>\n"}]}}}]}