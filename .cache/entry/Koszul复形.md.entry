{"sections":[{"slug":"Koszul复形","section":{"metadata":{"slug":{"Plain":"Koszul复形"},"ext":{"Plain":"md"},"title":{"Plain":"“Koszul <span lang=\"zh\">复形</span>”"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"“Koszul 复形”"},"data-taxon":{"Plain":"百科"}},"content":{"Plain":"\n<p><span lang=\"zh\">对于光滑概形</span> $X$ <span lang=\"zh\">上秩为</span> $r$ <span lang=\"zh\">的局部自由层</span> $F$ <span lang=\"zh\">的截面</span> $s$ <span lang=\"zh\">的零点集</span> $Y$, <span lang=\"zh\">有长正合列</span>\n$$\r\n0\\to \\bigwedge^r F^\\vee\\to\\cdots\\to F^\\vee \\to\\mathcal O_X\\to\\mathcal O_Y\\to 0.\r\n$$\n<span lang=\"zh\">换言之</span>, <span lang=\"zh\">有</span> $\\mathcal O_Y$ <span lang=\"zh\">的消解</span> $(\\bigwedge^\\bullet F^\\vee [1])\\to\\mathcal O_Y$.</p>\n"}}}]}