{"sections":[{"slug":"张量积","section":{"metadata":{"slug":{"Plain":"张量积"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">张量积</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"张量积"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">定义</span></h2>\n<p><span lang=\"zh\">这里所说的</span><strong><span lang=\"zh\">张量积</span></strong><span lang=\"zh\">特指如下概念</span>: <span lang=\"zh\">对于范畴</span> $\\mathcal C$ <span lang=\"zh\">的对象</span> $X$, <span lang=\"zh\">以及</span>"},{"Local":{"url":"/生象","text":"<span lang=\"zh\">生象</span>"}},{"Plain":" $A$, <strong><span lang=\"zh\">张量积</span></strong> $A\\cdot X$ <span lang=\"zh\">给出自然同构</span>\n$$\r\n\\operatorname{Hom}_{\\mathcal C}(A\\cdot X,-)\r\n\\simeq \\operatorname{Hom}_{\\mathsf{Ani}}(A,\\operatorname{Hom}_{\\mathcal C}(X,-)),\r\n$$\n<span lang=\"zh\">也即有</span>"},{"Local":{"url":"/伴随","text":"<span lang=\"zh\">伴随</span>"}},{"Plain":"\n$$\r\n(-)\\cdot X \\dashv \\operatorname{Hom}_{\\mathcal C}(X,-).\r\n$$\n<span lang=\"zh\">张量积</span> $A\\cdot X$ <span lang=\"zh\">也是</span> $A$ <span lang=\"zh\">形状</span>, <span lang=\"zh\">取值于</span> $X$ <span lang=\"zh\">的常值图表的余极限</span> $\\operatorname{colim}_A X$.</p>\n<p><span lang=\"zh\">当然</span>, "},{"Local":{"url":"/充实范畴","text":"<span lang=\"zh\">充实范畴</span>"}},{"Plain":"<span lang=\"zh\">的对象也有类似的张量积的概念</span>.</p>\n<h2><span lang=\"zh\">例</span></h2>\n<p><span lang=\"zh\">给定一个</span>"},{"Local":{"url":"/谱","text":"<span lang=\"zh\">谱</span>"}},{"Plain":" $E$, "},{"Local":{"url":"/生象","text":"<span lang=\"zh\">生象</span>"}},{"Plain":" $X$ <span lang=\"zh\">的</span> $E$-<span lang=\"zh\">值</span>"},{"Local":{"url":"/广义同调","text":"<span lang=\"zh\">广义同调</span>"}},{"Plain":"<span lang=\"zh\">为</span>\n$$\r\n\tE_*X = \\pi_*(X_+\\wedge E).\r\n$$\n<span lang=\"zh\">其中</span> $X_+\\wedge E$ <span lang=\"zh\">又可理解为</span> $\\mathsf{Sp}$ <span lang=\"zh\">的对象</span> $E$ <span lang=\"zh\">与生象</span> $X$ <span lang=\"zh\">的张量积</span>, <span lang=\"zh\">也即有</span>"},{"Local":{"url":"/伴随","text":"<span lang=\"zh\">伴随</span>"}},{"Plain":"\n$$\r\n    (-)_+\\wedge E \\dashv \\operatorname{Hom}_{\\mathsf{Sp}}(E,-).\r\n$$</p>\n<p><span lang=\"zh\">函子</span> $(-)_+\\wedge E\\colon \\mathsf{Ani} \\to \\mathsf{Sp}$ <span lang=\"zh\">保持余极限</span>, <span lang=\"zh\">因而被它在一个点上的取值完全决定</span>.</p>\n"}]}}}]}