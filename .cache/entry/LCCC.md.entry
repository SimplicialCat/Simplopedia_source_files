{"sections":[{"slug":"LCCC","section":{"metadata":{"slug":{"Plain":"LCCC"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">局部积闭范畴</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"局部积闭范畴"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">观念</span></h2>\n<p><span lang=\"zh\">局部积闭范畴是</span>"},{"Local":{"url":"/依值类型论","text":"<span lang=\"zh\">依值类型论</span>"}},{"Plain":"<span lang=\"zh\">的</span>"},{"Local":{"url":"/范畴语义","text":"<span lang=\"zh\">语义</span>"}},{"Plain":".</p>\n<h2><span lang=\"zh\">定义</span></h2>\n<p><strong><span lang=\"zh\">局部积闭范畴</span></strong> (locally Cartesian closed category, LCCC) $\\mathcal C$ <span lang=\"zh\">是满足所有</span>"},{"Local":{"url":"/俯范畴","text":"<span lang=\"zh\">俯范畴</span>"}},{"Plain":" $\\mathcal C_{/X}$ <span lang=\"zh\">均为</span>"},{"Local":{"url":"/积闭范畴","text":"<span lang=\"zh\">积闭范畴</span>"}},{"Plain":"<span lang=\"zh\">的范畴</span>. <span lang=\"zh\">通常我们要求</span> $\\mathcal C$ <span lang=\"zh\">有</span>"},{"Local":{"url":"/终对象","text":"<span lang=\"zh\">终对象</span>"}},{"Plain":" $1$, <span lang=\"zh\">从而</span> $\\mathcal C \\simeq\\mathcal C_{/1}$ <span lang=\"zh\">本身也是</span>"},{"Local":{"url":"/积闭范畴","text":"<span lang=\"zh\">积闭范畴</span>"}},{"Plain":".</p>\n<h2><span lang=\"zh\">性质</span></h2>\n<h3><span lang=\"zh\">依值积</span></h3>\n<p><span lang=\"zh\">对于局部积闭范畴</span> $\\mathcal C$ <span lang=\"zh\">中的态射</span> $f\\colon X\\to Y$, <span lang=\"zh\">俯范畴的拉回</span> $f^* \\colon \\mathcal C_{/Y} \\to \\mathcal C_{X}$ <span lang=\"zh\">同时有左伴随</span> $\\Sigma_f$ <span lang=\"zh\">与右伴随</span> $\\Pi_f$, <span lang=\"zh\">它们分别是</span>"},{"Local":{"url":"/依值和","text":"<span lang=\"zh\">依值和</span>"}},{"Plain":"<span lang=\"zh\">与</span>"},{"Local":{"url":"/依值积","text":"<span lang=\"zh\">依值积</span>"}},{"Plain":"<span lang=\"zh\">的</span>"},{"Local":{"url":"/语法–语义对偶","text":"<span lang=\"zh\">语义</span>"}},{"Plain":".</p>\n<h2><span lang=\"zh\">例</span></h2>\n<p>"},{"Local":{"url":"/意象","text":"<span lang=\"zh\">意象</span>"}},{"Plain":"<span lang=\"zh\">是局部积闭范畴</span>.</p>\n"}]}}}]}