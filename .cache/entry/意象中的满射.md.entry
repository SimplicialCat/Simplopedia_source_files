{"sections":[{"slug":"意象中的满射","section":{"metadata":{"slug":{"Plain":"意象中的满射"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">意象中的满射</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"subject":{"Lazy":[{"Local":{"url":"/意象理论","text":"<span lang=\"zh\">意象理论</span>"}}]},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"意象中的满射"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">定义</span></h2>\n<h3>∞-<span lang=\"zh\">意象</span></h3>\n<p>$\\infty$-<span lang=\"zh\">意象中的</span><strong><span lang=\"zh\">有效满射</span></strong> (effective epimorphism) <span lang=\"zh\">是可被</span> "},{"Local":{"url":"/Čech脉","text":"Čech <span lang=\"zh\">脉</span>"}},{"Local":{"url":"/几何实现(单纯图表的余极限)","text":"<span lang=\"zh\">实现</span>"}},{"Plain":"<span lang=\"zh\">的映射</span>, <span lang=\"zh\">也等价于</span> $0$-"},{"Local":{"url":"/截断性","text":"<span lang=\"zh\">截断</span>"}},{"Plain":"<span lang=\"zh\">后为</span> $1$-<span lang=\"zh\">意象中的</span> (<span lang=\"zh\">有效</span>) <span lang=\"zh\">满射</span>.</p>\n<h3>1-<span lang=\"zh\">意象</span>, <span lang=\"zh\">内语言定义</span></h3>\n<p>"},{"Local":{"url":"/意象","text":"$1$-<span lang=\"zh\">意象</span>"}},{"Plain":"<span lang=\"zh\">中的</span> (<span lang=\"zh\">有效</span>) <span lang=\"zh\">满射是</span>"},{"Local":{"url":"/意象的内语言","text":"<span lang=\"zh\">内语言</span>"}},{"Plain":"<span lang=\"zh\">中满足如下条件的映射</span> $f\\colon X\\to Y$:\n$$\r\n\\forall y\\in Y\\exists x\\in X \\, f(x) = y.\r\n$$</p>\n<p><span lang=\"zh\">注意这句话不能在外部语言中解释</span>; <span lang=\"zh\">不能推出</span> (<span lang=\"zh\">外部语言</span>) $f$ <span lang=\"zh\">存在截面</span>.</p>\n<h3><span lang=\"zh\">层意象</span></h3>\n<p>"},{"Local":{"url":"/层意象","text":"<span lang=\"zh\">层意象</span>"}},{"Plain":"<span lang=\"zh\">中的满射可用</span>"},{"Local":{"url":"/景","text":"<span lang=\"zh\">景</span>"}},{"Plain":"<span lang=\"zh\">的信息来定义</span>. <span lang=\"zh\">对于景</span> $(\\mathcal C,J)$ <span lang=\"zh\">上的</span>"},{"Local":{"url":"/景上的层","text":"<span lang=\"zh\">层</span>"}},{"Plain":" $X,Y$ <span lang=\"zh\">以及态射</span> $f\\colon X\\to Y$, $f$ <span lang=\"zh\">为</span>"},{"Local":{"url":"/层意象","text":"<span lang=\"zh\">层意象</span>"}},{"Plain":" $\\mathsf{Sh}(\\mathcal C,J)$ <span lang=\"zh\">中的满射当且仅当</span></p>\n<ul>\n<li><span lang=\"zh\">对任意</span> $U\\in\\mathcal C$ <span lang=\"zh\">与</span> $y\\in Y(U)$, <span lang=\"zh\">存在</span> $U$ <span lang=\"zh\">的</span> $J$-<span lang=\"zh\">覆盖</span> $\\{U_i\\to U\\}$ <span lang=\"zh\">以及</span> $x_i\\in X(U_i)$, <span lang=\"zh\">使得</span> $f_{U_i}(x_i) = y|_{U_i}$.</li>\n</ul>\n"}]}}}]}