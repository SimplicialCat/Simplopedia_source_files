{"sections":[{"slug":"投影公式","section":{"metadata":{"slug":{"Plain":"投影公式"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">投影公式</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"投影公式"},"data-taxon":{"Plain":"百科"}},"content":{"Plain":"\n<h2><span lang=\"zh\">陈述</span></h2>\n<p><span lang=\"zh\">对于概形态射</span> $p\\colon Y\\to X$, <span lang=\"zh\">令</span> $A = \\mathsf{QCoh}(X)$, $B = \\mathsf{QCoh}(Y)$, <span lang=\"zh\">则由拉回函子</span> $p^*\\colon A\\to B$, <span lang=\"zh\">有</span> $B$ <span lang=\"zh\">为</span> $A$-<span lang=\"zh\">代数</span>, <span lang=\"zh\">那么右伴随</span> $p_*\\colon B\\to A$ <span lang=\"zh\">同样为</span> $A$-<span lang=\"zh\">线性函子</span>:\n$$\r\np_*(p^*a \\otimes b) \\simeq a \\otimes p_* (b).\r\n$$</p>\n"}}}]}