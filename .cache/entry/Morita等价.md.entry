{"sections":[{"slug":"Morita等价","section":{"metadata":{"slug":{"Plain":"Morita等价"},"ext":{"Plain":"md"},"title":{"Plain":"Morita <span lang=\"zh\">等价</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"subject":{"Lazy":[{"Local":{"url":"/范畴论","text":"<span lang=\"zh\">范畴论</span>"}}]},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"Morita 等价"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">观念</span></h2>\n<p>Morita <span lang=\"zh\">等价是</span>"},{"Local":{"url":"/高阶模","text":"<span lang=\"zh\">模范畴</span>"}},{"Plain":"<span lang=\"zh\">的等价</span>. <span lang=\"zh\">通过追踪具有特殊范畴论性质的对象</span> ("},{"Local":{"url":"/紧投射生成元","text":"<span lang=\"zh\">有限生成投射生成元</span>"}},{"Plain":"), <span lang=\"zh\">可以给出</span> Morita <span lang=\"zh\">等价的具体刻画</span>.</p>\n<h2><span lang=\"zh\">定义</span></h2>\n<h3><span lang=\"zh\">代数</span></h3>\n<p><span lang=\"zh\">设</span> $k$ <span lang=\"zh\">为交换环</span>, $A,B$ <span lang=\"zh\">为</span> $k$ <span lang=\"zh\">上的</span>"},{"Local":{"url":"/结合代数","text":"<span lang=\"zh\">结合代数</span>"}},{"Plain":", <span lang=\"zh\">若如下等价条件成立</span>, <span lang=\"zh\">则称</span> $A$ <span lang=\"zh\">与</span> $B$ <strong>Morita <span lang=\"zh\">等价</span></strong>:</p>\n<ul>\n<li><span lang=\"zh\">左模范畴</span> $\\mathsf{LMod}(A)$ <span lang=\"zh\">与</span> $\\mathsf{LMod}(B)$ <span lang=\"zh\">等价</span>;</li>\n<li><span lang=\"zh\">右模范畴</span> $\\mathsf{RMod}(A)$ <span lang=\"zh\">与</span> $\\mathsf{RMod}(B)$ <span lang=\"zh\">等价</span>;</li>\n<li><span lang=\"zh\">存在</span> $(A,B)$-<span lang=\"zh\">双模</span> $M$ <span lang=\"zh\">与</span> $(B,A)$-<span lang=\"zh\">双模</span> $N$ <span lang=\"zh\">满足</span>$$\r\nM\\otimes_B N\\simeq A,\\,N\\otimes_A M\\simeq B.\r\n$$</li>\n<li>$A$ <span lang=\"zh\">同构于左</span> (<span lang=\"zh\">右</span>) $B$-<span lang=\"zh\">模范畴中某个</span>"},{"Local":{"url":"/紧投射生成元","text":"<span lang=\"zh\">有限生成投射生成元</span>"}},{"Plain":"<span lang=\"zh\">的自同态代数</span>.</li>\n<li>$B$ <span lang=\"zh\">同构于左</span> (<span lang=\"zh\">右</span>) $A$-<span lang=\"zh\">模范畴中某个</span>"},{"Local":{"url":"/紧投射生成元","text":"<span lang=\"zh\">有限生成投射生成元</span>"}},{"Plain":"<span lang=\"zh\">的自同态代数</span>.</li>\n</ul>\n<h3><span lang=\"zh\">充实范畴</span></h3>\n<p><span lang=\"zh\">设</span> $\\mathcal V$ <span lang=\"zh\">为</span> (<span lang=\"zh\">完备</span>, <span lang=\"zh\">余完备</span>) <span lang=\"zh\">闭</span>"},{"Local":{"url":"/对称幺半范畴","text":"<span lang=\"zh\">对称幺半范畴</span>"}},{"Plain":", <span lang=\"zh\">例如交换环</span> $R$ <span lang=\"zh\">上的模范畴</span> $\\mathsf{Mod}(R)$.</p>\n<p><span lang=\"zh\">回忆</span>, $\\mathcal V$ <span lang=\"zh\">中的</span>"},{"Local":{"url":"/结合代数","text":"<span lang=\"zh\">结合代数</span>"}},{"Plain":"<span lang=\"zh\">等同于仅有一个对象的</span> $\\mathcal V$-"},{"Local":{"url":"/充实范畴","text":"<span lang=\"zh\">充实范畴</span>"}},{"Plain":". <span lang=\"zh\">所以结合代数的</span> Morita <span lang=\"zh\">等价是下面的概念的特例</span>:</p>\n<p><strong><span lang=\"zh\">定义</span></strong>. <span lang=\"zh\">对于两个</span> $\\mathcal V$-"},{"Local":{"url":"/充实范畴","text":"<span lang=\"zh\">充实范畴</span>"}},{"Plain":" $\\mathcal A,\\mathcal B$, <span lang=\"zh\">定义其</span> <strong>Morita <span lang=\"zh\">等价</span></strong><span lang=\"zh\">为如下两个等价的条件</span>:</p>\n<ul>\n<li>$\\mathcal V$-<span lang=\"zh\">充实范畴</span> $\\mathsf{LMod}(\\mathcal A)$ <span lang=\"zh\">与</span> $\\mathsf{LMod}(\\mathcal B)$ <span lang=\"zh\">等价</span>;</li>\n<li><span lang=\"zh\">存在</span> $(\\mathcal A,\\mathcal B)$-<span lang=\"zh\">双模</span> $M$ <span lang=\"zh\">与</span> $(\\mathcal B,\\mathcal A)$-<span lang=\"zh\">双模</span> $N$ <span lang=\"zh\">满足</span>$$\r\n      M\\otimes_{\\mathcal B} N\\simeq\\mathcal A,\\,\\, N\\otimes_{\\mathcal A}M\\simeq\\mathcal B.\r\n  $$</li>\n</ul>\n<p><span lang=\"zh\">见</span>"},{"Local":{"url":"/充实范畴上的模","text":"<span lang=\"zh\">充实范畴上的模</span>"}},{"Plain":".</p>\n<h2><span lang=\"zh\">性质</span></h2>\n<p><span lang=\"zh\">以下的</span> “<span lang=\"zh\">环</span>” <span lang=\"zh\">指的是固定的含幺交换环</span> $k$ <span lang=\"zh\">上的</span>"},{"Local":{"url":"/结合代数","text":"<span lang=\"zh\">结合代数</span>"}},{"Plain":".</p>\n<p><strong><span lang=\"zh\">定义</span></strong>. <span lang=\"zh\">环</span> $A$ <span lang=\"zh\">上的右模</span> $M$ <span lang=\"zh\">的</span> <strong>Morita <span lang=\"zh\">语境</span></strong> (Morita context) <span lang=\"zh\">是如下的六元组</span> $(A,M,N,E,\\alpha,\\beta)$:</p>\n<ul>\n<li>$N=\\operatorname{Hom}_A(M,A)$;</li>\n<li>$E= \\operatorname{End}_A(M)$;</li>\n<li>$M\\in\\mathsf{BiMod}(E,A)$, $N\\in\\mathsf{BiMod}(A,E)$;</li>\n<li>$\\alpha\\colon N\\otimes_{E} M \\to A$, $f\\otimes x\\mapsto f(x)$;</li>\n<li>$\\beta\\colon M\\otimes_A N \\to E$, $x\\otimes f\\mapsto xf(-)$;</li>\n</ul>\n<p><span lang=\"zh\">下面两个命题显示了</span><strong><span lang=\"zh\">生成元</span></strong><span lang=\"zh\">和</span><strong><span lang=\"zh\">有限生成投射</span></strong><span lang=\"zh\">这两个性质之间的某种类比</span>; <span lang=\"zh\">这两个性质是</span><strong><span lang=\"zh\">纯范畴论</span></strong><span lang=\"zh\">性质</span>, <span lang=\"zh\">也即在范畴等价之下不变</span>; <span lang=\"zh\">特别地</span>, <span lang=\"zh\">模范畴之间的等价必须尊重这两个性质</span>. <span lang=\"zh\">代数</span> $A$ <span lang=\"zh\">在</span> $\\mathsf{RMod}(A)$ <span lang=\"zh\">中同时是生成元与有限生成投射对象</span>, <span lang=\"zh\">从而在任何等价的范畴中也是</span>"},{"Local":{"url":"/紧投射生成元","text":"<span lang=\"zh\">有限生成投射生成元</span>"}},{"Plain":". <span lang=\"zh\">这一观察是</span> Morita <span lang=\"zh\">理论的核心</span>.</p>\n<p><strong><span lang=\"zh\">命题</span></strong>.\n<span lang=\"zh\">设</span> $M$ <span lang=\"zh\">是</span> $\\mathsf{RMod}(A)$ <span lang=\"zh\">的</span>"},{"Local":{"url":"/生成元(范畴论)","text":"<span lang=\"zh\">生成元</span>"}},{"Plain":", <span lang=\"zh\">则</span></p>\n<ul>\n<li>$\\alpha\\colon N\\otimes_E M\\to A$ <span lang=\"zh\">为同构</span>;</li>\n<li>$N\\simeq \\operatorname{Hom}_{\\mathsf{LMod}(E)}(M,E)\\in\\mathsf{BiMod}(A,E)$;</li>\n<li>$M\\simeq \\operatorname{Hom}_{\\mathsf{RMod}(E)}(N,E)\\in\\mathsf{BiMod}(E,A)$;</li>\n<li>$A\\simeq\\operatorname{End}_{\\mathsf{RMod}(E)}(N)\\simeq\\operatorname{End}_{\\mathsf{LMod}(E)}(M)$.</li>\n</ul>\n<p><strong><span lang=\"zh\">命题</span></strong>.\n<span lang=\"zh\">设</span> $M$ <span lang=\"zh\">是</span> $\\mathsf{RMod}(A)$ <span lang=\"zh\">的</span>"},{"Local":{"url":"/可表现对象","text":"<span lang=\"zh\">有限生成</span>"}},{"Local":{"url":"/投射对象","text":"<span lang=\"zh\">投射对象</span>"}},{"Plain":", <span lang=\"zh\">则</span></p>\n<ul>\n<li>$\\beta\\colon M\\otimes_A N \\to E$ <span lang=\"zh\">为同构</span>;</li>\n<li>$M\\simeq \\operatorname{Hom}_{\\mathsf{LMod}(A)}(N,A)\\in\\mathsf{BiMod}(E,A)$;</li>\n<li>$N\\simeq\\operatorname{Hom}_{\\mathsf{RMod}(A)}(M,A)\\in\\mathsf{BiMod}(A,E)$ (<span lang=\"zh\">当然</span>, <span lang=\"zh\">这就是</span> $N$ <span lang=\"zh\">的定义</span>);</li>\n<li>$E\\simeq \\operatorname{End}_{\\mathsf{RMod}(A)}(M) \\simeq\\operatorname{End}_{\\mathsf{LMod}(A)}(N)$ (<span lang=\"zh\">第一个同构就是</span> $E$ <span lang=\"zh\">的定义</span>).</li>\n</ul>\n<p><strong><span lang=\"zh\">命题</span></strong> (“Morita I”). <span lang=\"zh\">设</span> $M$ <span lang=\"zh\">是</span> $\\mathsf{RMod}(A)$ <span lang=\"zh\">的</span>"},{"Local":{"url":"/紧投射生成元","text":"<span lang=\"zh\">有限生成投射生成元</span>"}},{"Plain":", $(A,M,N,E,\\alpha,\\beta)$ <span lang=\"zh\">是对应的</span> Morita <span lang=\"zh\">语境</span>, <span lang=\"zh\">则</span></p>\n<ul>\n<li>$-\\otimes_A N \\colon \\mathsf{RMod}(A) \\to \\mathsf{RMod}(E)$ <span lang=\"zh\">与</span> $-\\otimes_E M \\colon \\mathsf{RMod}(E) \\to \\mathsf{RMod}(A)$ <span lang=\"zh\">是一对互逆的等价</span>;</li>\n<li>$N\\otimes_E - \\colon \\mathsf{LMod}(E) \\to \\mathsf{LMod}(A)$ <span lang=\"zh\">与</span> $M\\otimes_A - \\colon \\mathsf{LMod}(A) \\to \\mathsf{LMod}(E)$ <span lang=\"zh\">是一对互逆的等价</span>.</li>\n</ul>\n<p><strong><span lang=\"zh\">命题</span></strong> (“Morita II”). <span lang=\"zh\">设</span> $A,B$ <span lang=\"zh\">为环</span>,\n$$\r\nF\\colon \\mathsf{RMod}(A) \\to \\mathsf{RMod}(B),\r\nG\\colon \\mathsf{RMod}(B) \\to \\mathsf{RMod}(A)\r\n$$\n<span lang=\"zh\">为互逆的等价</span>,\n<span lang=\"zh\">则有</span></p>\n<ul>\n<li>$N = F(A) \\in\\mathsf{BiMod}(A,B)$, $F\\simeq -\\otimes_A N$;</li>\n<li>$M = G(B) \\in\\mathsf{BiMod}(B,A)$, $G\\simeq -\\otimes_B M$.</li>\n</ul>\n<p><strong><span lang=\"zh\">定义</span></strong>. <span lang=\"zh\">对于环</span> $A,B$ <span lang=\"zh\">与右</span> $A$-<span lang=\"zh\">模</span> $M$, <span lang=\"zh\">若</span> $(B,A)$-<span lang=\"zh\">双模</span> $M$ <span lang=\"zh\">为</span> $\\mathsf{RMod}(A)$ <span lang=\"zh\">的</span>"},{"Local":{"url":"/紧投射生成元","text":"<span lang=\"zh\">有限生成投射生成元</span>"}},{"Plain":", <span lang=\"zh\">且</span> $B\\simeq\\operatorname{End}_{\\mathsf{RMod}(A)}(M)$, $A\\simeq\\operatorname{End}_{\\mathsf{LMod}(E)}(M)$, <span lang=\"zh\">则称</span> $M$ <span lang=\"zh\">为</span> $(B,A)$-<strong>pro-<span lang=\"zh\">生成元</span></strong> (progenerator).</p>\n<p><strong><span lang=\"zh\">命题</span></strong> (“Morita III”). <span lang=\"zh\">范畴等价</span> $\\mathsf{RMod}(A) \\to \\mathsf{RMod}(B)$ <span lang=\"zh\">的同构类一一对应于</span> $(B,A)$-pro-<span lang=\"zh\">生成元的同构类</span>. <span lang=\"zh\">范畴等价的复合等同于紧投射生成元的张量积</span>.</p>\n"}]}}}]}