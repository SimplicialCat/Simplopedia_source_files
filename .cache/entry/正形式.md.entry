{"sections":[{"slug":"正形式","section":{"metadata":{"slug":{"Plain":"正形式"},"ext":{"Plain":"md"},"title":{"Plain":"“<span lang=\"zh\">正形式</span>”"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"“正形式”"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2>$(1,1)$-<span lang=\"zh\">形式</span></h2>\n<p>"},{"Local":{"url":"/复流形","text":"<span lang=\"zh\">复流形</span>"}},{"Plain":" $M$ <span lang=\"zh\">上的实</span> $(1,1)$-<span lang=\"zh\">形式</span> $\\omega \\in \\mathcal A^{1,1}(M) \\cap \\mathcal A^2(M,\\mathbb{R})$ <span lang=\"zh\">称为正的是指对任意非零的实切向量</span> $v\\in TM$, <span lang=\"zh\">都有</span> $\\omega(v,Jv) &gt;0$.</p>\n"}]}}}]}