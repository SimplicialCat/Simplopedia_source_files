{"sections":[{"slug":"超迹","section":{"metadata":{"slug":{"Plain":"超迹"},"ext":{"Plain":"md"},"title":{"Plain":"“<span lang=\"zh\">超迹</span>”"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"“超迹”"},"data-taxon":{"Plain":"百科"}},"content":{"Plain":"\n<p><span lang=\"zh\">设</span> $A$ <span lang=\"zh\">是</span> $\\mathbb Z_2$-<span lang=\"zh\">分次</span> Hilbert <span lang=\"zh\">空间</span> $\\mathscr H^{\\pm}$ <span lang=\"zh\">上的迹类算子</span>, <span lang=\"zh\">保持奇偶</span>, <span lang=\"zh\">那么其超迹</span> $\\operatorname{str}A$ <span lang=\"zh\">定义为</span>\n$$\r\n\\operatorname{str}A=\\operatorname{tr}_{\\mathscr H^+}A-\\operatorname{tr}_{\\mathscr H^-}A.\r\n$$</p>\n"}}}]}