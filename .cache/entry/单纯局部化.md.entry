{"sections":[{"slug":"单纯局部化","section":{"metadata":{"slug":{"Plain":"单纯局部化"},"ext":{"Plain":"md"},"title":{"Plain":"“<span lang=\"zh\">单纯局部化</span>”"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"“单纯局部化”"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">定义</span></h2>\n<h3><span lang=\"zh\">标准单纯局部化</span></h3>\n<p><span lang=\"zh\">设</span> $U\\colon \\mathsf {Cat} \\to \\mathsf {Graph}$ <span lang=\"zh\">将小范畴对应到其底层无向图</span>. <span lang=\"zh\">函子</span> $U$ <span lang=\"zh\">有左伴随</span> $F\\colon \\mathsf {Graph}\\to\\mathsf {Cat}$. <span lang=\"zh\">于是我们得到</span> $\\mathsf {Cat}$ <span lang=\"zh\">上的</span>"},{"Local":{"url":"/余单子","text":"<span lang=\"zh\">余单子</span>"}},{"Plain":" $(G,\\varepsilon,\\delta)$.</p>\n"}]}}}]}