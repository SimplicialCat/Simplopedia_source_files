{"sections":[{"slug":"Gauss曲率","section":{"metadata":{"slug":{"Plain":"Gauss曲率"},"ext":{"Plain":"md"},"title":{"Plain":"Gauss <span lang=\"zh\">曲率</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"Gauss 曲率"},"data-taxon":{"Plain":"百科"}},"content":{"Plain":"\n<h2><span lang=\"zh\">观念</span></h2>\n<p>Gauss <span lang=\"zh\">曲率是</span> $2$ <span lang=\"zh\">维</span> Riemann <span lang=\"zh\">流形上的一个不变量</span>.</p>\n<h2><span lang=\"zh\">定义</span></h2>\n<h2><span lang=\"zh\">性质</span></h2>\n"}}}]}