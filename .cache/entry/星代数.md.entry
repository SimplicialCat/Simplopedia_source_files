{"sections":[{"slug":"星代数","section":{"metadata":{"slug":{"Plain":"星代数"},"ext":{"Plain":"md"},"title":{"Plain":"*-<span lang=\"zh\">代数</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"*-代数"},"data-taxon":{"Plain":"百科"}},"content":{"Plain":"\n<p><span lang=\"zh\">一个</span> *-<span lang=\"zh\">代数是一个交换</span> (<span lang=\"zh\">或非交换</span>), <span lang=\"zh\">结合</span> (<span lang=\"zh\">或非结合</span>) <span lang=\"zh\">代数</span> $A$, <span lang=\"zh\">具有一个反对合</span> (anti-involution) $(-)^*\\colon A \\to A$, <span lang=\"zh\">满足</span></p>\n<ul>\n<li>$(ab)^* = b^* a^*$,</li>\n<li>$(a^*)^* = a$,</li>\n<li>$1^*=1$.</li>\n</ul>\n"}}}]}