{"sections":[{"slug":"内射消解","section":{"metadata":{"slug":{"Plain":"内射消解"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">内射消解</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"内射消解"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<p><span lang=\"zh\">设</span> Abel <span lang=\"zh\">范畴</span> $\\mathcal A$ <span lang=\"zh\">有足够多内射对象</span>, <span lang=\"zh\">那么对于下有界复形</span> $A^\\bullet\\in \\mathsf K^+(\\mathcal A)$, <span lang=\"zh\">存在</span>"},{"Local":{"url":"/消解","text":"<span lang=\"zh\">消解</span>"}},{"Plain":" $A^\\bullet \\to I^\\bullet$.</p>\n<h2><span lang=\"zh\">性质</span></h2>\n<p><span lang=\"zh\">嵌入</span>\n$$\r\n\\iota\\colon \\mathsf K^+(\\mathcal I_{\\mathcal A})\\to \\mathsf K^+(\\mathcal A) \\to \\mathsf D^+(\\mathcal A)\r\n$$\n<span lang=\"zh\">是范畴等价</span>. <span lang=\"zh\">特别地</span>, <span lang=\"zh\">由内射对象组成的链复形之间的拟同构必为同伦等价</span>.</p>\n"}]}}}]}