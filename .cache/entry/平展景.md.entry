{"sections":[{"slug":"平展景","section":{"metadata":{"slug":{"Plain":"平展景"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">平展景</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"平展景"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">观念</span></h2>\n<p><span lang=\"zh\">概形的平展景可用于</span> "},{"Local":{"url":"/GrothendieckGalois理论","text":"Grothendieck Galois <span lang=\"zh\">理论</span>"}},{"Plain":".</p>\n<h2><span lang=\"zh\">定义</span></h2>\n<h2><span lang=\"zh\">性质</span></h2>\n<h3><span lang=\"zh\">与</span> Zariski <span lang=\"zh\">景的比较</span></h3>\n<p>Zariski <span lang=\"zh\">开集的嵌入都是平展映射</span>, <span lang=\"zh\">这给出一个</span>"},{"Local":{"url":"/景的态射","text":"<span lang=\"zh\">景的态射</span>"}},{"Plain":" $X_{\\mathrm{Zar}} \\to X_{\\mathrm{\\'et}}$, <span lang=\"zh\">从而有意象的</span>"},{"Local":{"url":"/几何态射","text":"<span lang=\"zh\">几何态射</span>"}},{"Plain":"\n$$\r\nf = (f^*\\dashv f_*)\r\n\\colon \\operatorname{Sh}(X_{\\mathrm{\\'et}}) \\to \\operatorname{Sh}(X_{\\mathrm{Zar}}).\r\n$$\n<span lang=\"zh\">其中</span>"},{"Local":{"url":"/直像","text":"<span lang=\"zh\">直像</span>"}},{"Plain":"<span lang=\"zh\">部分</span> $f_*$ <span lang=\"zh\">就是将</span> $X_{\\mathrm{\\'et}}$ <span lang=\"zh\">上的层限制到</span> Zariski <span lang=\"zh\">开集</span>; <span lang=\"zh\">而</span>"},{"Local":{"url":"/逆像","text":"<span lang=\"zh\">逆像</span>"}},{"Plain":"<span lang=\"zh\">部分</span> $f^*$ <span lang=\"zh\">是预层逆像的</span>"},{"Local":{"url":"/层化","text":"<span lang=\"zh\">层化</span>"}},{"Plain":": <span lang=\"zh\">对于</span> Zariski <span lang=\"zh\">层</span> $F$, <span lang=\"zh\">考虑</span> $X_{\\mathrm{\\'et}}$ <span lang=\"zh\">上的预层</span>\n$$\r\nf^*_{\\mathrm{pre}}F\\colon (g\\colon U\\to X) \\mapsto \\operatorname{colim}_{g(U)\\subset V} F(V) = g^*F(U),\r\n$$\n<span lang=\"zh\">而</span> $f^*F$ <span lang=\"zh\">是</span> $f^*_{\\mathrm{pre}}F$ <span lang=\"zh\">在</span> $X_{\\mathrm{\\'et}}$ <span lang=\"zh\">上的层化</span>.</p>\n<p><span lang=\"zh\">一个特例是</span>"},{"Local":{"url":"/凝聚层","text":"<span lang=\"zh\">凝聚</span>"}},{"Plain":" Zariski <span lang=\"zh\">层的逆像不需要层化</span>. <span lang=\"zh\">设</span> $M$ <span lang=\"zh\">是</span> $X_{\\mathrm{Zar}}$ <span lang=\"zh\">上的</span>"},{"Local":{"url":"/凝聚层","text":"<span lang=\"zh\">凝聚</span>"}},{"Plain":" $\\mathcal O_X$-<span lang=\"zh\">模</span>, $M$ <span lang=\"zh\">作为预层拉回到</span> $X_{\\mathrm{\\'et}}$ <span lang=\"zh\">上的预层</span> $M^{\\mathrm{\\'et}}$, <span lang=\"zh\">则</span> $M^{\\mathrm{\\'et}}$ <span lang=\"zh\">是</span> $X_{\\mathrm{\\'et}}$ <span lang=\"zh\">上的层</span>. <span lang=\"zh\">这是由于如下结论</span>: <span lang=\"zh\">对任意</span>"},{"Local":{"url":"/忠实平坦环同态","text":"<span lang=\"zh\">忠实平坦环同态</span>"}},{"Plain":" $A\\to B$ <span lang=\"zh\">以及</span> $A$-<span lang=\"zh\">模</span> $M$, <span lang=\"zh\">序列</span>\n$$\r\n0\\to M\\to M\\otimes_A B \\rightrightarrows M\\otimes_A B\\otimes_A B\r\n$$\n<span lang=\"zh\">正合</span>.</p>\n"}]}}}]}