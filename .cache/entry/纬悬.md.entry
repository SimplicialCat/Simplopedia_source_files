{"sections":[{"slug":"纬悬","section":{"metadata":{"slug":{"Plain":"纬悬"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">纬悬</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"纬悬"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">定义</span></h2>\n<p><span lang=\"zh\">设</span> "},{"Local":{"url":"/无穷范畴","text":"$\\infty$-<span lang=\"zh\">范畴</span>"}},{"Plain":" $\\mathcal C$ <span lang=\"zh\">有</span>"},{"Local":{"url":"/终对象","text":"<span lang=\"zh\">终对象</span>"}},{"Plain":" $*$. <span lang=\"zh\">定义对象</span> $X$ <span lang=\"zh\">的</span><strong><span lang=\"zh\">纬悬</span></strong> $\\Sigma X$ <span lang=\"zh\">为如下推出</span>,\n$$\r\n\\begin{array}\r\n    {ccc}\r\n    X &amp; \\to &amp; * \\\\\r\n    \\downarrow &amp; &amp; \\downarrow \\\\\r\n    * &amp; \\to &amp; \\Sigma X.\r\n\\end{array}\r\n$$</p>\n<h2><span lang=\"zh\">性质</span></h2>\n<p><span lang=\"zh\">纬悬函子</span> $\\Sigma\\colon \\mathcal C\\to\\mathcal C_{*/}$ <span lang=\"zh\">是</span>"},{"Local":{"url":"/环路空间","text":"<span lang=\"zh\">环路空间</span>"}},{"Plain":"<span lang=\"zh\">函子</span> $\\Omega\\colon \\mathcal C_{*/} \\to \\mathcal C$ <span lang=\"zh\">的左</span>"},{"Local":{"url":"/伴随","text":"<span lang=\"zh\">伴随</span>"}},{"Plain":": <span lang=\"zh\">对任意对象</span> $X$ <span lang=\"zh\">以及</span>"},{"Local":{"url":"/带基点对象","text":"<span lang=\"zh\">带基点对象</span>"}},{"Plain":" $Y$, <span lang=\"zh\">交换图</span>\n$$\r\n\\begin{array}\r\n    {ccc}\r\n    X &amp; \\to &amp; *\\\\\r\n    \\downarrow &amp; &amp; \\downarrow\\\\\r\n    * &amp; \\to &amp; Y\r\n\\end{array}\r\n$$\n<span lang=\"zh\">等同于态射</span> $\\Sigma X\\to Y$, <span lang=\"zh\">也等同于态射</span> $X\\to\\Omega Y$.</p>\n"}]}}}]}