{"sections":[{"slug":"标量限制","section":{"metadata":{"slug":{"Plain":"标量限制"},"ext":{"Plain":"md"},"title":{"Plain":"“<span lang=\"zh\">标量限制</span>”"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"“标量限制”"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">定义</span></h2>\n<p><span lang=\"zh\">设</span> $f \\colon R \\to S$ <span lang=\"zh\">为环同态</span>. <span lang=\"zh\">对于左</span> $S$-<span lang=\"zh\">模</span> $M$, <span lang=\"zh\">通过</span> $f$ <span lang=\"zh\">可将其视为左</span> $R$-<span lang=\"zh\">模</span>, <span lang=\"zh\">这给出了标量限制</span>\n$$\r\nf^* \\colon S\\mathsf {Mod} \\to R\\mathsf {Mod}.\r\n$$</p>\n<p><span lang=\"zh\">标量限制也可定义为</span>\n$$\r\nf^*M := \\operatorname{Hom}_S(S,M),\r\n$$\n<span lang=\"zh\">其中</span> $S$ <span lang=\"zh\">是左</span> $S$ <span lang=\"zh\">右</span> $R$ <span lang=\"zh\">模</span>, $\\operatorname{Hom}_S(S,M)$ <span lang=\"zh\">为左</span> $R$-<span lang=\"zh\">模</span>.</p>\n<h2><span lang=\"zh\">性质</span></h2>\n<p><span lang=\"zh\">标量限制是</span>"},{"Local":{"url":"/标量扩张","text":"<span lang=\"zh\">标量扩张</span>"}},{"Plain":"<span lang=\"zh\">的右伴随</span> ("},{"Local":{"url":"/张量-同态伴随","text":"<span lang=\"zh\">张量</span>-<span lang=\"zh\">同态伴随</span>"}},{"Plain":").</p>\n<p><span lang=\"zh\">考虑</span> $f\\colon R\\to S$ <span lang=\"zh\">对应的</span>"},{"Local":{"url":"/仿射概形","text":"<span lang=\"zh\">仿射概形</span>"}},{"Plain":"<span lang=\"zh\">的映射</span> $\\varphi\\colon \\operatorname{Spec}S\\to\\operatorname{Spec}R$, <span lang=\"zh\">则标量限制对应于</span>"},{"Local":{"url":"/六函子","text":"<span lang=\"zh\">六函子</span>"}},{"Plain":"<span lang=\"zh\">中的</span>"},{"Local":{"url":"/直像","text":"<span lang=\"zh\">直像</span>"}},{"Plain":" $\\varphi_*\\colon \\operatorname{QCoh}(\\operatorname{Spec}S) \\to \\operatorname{QCoh}(\\operatorname{Spec}R)$.</p>\n"}]}}}]}