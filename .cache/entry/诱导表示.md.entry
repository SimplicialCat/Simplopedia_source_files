{"sections":[{"slug":"诱导表示","section":{"metadata":{"slug":{"Plain":"诱导表示"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">诱导表示</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"诱导表示"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">定义</span></h2>\n<p><span lang=\"zh\">设</span> $k$ <span lang=\"zh\">为域</span>, $H\\subset G$ <span lang=\"zh\">为子群</span>, <span lang=\"zh\">那么由</span> $H$ <span lang=\"zh\">的表示</span> $X$ <span lang=\"zh\">可得</span> $G$ <span lang=\"zh\">的表示</span>\n$$\r\n\\operatorname{Ind}_H^G X := k[G]\\otimes_{k[H]}X,\r\n$$\n<span lang=\"zh\">称为诱导表示</span>. <span lang=\"zh\">这个过程是限制表示的左伴随</span>, <span lang=\"zh\">是</span>"},{"Local":{"url":"/标量扩张","text":"<span lang=\"zh\">标量扩张</span>"}},{"Plain":"<span lang=\"zh\">的特例</span>.</p>\n<h2><span lang=\"zh\">性质</span></h2>\n<p><span lang=\"zh\">参见</span> "},{"Local":{"url":"/Frobenius互反律","text":"Frobenius <span lang=\"zh\">互反律</span>"}},{"Plain":".</p>\n"}]}}}]}