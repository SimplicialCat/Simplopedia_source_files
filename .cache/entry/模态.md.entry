{"metadata":{"author":[{"Lazy":[{"Local":{"url":"SimplicialCat","text":"SimplicialCat"}}]},4],"slug":[{"Plain":"模态"},0],"ext":[{"Plain":"md"},1],"title":[{"Plain":"模态"},2],"tag":[{"Plain":"百科"},3]},"content":{"Lazy":[{"Plain":"\n<p>在形式逻辑中, 模态体现为"},{"Local":{"url":"模态算子","text":"模态算子"}},{"Plain":", 将命题/类型对应到新的命题/类型.</p>\n<p>在"},{"Local":{"url":"范畴论","text":"范畴论"}},{"Plain":"中, 模态通常定义为"},{"Local":{"url":"幂等单子","text":"幂等单子"}},{"Plain":".</p>\n"}]}}