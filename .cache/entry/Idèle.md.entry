{"sections":[{"slug":"Idèle","section":{"metadata":{"slug":{"Plain":"Idèle"},"ext":{"Plain":"md"},"title":{"Plain":"Idèle"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"Idèle"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">定义</span></h2>\n<p><span lang=\"zh\">理元</span> (idèle) <span lang=\"zh\">是</span>"},{"Local":{"url":"/Adèle","text":"<span lang=\"zh\">加元</span> (adèle) <span lang=\"zh\">环</span>"}},{"Plain":"<span lang=\"zh\">的乘法单位元群</span>:\n$$\r\n\\mathbb I = \\mathbb A^\\times.\r\n$$</p>\n<blockquote>\n<p>“Idèle” <span lang=\"zh\">这个名字由法国数学家</span> Claude Chevalley <span lang=\"zh\">创造</span>, <span lang=\"zh\">意为</span> “<span lang=\"zh\">理想的元素</span>” (ideal element), <span lang=\"zh\">缩写为</span> id.el. <span lang=\"zh\">而</span> “"},{"Local":{"url":"/Adèle","text":"Adèle"}},{"Plain":"” <span lang=\"zh\">意为</span> “<span lang=\"zh\">加性</span> idèle” (additive ideal element).</p>\n</blockquote>\n"}]}}}]}