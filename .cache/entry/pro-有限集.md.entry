{"sections":[{"slug":"pro-有限集","section":{"metadata":{"slug":{"Plain":"pro-有限集"},"ext":{"Plain":"md"},"title":{"Plain":"pro-<span lang=\"zh\">有限集</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"pro-有限集"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">定义</span></h2>\n<p>pro-<span lang=\"zh\">有限集可定义为如下等价的概念</span>:</p>\n<ul>\n<li><span lang=\"zh\">完全不连通紧</span> Hausdorff <span lang=\"zh\">空间</span></li>\n<li><span lang=\"zh\">有限集范畴中的</span> "},{"Local":{"url":"/pro-对象","text":"pro-<span lang=\"zh\">对象</span>"}},{"Plain":"</li>\n</ul>\n<h2><span lang=\"zh\">例</span></h2>\n<ul>\n<li>"},{"Local":{"url":"/Cantor集","text":"Cantor <span lang=\"zh\">集</span>"}},{"Plain":" $\\prod_{\\mathbb N}\\{0,1\\}$</li>\n<li>$\\mathbb Z_p = \\lim_n \\mathbb Z/p^n$</li>\n<li>$\\mathbb N\\cup\\{\\infty\\}=\\lim_n \\{0,1,\\cdots,n\\}\\cup\\{\\infty\\}$</li>\n<li>"},{"Local":{"url":"/绝对Galois群","text":"<span lang=\"zh\">绝对</span> Galois <span lang=\"zh\">群</span>"}},{"Plain":" $\\mathrm{Gal}(K^{\\mathrm{sep}}/K)=\\lim\\mathrm{Gal}(L/K)$</li>\n</ul>\n<h2><span lang=\"zh\">性质</span></h2>\n<p>pro-<span lang=\"zh\">有限集之间的满射一定是商映射</span>.</p>\n<h2><span lang=\"zh\">相关概念</span></h2>\n<p>"},{"Local":{"url":"/凝聚态集合","text":"<span lang=\"zh\">凝聚态集合</span>"}},{"Plain":"</p>\n"}]}}}]}