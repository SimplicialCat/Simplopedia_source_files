{"sections":[{"slug":"几何点","section":{"metadata":{"slug":{"Plain":"几何点"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">几何点</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"几何点"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">定义</span></h2>\n<p>"},{"Local":{"url":"/概形","text":"<span lang=\"zh\">概形</span>"}},{"Plain":" $X$ <span lang=\"zh\">的</span><strong><span lang=\"zh\">几何点</span></strong> (geometric point) <span lang=\"zh\">是</span>"},{"Local":{"url":"/可分闭域","text":"<span lang=\"zh\">可分闭域</span>"}},{"Plain":" $k$ <span lang=\"zh\">对应的仿射概形</span> $\\operatorname{Spec}k$ <span lang=\"zh\">到</span> $X$ <span lang=\"zh\">的映射</span>, <span lang=\"zh\">也相当于</span> $X$ <span lang=\"zh\">的一个</span> (<span lang=\"zh\">拓扑</span>) <span lang=\"zh\">点</span> $x$ <span lang=\"zh\">带有包含剩余域</span> $\\kappa(x)$ <span lang=\"zh\">的一个</span>"},{"Local":{"url":"/可分闭域","text":"<span lang=\"zh\">可分闭域</span>"}},{"Plain":".</p>\n"}]}}}]}