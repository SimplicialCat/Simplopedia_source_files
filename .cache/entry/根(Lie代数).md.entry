{"sections":[{"slug":"根(Lie代数)","section":{"metadata":{"slug":{"Plain":"根(Lie代数)"},"ext":{"Plain":"md"},"title":{"Plain":"“<span lang=\"zh\">根</span> (Lie <span lang=\"zh\">代数</span>)”"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"“根 (Lie 代数)”"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<p><span lang=\"zh\">注意区分</span>"},{"Local":{"url":"/根","text":"<span lang=\"zh\">根</span>"}},{"Plain":" (root).</p>\n<h2><span lang=\"zh\">定义</span></h2>\n<p><span lang=\"zh\">设</span> $\\mathfrak g$ <span lang=\"zh\">为有限维</span> Lie <span lang=\"zh\">代数</span>, <span lang=\"zh\">那么存在一个</span>"},{"Local":{"url":"/可解","text":"<span lang=\"zh\">可解</span> Lie <span lang=\"zh\">代数</span>"}},{"Plain":"<span lang=\"zh\">理想</span> $\\mathfrak r$ <span lang=\"zh\">包含所有的可解理想</span>, <span lang=\"zh\">称之为</span> $\\mathfrak g$ <span lang=\"zh\">的根</span> (radical).</p>\n<h2><span lang=\"zh\">相关概念</span></h2>\n<p>"},{"Local":{"url":"/半单Lie代数","text":"<span lang=\"zh\">半单</span> Lie <span lang=\"zh\">代数</span>"}},{"Plain":"</p>\n"}]}}}]}