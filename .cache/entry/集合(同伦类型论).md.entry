{"sections":[{"slug":"集合(同伦类型论)","section":{"metadata":{"slug":{"Plain":"集合(同伦类型论)"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">集合</span> (<span lang=\"zh\">同伦类型论</span>)"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"subject":{"Lazy":[{"Local":{"url":"/同伦类型论","text":"<span lang=\"zh\">同伦类型论</span>"}}]},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"集合 (同伦类型论)"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">定义</span></h2>\n<p><span lang=\"zh\">在</span>"},{"Local":{"url":"/同伦类型论","text":"<span lang=\"zh\">同伦类型论</span>"}},{"Plain":"<span lang=\"zh\">中</span>, <span lang=\"zh\">若类型</span> $A$ <span lang=\"zh\">满足对任意</span> $x,y\\colon A$, <span lang=\"zh\">任意</span> $p,q\\colon x=y$, <span lang=\"zh\">都有</span> $p=q$, <span lang=\"zh\">则称</span> $A$ <span lang=\"zh\">为</span><strong><span lang=\"zh\">集合</span></strong>.</p>\n<p><span lang=\"zh\">换言之</span>, $A$ <span lang=\"zh\">是集合当且仅当</span> $A$ <span lang=\"zh\">中任意两个元素之间的等式类型都是</span>"},{"Local":{"url":"/命题(同伦类型论)","text":"<span lang=\"zh\">命题</span>"}},{"Plain":".</p>\n<h2><span lang=\"zh\">例</span></h2>\n<p>"},{"Local":{"url":"/单点(同伦类型论)","text":"<span lang=\"zh\">单点</span>"}},{"Plain":"<span lang=\"zh\">是集合</span>.</p>\n<p><span lang=\"zh\">所有</span>"},{"Local":{"url":"/命题(同伦类型论)","text":"<span lang=\"zh\">命题</span>"}},{"Plain":"<span lang=\"zh\">都是集合</span>.</p>\n"}]}}}]}