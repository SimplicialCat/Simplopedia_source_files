{"sections":[{"slug":"伴随","section":{"metadata":{"slug":{"Plain":"伴随"},"ext":{"Plain":"md"},"title":{"Plain":"<span lang=\"zh\">伴随</span>"},"taxon":{"Plain":"<span lang=\"zh\">百科</span>. "},"author":{"Lazy":[{"Local":{"url":"/SimplicialCat","text":"SimplicialCat"}}]},"page-title":{"Plain":"伴随"},"data-taxon":{"Plain":"百科"}},"content":{"Lazy":[{"Plain":"\n<h2><span lang=\"zh\">观念</span></h2>\n<p><span lang=\"zh\">伴随是</span> "},{"Local":{"url":"/2-范畴","text":"$2$-<span lang=\"zh\">范畴</span>"}},{"Plain":"<span lang=\"zh\">的两个对象之间一对态射的一种关系</span>, <span lang=\"zh\">是</span> $1$-<span lang=\"zh\">范畴中态射的互逆关系的推广</span>.</p>\n<p>$2$-<span lang=\"zh\">范畴</span> $\\mathcal C$ <span lang=\"zh\">中的伴随等同于</span>"},{"Local":{"url":"/游走的伴随","text":"<span lang=\"zh\">游走的伴随</span>"}},{"Plain":" $\\mathsf{Adj}$ <span lang=\"zh\">到</span> $\\mathcal C$ <span lang=\"zh\">的函子</span>\n$$\r\n\\mathsf{Adj} \\to \\mathcal C.\r\n$$</p>\n<h2><span lang=\"zh\">定义</span></h2>\n<h2><span lang=\"zh\">例</span></h2>\n<h3><span lang=\"zh\">自由</span>-<span lang=\"zh\">遗忘伴随</span></h3>\n<p>"},{"Local":{"url":"/自由-遗忘伴随","text":"<span lang=\"zh\">自由</span>-<span lang=\"zh\">遗忘伴随</span>"}},{"Plain":"</p>\n<h3><span lang=\"zh\">偏序集之间的伴随</span></h3>\n<p><span lang=\"zh\">见</span> "},{"Local":{"url":"/Galois对应","text":"Galois <span lang=\"zh\">对应</span>"}},{"Plain":".</p>\n<h3><span lang=\"zh\">层与平展空间</span></h3>\n<p><span lang=\"zh\">对拓扑空间</span> $X$, <span lang=\"zh\">预层的</span>"},{"Local":{"url":"/平展空间","text":"<span lang=\"zh\">平展空间</span>"}},{"Plain":"<span lang=\"zh\">与丛的截面层给出了一对伴随</span>\n$$\r\n\\operatorname{Presh}(X) \\rightleftarrows\\mathsf {Top}/X.\r\n$$\n<span lang=\"zh\">这对伴随限制为满子范畴的等价</span>\n$$\r\n\\operatorname{Sh}(X) \\rightleftarrows\\mathsf {Et}(X).\r\n$$</p>\n"}]}}}]}